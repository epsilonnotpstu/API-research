+            with self.subTest(value=value):
+                hit = T.alternative_format(f'String "{value}" is invalid against requested date format(s) yyyy-MM-dd', 'fixture:F1')
+                self.assertEqual((hit.label, hit.confidence), ('SPEC', 1))
