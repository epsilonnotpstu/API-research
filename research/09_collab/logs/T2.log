+                     {'type': 'string', 'description': 'null if none', 'nullable': True}):
+            schema = {'type': 'object', 'properties': {'next': prop}}
+            self.assertIsNone(T.documented_null(T.Context({'api': [a]}, {'api': spec_with(schema)}), 'api', a, '/next'))
+
