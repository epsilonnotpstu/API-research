+        with patch.object(T, 'helpers', side_effect=ImportError('unavailable')):
+            self.assertIsNone(T.composition(T.Context({'api': [a]}, {'api': spec}), 'api', a, ''))
+
+    def test_duplicate_only_oneof_has_unsat_proof(self):
