+        self.assertEqual((hit.label, hit.rule), ('SPEC', 'COMPOSITION_UNSAT'))
+
+    def test_partial_overlap_or_duplicate_subset_is_not_unsat(self):
+        for schema in ({'oneOf': [{'type': 'number'}, {'type': 'integer'}]},
