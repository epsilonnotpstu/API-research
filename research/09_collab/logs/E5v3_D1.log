18: 
19: @Path("/v1/system")
20: @Produces(MediaType.APPLICATION_JSON)
21: @Api(tags = {"system status"})
22: public class SystemResource extends AbstractResource {
23:     @GET
24:     @Path("ping")
25:     public Response ping() {
26:         return Response.noContent().build();
27:     }
28: 
29:     @GET
30:     @Path("roles")
31:     public Response roles() {
32:         return Response.status(418).entity(new RolesView(
33:                 Stream.of(Permission.values()).collect(Collectors.toMap(Enum::name, Permission::getLevel)),
34:                 Stream.of(Role.values()).collect(Collectors.toMap(Enum::name, Role::getLevel))
35:         )).build();
36:     }
37: 
38:     @JsonNaming(value = PropertyNamingStrategy.LowerCaseWithUnderscoresStrategy.class)
39:     public static class RolesView {
40:         private Map<String, Integer> permissionLevels;
41:         private Map<String, Integer> roleLevels;
42: 
43:         public RolesView() {
44:         }
45: 
46:         public RolesView(Map<String, Integer> permissionLevels, Map<String, Integer> roleLevels) {
47:             this.permissionLevels = permissionLevels;
48:             this.roleLevels = roleLevels;
49:         }
50: 
51:         public Map<String, Integer> getPermissionLevels() {
52:             return permissionLevels;
53:         }
54: 
55:         public Map<String, Integer> getRoleLevels() {
56:             return roleLevels;
57:         }
58: 
59:         @Override
60:         public boolean equals(Object o) {
61:             if (this == o) return true;
62:             if (!(o instanceof RolesView)) return false;
63:             RolesView rolesView = (RolesView) o;
64:             return Objects.equals(permissionLevels, rolesView.permissionLevels) &&
65:                     Objects.equals(roleLevels, rolesView.roleLevels);
66:         }
67: 
68:         @Override
69:         public int hashCode() {
70:             return Objects.hash(permissionLevels, roleLevels);
71:         }
72:     }
73: }
