FILE K12/source/market-rest/src/main/java/market/rest/ProductsRestController.java
1: package market.rest;
2: 
3: import market.domain.Product;
4: import market.dto.ProductDTO;
5: import market.dto.assembler.ProductDtoAssembler;
6: import market.exception.UnknownEntityException;
7: import market.service.ProductService;
8: import org.springframework.hateoas.server.ExposesResourceFor;
9: import org.springframework.web.bind.annotation.GetMapping;
10: import org.springframework.web.bind.annotation.PathVariable;
11: import org.springframework.web.bind.annotation.RequestMapping;
12: import org.springframework.web.bind.annotation.RestController;
13: 
14: import java.util.Collection;
15: import java.util.Comparator;
16: import java.util.stream.Collectors;
17: 
18: import static org.springframework.hateoas.server.mvc.WebMvcLinkBuilder.linkTo;
19: import static org.springframework.hateoas.server.mvc.WebMvcLinkBuilder.methodOn;
20: 
21: @RestController
22: @RequestMapping(value = "products")
23: @ExposesResourceFor(ProductDTO.class)
24: public class ProductsRestController {
25: 
26: 	private final ProductService productService;
27: 	private final ProductDtoAssembler productAssembler = new ProductDtoAssembler();
28: 
29: 	public ProductsRestController(ProductService productService) {
30: 		this.productService = productService;
31: 	}
32: 
33: 	/**
34: 	 * All the existing products, sorted by id.
35: 	 */
36: 	@GetMapping
37: 	public Collection<ProductDTO> getProducts() {
38: 		return productService.findAll().stream()
39: 			.sorted(Comparator.comparing(Product::getId))
40: 			.map(productAssembler::toModel)
41: 			.peek(this::addSelfLink)
42: 			.collect(Collectors.toList());
43: 	}
44: 
45: 	private void addSelfLink(ProductDTO dto) {
46: 		dto.add(linkTo(methodOn(getClass()).getProduct(dto.getProductId())).withRel("self"));
47: 	}
48: 
49: 	/**
50: 	 * Viewing a single product.
51: 	 *
52: 	 * @return product with the specified id
53: 	 * @throws UnknownEntityException if the product with the specified id doesn't exist
54: 	 */
55: 	@GetMapping(value = "/{productId}")
56: 	public ProductDTO getProduct(@PathVariable long productId) {
57: 		return productService.findById(productId)
58: 			.map(productAssembler::toModel)
59: 			.map(this::addListLink)
60: 			.orElseThrow(() -> new UnknownEntityException(ProductDTO.class, productId));
61: 	}
62: 
63: 	private ProductDTO addListLink(ProductDTO dto) {
64: 		dto.add(linkTo(methodOn(getClass()).getProducts()).withRel("All products"));
65: 		return dto;
66: 	}
67: }
