245:     @GET
246:     @Timed
247:     @Path("{id}/file")
248:     @Produces(MediaType.APPLICATION_OCTET_STREAM)
249:     @UnitOfWork
250:     @ApiOperation(value = "Download media file. Can resize images (but images will never be enlarged).")
251:     public Response downloadFile(@PathParam("id") long id,
252: 
253:                                  @ApiParam(value = "" +
254:                                          "The maximum width/height of returned images. " +
255:                                          "The specified value will be rounded up to the " +
256:                                          "next 'power of 2', e.g. 256, 512, 1024 and so on.")
257:                                  @QueryParam("size") int size) {
258:         MediaFile mediaFile = dao.read(id);
259:         try {
260:             URI sourceURI = new URI(mediaFile.getUri());
261:             File localFile;
262:             if ("file".equals(sourceURI.getScheme())) {
263:                 localFile = new File(mediaFilesFolder, sourceURI.getPath());
264:             } else {
265:                 localFile = new File(mediaFilesFolder, mediaFile.getId() + "_" + StringUtils.right(mediaFile.getUri().replaceAll("[^a-zA-Z0-9._-]", ""), 50));
266:                 // Download file if not already downloaded
267:                 if (!localFile.isFile()) {
268:                     Files.write(localFile.toPath(), Resources.toByteArray(sourceURI.toURL()));
269:                 }
270:             }
271:             if (imageMimeTypes.containsKey(mediaFile.getMimeType()) && size > 0) {
272:                 String formatName = imageMimeTypes.get(mediaFile.getMimeType());
273:                 localFile = MediaFileUtils.getSuitableImage(localFile, size, formatName);
274:             }
275:             byte[] bytes = Files.readAllBytes(localFile.toPath());
276:             return Response.ok(bytes, StringUtils.defaultString(mediaFile.getMimeType(), MediaType.APPLICATION_OCTET_STREAM)).header(HttpHeaders.CONTENT_LENGTH, bytes.length).build();
277:         } catch (IOException e) {
278:             LOGGER.warn("Could not read file " + mediaFile.getUri(), e);
279:             throw new WebApplicationException(Response.Status.INTERNAL_SERVER_ERROR);
280:         } catch (URISyntaxException e) {
281:             LOGGER.warn("URI syntax error when parsing path stored in database.", e);
282:             throw new WebApplicationException(Response.Status.INTERNAL_SERVER_ERROR);
283:         }
284:     }
