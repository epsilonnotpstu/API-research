62: 
63:         // Verify that tags can be reported to have multiple activities assigned to them.
64:         assertTrue(tags.stream().anyMatch(tag -> tag.getId() == 2L && tag.getActivitiesCount() == 2L));
65: 
66:         // Verify that tags assigned to non-published activity revisions are not counted (tag 5 has only been assigned to an unpublished activity revision)
67:         assertTrue(tags.stream().anyMatch(tag -> tag.getId() == 5L && tag.getActivitiesCount() == 0L));
68: 
69:         // Verify that tags assigned to no activity revisions are not counted
70:         assertTrue(tags.stream().anyMatch(tag -> tag.getId() == 6L && tag.getActivitiesCount() == 0L));
71: 
72:         tx.rollback();
73:     }
