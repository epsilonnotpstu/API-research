import csv,json,subprocess,concurrent.futures
from pathlib import Path
rows=list(csv.DictReader(open('items.csv')))
def run(r):
 iid=r['item_id'];v=json.loads((Path('review_D1')/(iid+'.json')).read_text())
 if not v['search_mandatory']:return None
 cmd=['/usr/bin/python3','-I','-B','../../tools/intent_evidence.py',r['package']+'/source',r['package']+'/spec.json','--method',r['method'],'--path',r['template'],'--status',r['status']]
 if v['target_proposition']['field']:cmd+=['--field',v['target_proposition']['field']]
 cmd+=['--json']
 p=subprocess.run(cmd,capture_output=True)
 base=Path('search_D1')/iid
 base.with_suffix('.json').write_bytes(p.stdout);base.with_suffix('.stderr').write_bytes(p.stderr);base.with_suffix('.exitcode').write_text(str(p.returncode)+'\\n')
 try:
  x=json.loads(p.stdout);return iid,p.returncode,x['independent_evidence'],len(x['hits']),x['scan'],x['warnings']
 except ValueError:return iid,p.returncode,'parse error'
with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
 for z in pool.map(run,rows):
  if z:print(json.dumps(z))
