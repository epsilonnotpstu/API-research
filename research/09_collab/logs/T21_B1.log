   115	    public static Pet createPet(final Long id, final Category cat, final String name,
   116	                            final List<String> urls, final List<Tag> tags, final String status) {
   117	        final Pet pet = new Pet();
   118	        pet.setId(id);
   119	        pet.setCategory(cat);
   120	        pet.setName(name);
   121	        pet.setPhotoUrls(urls);
   122	        pet.setTags(tags);
   123	        pet.setStatus(status);
   124	        return pet;
