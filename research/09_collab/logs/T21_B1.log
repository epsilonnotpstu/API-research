    47	        doAuth(authResult, response, Permission.rating_set_own);
    48	        return activityRatingDao.all(authResult.getUser()).stream().filter(ar -> ar.isFavourite() != null && ar.isFavourite()).map(activityRating -> activityRating.getActivity().getId()).collect(Collectors.toList());
