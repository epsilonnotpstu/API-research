    54	/**
    55	 * This class represents the rest controller for internally needed tan operations.
    56	 */
    57	@Slf4j
    58	@RequiredArgsConstructor
    59	@RestController
    60	@RequestMapping("/version/v1")
    61	@Validated
    62	@Profile("internal")
    63	public class InternalTanController {
    64	
    65	  /**
    66	   * The route to the tan verification endpoint.
    67	   */
    68	  public static final String TAN_VERIFY_ROUTE = "/tan/verify";
    69	  /**
    70	   * The route to the teleTAN generation endpoint.
    71	   */
    72	  public static final String TELE_TAN_ROUTE = "/tan/teletan";
    73	
    74	  public static final String TELE_TAN_TYPE_HEADER = "X-CWA-TELETAN-TYPE";
    75	
    76	  @NonNull
    77	  private final TanService tanService;
    78	
    79	  @NonNull
    80	  private final JwtService jwtService;
    81	
    82	  /**
    83	   * This provided REST method verifies the transaction number (TAN).
    84	   *
    85	   * @param tan - the transaction number, which needs to be verified {@link Tan}
    86	   * @return HTTP 200, if the verification was successful. Otherwise HTTP 404.
    87	   */
    88	  @Operation(
    89	    summary = "Verify provided Tan",
    90	    description = "The provided Tan is verified to be formerly issued by the verification server"
    91	  )
    92	  @ApiResponses(value = {
    93	    @ApiResponse(
    94	      responseCode = "200",
    95	      description = "Tan is valid an formerly issued by the verification server",
    96	      headers = {
    97	        @Header(name = TELE_TAN_TYPE_HEADER, description = "Type of the TeleTan (TEST or EVENT)")
    98	      }),
    99	    @ApiResponse(responseCode = "404", description = "Tan could not be verified")})
   100	  @PostMapping(value = TAN_VERIFY_ROUTE,
   101	    consumes = MediaType.APPLICATION_JSON_VALUE
   102	  )
   103	  public ResponseEntity<?> verifyTan(@Valid @RequestBody Tan tan) {
   104	    return tanService.getEntityByTan(tan.getTan())
   105	      .filter(t -> t.canBeRedeemed(LocalDateTime.now()))
   106	      .map(t -> {
   107	        tanService.deleteTan(t);
   108	        log.info("The Tan is valid.");
   109	        return t;
   110	      })
   111	      .map(t -> {
   112	        ResponseEntity.BodyBuilder responseBuilder = ResponseEntity.ok();
   113	
   114	        if (t.getTeleTanType() != null) {
   115	          responseBuilder.header(TELE_TAN_TYPE_HEADER, t.getTeleTanType().toString());
   116	        }
   117	
   118	        return responseBuilder.build();
   119	      })
   120	      .get();
   121	  }
   122	
   123	  /**
   124	   * This method generates a valid teleTAN.
   125	   *
   126	   * @param authorization auth
   127	   * @return a created teletan
   128	   */
   129	  @Operation(
   130	    summary = "Request generation of a teleTAN",
   131	    description = "A teleTAN is a human readable TAN with 7 characters which is supposed to be issued via call line"
   132	  )
   133	  @ApiResponses(value = {
   134	    @ApiResponse(responseCode = "201", description = "TeleTan created")})
   135	  @PostMapping(value = TELE_TAN_ROUTE,
   136	    produces = MediaType.APPLICATION_JSON_VALUE
   137	  )
   138	  public ResponseEntity<TeleTan> createTeleTan(
   139	    @RequestHeader(JwtService.HEADER_NAME_AUTHORIZATION) @Valid AuthorizationToken authorization,
   140	    @RequestHeader(value = TELE_TAN_TYPE_HEADER, required = false) @Valid TeleTanType teleTanType) {
   141	
   142	    List<AuthorizationRole> requiredRoles = new ArrayList<>();
   143	
   144	    if (teleTanType == null) {
   145	      teleTanType = TeleTanType.TEST;
   146	      requiredRoles.add(AuthorizationRole.AUTH_C19_HOTLINE);
   147	    } else if (teleTanType == TeleTanType.EVENT) {
   148	      requiredRoles.add(AuthorizationRole.AUTH_C19_HOTLINE_EVENT);
   149	    }
   150	
   151	    if (jwtService.isAuthorized(authorization.getToken(), requiredRoles)) {
   152	      if (tanService.isTeleTanRateLimitNotExceeded()) {
   153	        String teleTan = tanService.generateVerificationTeleTan(teleTanType);
   154	        log.info("The teleTAN is generated.");
   155	        return ResponseEntity.status(HttpStatus.CREATED).body(new TeleTan(teleTan));
   156	      } else {
   157	        throw new VerificationServerException(HttpStatus.TOO_MANY_REQUESTS, "Rate Limit exceed. Try again later.");
   158	      }
   159	    }
   160	    throw new VerificationServerException(HttpStatus.UNAUTHORIZED, "JWT is invalid.");
   161	  }
   162	
   163	}

