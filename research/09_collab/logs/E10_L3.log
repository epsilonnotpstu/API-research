282:     private void partitionsAssignmentAndSeek() {
283: 
284:         List<Future> partitionsForHandlers = new ArrayList<>();
285:         // ask about partitions for all the requested topic subscriptions
286:         for (SinkTopicSubscription topicSubscription : this.topicSubscriptions) {
287:             Promise<List<PartitionInfo>> promise = Promise.promise();
288:             partitionsForHandlers.add(promise.future());
289:             this.consumer.partitionsFor(topicSubscription.getTopic(), promise);
290:         }
291: 
292:         CompositeFuture.join(partitionsForHandlers).onComplete(partitionsResult -> {
293: 
294:             if (partitionsResult.failed()) {
295:                 this.handlePartition(Future.failedFuture(partitionsResult.cause()));
296:                 return;
297:             }
298: 
299: 
300:             // fill a list with all available partitions as result of the partitionsFor for all topic subscriptions
