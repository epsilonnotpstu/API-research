36: 
37: @Slf4j
38: @Provider
39: public class DefaultExceptionMapper implements ExceptionMapper<Exception> {
40: 
41:   @Context UriInfo info;
42: 
43:   @Override
44:   public Response toResponse(Exception exception) {
45:     // Usage-context subscription misses are expected; do not log them at ERROR here.
46:     if (exception instanceof UsageContextSubscriptionNotFoundException e) {
47:       return e.getResponse();
48:     }
49: 
50:     // Proceed with the rest of unexpected exceptions
51:     log.error(
52:         "Request '{}' failed with error '{}'", info.getPath(), exception.getMessage(), exception);
53:     if (exception instanceof ServiceException e) {
54:       return Response.status(e.getStatus()).entity(e.error()).build();
55:     } else if (exception instanceof ClientErrorException clientErrorException) {
56:       return Response.status(clientErrorException.getResponse().getStatus()).build();
57:     } else if (exception instanceof WebApplicationException webApplicationException) {
58:       Response webResponse = webApplicationException.getResponse();
59:       if (webResponse != null) {
60:         return webResponse;
61:       }
62:     }
63: 
64:     var status = Status.INTERNAL_SERVER_ERROR;
65:     return Response.status(status)
66:         .entity(
67:             new Error()
68:                 .code(ErrorCode.UNHANDLED_EXCEPTION.getCode())
69:                 .status(String.valueOf(status.getStatusCode()))
70:                 .title(exception.getMessage()))
71:         .build();
72:   }
73: }

