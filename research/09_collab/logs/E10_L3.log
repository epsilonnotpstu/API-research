27: @Order(Ordered.LOWEST_PRECEDENCE)
28: public class GlobalExceptionHandler {
29: 
30:     private final ApiErrorResponseCreator apiErrorResponseCreator;
31: 
32:     @ExceptionHandler(MethodArgumentNotValidException.class)
33:     @ResponseStatus(HttpStatus.BAD_REQUEST)
34:     public ApiErrorResponse handleMethodArgumentNotValidException(final MethodArgumentNotValidException exception) {
35:         ApiErrorResponse apiErrorResponse = apiErrorResponseCreator.buildResponse(
36:                 exception.getMessage(), HttpStatus.BAD_REQUEST);
37:         String fieldNames = exception.getBindingResult().getFieldErrors().stream()
38:                 .map(org.springframework.validation.FieldError::getField)
39:                 .distinct()
40:                 .collect(java.util.stream.Collectors.joining(","));
41:         log.warn("exception.validation: errorCount={}, fields={}, status=400",
42:                 exception.getBindingResult().getErrorCount(), fieldNames);
43:         return apiErrorResponse;
44:     }
45: 
46:     @ExceptionHandler(ResourceNotFoundException.class)
47:     @ResponseStatus(HttpStatus.NOT_FOUND)
48:     public ApiErrorResponse handleResourceNotFoundException(final ResourceNotFoundException exception) {
49:         ApiErrorResponse apiErrorResponse = apiErrorResponseCreator.buildResponse(exception, HttpStatus.NOT_FOUND);
50:         log.warn("exception.resource_not_found: exceptionClass={}, status=404",
51:                 exception.getClass().getSimpleName());
52:         return apiErrorResponse;
53:     }
54: 
55:     @ExceptionHandler(ConstraintViolationException.class)
56:     @ResponseStatus(HttpStatus.BAD_REQUEST)
57:     public ApiErrorResponse handleConstraintViolationException(final ConstraintViolationException exception) {
58:         ApiErrorResponse apiErrorResponse = apiErrorResponseCreator.buildResponse(exception, HttpStatus.BAD_REQUEST);
59:         String fieldNames = exception.getConstraintViolations().stream()
60:                 .map(v -> v.getPropertyPath().toString())
61:                 .distinct()
62:                 .collect(java.util.stream.Collectors.joining(","));
63:         log.warn("exception.constraint_violation: errorCount={}, fields={}, status=400",
64:                 exception.getConstraintViolations().size(), fieldNames);
65:         return apiErrorResponse;
66:     }
67: 
68:     @ExceptionHandler(NoResourceFoundException.class)
69:     @ResponseStatus(HttpStatus.NOT_FOUND)
70:     public ApiErrorResponse handleNoResourceFoundException(final NoResourceFoundException exception) {
71:         ApiErrorResponse apiErrorResponse = apiErrorResponseCreator.buildResponse(exception, HttpStatus.NOT_FOUND);
72:         log.warn("exception.resource_not_found: method={}, path={}", exception.getHttpMethod(), exception.getResourcePath());
73:         return apiErrorResponse;
74:     }
75: 
76:     @ExceptionHandler(JwtTokenHasNoUserEmailException.class)
77:     @ResponseStatus(HttpStatus.UNAUTHORIZED)
78:     public ApiErrorResponse handleJwtTokenHasNoUserEmailException(final JwtTokenHasNoUserEmailException exception) {
79:         ApiErrorResponse apiErrorResponse = apiErrorResponseCreator.buildResponse(exception, HttpStatus.UNAUTHORIZED);
80:         log.warn("exception.auth.invalid_token: message={}", exception.getMessage());
81:         return apiErrorResponse;
82:     }
83: 
