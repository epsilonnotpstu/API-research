318: 
319:                 this.handleAssign(assignResult);
320:                 if (assignResult.failed()) {
321:                     return;
322:                 }
323:                 log.debug("Assigned to topic partitions {}", topicPartitions);
324: 
325:                 for (SinkTopicSubscription topicSubscription : this.topicSubscriptions) {
326:                     TopicPartition topicPartition = new TopicPartition(topicSubscription.getTopic(), topicSubscription.getPartition());
327:                     // start reading from specified offset inside partition
328:                     if (topicSubscription.getOffset() != null) {
329: 
330:                         log.debug("Seeking to offset {}", topicSubscription.getOffset());
331:                         this.consumer.seek(topicPartition, topicSubscription.getOffset(), seekResult -> {
332: 
333:                             this.handleSeek(seekResult);
334:                             if (seekResult.failed()) {
335:                                 return;
336:                             }
337:                             partitionsAssigned(Collections.singleton(topicPartition));
338:                         });
339:                     } else {
340:                         partitionsAssigned(Collections.singleton(topicPartition));
341:                     }
342:                 }
343:             });
344:         });
345:     }
