+    for name,pattern in [('email',r'[\w.+-]+@[\w.-]+\.[A-Za-z]{2,}'),('attribution_trailer',r'(?im)^[+\- ]*(?:Signed-off-by|Co-authored-by|Author|Committer|Reviewed-by):'),('token',r'\b(?:gh[pousr]_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]+|AKIA[A-Z0-9]{16})\b')]:
