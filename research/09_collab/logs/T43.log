+            behaviour=[p for p in prod if p.endswith(('.java','.kt'))]
+            specific=bool(SPECIFIC.search(msg));correction=bool(re.search(r'\bfix\w*|\bcorrect\w*|\bwrong|\binvalid|\berror|\bbug',msg,re.I))
