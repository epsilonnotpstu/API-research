34:     @Override
35:     public CompletableFuture initiatePayment(PaymentInitiation body,
36:                                              String serviceSessionPassword,
37:                                              String fintechUserID,
38:                                              String fintechRedirectURLOK,
39:                                              String fintechRedirectURLNOK,
40:                                              UUID xRequestID,
41:                                              String paymentProduct,
42:                                              String xTimestampUTC,
43:                                              String xOperationType,
46:                                              String bankID
47:     ) {
48:         return payments.execute(
49:                 InitiateSinglePaymentRequest.builder()
50:                         .facadeServiceable(FacadeServiceableRequest.builder()
51:                                                    // Get rid of CGILIB here by copying:
52:                                                    .uaContext(userAgentContext.toBuilder().build())
53:                                                    .authorization(fintechID)
54:                                                    .sessionPassword(serviceSessionPassword)
55:                                                    .fintechUserId(fintechUserID)
56:                                                    .fintechRedirectUrlOk(fintechRedirectURLOK)
57:                                                    .fintechRedirectUrlNok(fintechRedirectURLNOK)
59:                                                    .bankId(bankID)
60:                                                    .build()
61:                         )
62:                         .singlePayment(pisSinglePaymentMapper.map(body, PaymentProductDetails.fromValue(paymentProduct)))
63:                         .build()
64:         ).thenApply((FacadeResult<SinglePaymentBody> result) -> mapper.translate(result, paymentResponseMapper));
65:     }
