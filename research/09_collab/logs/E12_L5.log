106: func (t *taskDAO) ListScanTasksByReportUUID(ctx context.Context, uuid string) ([]*Task, error) {
107: 	ormer, err := orm.FromContext(ctx)
108: 	if err != nil {
109: 		return nil, err
110: 	}
111: 
112: 	if !isValidUUID(uuid) {
113: 		return nil, errors.BadRequestError(fmt.Errorf("invalid UUID %v", uuid))
114: 	}
115: 
116: 	var tasks []*Task
117: 	param := fmt.Sprintf(`{"report_uuids":["%s"]}`, uuid)
118: 	sql := `SELECT * FROM task WHERE extra_attrs::jsonb @> cast( ? as jsonb )`
119: 	_, err = ormer.Raw(sql, param).QueryRows(&tasks)
120: 	if err != nil {
121: 		return nil, err
122: 	}
123: 	return tasks, nil
124: }
