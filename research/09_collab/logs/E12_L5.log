86:                         )
87:                         .paymentProduct(PaymentProductDetails.fromValue(paymentProduct))
88:                         .build()
89:         ).thenApply((FacadeResult<PaymentStatusBody> result) -> mapper.translate(result, paymentStatusResponseMapper));
90:     }
