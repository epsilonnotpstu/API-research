 for p in sorted(Path(item).rglob(base)):
  if not p.is_file(): continue
  lines=p.read_text(errors='replace').splitlines(); inds=set()
  for i,l in enumerate(lines):
   if re.search(pat,l): inds.update(range(max(0,i-before),min(len(lines),i+after+1)))
  if not inds: continue
  print('\\n'+str(p))
  for i in sorted(inds):
