54:                                 .sessionPassword(serviceSessionPassword)
55:                                 .fintechUserId(fintechUserID)
56:                                 .authorization(fintechID)
57:                                 .serviceSessionId(serviceSessionID)
58:                                 .build()
59:                         )
60:                         .paymentProduct(PaymentProductDetails.fromValue(paymentProduct))
61:                         .build()
62:         ).thenApply((FacadeResult<PaymentInfoBody> result) -> mapper.translate(result, paymentInfoResponseMapper));
63:     }
