46: // SendError tries to parse the HTTP status code from the specified error, envelops it into
47: // an error array as the error payload and returns the code and payload to the response.
48: // And the error is logged as well
49: func SendError(w http.ResponseWriter, err error) {
50: 	w.Header().Set("Content-Type", "application/json; charset=utf-8")
51: 	statusCode, errPayload, stackTrace := apiError(err)
52: 	// the error detail is logged only, and will not be sent to the client to avoid leaking server information
53: 	if statusCode >= http.StatusInternalServerError {
54: 		log.Errorf("%s %s", errPayload, stackTrace)
55: 		err = errors.New(nil).WithCode(errors.GeneralCode).WithMessage("internal server error")
56: 		errPayload = errors.NewErrs(err).Error()
57: 	} else {
58: 		// only log the error whose status code < 500 when debugging to avoid log flooding
59: 		log.Debug(errPayload)
60: 	}
61: 	w.WriteHeader(statusCode)
62: 	fmt.Fprintln(w, errPayload)
63: }
64: 
65: // generates the HTTP status code based on the specified error,
66: // envelops the error into an error array as the payload and return them
67: func apiError(err error) (statusCode int, errPayload, stackTrace string) {
68: 	code := 0
69: 	var openAPIErr openapi.Error
70: 	if errors.As(err, &openAPIErr) {
71: 		// Before executing operation handler, go-swagger will bind a parameters object to a request and validate the request,
72: 		// it will return directly when bind and validate failed.
73: 		// The response format of the default ServeError implementation does not match the internal error response format.
74: 		// So we needed to convert the format to the internal error response format.
75: 		code = int(openAPIErr.Code())
76: 		errCode := strings.Replace(strings.ToUpper(http.StatusText(code)), " ", "_", -1)
77: 		err = errors.New(nil).WithCode(errCode).WithMessage(openAPIErr.Error())
78: 	} else if legacyErr, ok := err.(*commonhttp.Error); ok {
79: 		// make sure the legacy error format is align with the new one
80: 		code = legacyErr.Code
81: 		errCode := strings.Replace(strings.ToUpper(http.StatusText(code)), " ", "_", -1)

