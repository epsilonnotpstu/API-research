53: 	@Override
54: 	public OperationCompletionRS deleteUser(Long userId, ReportPortalUser loggedInUser) {
55: 		User user = userRepository.findById(userId).orElseThrow(() -> new ReportPortalException(ErrorType.USER_NOT_FOUND, userId));
56: 		BusinessRule.expect(Objects.equals(userId, loggedInUser.getUserId()), Predicates.equalTo(false))
57: 				.verify(ErrorType.INCORRECT_REQUEST, "You cannot delete own account");
58: 		user.getProjects()
59: 				.forEach(userProject -> ProjectUtils.excludeProjectRecipients(Lists.newArrayList(user), userProject.getProject()));
60: 		userRepository.delete(user);
61: 		return new OperationCompletionRS("User with ID = '" + userId + "' successfully deleted.");
62: 	}
63: 
64: 	@Override
65: 	public DeleteBulkRS deleteUsers(DeleteBulkRQ deleteBulkRQ, ReportPortalUser currentUser) {
66: 		List<ReportPortalException> exceptions = Lists.newArrayList();
67: 		List<Long> deleted = Lists.newArrayList();
68: 		deleteBulkRQ.getIds().forEach(userId -> {
69: 			try {
70: 				deleteUser(userId, currentUser);
71: 				deleted.add(userId);
72: 			} catch (ReportPortalException rp) {
73: 				exceptions.add(rp);
74: 			}
75: 		});
76: 		return new DeleteBulkRS(deleted, Collections.emptyList(), exceptions.stream().map(ex -> {
77: 			ErrorRS errorResponse = new ErrorRS();
78: 			errorResponse.setErrorType(ex.getErrorType());
79: 			errorResponse.setMessage(ex.getMessage());
80: 			return errorResponse;
81: 		}).collect(Collectors.toList()));

