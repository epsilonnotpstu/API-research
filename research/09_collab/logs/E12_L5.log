26: /**
27:  * This strategy handles the {@link org.eclipse.ditto.connectivity.model.signals.commands.query.RetrieveConnection} command.
28:  */
29: final class RetrieveConnectionStrategy extends AbstractConnectivityCommandStrategy<RetrieveConnection> {
30: 
31:     RetrieveConnectionStrategy() {
32:         super(RetrieveConnection.class);
33:     }
34: 
35:     @Override
36:     protected Result<ConnectivityEvent<?>> doApply(final Context<ConnectionState> context,
37:             @Nullable final Connection entity,
38:             final long nextRevision,
39:             final RetrieveConnection command,
40:             @Nullable final Metadata metadata) {
41: 
42:         if (entity != null) {
43:             return ResultFactory.newQueryResult(command,
44:                     RetrieveConnectionResponse.of(entity.toJson(), command.getDittoHeaders()));
45:         } else {
46:             return ResultFactory.newErrorResult(notAccessible(context, command), command);
47:         }
48:     }
49: }

