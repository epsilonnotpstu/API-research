90: 		tx = tx.Limit(int(*params.Limit))
91: 	}
92: 	if params.Preload != nil && *params.Preload {
93: 		tx = entity.PreloadSegmentsVariants(tx)
94: 	}
95: 	if params.DescriptionLike != nil {
96: 		tx = tx.Where(
97: 			"lower(description) like ?",
98: 			fmt.Sprintf("%%%s%%", strings.ToLower(*params.DescriptionLike)),
99: 		)
100: 	}
101: 
102: 	err := tx.Order("id").Where(q).Find(&fs).Error
103: 	if err != nil {
104: 		return flag.NewFindFlagsDefault(500).WithPayload(
105: 			ErrorMessage("cannot query all flags. %s", err))
106: 	}
107: 	resp := flag.NewFindFlagsOK()
