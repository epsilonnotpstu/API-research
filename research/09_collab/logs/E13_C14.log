840: 	}
841: 
842: 	task, ok := r.tasks[id]
843: 	if !ok {
844: 		return fmt.Errorf("unknown process ID (%s)", id)
845: 	}
846: 
847: 	t.process.Order = task.process.Order
848: 
849: 	if id != t.id {
850: 		_, ok := r.tasks[t.id]
851: 		if ok {
852: 			return fmt.Errorf("the process ID '%s' already exists", t.id)
853: 		}
854: 	}
855: 
856: 	if err := r.stopProcess(id); err != nil {
857: 		return err
858: 	}
859: 
860: 	if err := r.deleteProcess(id); err != nil {
861: 		return err
862: 	}
863: 
864: 	r.tasks[t.id] = t
865: 
866: 	// set filesystem cleanup rules
867: 	r.setCleanup(t.id, t.config)
