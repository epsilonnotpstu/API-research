58: // swagger:route GET /expand read getExpand
59: //
60: // Expand a Relation Tuple
61: //
62: // Use this endpoint to expand a relation tuple.
63: //
64: //     Consumes:
65: //     -  application/x-www-form-urlencoded
66: //
67: //     Produces:
68: //     - application/json
69: //
70: //     Schemes: http, https
71: //
72: //     Responses:
73: //       200: expandTree
74: //       400: genericError
75: //       404: genericError
76: //       500: genericError
77: func (h *handler) getExpand(w http.ResponseWriter, r *http.Request, _ httprouter.Params) {
78: 	maxDepth, err := x.GetMaxDepthFromQuery(r.URL.Query())
79: 	if err != nil {
80: 		h.d.Writer().WriteError(w, r, herodot.ErrBadRequest.WithError(err.Error()))
81: 		return
82: 	}
83: 
84: 	res, err := h.d.ExpandEngine().BuildTree(r.Context(), (&relationtuple.SubjectSet{}).FromURLQuery(r.URL.Query()), maxDepth)
85: 	if err != nil {
86: 		h.d.Writer().WriteError(w, r, err)
87: 		return
88: 	}
89: 
90: 	h.d.Writer().Write(w, r, res)
91: }
92: 
93: func (h *handler) Expand(ctx context.Context, req *acl.ExpandRequest) (*acl.ExpandResponse, error) {
94: 	sub, err := relationtuple.SubjectFromProto(req.Subject)
95: 	if err != nil {
96: 		return nil, err
97: 	}
98: 	tree, err := h.d.ExpandEngine().BuildTree(ctx, sub, int(req.MaxDepth))
99: 	if err != nil {
100: 		return nil, err
101: 	}
102: 
103: 	return &acl.ExpandResponse{Tree: tree.ToProto()}, nil
104: }

