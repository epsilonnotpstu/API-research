799: func (r *restream) resolveAddress(tasks map[string]*task, id, address string) (string, error) {
800: 	re := regexp.MustCompile(`^#(.+):output=(.+)`)
801: 
802: 	if len(address) == 0 {
803: 		return address, fmt.Errorf("empty address")
804: 	}
805: 
806: 	if address[0] != '#' {
807: 		return address, nil
808: 	}
809: 
810: 	matches := re.FindStringSubmatch(address)
811: 	if matches == nil {
812: 		return address, fmt.Errorf("invalid format (%s)", address)
813: 	}
814: 
815: 	if matches[1] == id {
816: 		return address, fmt.Errorf("self-reference not possible (%s)", address)
817: 	}
818: 
819: 	task, ok := tasks[matches[1]]
820: 	if !ok {
821: 		return address, fmt.Errorf("unknown process '%s' (%s)", matches[1], address)
822: 	}
823: 
824: 	for _, x := range task.config.Output {
825: 		if x.ID == matches[2] {
826: 			return x.Address, nil
827: 		}
828: 	}
829: 
830: 	return address, fmt.Errorf("the process '%s' has no outputs with the ID '%s' (%s)", matches[1], matches[2], address)
831: }
