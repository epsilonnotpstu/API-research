diff --git a/research/08_experiments/E2_labelling/e13_blind/codes_work_C14/read.py b/research/08_experiments/E2_labelling/e13_blind/codes_work_C14/read.py
new file mode 100644
index 0000000000000000000000000000000000000000..26eeeddd96096604141636f3897fa269dccc4c42
--- /dev/null
+++ b/research/08_experiments/E2_labelling/e13_blind/codes_work_C14/read.py
@@ -0,0 +1,41 @@
+import argparse
+import pathlib
+import re
+
+p = argparse.ArgumentParser()
+p.add_argument('paths', nargs='+')
+p.add_argument('--pattern', default=None)
+p.add_argument('--context', type=int, default=5)
+p.add_argument('--lines', default=None)
+a = p.parse_args()
+for path in a.paths:
+    root = pathlib.Path(path)
+    assert re.match(r'^Q[0-9]{2}/(impl|contract)(/|$)', path), path
+    files = [root] if root.is_file() else sorted(f for f in root.rglob('*') if f.is_file())
+    for f in files:
+        lines = f.read_text().splitlines()
+        keep = set()
+        if a.lines:
+            for span in a.lines.split(','):
+                bounds = [int(n) for n in span.split('-')]
+                keep.update(range(bounds[0]-1, bounds[-1]))
+        elif a.pattern:
+            for i, line in enumerate(lines):
+                if re.search(a.pattern, line, re.I):
+                    keep.update(range(max(0, i-a.context), min(len(lines), i+a.context+1)))
+        else:
+            keep.update(range(len(lines)))
+        if not keep:
+            continue
+        print('\n' + str(f))
+        last = -2
+        for i in sorted(keep):
+            if i >= len(lines):
+                continue
+            if i != last+1:
+                print('...')
+            line = lines[i]
+            if re.search(r'@author\b|copyright|(?:FIXME|TODO):\s*[A-Z][a-z]+:|[\w.+-]+@[\w.-]+\.[a-z]{2,}|BEGIN .*PRIVATE KEY|authelia_(at|rt)_|[A-Za-z0-9_-]{45,}\.[A-Za-z0-9_.-]{20,}', line, re.I) or re.search(r'(password|secret|api[_-]?key|access[_-]?token)\s*[:=]\s*[\"\x27][^\"\x27]+[\"\x27]', line, re.I):
+                line = '[REDACTED attribution or credential-looking line]'
+            print(f'{i+1}: {line[:650]}')
+            last = i
diff --git a/research/08_experiments/E2_labelling/e13_blind/codes_work_C14/write_codes.py b/research/08_experiments/E2_labelling/e13_blind/codes_work_C14/write_codes.py
new file mode 100644
index 0000000000000000000000000000000000000000..bd052c5d3c03d391b536e49f6d435bb609488980
--- /dev/null
+++ b/research/08_experiments/E2_labelling/e13_blind/codes_work_C14/write_codes.py
@@ -0,0 +1,33 @@
+import csv
+import pathlib
+
+root = pathlib.Path('.')
+with open('items.csv', newline='') as f:
+    expected = [row['item_id'] for row in csv.DictReader(f)]
+with open('codes_work_C14/decisions.psv', newline='') as f:
+    rows = list(csv.DictReader(f, delimiter='|'))
+assert [row['item_id'] for row in rows] == expected
+
+for row in rows:
+    assert row['divergence_kind'] in {'DELIBERATE', 'ACCIDENTAL', 'UNCLEAR'}
+    assert row['contract_specificity'] in {'SPECIFIC', 'GENERIC', 'UNCLEAR'}
+    assert row['confidence'] in {'1', '2', '3'}
+    assert len(row['rationale'].split()) <= 40, (row['item_id'], len(row['rationale'].split()))
+    for kind in ('impl', 'contract'):
+        key = kind + '_locators'
+        resolved = []
+        for locator in row[key].split(';'):
+            suffix, line = locator.rsplit('@', 1)
+            item_root = root / row['item_id'] / kind
+            matches = [p for p in item_root.rglob('*') if p.is_file() and str(p).endswith('/' + suffix)]
+            assert len(matches) == 1, (row['item_id'], kind, locator, matches)
+            path = matches[0]
+            assert 0 < int(line) <= len(path.read_text().splitlines()), (path, line)
+            resolved.append(str(path) + (':' if kind == 'impl' else '#') + line)
+        row[key] = ';'.join(resolved)
+
+with open('codes_C14.csv', 'w', newline='') as f:
+    writer = csv.DictWriter(f, fieldnames=list(rows[0]))
+    writer.writeheader()
+    writer.writerows(rows)
+print(f'Validated and wrote {len(rows)} rows in items.csv order.')

