33: func (e *Engine) BuildTree(ctx context.Context, subject relationtuple.Subject, restDepth int) (*Tree, error) {
34: 	// global max-depth takes precedence when it is the lesser or if the request max-depth is less than or equal to 0
35: 	if globalMaxDepth := e.d.Config().ReadAPIMaxDepth(); restDepth <= 0 || globalMaxDepth < restDepth {
36: 		restDepth = globalMaxDepth
37: 	}
38: 
39: 	if us, isUserSet := subject.(*relationtuple.SubjectSet); isUserSet {
40: 		ctx, wasAlreadyVisited := graph.CheckAndAddVisited(ctx, subject)
41: 		if wasAlreadyVisited {
42: 			return nil, nil
43: 		}
44: 
45: 		subTree := &Tree{
46: 			Type:    Union,
47: 			Subject: subject,
48: 		}
49: 
50: 		var (
51: 			rels     []*relationtuple.InternalRelationTuple
52: 			nextPage string
53: 		)
54: 		// do ... while nextPage != ""
55: 		for ok := true; ok; ok = nextPage != "" {
56: 			var err error
57: 			rels, nextPage, err = e.d.RelationTupleManager().GetRelationTuples(
58: 				ctx,
59: 				&relationtuple.RelationQuery{
60: 					Relation:  us.Relation,
61: 					Object:    us.Object,
62: 					Namespace: us.Namespace,
63: 				},
64: 				x.WithToken(nextPage),
65: 			)
66: 			if err != nil {
67: 				return nil, err
68: 			} else if len(rels) == 0 {
69: 				return nil, nil
70: 			}
71: 
72: 			if restDepth <= 1 {
73: 				subTree.Type = Leaf
74: 				return subTree, nil
75: 			}
76: 
77: 			children := make([]*Tree, len(rels))
78: 			for ri, r := range rels {
79: 				child, err := e.BuildTree(ctx, r.Subject, restDepth-1)
80: 				if err != nil {
81: 					return nil, err
82: 				}
83: 				if child == nil {
84: 					child = &Tree{
85: 						Type:    Leaf,
86: 						Subject: r.Subject,
87: 					}
88: 				}
89: 				children[ri] = child
90: 			}
91: 			subTree.Children = append(subTree.Children, children...)
92: 		}
93: 
94: 		return subTree, nil
95: 	}
96: 
97: 	// is SubjectID
98: 	return &Tree{
99: 		Type:    Leaf,
100: 		Subject: subject,
101: 	}, nil
102: }

