index 0000000000000000000000000000000000000000..26eeeddd96096604141636f3897fa269dccc4c42
--- /dev/null
+++ b/research/08_experiments/E2_labelling/e13_blind/codes_work_C14/read.py
@@ -0,0 +1,41 @@
+import argparse
+import pathlib
+import re
+
+p = argparse.ArgumentParser()
+p.add_argument('paths', nargs='+')
+p.add_argument('--pattern', default=None)
+p.add_argument('--context', type=int, default=5)
+p.add_argument('--lines', default=None)
+a = p.parse_args()
+for path in a.paths:
+    root = pathlib.Path(path)
+    assert re.match(r'^Q[0-9]{2}/(impl|contract)(/|$)', path), path
+    files = [root] if root.is_file() else sorted(f for f in root.rglob('*') if f.is_file())
+    for f in files:
+        lines = f.read_text().splitlines()
+        keep = set()
+        if a.lines:
+            for span in a.lines.split(','):
+                bounds = [int(n) for n in span.split('-')]
+                keep.update(range(bounds[0]-1, bounds[-1]))
+        elif a.pattern:
+            for i, line in enumerate(lines):
+                if re.search(a.pattern, line, re.I):
+                    keep.update(range(max(0, i-a.context), min(len(lines), i+a.context+1)))
+        else:
+            keep.update(range(len(lines)))
+        if not keep:
+            continue
+        print('\n' + str(f))
+        last = -2
+        for i in sorted(keep):
+            if i >= len(lines):
+                continue
+            if i != last+1:
+                print('...')
+            line = lines[i]
+            if re.search(r'@author\b|copyright|(?:FIXME|TODO):\s*[A-Z][a-z]+:|[\w.+-]+@[\w.-]+\.[a-z]{2,}|BEGIN .*PRIVATE KEY|authelia_(at|rt)_|[A-Za-z0-9_-]{45,}\.[A-Za-z0-9_.-]{20,}', line, re.I) or re.search(r'(password|secret|api[_-]?key|access[_-]?token)\s*[:=]\s*[\"\x27][^\"\x27]+[\"\x27]', line, re.I):
+                line = '[REDACTED attribution or credential-looking line]'
+            print(f'{i+1}: {line[:650]}')
+            last = i
diff --git a/research/08_experiments/E2_labelling/e13_blind/codes_work_C14/validate.py b/research/08_experiments/E2_labelling/e13_blind/codes_work_C14/validate.py
new file mode 100644
index 0000000000000000000000000000000000000000..aad8e4aa891dcb2210842c84f0f880a44214d735
--- /dev/null
+++ b/research/08_experiments/E2_labelling/e13_blind/codes_work_C14/validate.py
@@ -0,0 +1,50 @@
+import collections
+import csv
+import json
+import pathlib
+import re
+
+headers = ['item_id', 'divergence_kind', 'contract_specificity', 'confidence', 'impl_locators', 'contract_locators', 'rationale']
+with open('items.csv', newline='') as f:
+    expected = [r['item_id'] for r in csv.DictReader(f)]
+with open('codes_C14.csv', newline='') as f:
+    reader = csv.DictReader(f)
+    assert reader.fieldnames == headers
+    rows = list(reader)
+assert [r['item_id'] for r in rows] == expected
+assert len({r['item_id'] for r in rows}) == len(rows)
+locator_count = 0
+for row in rows:
+    assert row['divergence_kind'] in {'DELIBERATE', 'ACCIDENTAL', 'UNCLEAR'}
+    assert row['contract_specificity'] in {'SPECIFIC', 'GENERIC', 'UNCLEAR'}
+    assert row['confidence'] in {'1', '2', '3'}
+    assert len(row['rationale'].split()) <= 40
+    for kind, sep in [('impl', ':'), ('contract', '#')]:
+        for locator in row[kind + '_locators'].split(';'):
+            path, number = locator.rsplit(sep, 1)
+            assert path.startswith(row['item_id'] + '/' + kind + '/')
+            assert '..' not in pathlib.Path(path).parts
+            lines = pathlib.Path(path).read_text().splitlines()
+            assert 0 < int(number) <= len(lines)
+            locator_count += 1
+
