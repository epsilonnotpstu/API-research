+                self.assertFalse(out.exists())
+
+    def test_v2_ambiguous_anchor_refused_even_with_matching_digest(self):
+        for original_site in self.selected.values():
+            with self.subTest(site=original_site["site_id"]):
+                site = copy.deepcopy(original_site)
+                data = (self.source(site) / site["file"]).read_bytes() + b"\n" + site["before"].encode()
+                site["source_sha256"] = hashlib.sha256(data).hexdigest()
+                with self.assertRaisesRegex(MODULE.MutationError, "exactly once"):
+                    MODULE.edit_bytes(data, site)
+
+    def test_v2_missing_anchor_refused_even_with_matching_digest(self):
+        for original_site in self.selected.values():
+            with self.subTest(site=original_site["site_id"]):
+                site = copy.deepcopy(original_site)
+                data = (self.source(site) / site["file"]).read_bytes().replace(site["before"].encode(), b"// removed anchor", 1)
+                site["source_sha256"] = hashlib.sha256(data).hexdigest()
+                with self.assertRaisesRegex(MODULE.MutationError, "exactly once"):
+                    MODULE.edit_bytes(data, site)
+
+    def test_v2_existing_output_and_second_application_refused(self):
+        for site in self.selected.values():
+            with self.subTest(site=site["site_id"]):
+                out = self.root / site["site_id"]
+                self.mutate(self.source(site), out, site)
+                frozen = (out / "manifest.json").read_bytes()
+                with self.assertRaisesRegex(MODULE.MutationError, "must not exist"):
+                    self.mutate(self.source(site), out, site)
+                self.assertEqual((out / "manifest.json").read_bytes(), frozen)
+                second = self.root / (site["site_id"] + "-second")
+                with self.assertRaisesRegex(MODULE.MutationError, "digest"):
+                    self.mutate(out / "source", second, site)
+                self.assertFalse(second.exists())
+
+
 if __name__ == "__main__":
     unittest.main(verbosity=2)
diff --git a/research/09_collab/logs/T25_scratch/audit_selection.py b/research/09_collab/logs/T25_scratch/audit_selection.py
new file mode 100644
index 0000000000000000000000000000000000000000..d5a4816d9c55b71a48ea7648a988d67ce489f8c0
--- /dev/null
+++ b/research/09_collab/logs/T25_scratch/audit_selection.py
@@ -0,0 +1,148 @@
+"""Read saved E5 evidence only; never invoke a SUT or external program.
+
+Run from research/ with /usr/bin/python3 -I -B. Output stays in this directory.
+CSV exchange locators are physical 1-based JSONL lines; saved violations use
+0-based exchange indices. Match operation templates with our existing checker.
+"""
+import collections
+import csv
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).resolve().parents[3]
+OUT = Path(__file__).resolve().parent
+E5 = ROOT / "08_experiments/E5_codemut"
+sys.path.insert(0, str(ROOT / "08_experiments/tools"))
+import conformance
+
+
+def relative(path):
+    return str(path.relative_to(ROOT))
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def dump(name, value):
+    (OUT / name).write_text(json.dumps(value, indent=2, ensure_ascii=False) + "\n")
+
+
+def main():
+    inputs = {}
+    counts = []
+    witnesses = []
+    attributions = []
+    for pair in sorted((E5 / "work").glob("petstore-*_20*")):
+        if not pair.is_dir():
+            continue
+        analyses = sorted(pair.glob("*analysis-s*-default/analysis.json"))
+        assert len(analyses) == 6, pair
+        for analysis_path in analyses:
+            inputs[relative(analysis_path)] = digest(analysis_path)
+            analysis = json.loads(analysis_path.read_text())
+            assert analysis["status"] == "COMPLETE"
+            attribution_path = analysis_path.parent / "attribution.csv"
+            inputs[relative(attribution_path)] = digest(attribution_path)
+            with attribution_path.open() as stream:
+                attribution_rows = list(csv.DictReader(stream))
+            for index, row in enumerate(attribution_rows, 2):
+                if row["kind"] == "VALID_REJECTED":
+                    attributions.append(dict(row, file=relative(attribution_path), line=index))
+            for key in sorted(k for k in analysis if k.endswith("_run")):
+                role = key[:-4]
+                run = Path(analysis[key])
+                exchanges = run / "exchanges.jsonl"
+                original = run / "spec.original.json"
+                metadata = run / "run.json"
+                for path in (exchanges, original, metadata):
+                    inputs[relative(path)] = digest(path)
+                spec = conformance.Spec(json.loads(original.read_text()),
+                                        deploy_origin=analysis["deploy_origin"])
+                grouped = {}
+                with exchanges.open() as stream:
+                    for line_no, line in enumerate(stream, 1):
+                        exchange = json.loads(line)
+                        request = exchange["request"]
+                        method = request["method"].upper()
+                        template, params = spec.match(request["path"], method, request.get("origin"))
+                        op_key = (method, template or request["path"])
+                        item = grouped.setdefault(op_key, {
+                            "statuses": collections.Counter(), "lines": [],
+                            "valid_requests": 0, "invalid_requests": 0,
+                            "uncheckable_requests": 0, "guard_hits": 0})
+                        item["statuses"][int(exchange["response"]["status"])] += 1
+                        item["lines"].append(line_no)
+                        if template is not None:
+                            operation, parameters = spec.operation(template, method)
+                            problems = conformance.request_problems(spec, parameters, operation, exchange, params)
+                            item["uncheckable_requests"] += bool(problems.uncheckable)
+                            item["invalid_requests"] += bool(problems)
+                            valid = not problems and not problems.uncheckable
+                            item["valid_requests"] += valid
+                            if op_key == ("GET", "/user/login"):
+                                # The candidate makes this optional parameter mandatory.
+                                guard_hit = "username" not in request.get("query", {})
+                                item["guard_hits"] += guard_hit
+                                witnesses.append({"pair": pair.name, "seed": analysis["seed"],
+                                    "analysis": relative(analysis_path), "role": role,
+                                    "file": relative(exchanges), "line": line_no,
+                                    "request_valid": valid, "guard_hit": guard_hit,
+                                    "status": exchange["response"]["status"],
+                                    "query": request.get("query", {}),
+                                    "saved_response_kinds": sorted(v["kind"] for v in conformance.check(spec, exchange))})
+                violations = analysis_path.parent / f"{role}.violations.jsonl"
+                inputs[relative(violations)] = digest(violations)
+                vr = collections.Counter()
+                with violations.open() as stream:
+                    for line in stream:
+                        v = json.loads(line)
+                        if v["kind"] == "VALID_REJECTED":
+                            vr[(v["method"], v["template"])] += 1
+                for (method, template), item in sorted(grouped.items()):
+                    counts.append({"row_id": f"P{len(counts)+1:04}", "pair": pair.name,
+                        "seed": analysis["seed"], "kind": analysis.get("kind", "mutant"),
+                        "role": role, "method": method, "template": template,
+                        "total": sum(item["statuses"].values()),
+                        "statuses": dict(sorted(item["statuses"].items())),
+                        "valid_requests_current_checker": item["valid_requests"],
+                        "invalid_requests_current_checker": item["invalid_requests"],
+                        "uncheckable_requests_current_checker": item["uncheckable_requests"],
+                        "saved_VALID_REJECTED": vr[(method, template)],
+                        "candidate_guard_hits": item["guard_hits"],
+                        "exchanges": relative(exchanges), "lines": item["lines"],
+                        "attribution": relative(attribution_path)})
+    assert len(witnesses) == 48
+    assert all(w["request_valid"] and w["guard_hit"] and w["status"] == 200 for w in witnesses)
+    selected = [c for c in counts if (c["method"], c["template"]) == ("GET", "/user/login")]
+    assert len(selected) == 24
+    assert all(c["statuses"] == {200: 2} and c["saved_VALID_REJECTED"] == 0 for c in selected)
+    assert not any(r["method"] == "GET" and r["template"] == "/user/login" for r in attributions)
+    for path in (ROOT / "08_experiments/tools").glob("*.py"):
+        inputs[relative(path)] = digest(path)
+    dump("input_sha256.json", inputs)
+    dump("petstore_operation_counts.json", counts)
+    dump("petstore_login_witnesses.json", witnesses)
+    dump("petstore_saved_valid_rejected.json", attributions)
+    with (OUT / "petstore_operation_counts.csv").open("w", newline="") as stream:
+        fields = list(counts[0])
+        writer = csv.DictWriter(stream, fields)
+        writer.writeheader()
+        for row in counts:
+            writer.writerow({k: json.dumps(v, separators=(",", ":")) if isinstance(v, (dict, list)) else v
+                             for k, v in row.items()})
+    dump("selection_summary.json", {
+        "analysis_files": 12, "saved_runs": 24, "operation_rows": len(counts),
+        "login_requests": len(witnesses), "login_control_requests": sum(w["role"] != "mutant" for w in witnesses),
+        "login_mutant_requests": sum(w["role"] == "mutant" for w in witnesses),
+        "login_400_or_422": 0, "login_saved_VALID_REJECTED": 0,
+        "login_valid_requests_current_checker": len(witnesses),
+        "login_optional_username_absent": len(witnesses),
+        "limitation": "Two login exchanges per run; repeated empty-query shape, not 48 independent input shapes."})
+    print(json.dumps(json.loads((OUT / "selection_summary.json").read_text())))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/research/09_collab/logs/T25_scratch/verify_delivery.py b/research/09_collab/logs/T25_scratch/verify_delivery.py
new file mode 100644
index 0000000000000000000000000000000000000000..3309c7cfa47464648c5dba7ab894721abf50be10
--- /dev/null
+++ b/research/09_collab/logs/T25_scratch/verify_delivery.py
@@ -0,0 +1,136 @@
+"""Retain reviewed source copies and oracle models; no Java/build/network calls."""
+import ast
+import copy
+import hashlib
+import itertools
+import json
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).resolve().parents[3]
+OUT = Path(__file__).resolve().parent
+E5 = ROOT / "08_experiments/E5_codemut"
+sys.path.insert(0, str(E5))
+sys.path.insert(0, str(ROOT / "08_experiments/tools"))
+import codemut
+import conformance
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def save(name, value):
+    (OUT / name).write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n")
+
+
+def main():
+    catalogue = json.loads((E5 / "sites.json").read_text())
+    old = json.loads((OUT / "sites_before.json").read_text())
+    assert catalogue["sites"][:-2] == old["sites"]
+    assert {k: v for k, v in catalogue.items() if k != "sites"} == {k: v for k, v in old.items() if k != "sites"}
+    assert len(catalogue["sites"]) == 22
+    # Preserve every original test body. Only fixture storage location changes.
+    old_tests = ast.parse((OUT / "test_codemut_before.py").read_text())
+    new_tests = ast.parse((E5 / "test_codemut.py").read_text())
+    def test_methods(tree):
+        return {n.name: ast.dump(n) for n in ast.walk(tree)
+                if isinstance(n, ast.FunctionDef) and n.name.startswith("test_")}
+    previous = test_methods(old_tests)
+    current = test_methods(new_tests)
+    assert all(current[k] == v for k, v in previous.items())
+    proof = {}
+    for site in catalogue["sites"][-2:]:
+        source = codemut.EMB / catalogue["roots"][site["sut"]]
+        dest = OUT / "source_proofs" / site["site_id"]
+        if not dest.exists():
+            manifest = codemut.mutate(source, dest, site["sut"], site["operator"],
+                                      catalogue["sites"], site_id=site["site_id"])
+        else:
+            manifest = json.loads((dest / "manifest.json").read_text())
+        original = (source / site["file"]).read_bytes()
+        assert original.count(site["before"].encode()) == 1
+        assert (dest / "source" / site["file"]).read_bytes() == original.replace(site["before"].encode(), site["after"].encode(), 1)
+        assert codemut.inventory(source) == manifest["source_files"]
+        actual = codemut.inventory(dest / "source")
+        assert codemut.canonical_hash(actual) == manifest["mutated_tree_sha256"]
+        assert [p for p in actual if actual[p] != manifest["source_files"][p]] == [site["file"]]
+        proof[site["site_id"]] = {
+            "manifest": str((dest / "manifest.json").relative_to(ROOT)),
+            "patch": str((dest / "patch.diff").relative_to(ROOT)),
+            "source_sha256": manifest["source_sha256"],
+            "mutated_file_sha256": manifest["mutated_file_sha256"],
+            "source_file_count": len(actual), "exact_before_matches": 1,
+            "java_compile": "not_run", "runtime": "not_run"}
+    # This counterfactual tests the Python oracle, not the Java mutation.
+    login_models = []
+    witnesses = json.loads((OUT / "petstore_login_witnesses.json").read_text())
+    for w in witnesses:
+        path = ROOT / w["file"]
+        with path.open() as stream:
+            exchange = json.loads(next(itertools.islice(stream, w["line"] - 1, None)))
+        assert exchange["request"]["method"] == "GET"
+        assert exchange["request"]["path"] == "/api/v3/user/login"
+        spec = conformance.Spec(json.loads((path.parent / "spec.original.json").read_text()),
+                                deploy_origin="http://sut-swagger-petstore:8080")
+        modeled = copy.deepcopy(exchange)
+        modeled["response"]["status"] = 400
+        signals = conformance.check(spec, modeled)
+        vr = [s for s in signals if s["kind"] == "VALID_REJECTED"]
+        assert len(vr) == 1
+        login_models.append({"file": w["file"], "line": w["line"],
+                             "modeled_fingerprint": vr[0]["fingerprint"]})
+    market_analysis = E5 / "work/market-wrong-status_20261114T114420Z/analysis-s1-default/analysis.json"
+    market_run = Path(json.loads(market_analysis.read_text())["control_run"])
+    spec = conformance.Spec(json.loads((market_run / "spec.original.json").read_text()),
+                            deploy_origin="http://sut-market:8080")
+    market_model = None
+    for line_no, line in enumerate((market_run / "exchanges.jsonl").open(), 1):
+        x = json.loads(line)
+        if x["request"]["method"] != "GET" or x["request"]["path"] != "/products" or x["response"]["status"] != 200:
+            continue
+        try:
+            body = json.loads(x["response"]["body"]["text"])
+        except (ValueError, KeyError):
+            continue
+        if not isinstance(body, list) or not body or not all(isinstance(v, dict) and v.get("price") is not None for v in body):
+            continue
+        modeled = copy.deepcopy(x)
+        for product in body:
+            del product["price"]
+        modeled["response"]["body"]["text"] = json.dumps(body)
+        baseline = conformance.check(spec, x)
+        signals = conformance.check(spec, modeled)
+        missing_price = [s for s in signals if s["kind"] == "RESPONSE_SCHEMA" and s.get("property") == "price" and s.get("keyword") == "required"]
+        assert len(missing_price) == len(body)
+        market_model = {"file": str((market_run / "exchanges.jsonl").relative_to(ROOT)),
+            "line": line_no, "products": len(body), "modeled_missing_price_diagnostics": len(missing_price),
+            "baseline_kinds": sorted({s["kind"] for s in baseline}),
+            "modeled_required_price_pointers": sorted({s["pointer"] for s in missing_price}),
+            "modeled_fingerprint_examples": [s["fingerprint"] for s in missing_price[:2]],
+            "note": "Python counterfactual deletion only; no Java/Jackson serialization was executed."}
+        break
+    assert market_model is not None
+    save("oracle_models.json", {"login_counterfactual_400": login_models, "market_counterfactual_price_removal": market_model})
+    before = json.loads((OUT / "before_sha256.json").read_text())
+    editable = {str((E5 / p).relative_to(ROOT)) for p in ("sites.json", "test_codemut.py", "README.md", "OPERATORS.md")}
+    protected = {p: h for p, h in before.items() if p not in editable}
+    drift = [p for p, h in protected.items() if sha(ROOT / p) != h]
+    assert not drift, drift
+    inputs = json.loads((OUT / "input_sha256.json").read_text())
+    assert all(sha(ROOT / p) == h for p, h in inputs.items())
+    tests = json.loads((OUT / "test_results.json").read_text())
+    assert tests["success"] and tests["tests"] == 124 and tests["skipped"] == 0
+    save("verification.json", {"catalogue_entries": 22, "old_entries_preserved": 20,
+        "original_test_methods_preserved": len(previous), "new_test_methods": len(current) - len(previous),
+        "codemut_py_unchanged": True, "protected_files_unchanged": len(protected),
+        "selection_input_hashes_unchanged": len(inputs), "tests": tests,
+        "source_proofs": proof, "oracle_model_only": True,
+        "market_model": market_model, "login_model_requests": len(login_models),
+        "external_code_execution": False})
+    print(json.dumps({"old_sites_preserved": 20, "test_methods_preserved": len(previous),
+        "protected_unchanged": len(protected), "input_hashes_unchanged": len(inputs), "tests": tests}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/research/09_collab/logs/T25_scratch/write_report.py b/research/09_collab/logs/T25_scratch/write_report.py
new file mode 100644
index 0000000000000000000000000000000000000000..a49a9b9611abc820dce7a8693cd222ad6cd7a2d9
--- /dev/null
+++ b/research/09_collab/logs/T25_scratch/write_report.py
@@ -0,0 +1,125 @@
+"""Render the Bengali T25 report from reviewed text and saved count rows."""
+import json
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[3]
+OUT = Path(__file__).resolve().parent
+rows = json.loads((OUT / "petstore_operation_counts.json").read_text())
+verification = json.loads((OUT / "verification.json").read_text())
+
+report = """# T25 রিপোর্ট — E5 replacement mutation sites
+
+## কাজ ও ফল
+
+`sites.json`-এ `market-response-field-v2` এবং `petstore-reject-valid-v2` append করা হয়েছে; দুটিই `pilot: true`। আগের ২০টি entry ও catalogue metadata অপরিবর্তিত, মোট entry ২২। `codemut.py` বদলানোর প্রয়োজন হয়নি। নতুন site দুটির exact source-copy application, hash/anchor পরীক্ষা ও refusal tests দেওয়া হয়েছে। প্রথমে existing ১১৭/১১৭, পরে মোট ১২৪/১২৪ tests PASS; failure/error/skip শূন্য। সব পুরোনো ২২টি codemut test method-এর AST অপরিবর্তিত; fixture-এর temporary directory শুধু T25 scratch-এ নেওয়া হয়েছে। প্রমাণ: `08_experiments/E5_codemut/sites.json:520,549`; `test_codemut.py:218–327` একই directory-তে; `09_collab/logs/T25_scratch/baseline_tests.txt` শেষ তিন লাইন; `tests.txt` শেষ চার লাইন; `verification.json`-এর `old_entries_preserved`, `original_test_methods_preserved`, `tests`।
+
+এটি write-only design ও Python verification। Java/Maven/Docker/network/build/SUT execution করা হয়নি; source copies সাধারণ data হিসেবে লেখা হয়েছে। `harness_v2/`, `tools/`, `_external/`, `E1_pilot/runs/`, `E5_codemut/work/`-এ write করা হয়নি; blind package/key খোলা হয়নি। শুরুতে snapshot করা ১৯৮টি protected file (এর মধ্যে `codemut.py`) ও selection audit-এর ১৩১টি input hash অপরিবর্তিত। এই hash count পুরো forbidden directory tree-র exhaustive snapshot দাবি করে না। প্রমাণ: `09_collab/tasks/T25.md`, Write scope; `09_collab/logs/T25_scratch/before_sha256.json`, `input_sha256.json`, `verification.json:1–20`; execution record `09_collab/logs/T25.log`।
+
+## Market নির্বাচন ও compile dependency evidence
+
+নতুন anchor: `08_experiments/_external/emb/jdk_11_maven/cs/rest-gui/market/market-rest/src/main/java/market/RestConfig.java:13`, `public class RestConfig {`। একই file-এর একটিমাত্র edit-এ `Jackson2ObjectMapperBuilderCustomizer` bean ও nested abstract mix-in যোগ হয়; mix-in-এর `getPrice()`-এ FQ `@JsonProperty(access = WRITE_ONLY)` থাকে। Builder শুধু `ProductDTO`-র জন্য mix-in register করে। Exact `before`/`after`, original hash এবং patch: `08_experiments/E5_codemut/sites.json`, `site_id=market-response-field-v2`; `09_collab/logs/T25_scratch/source_proofs/market-response-field-v2/patch.diff:1–25`।
+
+`market-rest`-এ Jackson compile dependency-র POM path নিচে; dependency-গুলিতে `optional=true` নেই। Explicit scope না থাকলে Maven-এর default compile scope ব্যবহৃত হয়েছে। Cached POM data-র byte-identical snapshot scratch-এ রাখা হয়েছে, কোনো Maven command চালানো হয়নি; original location ও SHA-256 আছে `09_collab/logs/T25_scratch/pom_evidence.json`-এর ছয়টি entry-তে।
+
+| Dependency edge / version | File evidence |
+|---|---|
+| market-rest → spring-boot-starter-web; parent imports Boot dependency management 2.4.3 | `08_experiments/_external/emb/jdk_11_maven/cs/rest-gui/market/market-rest/pom.xml:60–63`; `08_experiments/_external/emb/jdk_11_maven/cs/rest-gui/market/pom.xml:44–49` |
+| starter-web 2.4.3 → starter-json 2.4.3, explicit compile | `09_collab/logs/T25_scratch/poms/spring-boot-starter-web-2.4.3.pom:50–54` |
+| starter-json 2.4.3 → jackson-databind 2.11.4, explicit compile | `09_collab/logs/T25_scratch/poms/spring-boot-starter-json-2.4.3.pom:56–60` |
+| jackson-databind → jackson-annotations, default compile | `09_collab/logs/T25_scratch/poms/jackson-databind-2.11.4.pom:60–67` |
+| Boot BOM → Jackson BOM 2.11.4; annotations version 2.11.4 | `09_collab/logs/T25_scratch/poms/spring-boot-dependencies-2.4.3.pom:78,2610–2616`; `09_collab/logs/T25_scratch/poms/jackson-bom-2.11.4.pom:52,60,85–88` |
