+    for i, arg in enumerate(args):
+        if arg == '--data-generation-method':
+            return 'schemathesis:' + args[i + 1]
+        if arg.startswith('--data-generation-method='):
+            return 'schemathesis:' + arg.split('=', 1)[1]
+    return None
+
+
