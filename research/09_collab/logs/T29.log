+    files = ['fuzzer_compare.py', 'fuzzer_compare.csv', 'fuzzer_noise_cross_seed.py',
+             'fuzzer_noise_cross_seed.csv', 'FUZZER_COMPARE.md', 'noise_floor_spec.py']
+    hashes = {str(RESULTS / f): digest(RESULTS / f) for f in files}
