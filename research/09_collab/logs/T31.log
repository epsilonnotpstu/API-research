#!/usr/bin/env bash
set -euo pipefail
# Pure argv builders. The caller supplies validated run settings; no subprocesses.
build_schemathesis_argv() {
    schema_cmd=(run "/work/$(basename "$test_spec")" --base-url "http://mitmproxy:8080$BASE_PATH" \
        --checks "$SCHEMA_CHECKS" --hypothesis-seed "$seed" --hypothesis-max-examples "$MAX_EXAMPLES" \
        --junit-xml /work/schemathesis.junit.xml --cassette-path /work/schemathesis-cassette.yaml \
        --request-timeout "$REQUEST_TIMEOUT_MS" --hypothesis-phases "$PILOT_HYPOTHESIS_PHASES" --sanitize-output true)
    # An unset or empty DATA_GEN preserves the original argv exactly.
    if [[ -n ${DATA_GEN:-} ]]; then
        [[ $DATA_GEN =~ ^(positive|negative|all)$ ]] || { echo 'Invalid DATA_GEN' >&2; return 2; }
        schema_cmd+=(--data-generation-method "$DATA_GEN")
    fi
}

build_evomaster_argv() {
    schema_cmd=(--blackBox true --problemType REST --base http://mitmproxy:8080 \
        --schema /work/spec.test.json --seed "$seed" --stoppingCriterion TIME --maxTime "${budget}s" \
        --outputFolder /work/evomaster/tests --outputFormat JAVA_JUNIT_5 \
        --writeStatistics true --statisticsFile /work/evomaster/statistics.csv \
        --appendToStatisticsFile false --ratePerMinute 0 --schemaOracles "$PILOT_EVOMASTER_SCHEMA_ORACLES" \
        --tcpTimeoutMs "$REQUEST_TIMEOUT_MS" --createConfigPathIfMissing false)
}

record_fuzzer_argv() {
    local destination=$1 header_flag=$2
    printf '%s\n' "${schema_cmd[@]}" >"$destination"
    if [[ -n $AUTH_HEADER ]]; then
        printf '%s\n' "$header_flag" '<redacted>' >>"$destination"
        schema_cmd+=("$header_flag" "$AUTH_HEADER")
    fi
}
"""Write atomic, standard-library-only provenance for a pilot (called by run_pilot.sh)."""
import datetime
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() else None


def main():
    (run, emb, sut, source, mode, fault, severity, seed, budget, examples, image,
     project, started, phase, schema_rc, coverage_rc, cleanup_rc, harness_rc,
     health, base_path) = sys.argv[1:]
    run, emb = Path(run), Path(emb)
    commit = subprocess.check_output(['git', '-C', str(emb), 'rev-parse', 'HEAD'], text=True).strip()
    dirty = subprocess.check_output(['git', '-C', str(emb), 'status', '--porcelain'], text=True)
    images = {}
    for path in sorted(run.glob('*-image.json')):
        try:
            inspected = json.loads(path.read_text())[0]
            images[path.stem] = {'id': inspected['Id'], 'repo_digests': inspected.get('RepoDigests', []),
                                'repo_tags': inspected.get('RepoTags', [])}
        except (ValueError, IndexError, KeyError) as error:
            images[path.stem] = {'inspection_error': str(error)}
    files = {p.name: sha(p) for p in sorted(run.iterdir())
             if p.is_file() and p.name != 'run.json' and not p.name.endswith('.tmp')}
    fuzzer = os.environ.get('PILOT_FUZZER', 'schemathesis')
    data = {
        'fuzzer': fuzzer,
        'run_id': run.name, 'sut': sut, 'source_spec': source,
        'source_sha256': sha(next(run.glob('spec.original.*'), Path(source))),
        'mode': mode, 'fault': fault, 'severity': int(severity), 'seed': int(seed),
        'budget_seconds': int(budget), 'max_examples': int(examples),
        'schemathesis_image': image, 'compose_project': project,
        'started_at': started, 'updated_at': datetime.datetime.now(datetime.timezone.utc).isoformat(),
        'finished_at': None if harness_rc == 'pending' else datetime.datetime.now(datetime.timezone.utc).isoformat(),
        'phase': phase, 'schemathesis_exit': schema_rc, 'coverage_exit': coverage_rc,
        'cleanup_exit': cleanup_rc, 'harness_exit': harness_rc,
        'complete': harness_rc == '0', 'emb_commit': commit, 'emb_status_porcelain': dirty,
        'health_path': health, 'base_path': base_path, 'auth': os.environ.get('PILOT_AUTH_ROLE', 'none (pilot assumption)'),
        'request_timeout_ms': int(os.environ.get('PILOT_REQUEST_TIMEOUT_MS', '10000')),
        'hypothesis_phases': os.environ.get('PILOT_HYPOTHESIS_PHASES', 'explicit,generate'),
        'schema_checks': os.environ['SCHEMA_CHECKS'],
        'harness_version': 2,
        'sut_service': os.environ['SUT_SERVICE'],
        'sut_image': os.environ['SUT_IMAGE'],
        'internal_port': int(os.environ['INTERNAL_PORT']),
        'auth_source': os.environ['PILOT_AUTH_SOURCE'],
        'auth_source_sha256': (sha(emb / os.environ['PILOT_AUTH_SOURCE'])
                               if os.environ['PILOT_AUTH_SOURCE'] not in ('none', 'runtime-override') else None),
        'logger_max_body': int(os.environ['MITM_MAX_BODY']),
        'host_port': os.environ['HOST_PORT'], 'jacoco_port': os.environ['JACOCO_PORT'],
        'sut_jar_sha256': sha(Path(os.environ.get('PILOT_SUT_JAR_PATH', str(emb / 'dist' / f'{sut}-sut.jar')))),
        'code_mutation': ({'role': os.environ['PILOT_CODE_ROLE'],
                           'source_tree_sha256': os.environ['PILOT_CODE_SOURCE_SHA256'],
                           'manifest_sha256': sha(run / 'code.manifest.json')}
                          if os.environ.get('PILOT_CODE_ROLE') else None),
        'jacoco_agent_sha256': sha(emb / 'dist' / 'jacocoagent.jar'),
        'jacoco_cli_sha256': sha(emb / 'dist' / 'jacococli.jar'),
        'images': images, 'file_sha256': files,
        'tool_sha256': {p.name: sha(p) for p in sorted((emb.parent.parent / 'tools').glob('*.py'))},
        'harness_sha256': {str(p.relative_to(Path(__file__).parent)): sha(p)
                           for p in sorted(Path(__file__).parent.rglob('*'))
                           if p.is_file() and not any(part.startswith('.') for part in p.relative_to(Path(__file__).parent).parts)},
        'emb_config_sha256': {name: sha(emb / name) for name in
                              (os.environ['COMPOSE_FILE'], os.environ['DOCKERFILE'])},
        'limitations': ['fresh traffic is observational', 'fixed seed does not guarantee identical traffic',
                         'generator schema back edges are cut; conformance uses the original or mutated oracle',
                         'equal mutation operation sets do not imply equal generator and oracle constraints',
                         'transport-error and truncation coverage require review',
                         'locally built SUT may have only image ID, no registry digest'],
    }
    if fuzzer == 'evomaster':
        # Legacy image key identifies the selected generator for unchanged analysis.
        # Do not claim that Schemathesis ran in an EvoMaster collection.
        data['schemathesis_exit'] = 'not_started'
        data.update({
            'evomaster_image': os.environ['PILOT_EVOMASTER_IMAGE'],
            'evomaster_version': os.environ['PILOT_EVOMASTER_VERSION'],
            'evomaster_schema_oracles': os.environ.get('PILOT_EVOMASTER_SCHEMA_ORACLES', 'true') == 'true',
            'evomaster_exit': schema_rc,
            'evomaster_argv_file': 'evomaster-argv.txt',
            'evomaster_argv': ((run / 'evomaster-argv.txt').read_text().splitlines()
                               if (run / 'evomaster-argv.txt').is_file() else []),
            'evomaster_watchdog_seconds': int(budget) + 120,
        })
        data['file_sha256'].update({str(p.relative_to(run)): sha(p)
                                   for p in sorted((run / 'evomaster').rglob('*')) if p.is_file()})
        data['limitations'] = [line for line in data['limitations']
                               if not line.startswith(('generator schema back edges',
                                                       'equal mutation operation sets'))]
        data['limitations'].append('EvoMaster uses spec.test unchanged; schema path checked against base_path')
    tmp = run / 'run.json.tmp' 
    tmp.write_text(json.dumps(data, indent=2) + '\n')
    tmp.replace(run / 'run.json')


if __name__ == '__main__':
    main()
"""Offline argv, routing, redaction, completion, and provenance regression tests."""
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest
from unittest.mock import patch

HERE = Path(__file__).resolve().parent


def load(name):
    spec = importlib.util.spec_from_file_location('t27_' + name, HERE / (name + '.py'))
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


GUARD = load('evomaster_guard')
REDACTOR = load('redact_auth')
METADATA = load('run_metadata')


def settings(**updates):
    values = dict(os.environ)
    # Synthetic headers only; inherited real credentials never enter a subprocess.
    for key in ('AUTH_HEADER', 'PILOT_AUTH_REDACT', 'DATA_GEN', 'FUZZER', 'PILOT_FUZZER', 'ONLY_OPS',
                'EVOMASTER_SCHEMA_ORACLES', 'PILOT_EVOMASTER_SCHEMA_ORACLES'):
        values.pop(key, None)
    values.update({'BASE_PATH': '/api', 'SCHEMA_CHECKS': 'all', 'seed': '7', 'budget': '300',
                   'MAX_EXAMPLES': '100', 'REQUEST_TIMEOUT_MS': '10000',
                   'PILOT_HYPOTHESIS_PHASES': 'explicit,generate', 'AUTH_HEADER': '',
                   'test_spec': '/synthetic/spec.test.json', 'HERE': str(HERE), 'mode': 'baseline'})
    values.update(updates)
    return values


def selection_block():
    source = (HERE / 'run_pilot.sh').read_text()
    return source[source.index('export PILOT_FUZZER='):source.index('source "$HERE/fuzzer_args.sh"')]


def build(fuzzer, **updates):
    with tempfile.TemporaryDirectory(prefix='t27-argv-') as directory:
        dest = Path(directory) / 'argv.txt'
        script = selection_block() + '\nsource "$HERE/fuzzer_args.sh"\n'
        if fuzzer == 'schemathesis':
            script += 'build_schemathesis_argv\nschema_cmd[1]=/work/generator-input.json\n'
            flag = '-H'
        else:
            script += 'build_evomaster_argv\n'
            flag = '--header0'
        script += 'record_fuzzer_argv "$ARGV_DEST" ' + flag + '\nprintf "%s\\0" "${schema_cmd[@]}"'
        values = settings(**{'FUZZER': fuzzer, 'ARGV_DEST': str(dest), **updates})
        result = subprocess.run(['bash', '-euc', script], env=values,
                                capture_output=True, check=True)
        return result.stdout.decode().removesuffix('\0').split('\0'), dest.read_text().splitlines()


class ArgvTests(unittest.TestCase):
    def test_original_golden_argv_and_recording(self):
        # The fixture was captured from the unmodified run_pilot.sh argv statements.
        for item in json.loads((HERE / 'fuzzer-golden.json').read_text())['cases']:
            with self.subTest(item['name']):
                actual, recorded = build('schemathesis', **item['environment'])
                self.assertEqual(actual, item['argv'])
                self.assertEqual(recorded, item['recorded'])

    def test_unset_and_explicit_default_selection(self):
        source = (HERE / 'run_pilot.sh').read_text()
        block = source[source.index('export PILOT_FUZZER='):source.index('source "$HERE/fuzzer_args.sh"')]
        for value in (None, '', 'schemathesis', 'evomaster', 'other'):
            with self.subTest(value=value):
                values = settings()
                if value is not None:
                    values['FUZZER'] = value
                result = subprocess.run(['bash', '-euc', block + '\nprintf "%s" "$PILOT_FUZZER"'],
                                        env=values, capture_output=True)
                if value == 'other':
                    self.assertEqual(result.returncode, 2)
                    self.assertNotIn(value.encode(), result.stderr)
                else:
                    self.assertEqual(result.returncode, 0, result.stderr)
                    self.assertEqual(result.stdout.decode(), value or 'schemathesis')

    def test_evomaster_golden(self):
        actual, recorded = build('evomaster')
        expected = ['--blackBox', 'true', '--problemType', 'REST', '--base', 'http://mitmproxy:8080',
                    '--schema', '/work/spec.test.json', '--seed', '7', '--stoppingCriterion', 'TIME',
                    '--maxTime', '300s', '--outputFolder', '/work/evomaster/tests', '--outputFormat',
                    'JAVA_JUNIT_5', '--writeStatistics', 'true', '--statisticsFile',
                    '/work/evomaster/statistics.csv', '--appendToStatisticsFile', 'false',
                    '--ratePerMinute', '0', '--schemaOracles', 'true', '--tcpTimeoutMs', '10000',
                    '--createConfigPathIfMissing', 'false']
        self.assertEqual(actual, expected)
        self.assertEqual(recorded, expected)

    def test_auth_both_fuzzers_shell_metacharacters_are_literal(self):
        header = 'Authorization: Bearer synthetic $(do-not-execute) `literal` "quotes"'
        for fuzzer, flag in (('schemathesis', '-H'), ('evomaster', '--header0')):
            with self.subTest(fuzzer=fuzzer):
                argv, recorded = build(fuzzer, AUTH_HEADER=header)
                self.assertEqual(argv[-2:], [flag, header])
                self.assertEqual(recorded[-2:], [flag, '<redacted>'])
                self.assertNotIn(header, '\n'.join(recorded))
                self.assertNotIn('synthetic', '\n'.join(recorded))

    def test_schema_oracles_default_empty_true_false_argv_and_export(self):
        default, default_recorded = build('evomaster')
        for value in (None, '', 'true', 'false'):
            with self.subTest(value=value):
                updates = {} if value is None else {'EVOMASTER_SCHEMA_ORACLES': value}
                expected = default.copy()
                expected[expected.index('--schemaOracles') + 1] = value or 'true'
                argv, recorded = build('evomaster', **updates)
                self.assertEqual(argv, expected)
                self.assertEqual(recorded, expected)
                if value != 'false':
                    self.assertEqual(recorded, default_recorded)
                result = subprocess.run(
                    ['bash', '-euc', selection_block() +
                     '\n/usr/bin/python3 -I -B -c \'import os; print(os.environ["PILOT_EVOMASTER_SCHEMA_ORACLES"])\''],
                    env=settings(FUZZER='evomaster', **updates), capture_output=True)
                self.assertEqual(result.returncode, 0, result.stderr)
                self.assertEqual(result.stdout, ((value or 'true') + '\n').encode())

    def test_invalid_schema_oracles_exit_2_without_echoing_value(self):
        for value in ('synthetic-private-value', 'TRUE', 'False', '0', ' true', 'false\n'):
            with self.subTest(value=value):
                result = subprocess.run(['bash', '-euc', selection_block()],
                                        env=settings(FUZZER='evomaster', EVOMASTER_SCHEMA_ORACLES=value),
                                        capture_output=True)
                self.assertEqual(result.returncode, 2)
                self.assertIn(b'Invalid EVOMASTER_SCHEMA_ORACLES', result.stderr)
                self.assertNotIn(value.encode(), result.stdout + result.stderr)

    def test_schemathesis_rejects_nonempty_schema_oracles(self):
        for fuzzer in (None, '', 'schemathesis'):
            for value in ('true', 'false', 'synthetic-private-value'):
                with self.subTest(fuzzer=fuzzer, value=value):
                    updates = {} if fuzzer is None else {'FUZZER': fuzzer}
                    result = subprocess.run(['bash', '-euc', selection_block()],
                                            env=settings(EVOMASTER_SCHEMA_ORACLES=value, **updates),
                                            capture_output=True)
                    self.assertEqual(result.returncode, 2)
                    self.assertIn(b'EVOMASTER_SCHEMA_ORACLES requires FUZZER=evomaster', result.stderr)
                    self.assertNotIn(value.encode(), result.stdout + result.stderr)
        self.assertEqual(build('schemathesis', EVOMASTER_SCHEMA_ORACLES=''), build('schemathesis'))

    def test_seed_budget_timeout_are_forwarded(self):
        argv, _ = build('evomaster', seed='9223372036854775807', budget='123', REQUEST_TIMEOUT_MS='42')
        self.assertEqual(argv[argv.index('--seed') + 1], '9223372036854775807')
        self.assertEqual(argv[argv.index('--maxTime') + 1], '123s')
        self.assertEqual(argv[argv.index('--tcpTimeoutMs') + 1], '42')

    def test_default_invalid_data_gen_fails(self):
        with self.assertRaises(subprocess.CalledProcessError):
            build('schemathesis', DATA_GEN='invalid')

    def test_schemathesis_data_gen_variants(self):
        default, _ = build('schemathesis')
        for value in ('positive', 'negative', 'all'):
            self.assertEqual(build('schemathesis', DATA_GEN=value)[0], default + ['--data-generation-method', value])

    def test_preexisting_shell_fragments_are_byte_identical(self):
        # Pinned source fragments include default Docker argv, readiness, cleanup,
        # mutation candidate handling and both original de-recursion passes.
        source = (HERE / 'run_pilot.sh').read_text()
        fixture = json.loads((HERE / 'fuzzer-golden.json').read_text())
        for name, item in fixture['preserved_fragments'].items():
            with self.subTest(fragment=name):
                begin = source.index(item['start'])
                end = source.index(item['end'], begin)
                self.assertEqual(hashlib.sha256(source[begin:end].encode()).hexdigest(), item['sha256'])

    def test_pipeline_status_is_saved_before_if_completion(self):
        source = (HERE / 'run_pilot.sh').read_text()
        for log in ('evomaster.log', 'schemathesis.log'):
            tail = source.split('>"$run_dir/' + log + '"\n', 1)[1]
            self.assertEqual(tail.lstrip().splitlines()[0], 'pilot_pipeline_rc=("${PIPESTATUS[@]}")')


class GuardTests(unittest.TestCase):
