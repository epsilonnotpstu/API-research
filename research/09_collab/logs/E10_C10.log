110:     public ApiErrorResponse handleMethodArgumentTypeMismatchException(final MethodArgumentTypeMismatchException exception) {
111:         ApiErrorResponse apiErrorResponse = apiErrorResponseCreator.buildResponse(
112:                 "Invalid value for parameter '" + exception.getName() + "'", HttpStatus.BAD_REQUEST);
113:         log.warn("exception.type_mismatch: param={}, value={}, status=400",
114:                 exception.getName(), exception.getValue());
115:         return apiErrorResponse;
116:     }
117: 
118:     @ExceptionHandler(HttpMessageNotReadableException.class)
