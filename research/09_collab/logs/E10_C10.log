99:         ApiErrorResponse apiErrorResponse = apiErrorResponseCreator.buildResponse(
100:                 "Malformed multipart request",
101:                 HttpStatus.BAD_REQUEST
102:         );
103:         log.warn("exception.multipart.invalid_request: exceptionClass={}, status=400",
104:                 exception.getClass().getSimpleName());
105:         return apiErrorResponse;
106:     }
107: 
108:     @ExceptionHandler(MethodArgumentTypeMismatchException.class)
