236:     private static byte[] concatContentAndReferences(byte[] contentBytes, String serializedReferences)
237:             throws IOException {
238:         if (serializedReferences != null && !serializedReferences.isEmpty()) {
239:             var serializedReferencesBytes = ContentHandle.create(serializedReferences).bytes();
240:             var bytes = ByteBuffer.allocate(contentBytes.length + serializedReferencesBytes.length);
241:             bytes.put(contentBytes);
242:             bytes.put(serializedReferencesBytes);
243:             return bytes.array();
244:         } else {
245:             throw new IllegalArgumentException("serializedReferences is null or empty");
246:         }
