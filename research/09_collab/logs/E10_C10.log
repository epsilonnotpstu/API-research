90:         );
91:         log.warn("exception.multipart.max_size_exceeded: exceptionClass={}, status=413",
92:                 exception.getClass().getSimpleName());
93:         return apiErrorResponse;
94:     }
95: 
96:     @ExceptionHandler(MultipartException.class)
97:     @ResponseStatus(HttpStatus.BAD_REQUEST)
