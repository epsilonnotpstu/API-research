182: func parseListIdentitiesParameters(r *http.Request) (params ListIdentityParameters, err error) {
183: 	query := r.URL.Query()
184: 	var requestedFilters int
185: 
186: 	params.Expand = ExpandDefault
187: 
188: 	if ids := query["ids"]; len(ids) > 0 {
189: 		requestedFilters++
190: 		for _, v := range ids {
191: 			id, err := uuid.FromString(v)
192: 			if err != nil {
193: 				return params, errors.WithStack(herodot.ErrBadRequest.WithReasonf("Invalid UUID value `%s` for parameter `ids`.", v))
194: 			}
195: 			params.IdsFilter = append(params.IdsFilter, id)
196: 		}
197: 	}
198: 	if len(params.IdsFilter) > 500 {
199: 		return params, errors.WithStack(herodot.ErrBadRequest.WithReason("The number of ids to filter must not exceed 500."))
200: 	}
201: 
202: 	if orgID := query.Get("organization_id"); orgID != "" {
203: 		requestedFilters++
204: 		params.OrganizationID, err = uuid.FromString(orgID)
205: 		if err != nil {
206: 			return params, errors.WithStack(herodot.ErrBadRequest.WithReasonf("Invalid UUID value `%s` for parameter `organization_id`.", orgID))
207: 		}
208: 	}
209: 
210: 	if identifier := query.Get("credentials_identifier"); identifier != "" {
211: 		requestedFilters++
212: 		params.Expand = ExpandEverything
213: 		params.CredentialsIdentifier = identifier
214: 	}
215: 
216: 	if identifier := query.Get("credentials_identifier_similar"); identifier != "" {
217: 		requestedFilters++
218: 		params.Expand = ExpandEverything
219: 		params.CredentialsIdentifierSimilar = identifier
220: 	}
221: 
222: 	for _, v := range query["include_credential"] {
223: 		params.Expand = ExpandEverything
224: 		tc, ok := ParseCredentialsType(v)
225: 		if !ok {
226: 			return params, errors.WithStack(herodot.ErrBadRequest.WithReasonf("Invalid value `%s` for parameter `include_credential`.", v))
227: 		}
228: 		params.DeclassifyCredentials = append(params.DeclassifyCredentials, tc)
229: 	}
230: 
231: 	if requestedFilters > 1 {
232: 		return params, errors.WithStack(herodot.ErrBadRequest.WithReason("You cannot combine multiple filters in this API"))
233: 	}
