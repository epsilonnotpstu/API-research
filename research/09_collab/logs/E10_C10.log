290:         }
291: 
292:         CompositeFuture.join(partitionsForHandlers).onComplete(partitionsResult -> {
293: 
294:             if (partitionsResult.failed()) {
295:                 this.handlePartition(Future.failedFuture(partitionsResult.cause()));
296:                 return;
297:             }
298: 
299: 
300:             // fill a list with all available partitions as result of the partitionsFor for all topic subscriptions
301:             List<PartitionInfo> availablePartitions = new ArrayList<>();
302:             for (int i = 0; i < partitionsForHandlers.size(); i++) {
303:                 // check if, for each future, the partitionsFor operation is completed successfully or failed
304:                 if (partitionsResult.result() != null && partitionsResult.result().succeeded(i)) {
305:                     availablePartitions.addAll(partitionsResult.result().resultAt(i));
309:                     //  for not existing partitions
