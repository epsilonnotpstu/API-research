35:     @Override
36:     public ProducerRecord<byte[], byte[]> toKafkaRecord(String kafkaTopic, Integer partition, byte[] message) {
37: 
38:         Integer partitionFromBody = null;
39:         Long timestamp = null;
40:         byte[] key = null;
41:         byte[] value = null;
42:         Headers headers = new RecordHeaders();
43: 
44:         JsonNode json = JsonUtils.bytesToJson(message);
45: 
46:         if (!json.isEmpty()) {
47:             if (json.has("key")) {
48:                 key = Base64.getDecoder().decode(json.get("key").asText());
49:             }
50:             if (json.has("value")) {
51:                 value = Base64.getDecoder().decode(json.get("value").asText());
52:             }
53:             if (json.has("timestamp")) {
54:                 timestamp = json.get("timestamp").asLong();
55:             }
56:             if (json.has("headers")) {
57:                 ArrayNode jsonArray = (ArrayNode) json.get("headers");
58:                 for (JsonNode jsonObject: jsonArray) {
59:                     headers.add(new RecordHeader(jsonObject.get("key").asText(), Base64.getDecoder().decode(jsonObject.get("value").asText())));
60:                 }
61:             }
62:             if (json.has("partition")) {
63:                 partitionFromBody = json.get("partition").asInt();
64:             }
65:             if (partition != null && partitionFromBody != null) {
66:                 throw new IllegalStateException("Partition specified in body and in request path");
67:             }
68:             if (partition != null) {
69:                 partitionFromBody = partition;
70:             }
71:         }
72:         return new ProducerRecord<>(kafkaTopic, partitionFromBody, timestamp, key, value, headers);
73:     }
74: 
75:     @Override
76:     public List<ProducerRecord<byte[], byte[]>> toKafkaRecords(String kafkaTopic, Integer partition, byte[] messages) {
77: 
78:         List<ProducerRecord<byte[], byte[]>> records = new ArrayList<>();
79: 
80:         JsonNode json = JsonUtils.bytesToJson(messages);
81:         ArrayNode jsonArray = (ArrayNode) json.get("records");
82: 
83:         for (JsonNode jsonObj : jsonArray) {
84:             records.add(toKafkaRecord(kafkaTopic, partition, JsonUtils.jsonToBytes(jsonObj)));
85:         }

