import csv,re,json,collections
from pathlib import Path
csv.field_size_limit(100000000);p=Path('../_external/p001/specs/Spotify_Playlists__openapi.yaml');lines=p.read_text().splitlines()
starts=[(i,re.match(r'"'^    ([A-Za-z0-9_]+):$'"',l).group(1)) for i,l in enumerate(lines) if re.match(r'"'^    ([A-Za-z0-9_]+):$'"',l)]
blocks={name:lines[i:(starts[n+1][0] if n+1<len(starts) else len(lines))] for n,(i,name) in enumerate(starts)}
# Read only type and reference constraints in the actual schema blocks.
def node_info(block,indent):
 info={}; props={}; current=None
 for l in block:
  m=re.match(r'"'^'"'+(' '*indent)+r'(type|format|nullable): (.*)"'$'"',l)
  if m:info[m[1]]=m[2]
  m=re.match(r'"'^'"'+(' '*indent)+r'\\"'$ref: ["'"\\']?#/components/schemas/(["'^"'"\\']+)',l)
  if m:info['ref']=m[1]
  m=re.match(r'"'^'"'+(' '*(indent+2))+r'([A-Za-z0-9_]+):"'$'"',l)
  if m:current=m[1];props[current]=[]
  elif current:props[current].append(l)
 if props:info['props']={k:node_info(v,indent+4) for k,v in props.items()}
 return info
for name in ('TrackObject','EpisodeObject'):
 block=blocks[name];props={};cur=None
 for l in block:
  m=re.match(r'"'^        ([A-Za-z0-9_]+):$'"',l)
  if m:cur=m[1];props[cur]=[]
  elif cur:props[cur].append(l)
 print(name,{k:{m.group(1):m.group(2) for l in v if (m:=re.match(r'"'^          (type|format): (.*)$'"',l))} for k,v in props.items()})
 print('required/enum/closure',[(i+1,l) for i,l in enumerate(block) if re.match(r'"'^      required:|''^          enum:|''^      additionalProperties:'"',l)])
