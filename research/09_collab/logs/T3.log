  elif api=='yelp_Businesses':
   print(x['fault_id'],'QUERY',r['queryParameters'])
   if n==70:print(' ZERO_RATING',[(v.get('name'),v.get('rating'),v.get('review_count')) for v in d['businesses'] if v.get('rating')==0])
  elif api=='omdb':print(x['fault_id'],'totalResults',d['totalResults'])
