 for n in ids:
  x=b[n-1];r=raw[x['testCaseId']]
  try:d=json.loads(r['responseBody'])
  except json.JSONDecodeError:continue
  if api=='amadeus':
   ctr=collections.Counter(); sample={}
   for h in d.get('data',[]):
    c=h.get('hotel',{}).get('contact')
    if c is not None: ctr['contact_with_fax' if 'fax' in c else 'contact_without_fax']+=1
    for o in h.get('offers',[]):
     if 'roomQuantity' in o:
      v=o['roomQuantity'];ctr['roomQuantity_'+type(v).__name__]+=1;sample['roomQuantity']=v
   print(x['fault_id'],dict(ctr),sample)
   if n==6:
    msgs=r['failReason'].split(' --- '); groups={}
    for msg in msgs:
     m=re.search(r\"\\[Path '(["'^'"']+)'\\] (.*)\",msg)
     if m:
      p,tail=m.groups();groups.setdefault((p,tail.split('\"')[0]),tail)
    for (p,_),msg in groups.items():print(' ',p,msg[:180])
  elif api=='foursquare':print(x['fault_id'],'QUERY',re.sub(r'(client_id|client_secret|oauth_token)=["'^;]*'"',r'\\1=REDACTED',r['queryParameters']))
  elif api.startswith('spotify'):
