def walk(x,p=''):
 yield p,x
 if isinstance(x,dict):
  for k,v in x.items():yield from walk(v,p+'/'+k)
 elif isinstance(x,list):
  for v in x:yield from walk(v,p+'/[item]')
for b in blind[19:45]:
 r=raw[b['testCaseId']];print('\\n'+b['fault_id']+' '+b['testCaseId'])
 if b['http_status']"'!='"'200':
  print('QUERY',r['queryParameters']);print('PATH',r['pathParameters']);print('BODY',r['responseBody'][:850]);continue
 body=json.loads(r['responseBody']); fields=collections.defaultdict(list)
