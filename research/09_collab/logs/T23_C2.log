   101		private String resolveErrorMessage(FieldError fieldError) {
   102			Locale currentLocale = LocaleContextHolder.getLocale();
   103			String localizedErrorMessage = messageSource.getMessage(fieldError, currentLocale);
   104	
   105			if (localizedErrorMessage.equals(fieldError.getDefaultMessage())) {
   106				String[] fieldErrorCodes = fieldError.getCodes();
   107				if (fieldErrorCodes != null)
   108					localizedErrorMessage = fieldErrorCodes[0];
   109			}
   110			return localizedErrorMessage;
   111		}
