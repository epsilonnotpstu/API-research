    93		private RestErrorResponse resolveFieldErrors(RestErrorResponse response, List<FieldError> fieldErrors) {
    94			for (FieldError fieldError : fieldErrors) {
    95				String localizedErrorMessage = resolveErrorMessage(fieldError);
    96				response.addFieldError(fieldError.getField(), localizedErrorMessage);
    97			}
    98			return response;
    99		}
