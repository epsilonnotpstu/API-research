51:    }
52:
53:    public User findUserByName(final String username) {
54:        for (final User user : users) {
55:            if (user.getUsername().equals(username)) {
56:                return user;
57:            }
58:        }
59:        return null;
60:    }
61:
62:    public void addUser(final User user) {
63:        if (users.size() > 0) {
64:            for (int i = users.size() - 1; i >= 0; i--) {
65:                if (users.get(i).getUsername().equals(user.getUsername())) {
66:                    users.remove(i);
