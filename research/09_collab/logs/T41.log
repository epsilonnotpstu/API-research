+            head_state = "The corresponding API source remains; EMB uses added Tomcat bootstrap/dependencies while upstream uses Jetty. Exact container-policy behaviour at HEAD is unverified."
+            markers = []
+            direction = "unclear"
+        elif id in {"C003", "C006"}:
