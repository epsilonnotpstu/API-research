+        item = next(i for i in items if i["baseline"]["sut"] == sut)
+        run = re.search(r"(08_experiments/[^;]+/exchanges.jsonl):\d+", item["codex"]["evidence_locators"]).group(1)
+        original = m.ROOT / Path(run).parent / "spec.original.json"
