+        witness = re.search(r"(08_experiments/[^;]+/exchanges.jsonl:\d+)", item["codex"]["evidence_locators"]).group(1)
+        locs = [witness, "08_experiments/E2_labelling/" + sut + "_adjudication.csv:" + id] + code_locs
