+MAPPING = {"spec_changed_to_match_code": {"SPEC", "SPEC_PARTIAL"}, "code_changed_to_match_spec": {"IMPL"}, "both_changed": {"BOTH"}}
+UNCHECKABLE = {"P002", "P003", "P004", "P007", "P008", "P009", "P010", "P020", "P023", "P024", "P025", "P028", "P029", "P030", "P040", "P041"}
+TRANSPORT = {"P037", "P039"}
