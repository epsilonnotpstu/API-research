+    mapping = {"C002": "ExternalToken", "C003": "ExternalTan", "C004": "InternalTan", "C005": "InternalTan", "C006": "ExternalTestState"}
+    return [C + "controller/" + mapping.get(b["item_id"], "InternalTan") + "Controller.java"]
