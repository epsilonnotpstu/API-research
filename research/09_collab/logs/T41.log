+#!/usr/bin/env python3
+"""Collect safe static evidence and inspect the exact candidate witness subsets."""
+import collections
+import importlib.util
+import json
+from pathlib import Path
+import re
+
+HERE = Path(__file__).resolve().parent
+spec = importlib.util.spec_from_file_location("t41_miner", HERE / "mine_history.py")
+m = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(m)
+
+PET = "src/main/java/io/swagger/petstore/"
+CWA = "src/main/java/app/coronawarn/verification/"
+MARKET_REST = "market-rest/src/main/java/market/"
+MARKET_CORE = "market-core/src/main/java/market/"
+PATHS = {
+    "swagger-petstore": ["src/main/resources/openapi.yaml", "inflector.yaml", "pom.xml"] + [PET + p for p in ["controller/PetController.java", "controller/OrderController.java", "controller/UserController.java", "data/PetData.java", "data/OrderData.java", "data/UserData.java", "model/Pet.java", "model/Order.java", "model/User.java", "utils/Util.java"]],
+    "cwa-verification": ["api-docs.json", "pom.xml"] + [CWA + p for p in ["config/OpenApiConfig.java", "config/RequestSizeLimitFilter.java", "controller/ExternalTokenController.java", "controller/ExternalTanController.java", "controller/ExternalTestStateController.java", "controller/InternalTanController.java", "controller/VerificationExceptionHandler.java", "model/RegistrationTokenRequest.java", "model/RegistrationToken.java", "model/Tan.java", "model/AuthorizationToken.java", "validator/RegistrationTokenKeyConstraint.java", "validator/RegistrationTokenRequestValidator.java", "service/HashingService.java", "service/AppSessionService.java", "service/TanService.java"]],
+    "market": ["pom.xml", "market-rest/pom.xml", "market-core/pom.xml", MARKET_REST + "RestConfig.java", MARKET_REST + "rest/exception/RestExceptionHandler.java"] + [MARKET_REST + "rest/" + p + "RestController.java" for p in ["Cart", "Contacts", "Customer", "Orders"]] + [MARKET_CORE + "dto/" + p + "DTO.java" for p in ["Cart", "CartItem", "CreditCard", "Contacts", "User"]],
+}
+
+
+def full_inventory(anchors):
+    protected = json.loads((m.SCRATCH / "protected_hashes.json").read_text())
+    for sut, a in anchors.items():
+        source, repo = m.ROOT / a["emb_source"], m.ROOT / a["upstream_clone"]
+        upstream = m.tree(repo, a["commit"])
+        rows = []
+        for p in sorted(source.rglob("*")):
+            rel = p.relative_to(source).as_posix()
+            if any(t in {"target", ".git", "node_modules"} for t in p.relative_to(source).parts) or not p.is_file():
+                continue
+            assert not p.is_symlink()
+            data = p.read_bytes()  # Hash only; README/demo HTML are never decoded or quoted.
+            protected[str(p.relative_to(m.ROOT))] = m.sha(data)
+            upath = rel if rel in upstream else m.ALIASES.get(sut, {}).get(rel, rel)
+            rows.append({"path": rel, "upstream_path": upath, "emb_blob": m.blob(data), "upstream_blob": upstream.get(upath), "state": "exact" if upstream.get(upath) == m.blob(data) else "different" if upath in upstream else "emb_only", "selected_for_anchor": m.relevant(rel)})
+        m.dump(m.OUT / (sut + "_file_inventory.json"), rows)
+    m.dump(m.SCRATCH / "protected_hashes.json", protected)
+
+
+def collect_history(anchors):
+    index = []
+    for sut, a in anchors.items():
+        repo = m.ROOT / a["upstream_clone"]
+        # All ref descendants are also screened; the primary outcome is default HEAD.
+        desc = m.git(repo, "rev-list", "--reverse", "--all", "--ancestry-path=" + a["commit"], "^" + a["commit"]).decode().splitlines()
+        a["all_ref_post_anchor_descendants"] = desc
+        a["all_ref_commit_count"] = len(m.git(repo, "rev-list", "--all").splitlines())
+        a["head_commit_count"] = len(m.git(repo, "rev-list", "HEAD").splitlines())
+        a["ref_tip_metadata"] = m.git(repo, "log", "--all", "--simplify-by-decoration", "--format=%H %D").decode().splitlines()
+        rows = []
+        for commit in desc:
+            meta = m.git(repo, "show", "-s", "--format=%H%n%P%n%aI%n%cI%n%s", commit).decode().splitlines()
+            parent = meta[1].split()[0]
+            touched = m.git(repo, "diff", "--name-only", parent, commit).decode().splitlines()
+            filtered = [p for p in touched if m.relevant(p)]
+            patch_path = None
+            text_paths = [p for p in filtered if not p.endswith('.sql')]
+            if text_paths:
+                patch_path = m.OUT / "history_diffs" / sut / (commit + ".diff")
+                patch_path.parent.mkdir(parents=True, exist_ok=True)
+                patch_path.write_text(m.sanitize(m.git(repo, "diff", "--no-ext-diff", "--no-textconv", "--unified=3", parent, commit, "--", *text_paths).decode(errors="replace")))
+            rows.append({"commit": commit, "parent": parent, "author_date": meta[2], "committer_date": meta[3], "message": m.sanitize(meta[4][:160]), "in_default_head": commit in a["post_anchor_reachable_commits"], "files": touched, "selected_files": filtered, "patch": str(patch_path.relative_to(m.ROOT)) if patch_path else None})
+        m.dump(m.OUT / (sut + "_all_descendant_history.json"), rows)
+        # Save only reviewed source files, as inert text. Line numbers match Git blobs.
+        for revision in [a["commit"], a["head"]]:
+            tree = m.tree(repo, revision)
+            for path in PATHS[sut]:
+                if path not in tree:
+                    continue
+                data = m.git(repo, "show", revision + ":" + path)
+                dest = m.OUT / "source_evidence" / sut / revision / (path + ".txt")
+                dest.parent.mkdir(parents=True, exist_ok=True)
+                dest.write_text(m.sanitize(data.decode(errors="replace")))
+                index.append({"sut": sut, "commit": revision, "path": path, "blob": tree[path], "sha256_original": m.sha(data), "line_count": len(data.decode(errors="replace").splitlines()), "copy": str(dest.relative_to(m.ROOT))})
+    m.dump(m.OUT / "source_index.json", index)
+    m.dump(m.OUT / "anchors.json", anchors)
+
+
+def semantic_json_deltas(before, after, prefix=""):
+    if isinstance(before, dict) and isinstance(after, dict):
+        changes = []
+        for key in sorted(set(before) | set(after)):
+            ptr = prefix + "/" + key.replace("~", "~0").replace("/", "~1")
+            if key not in before:
+                changes.append({"pointer": ptr, "before_absent": True, "after": after[key]})
+            elif key not in after:
+                changes.append({"pointer": ptr, "before": before[key], "after_absent": True})
+            else:
+                changes.extend(semantic_json_deltas(before[key], after[key], ptr))
+        return changes
+    return [] if before == after else [{"pointer": prefix, "before": before, "after": after}]
+
+
+def candidates(anchors, items):
+    rows = []
+    for item_id in ["P014", "P015", "C002"]:
+        item = next(i for i in items if i["baseline"]["item_id"] == item_id)
+        b = item["baseline"]
+        path = re.search(r"(08_experiments/[^;]+/exchanges.jsonl):\d+", item["codex"]["evidence_locators"]).group(1)
+        counts = collections.Counter()
+        witnesses = []
+        for n, line in enumerate((m.ROOT / path).read_text().split("\n"), 1):
+            if not line:
+                continue
+            exchange = json.loads(line)
+            req, res = exchange["request"], exchange.get("response") or {}
+            reqpath = req.get("path", "").split("?", 1)[0]
+            target = b["template"]
+            if b["sut"] == "swagger-petstore":
+                target = "/api/v3" + target
+            if req.get("method") != b["method"] or reqpath != target or str(res.get("status")) != b["status"]:
+                continue
+            # Never serialize headers, cookie values, or raw request bodies.
+            record = {"locator": path + ":" + str(n), "status": res["status"]}
+            if item_id in {"P014", "P015"}:
+                key = "status" if item_id == "P014" else "tags"
+                query = req.get("query", [])
+                if isinstance(query, dict):
+                    names = list(query)
+                else:
+                    names = [x[0] for x in query]
+                record.update({"parameter": key, "query_parameter_present": key in names, "response_matches_guard": res.get("body", {}).get("text", "").startswith("No " + key + " provided")})
+                counts["parameter_present" if key in names else "parameter_absent"] += 1
+            else:
+                body = json.loads(req.get("body", {}).get("text", ""))
+                is_object = isinstance(body, dict)
+                absent = [key for key in ["key", "keyType"] if not is_object or key not in body]
+                null = [key for key in ["key", "keyType"] if is_object and key in body and body[key] is None]
+                dob_invalid = is_object and "keyDob" in body and body["keyDob"] is not None and (not isinstance(body["keyDob"], str) or re.fullmatch(r"[XxA-Fa-f0-9][A-Fa-f0-9]{63}", body["keyDob"]) is None)
+                headers = req.get("headers", [])
+                pairs = headers.items() if isinstance(headers, dict) else headers
+                illegal = any(any(ord(c) < 32 and c != "\t" or ord(c) == 127 for c in str(v)) for k, v in pairs if k.lower() not in {"authorization", "cookie", "proxy-authorization", "set-cookie"})
+                record.update({"absent_required_fields": absent, "null_required_fields": null, "invalid_keyDob_under_new_spec": dob_invalid, "illegal_non_auth_header_control": illegal})
+                counts["missing_or_null_required" if absent or null else "required_present_nonnull"] += 1
+                counts["absent_required_fields"] += bool(absent)
+                counts["null_required_fields"] += bool(null)
+                counts["new_spec_required_or_keyDob_rejects"] += bool(absent or null or dob_invalid)
+                counts["illegal_non_auth_header_control"] += illegal
+                counts["new_spec_rejects_without_illegal_headers"] += bool((absent or null or dob_invalid) and not illegal)
+            witnesses.append(record)
+        assert len(witnesses) == int(b["occurrences"]), (item_id, len(witnesses))
+        rows.append({"item_id": item_id, "counts": dict(counts), "witnesses": witnesses})
+    m.dump(m.OUT / "candidate_witnesses.json", rows)
+    cwa = anchors["cwa-verification"]
+    repo = m.ROOT / cwa["upstream_clone"]
+    before = json.loads(m.git(repo, "show", cwa["commit"] + ":api-docs.json"))
+    after = json.loads(m.git(repo, "show", cwa["head"] + ":api-docs.json"))
+    m.dump(m.OUT / "cwa_spec_semantic_delta.json", semantic_json_deltas(before, after))
+    provenance = {}
+    for sut, a in anchors.items():
+        deployed = (m.ROOT / a["deployed_spec"]).read_bytes()
+        if sut == "cwa-verification":
+            upstream = m.git(m.ROOT / a["upstream_clone"], "show", a["commit"] + ":api-docs.json")
+            provenance[sut] = {"deployed_sha256": m.sha(deployed), "anchor_spec_sha256": m.sha(upstream), "byte_identical": deployed == upstream}
+        else:
+            provenance[sut] = {"deployed_sha256": m.sha(deployed)}
+        item = next(i for i in items if i["baseline"]["sut"] == sut)
+        run = re.search(r"(08_experiments/[^;]+/exchanges.jsonl):\d+", item["codex"]["evidence_locators"]).group(1)
+        original = m.ROOT / Path(run).parent / "spec.original.json"
+        provenance[sut]["baseline_run_spec"] = str(original.relative_to(m.ROOT))
+        provenance[sut]["run_spec_semantic_equal"] = json.loads(original.read_bytes()) == json.loads(deployed)
+    m.dump(m.OUT / "spec_provenance.json", provenance)
+    print(json.dumps({r["item_id"]: r["counts"] for r in rows}, indent=2))
+
+
+def origin_and_local_audit(anchors):
+    origins = {}
+    local = {}
+    for sut, a in anchors.items():
+        repo = m.ROOT / a["upstream_clone"]
+        tree = m.tree(repo, a["commit"])
+        specs = [p for p in tree if re.search(r"(?i)(openapi|api-docs|swagger)", Path(p).name) and Path(p).suffix in {".yaml", ".yml", ".json"}]
+        tokens = []
+        for path in PATHS[sut]:
+            if path not in tree:
+                continue
+            for n, line in enumerate(m.git(repo, "show", a["commit"] + ":" + path).decode().splitlines(), 1):
+                if any(t in line for t in ["springdoc", "springfox", "Docket(", "@Schema", "@ApiResponse", "swagger-inflector", "swaggerUrl", "@NotNull", "@Pattern"]):
+                    tokens.append({"locator": a["commit"] + ":" + path + ":" + str(n), "text": m.sanitize(line.strip())})
+        origins[sut] = {"candidate_spec_paths_at_anchor": specs, "generator_markers": tokens}
+        selected = []
+        for row in json.loads((m.OUT / (sut + "_file_inventory.json")).read_text()):
+            if row["state"] == "different":
+                path = row["path"]
+                before = m.git(repo, "show", a["commit"] + ":" + row["upstream_path"])
+                after = (m.ROOT / a["emb_source"] / path).read_bytes()
+                # No SQL values or README text are retained, even in diffs.
+                selected.append({"path": path, "equal_after_newline_normalization": before.replace(b"\r\n", b"\n") == after.replace(b"\r\n", b"\n"), "upstream_bytes": len(before), "emb_bytes": len(after), "upstream_lf_count": before.count(b"\n"), "emb_lf_count": after.count(b"\n"), "content_saved": path not in {"README.adoc", "market-core/src/main/resources/data.sql"}})
+        local[sut] = selected
+    m.dump(m.OUT / "spec_origins.json", origins)
+    m.dump(m.OUT / "local_modification_audit.json", local)
+
+
+def main():
+    anchors = json.loads((m.OUT / "anchors.json").read_text())
+    items = json.loads((m.OUT / "baseline_evidence.json").read_text())
+    full_inventory(anchors)
+    collect_history(anchors)
+    candidates(anchors, items)
+    origin_and_local_audit(anchors)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/research/08_experiments/E4_triage/future_oracle/mine_history.py b/research/08_experiments/E4_triage/future_oracle/mine_history.py
new file mode 100644
index 0000000000000000000000000000000000000000..8ec7e9d3e6aefe19146603215af908297993cbe1
--- /dev/null
+++ b/research/08_experiments/E4_triage/future_oracle/mine_history.py
@@ -0,0 +1,188 @@
+#!/usr/bin/env python3
+"""T41 offline metadata miner. Never imports or executes external project code.
+
+Run from research/: /usr/bin/python3 -I -B .../mine_history.py
+Only the seven explicitly permitted, read-only Git verbs are allowed.
+"""
+import csv
+import hashlib
+import json
+from pathlib import Path
+import re
+import subprocess
+
+ROOT = Path(__file__).resolve().parents[3]
+OUT = ROOT / "08_experiments/E4_triage/future_oracle"
+SCRATCH = ROOT / "09_collab/logs/T41_scratch"
+EMB = ROOT / "08_experiments/_external/emb"
+UP = ROOT / "08_experiments/_external/upstream"
+LABELS = ROOT / "08_experiments/E2_labelling"
+SUTS = {
+    "swagger-petstore": ("jdk_8_maven/cs/rest/original/swagger-petstore", "swagger-petstore"),
+    "cwa-verification": ("jdk_11_maven/cs/rest/cwa-verification-server", "cwa-verification-server"),
+    "market": ("jdk_11_maven/cs/rest-gui/market", "market"),
+}
+VERBS = {"log", "show", "rev-list", "ls-tree", "diff", "cat-file"}
+EXTS = {".java", ".json", ".yaml", ".yml", ".xml", ".properties", ".sql"}
+ALIASES = {"swagger-petstore": {"src/main/webapp/openapi.yaml": "src/main/resources/openapi.yaml"}}
+
+
+def sanitize(value):
+    """Redact header values without printing them. Never read README/demo HTML."""
+    value = re.sub(r"(?im)(authorization|proxy-authorization|cookie|set-cookie)(\s*[\"']?\s*[:=]\s*)[^\r\n]*", r"\1\2[REDACTED]", value)
+    value = re.sub(r"(?i)\b(Basic|Bearer)\s+[A-Za-z0-9+/=._~-]{8,}", r"\1 [REDACTED]", value)
+    return value
+
+
+def git(repo, *args):
+    assert args[0] in VERBS, args
+    return subprocess.run(
+        ["git", "-c", "core.hooksPath=/dev/null", "-c", "core.pager=cat", "-C", str(repo), *args],
+        check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+        env={"PATH": "/usr/bin:/bin", "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null", "GIT_NO_REPLACE_OBJECTS": "1", "GIT_TERMINAL_PROMPT": "0", "GIT_NO_LAZY_FETCH": "1"},
+    ).stdout
+
+
+def dump(path, obj):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(obj, indent=2, ensure_ascii=False) + "\n")
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def blob(data):
+    return hashlib.sha1(b"blob " + str(len(data)).encode() + b"\0" + data).hexdigest()
+
+
+def relevant(path):
+    p = Path(path)
+    return p.suffix in EXTS and (
+        "src" in p.parts or path in {"api-docs.json", "inflector.yaml", "pom.xml"}
+        or (p.name == "pom.xml" and len(p.parts) == 2)
+    )
+
+
+def tree(repo, commit):
+    result = {}
+    for row in git(repo, "ls-tree", "-r", "-z", commit).split(b"\0"):
+        if row:
+            meta, path = row.split(b"\t", 1)
+            mode, kind, oid = meta.decode().split()
+            if kind == "blob":
+                result[path.decode()] = oid
+    return result
+
+
+def read_csv(path):
+    with path.open(newline="") as f:
+        return list(csv.DictReader(f))
+
+
+def main():
+    OUT.mkdir(parents=True, exist_ok=True)
+    SCRATCH.mkdir(parents=True, exist_ok=True)
+    final = [r for r in read_csv(LABELS / "final_labels_baseline_s1.csv") if r["sut"] in SUTS]
+    assert len(final) == 62
+    protected = {}
+    for name in ["final_labels_baseline_s1.csv"] + [s + suffix for s in SUTS for suffix in ["_adjudication.csv", "_baseline_s1_labels_codex.csv"]]:
+        p = LABELS / name
+        protected[str(p.relative_to(ROOT))] = sha(p.read_bytes())
+    items = []
+    for sut in SUTS:
+        adjud = {r["item_id"]: r for r in read_csv(LABELS / (sut + "_adjudication.csv"))}
+        lab = {r["item_id"]: r for r in read_csv(LABELS / (sut + "_baseline_s1_labels_codex.csv"))}
+        for row in final:
+            if row["sut"] == sut:
+                item_id = row["item_id"]
+                items.append({"baseline": row, "adjudication": adjud[item_id], "codex": lab[item_id]})
+    # These inputs contain locators/rationales, not raw HTTP headers or bodies.
+    dump(OUT / "baseline_evidence.json", json.loads(sanitize(json.dumps(items, ensure_ascii=False))))
+    anchors = {}
+    scores = []
+    for sut, (emb_rel, clone_name) in SUTS.items():
+        source, repo = EMB / emb_rel, UP / clone_name
+        emb = {}
+        for p in sorted(source.rglob("*")):
+            rel = p.relative_to(source).as_posix()
+            if any(part in {"target", ".git", "node_modules"} for part in p.relative_to(source).parts):
+                continue
+            if p.is_file() and relevant(rel):
+                assert not p.is_symlink(), p
+                data = p.read_bytes()
+                emb[rel] = blob(data)
+                protected[str(p.relative_to(ROOT))] = sha(data)
+        spec = EMB / "openapi-swagger" / (sut + ".json")
+        protected[str(spec.relative_to(ROOT))] = sha(spec.read_bytes())
+        commits = git(repo, "rev-list", "--all").decode().splitlines()
+        head = git(repo, "rev-list", "-1", "HEAD").decode().strip()
+        reachable = set(git(repo, "rev-list", "HEAD").decode().splitlines())
+        all_scores = []
+        for commit in commits:
+            upstream = tree(repo, commit)
+            mapped = {p: p if p in upstream else ALIASES.get(sut, {}).get(p, p) for p in emb}
+            matches = sum(upstream.get(mapped[p]) == oid for p, oid in emb.items())
+            common = sum(mapped[p] in upstream for p in emb)
+            java = [p for p in emb if p.endswith(".java")]
+            java_matches = sum(upstream.get(p) == emb[p] for p in java)
+            score = {"sut": sut, "commit": commit, "matches": matches, "literal_path_matches": sum(upstream.get(p) == oid for p, oid in emb.items()), "denominator": len(emb), "fraction": matches / len(emb), "common_paths": common, "java_matches": java_matches, "java_total": len(java), "reachable_from_head": commit in reachable}
+            all_scores.append(score)
+        best = max(r["matches"] for r in all_scores if r["reachable_from_head"])
+        # rev-list is reverse topological/date traversal; retain all tied maxima.
+        ties = [r["commit"] for r in all_scores if r["matches"] == best and r["reachable_from_head"]]
+        chosen = ties[-1]
+        selected = tree(repo, chosen)
+        per_file = []
+        for p, oid in emb.items():
+            mapped_path = p if p in selected else ALIASES.get(sut, {}).get(p, p)
+            per_file.append({"path": p, "upstream_path": mapped_path, "emb_blob": oid, "upstream_blob": selected.get(mapped_path), "state": "exact" if selected.get(mapped_path) == oid else "different" if mapped_path in selected else "emb_only"})
+        upstream_only = [p for p in selected if relevant(p) and p not in {r['upstream_path'] for r in per_file}]
+        metadata = git(repo, "show", "-s", "--format=%H%n%aI%n%cI%n%s", chosen).decode().splitlines()
+        post = git(repo, "rev-list", "--reverse", "--ancestry-path", chosen + ".." + head).decode().splitlines()
+        reachable_post = git(repo, "rev-list", "--reverse", head, "^" + chosen).decode().splitlines()
+        headmeta = git(repo, "show", "-s", "--format=%H%n%aI%n%cI%n%s", head).decode().splitlines()
+        anchors[sut] = {
+            "emb_source": str(source.relative_to(ROOT)), "upstream_clone": str(repo.relative_to(ROOT)),
+            "deployed_spec": str(spec.relative_to(ROOT)), "head": head, "head_author_date": headmeta[1], "head_committer_date": headmeta[2], "head_message": sanitize(headmeta[3][:160]),
+            "commit": chosen, "author_date": metadata[1], "committer_date": metadata[2], "message": sanitize(metadata[3][:160]),
+            "selection": "oldest tied maximum in rev-list --all traversal, restricted to HEAD ancestors; all ties retained",
+            "scope": "All Java/JSON/YAML/XML/properties/SQL under src, plus module/root pom.xml, api-docs.json, inflector.yaml; target/.git/node_modules excluded",
+            "path_aliases": ALIASES.get(sut, {}),
+            "matches": best, "denominator": len(emb), "fraction": best / len(emb), "tied_best_commits": ties,
+            "global_best_matches": max(r["matches"] for r in all_scores),
+            "java_matches": sum(r["state"] == "exact" and r["path"].endswith(".java") for r in per_file),
+            "java_total": sum(r["path"].endswith(".java") for r in per_file),
+            "per_file": per_file, "upstream_only_relevant_files": upstream_only,
+            "post_anchor_ancestry_commits": post, "post_anchor_reachable_commits": reachable_post,
+        }
+        # Do not include README/HTML patches; these are known to contain credentials.
+        # SQL seed data may contain credentials: retain hashes/paths only.
+        changed = [r for r in per_file if r["state"] == "different" and not r["path"].endswith('.sql')]
+        patches = []
+        for row in changed:
+            p = row['path']
+            old = git(repo, "show", chosen + ":" + row['upstream_path']).decode(errors="replace").splitlines(True)
+            new = (source / p).read_text(errors="replace").splitlines(True)
+            import difflib
+            patches.extend(difflib.unified_diff(old, new, fromfile=chosen + ":" + p, tofile="EMB:" + p))
+        (OUT / (sut + "_emb_local.diff")).write_text(sanitize("".join(patches)))
+        logs = []
+        for commit in reachable_post:
+            meta = git(repo, "show", "-s", "--format=%H%n%P%n%aI%n%cI%n%s", commit).decode().splitlines()
+            parents = meta[1].split()
+            touched = git(repo, "diff", "--name-only", parents[0], commit).decode().splitlines() if parents else []
+            logs.append({"commit": commit, "parents": parents, "author_date": meta[2], "committer_date": meta[3], "message": sanitize(meta[4][:160]), "ancestry_descendant": commit in post, "files": touched})
+        dump(OUT / (sut + "_history.json"), logs)
+        scores.extend(all_scores)
+    dump(OUT / "anchors.json", anchors)
+    with (OUT / "anchor_scores.csv").open("w", newline="") as f:
+        writer = csv.DictWriter(f, fieldnames=list(scores[0]))
+        writer.writeheader()
+        writer.writerows(scores)
+    dump(SCRATCH / "protected_hashes.json", protected)
+    print(json.dumps({s: {k: a[k] for k in ["commit", "matches", "denominator", "fraction", "java_matches", "java_total", "tied_best_commits"]} for s, a in anchors.items()}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/research/09_collab/reports/T41_report.md b/research/09_collab/reports/T41_report.md
new file mode 100644
index 0000000000000000000000000000000000000000..c029a39cd8134f8992ad59df294c5168089d0f73
--- /dev/null
+++ b/research/09_collab/reports/T41_report.md
@@ -0,0 +1,103 @@
+**T41 — Future-version oracle: upstream SPEC বদলেছে, না CODE?**
+
+৬২টি baseline item-এর মধ্যে **৩টিতে developer direction পাওয়া গেছে: সবই `spec_changed_to_match_code`**, দুটি upstream commit থেকে। P014-এর একটি witness সম্পূর্ণভাবে এই পরিবর্তনের আওতায়; P015 ও C002-তে cluster-এর কেবল অংশের জন্য evidence আছে। `code_changed_to_match_spec` বা `both_changed` পাওয়া যায়নি। এই তিনটির direction বনাম বর্তমান `final_L1` মিল **২/৩**; একমাত্র disagreement **P014: developer SPEC দিকে পরিবর্তন করেছে, final label IMPL**। Labels অপরিবর্তিত; শুধু review proposal লেখা হয়েছে। সূত্র: `08_experiments/E4_triage/future_oracle/{summary.json,agreement.csv,review_proposals.csv}`, item P014/P015/C002।
+
+⚠️ এখানে “future” মানে **EMB source anchor-এর পরের upstream history**। Fix-দুটি 2021 ও 2025-এর, baseline experiment November 2026-এর; এটি experiment-এর পরে developer-এর প্রতিক্রিয়া নয়। Analysis non-blind: final labels ও adjudication থেকে mismatch proposition নেওয়া হয়েছে। Patch কে কোন report-এর প্রতিক্রিয়ায় করেছে, তার প্রমাণ নেই। সূত্র: `future_oracle/anchors.json`-এর commit dates; `future_oracle/candidate_witnesses.json`-এর baseline run locators; `future_oracle/*_all_descendant_history.json`-এর দুই fix commit। এই report-এ `future_oracle/` বলতে `08_experiments/E4_triage/future_oracle/` বোঝানো হয়েছে।
+
+**কাজের পদ্ধতি ও anchor**
+
+প্রতি EMB file-এর `SHA1("blob " + byte_length + NUL + content)` upstream `ls-tree` blob-এর সঙ্গে মিলিয়েছি। Denominator: `src/`-এর Java, JSON, YAML, XML, properties ও SQL; root/module `pom.xml`, `api-docs.json`, `inflector.yaml`। `target/`, `.git/`, `node_modules/`, generated build output বাদ। সব local ref-এর সব commit score করা হয়েছে; default HEAD-এর ancestor-গুলির সর্বোচ্চ match থেকে anchor নিয়েছি। Tie-গুলিও সংরক্ষিত; primary anchor tie traversal-এর পুরোনো প্রান্তে, যাতে সমান source-এর মাঝের কোনো change বাদ না পড়ে। এটি exact original import commit শনাক্ত করার দাবি নয়। সূত্র: `future_oracle/mine_history.py:relevant,main`, `future_oracle/anchor_scores.csv`, `future_oracle/anchors.json`।
+
+| SUT | anchor, author date | relevant exact match | Java exact match | tied best |
+|---|---|---:|---:|---:|
+| swagger-petstore | `f1ed336a08b18ba4a86c496147c4f546ae965a7b`, 2025-03-19 | 24/27 = **88.9%** | 22/23 | 2 |
+| cwa-verification | `a02110fb8dd960a66f4d359d99c62454b8bc0b79`, 2021-09-07 | 67/71 = **94.4%** | 55/57 | 1 |
+| market | `2b690750752a848ed5fdb48006bc2d5e8db97bf1`, 2022-02-06 | 135/139 = **97.1%** | 124/124 | 3 |
+
+Table-এর evidence: `future_oracle/anchors.json`, সংশ্লিষ্ট SUT-এর `matches`, `denominator`, `java_matches`, `java_total`, `tied_best_commits`; সব score `anchor_scores.csv`-এ। কোনো SUT 80%-এর নিচে নয়। Market-এর প্রাথমিক 97.8% হিসাবটিতে SQL ছিল না; final 97.1% scope-এ SQL-ও আছে।
+
+Petstore-এ path alias জরুরি: EMB `src/main/webapp/openapi.yaml` upstream `src/main/resources/openapi.yaml`-এর **একই blob** `1882eca957c5cf17bb97b8d8754bb6f31cad1e5b`। Alias ছাড়া literal-path maximum 23/27 এবং অনেক পরের commit-ও tie হয়; alias দিলে spec-সহ 24/27-এর দুইটি candidate পাওয়া যায়। দ্বিতীয়টি `0f0761b71b849c96b0425ea3796b8fb3aaa129e6`; relevant state একই। তিন SUT-এর baseline run `spec.original.json` supplied deployed JSON-এর সঙ্গে semantic equality পাস করেছে। CWA deployed JSON ও anchored `api-docs.json` byte-identical। সূত্র: `future_oracle/{anchors.json,anchor_scores.csv,spec_provenance.json}`। Petstore-এর JSON/YAML-এর সম্পূর্ণ byte বা parsed-tree equality দাবি করা হয়নি; YAML relocation-এর blob equality ও item-specific constraint correspondence ব্যবহার করেছি।
+
+EMB-local differences-এর সম্পূর্ণ hash-only inventory `future_oracle/*_file_inventory.json`-এ। Relevant patches `*_emb_local.diff`-এ; নিচের তালিকায় non-build inventory-এর সব non-exact path আছে। Market README/seed SQL-এর values প্রকাশ বা copy করা হয়নি। সূত্র: `future_oracle/{swagger-petstore,cwa-verification,market}_file_inventory.json`, `future_oracle/local_modification_audit.json`।
+
+| SUT | modified upstream paths | EMB-only paths |
+|---|---|---|
+| petstore | `inflector.yaml`, `pom.xml` | `dependency-reduced-pom.xml`; `src/main/java/io/swagger/petstore/Main.java`; `src/main/webapp/swagger-ui-bundle.js`, `swagger-ui-standalone-preset.js`, `swagger-ui.css` |
+| CWA | `pom.xml`; `src/main/java/app/coronawarn/verification/controller/InternalTestStateController.java`; `src/main/resources/db/changelog/v000-create-app-session-table.yml` | `src/main/java/app/coronawarn/verification/config/IdeConfig.java` |
+| market | `README.adoc`; `market-core/src/main/resources/data.sql`; `market-rest/pom.xml`; `market-web/pom.xml`; `pom.xml` | `Project.xml`, `codeStyleConfig.xml`, `codeStyles/Project.xml`, `codeStyles/codeStyleConfig.xml` |
+
