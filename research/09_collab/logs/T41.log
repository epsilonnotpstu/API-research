+def market_review(b):
+    id, route, method, status = b["item_id"], b["template"], b["method"], b["status"]
+    exception = R + "rest/exception/RestExceptionHandler.java"
+    markers = [(exception, "@ExceptionHandler(Exception.class)")]
+    if id in {"M003", "M005", "M007", "M012"}:
