+def source_locator(sut, commit, path, marker):
+    text = (HERE / "source_evidence" / sut / commit / (path + ".txt")).read_text()
+    lines = text.splitlines()
+    line = next((n for n, v in enumerate(lines, 1) if marker in v), None)
