+                                               'csv_sha256': hashlib.sha256(args.output.read_bytes()).hexdigest(),
+                                               'row_counts': dict(Counter(r['row_type'] for r in all_rows))},
+                                              ensure_ascii=False, indent=2) + '\n')
+    print(f'{len(all_rows)} rows -> {args.output}')
+
+
+if __name__ == '__main__':
+    main()

