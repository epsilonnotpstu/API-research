+            ns = specmut.resolve(mutated.raw, entry.get('schema', {}))
+            base = prefix + '/requestBody/content' + specmut.ptr(media) + '/schema'
+            changes = [(base + suffix, bv, av, '/requestBody' + suffix)
+                       for suffix, bv, av in strict_changes(os, ns)]
+            if changes:
