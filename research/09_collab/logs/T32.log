new file mode 100644
index 0000000000000000000000000000000000000000..79775265194517d6e2394886486fd92a7025c639
--- /dev/null
+++ b/research/09_collab/logs/T32_scratch/test_strict_exposure.py
@@ -0,0 +1,132 @@
+"""Focused synthetic checks for T32's measurement semantics (own Python only)."""
+import copy
+import importlib.util
+import json
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[3]
+SCRIPT = ROOT / '08_experiments/E1_pilot/pilot_results/strict_exposure.py'
+spec = importlib.util.spec_from_file_location('strict_exposure', SCRIPT)
+s = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(s)
+
+
+class ExposureTests(unittest.TestCase):
+    def setUp(self):
+        self.folder = Path(__file__).parent / 'fixtures' / self._testMethodName
+        self.run, self.baseline = self.folder / 'mutated', self.folder / 'baseline'
+        self.run.mkdir(parents=True, exist_ok=True)
+        self.baseline.mkdir(parents=True, exist_ok=True)
+
+    def measure(self, old, new, exchanges):
+        manifest = {'mutations': []}
+        for path, item in new['paths'].items():
+            for method, op in item.items():
+                edits = s.specmut.document_edits(old['paths'][path][method], op, s.specmut.ptr('paths', path, method))
+                if edits:
+                    manifest['mutations'].append({'path': path, 'method': method, 'fault': 'REQUEST_STRICT', 'edits': edits})
+        for run in (self.run, self.baseline):
+            (run / 'exchanges.jsonl').write_text(''.join(json.dumps(e) + '\n' for e in exchanges))
+        rows, audit = s.analyse_run({'sut': 'market', 'seed': '1', 'severity': '30'}, 'evomaster',
+                                   self.run, self.baseline, s.c.Spec(old), s.c.Spec(new), manifest, lambda *a: None)
+        self.assertEqual(rows[0]['fresh_violating_requests'], rows[0]['baseline_violating_requests'])
+        return rows, audit
+
+    @staticmethod
+    def ex(path='/x/2', status=200, query=None, body='', ctype='application/json', headers=None, truncated=False):
+        return {'request': {'path': path, 'method': 'POST', 'query': query or {},
+                            'headers': {'content-type': ctype, **(headers or {})},
+                            'body': {'text': body, 'truncated': truncated, 'decode_error': False}},
+                'response': {'status': status}}
+
+    @staticmethod
+    def base():
+        return {'openapi': '3.0.0', 'paths': {'/x/{id}': {'post': {
+            'parameters': [{'name': 'id', 'in': 'path', 'required': True,
+                            'schema': {'type': 'integer', 'format': 'int64'}},
+                           {'name': 'q', 'in': 'query', 'schema': {'type': 'string'}}],
+            'responses': {'200': {'description': 'ok'}}}}}}
+
+    def test_union_response_classes_and_location_gate(self):
+        old = self.base()
+        new = copy.deepcopy(old)
+        ps = new['paths']['/x/{id}']['post']['parameters']
+        ps[0]['schema']['maximum'] = 0
+        ps[1]['required'] = True
+        ps[1]['schema']['maxLength'] = 1
+        examples = [self.ex(query={'q': ['long']}), self.ex(status=400),
+                    self.ex(status=500), self.ex('/x/9223372036854775808', query={'q': ['x']}),
+                    self.ex('/x/no-integer', query={'q': ['long']}), self.ex('/x/-1', query={'q': ['x']})]
+        rows, audit = self.measure(old, new, examples)
+        r = rows[0]
+        self.assertEqual(r['fresh_requests_to_mutated_ops'], 6)
+        self.assertEqual((r['fresh_violating_requests'], r['fresh_violating_2xx'], r['fresh_violating_4xx'],
+                          r['fresh_violating_other']), (4, 2, 1, 1))
+        # Overflow invalid originally: does not become an eligible maximum violation.
+        maximum = next(r for r in rows if r['row_type'] == 'constraint' and r['pointer'].endswith('/maximum'))
+        self.assertEqual(maximum['fresh_constraint_breaches'], 4)
+        self.assertEqual(maximum['fresh_violating_requests'], 3)
+        # Invalid id does not suppress independent valid-original query violation.
+        self.assertEqual(r['fresh_original_invalid_requests'], 2)
+        self.assertGreater(sum(r['fresh_violating_requests'] for r in rows if r['row_type'] == 'constraint'), 4)
+
+    def test_body_gate_ref_expansion_and_array_unique_requests(self):
+        old = self.base()
+        old['components'] = {'schemas': {'Item': {'type': 'object', 'required': ['code'], 'properties': {
+            'code': {'type': 'string', 'enum': ['ok']}, 'name': {'type': 'string'}}}}}
+        schema = {'type': 'array', 'items': {'$ref': '#/components/schemas/Item'}}
+        op = old['paths']['/x/{id}']['post']
+        op['requestBody'] = {'required': True, 'content': {'application/json': {'schema': schema},
+                                                        'application/xml': {'schema': copy.deepcopy(schema)}}}
+        new = copy.deepcopy(old)
+        ns = new['paths']['/x/{id}']['post']['requestBody']['content']['application/json']['schema']
+        ns['items'] = copy.deepcopy(old['components']['schemas']['Item'])
+        ns['items']['properties']['name']['maxLength'] = 1
+        ns['items']['required'] = ['code', 'name']
+        examples = [self.ex(body='[{"code":"ok","name":"long"},{"code":"ok","name":"long"}]'),
+                    self.ex(body='[{"code":"bad","name":"long"}]'),
+                    self.ex(body='[{"code":"ok"}]', status=404),
+                    self.ex(body='{"code":"ok","name":"long"}'),
+                    self.ex(body='[{"code":"ok","name":"long"}]', truncated=True),
+                    self.ex(body='[{"code":"ok","name":"long"}]', ctype='application/xml'),
+                    self.ex(body='not-json')]
+        rows, _ = self.measure(old, new, examples)
+        r = rows[0]
+        self.assertEqual(r['fresh_violating_requests'], 2)
+        self.assertEqual(r['fresh_violating_2xx'], 1)
+        self.assertEqual(r['fresh_violating_4xx'], 1)
+        self.assertEqual(r['fresh_constraint_breaches'], 3)
+        self.assertEqual(r['fresh_original_invalid_requests'], 3)
+        self.assertEqual(r['fresh_uncheckable_requests'], 1)
+        structural = [r for r in rows if r.get('edit_role') == 'structural_or_annotation']
+        self.assertTrue(structural)
+        self.assertTrue(all(r['fresh_violating_requests'] == 0 for r in structural))
+
+    def test_unknown_object_header_is_not_zero_compliance(self):
+        old = self.base()
+        ps = old['paths']['/x/{id}']['post']['parameters']
+        ps.append({'name': 'Authorization', 'in': 'header', 'required': True,
+                   'schema': {'type': 'object', 'properties': {'token': {'type': 'string'}}}})
+        new = copy.deepcopy(old)
+        new['paths']['/x/{id}']['post']['parameters'][-1]['schema']['properties']['token']['maxLength'] = 1
+        rows, audit = self.measure(old, new, [self.ex(headers={'authorization': '<redacted>'})])
+        self.assertEqual(rows[0]['fresh_uncheckable_requests'], 1)
+        self.assertEqual(rows[0]['fresh_evaluated_requests'], 0)
+        self.assertEqual(rows[0]['fresh_violating_requests'], 0)
+        self.assertIn('unsupported parameter serialization: Authorization',
+                      next(x for x in audit['examples'] if 'reasons' in x)['reasons'])
+
+    def test_template_matching_concrete_precedence_and_decoding(self):
+        old = self.base()
+        old['paths']['/x/fixed'] = {'get': {'responses': {}}}
+        new = copy.deepcopy(old)
+        new['paths']['/x/{id}']['post']['parameters'][0]['schema']['maximum'] = 0
+        rows, _ = self.measure(old, new, [self.ex('/x/fixed'), self.ex('/x/%32/'), self.ex('/x/3', status=302)])
+        self.assertEqual(rows[0]['fresh_requests_to_mutated_ops'], 2)
+        self.assertEqual(rows[0]['fresh_violating_requests'], 2)
+        self.assertEqual(rows[0]['fresh_violating_other'], 1)
+
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
diff --git a/research/09_collab/logs/T32_scratch/verify_exposure.py b/research/09_collab/logs/T32_scratch/verify_exposure.py
new file mode 100644
index 0000000000000000000000000000000000000000..fdf34b5c030bf58520a0aff618b07213a659d299
--- /dev/null
+++ b/research/09_collab/logs/T32_scratch/verify_exposure.py
@@ -0,0 +1,185 @@
+"""Independent scalar/body validation of EVERY T32 row, without request_problems.
+
+Uses the same required conformance route matcher, coercion and JSON Schema policy,
+but extracts evidence directly and applies validators to each location. The main
+script instead isolates request_problems calls and maps their pointer identities.
+"""
+import csv
+import hashlib
+import importlib.util
+import json
+from collections import Counter, defaultdict
+from functools import lru_cache
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[3]
+PILOT = ROOT / '08_experiments/E1_pilot'
+spec = importlib.util.spec_from_file_location('strict_exposure', PILOT / 'pilot_results/strict_exposure.py')
+s = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(s)
+c = s.c
+rows = list(csv.DictReader((PILOT / 'pilot_results/strict_exposure.csv').open()))
+groups = defaultdict(list)
+for row in rows:
+    groups[row['run']].append(row)
+checked, reports, statuses = 0, [], Counter()
+
+
+def errors(spec, schema, value):
+    out, unknown = [], False
+    try:
+        for error in spec.errors(schema, value, 'request'):
+            pointer = s.specmut.ptr(*error.schema_path) if error.schema_path else ''
+            for identity in c.error_identity(error):
+                out.append((pointer, identity))
+    except Exception:
+        unknown = True
+    return out, unknown
+
+
+for name, run_rows in groups.items():
+    summary = next(r for r in run_rows if r['row_type'] == 'run')
+    sut = summary['sut']
+    run = PILOT / 'runs' / sut / name
+    base = PILOT / 'runs' / sut / summary['baseline_run']
+    old, new = [c.Spec(json.loads((run / filename).read_text()), deploy_origin=f'http://sut-{sut}:8080')
+                for filename in ('spec.original.json', 'spec.test.json')]
+    ops = {}
+    for op_row in (r for r in run_rows if r['row_type'] == 'operation'):
+        op_key = (op_row['path'], op_row['method'])
+        old_op, old_params = old.operation(*op_key)
+        new_op, new_params = new.operation(*op_key)
+        locs = defaultdict(list)
+        for constraint in run_rows:
+            if constraint['row_type'] == 'constraint' and (constraint['path'], constraint['method']) == op_key:
+                locs[(constraint['location'], constraint['media_type'])].append(constraint)
+        ops[op_key] = (op_row, old_op, new_op, old_params, new_params, locs)
+
+    @lru_cache(maxsize=8192)
+    def evaluate(path, method, location, media, evidence_key):
+        op_row, old_op, new_op, old_params, new_params, locs = ops[(path, method)]
+        constraints = locs[(location, media)]
+        hits = set()
+        data = json.loads(evidence_key)
+        if location == 'body' or location.startswith('body:'):
+            capture, ctype = data
+            if capture.get('truncated') or capture.get('decode_error'):
+                return False, True, ()
+            if location == 'body':
+                os = old_op['requestBody']['content'][media]['schema']
+                ns = new_op['requestBody']['content'][media]['schema']
+                required = old_op['requestBody'].get('required', False)
+                selected_media = media
+            else:
+                bp_old = next(p for p in old_params if p['in'] == 'body')
+                bp_new = next(p for p in new_params if p['in'] == 'body')
+                os, ns = bp_old['schema'], bp_new['schema']
+                required = bp_old.get('required', False)
+                selected_media = ctype or next(iter(new_op.get('consumes', new.raw.get('consumes', ['application/json']))))
+            if not capture.get('text'):
+                return bool(required), False, ()
+            try:
+                value = c.parse_body(capture['text'], ctype or selected_media)
+            except ValueError:
+                return True, False, ()
+            except LookupError:
+                return False, True, ()
+            prefix = '/requestBody'
+        else:
+            where, pname = location.split(':', 1)
+            op = next(p for p in old_params if (p['in'], p['name']) == (where, pname))
+            np = next(p for p in new_params if (p['in'], p['name']) == (where, pname))
+            present, value = data
+            if not present:
+                for item in constraints:
+                    if item['pointer'].endswith('/required') and np.get('required') and not op.get('required'):
+                        hits.add(item['row_id'])
+                return bool(op.get('required')), False, tuple(hits)
+            os = op.get('schema', {k: op[k] for k in c.PARAM_SCHEMA_KEYS if k in op})
+            ns = np.get('schema', {k: np[k] for k in c.PARAM_SCHEMA_KEYS if k in np})
+            if any('content' in p or p.get('schema', {}).get('type') == 'object'
+                   or '$ref' in p.get('schema', {}) for p in (op, np)):
+                return False, True, ()
+            if os.get('type') not in ('string', 'integer', 'number', 'boolean'):
+                raise AssertionError('independent check needs scalar parameter, got ' + str(os))
+            value = c.coerce(value, c.to_json_schema(ns, new.dialect, direction='request'))
+            prefix = '/parameters' + s.specmut.ptr(where, pname)
+        old_errors, old_unknown = errors(old, os, value)
+        new_errors, new_unknown = errors(new, ns, value)
+        for item in constraints:
+            bv, av = json.loads(item['before']), json.loads(item['after'])
+            added = set(av) - set(bv or []) if isinstance(av, list) else None
+            if any(prefix + pointer == item['error_pointer'] and
+                   (added is None or identity.get('property') in added) for pointer, identity in new_errors):
+                hits.add(item['row_id'])
+        return bool(old_errors), old_unknown or new_unknown, tuple(hits)
+
+    for side, directory in (('fresh', run), ('baseline', base)):
+        counts = defaultdict(Counter)
+        matched = Counter()
+        for line_no, raw in enumerate((directory / 'exchanges.jsonl').open(), 1):
+            ex = json.loads(raw)
+            req = ex['request']
+            path, pp = new.match(req['path'], req['method'], req.get('origin'))
+            method = req['method'].upper()
+            if (path, method) not in ops:
+                continue
+            op_row, old_op, new_op, old_params, new_params, locs = ops[(path, method)]
+            oid = op_row['row_id']
+            matched[oid] += 1
+            flags = defaultdict(set)
+            headers = {k.lower(): v for k, v in req.get('headers', {}).items()}
+            ctype = headers.get('content-type', '').split(';')[0].strip().lower()
+            for (location, media), constraints in locs.items():
+                if media and c.select_media(new_op['requestBody']['content'], ctype)[0] != media:
+                    continue
+                if location == 'body' or location.startswith('body:'):
+                    key = [req.get('body', {}), ctype]
+                else:
+                    where, pname = location.split(':', 1)
+                    if where == 'path':
+                        key = [pname in pp, pp.get(pname)]
+                    elif where == 'header':
+                        key = [pname.lower() in headers, headers.get(pname.lower())]
+                    elif where == 'query':
+                        value = req.get('query', {}).get(pname)
+                        vals = value if isinstance(value, list) else [value] if value is not None else []
+                        key = [bool(vals), vals[0] if vals else None]
+                    else:
+                        raise AssertionError('unexpected location: ' + where)
+                invalid_old, unknown, hits = evaluate(path, method, location, media, s.compact(key))
+                for item in constraints:
+                    for rid in (summary['row_id'], oid, item['parent_manifest_edit'], item['row_id']):
+                        flags[rid].add('applicable_requests')
+                        flags[rid].add('uncheckable_requests' if unknown else 'evaluated_requests')
+                        if invalid_old:
+                            flags[rid].add('original_invalid_requests')
+                        if item['row_id'] in hits:
+                            flags[rid].add('constraint_breaches')
+                            if not invalid_old and not unknown:
+                                status = int(ex['response']['status'])
+                                flags[rid].add('violating_requests')
+                                flags[rid].add('violating_2xx' if 200 <= status < 300 else
+                                               'violating_4xx' if 400 <= status < 500 else 'violating_other')
+            for rid, flags_for_row in flags.items():
+                counts[rid].update(flags_for_row)
+                if rid == summary['row_id'] and 'violating_requests' in flags_for_row:
+                    statuses[(sut, summary['fuzzer'], side, str(ex['response']['status']))] += 1
+        for row in run_rows:
+            rid = row['row_id']
+            counts[rid]['requests_to_mutated_ops'] = (sum(matched.values()) if row['row_type'] == 'run'
+                else matched[ops[(row['path'], row['method'])][0]['row_id']])
+            for metric in s.METRICS:
+                actual, expected = counts[rid][metric], int(row[side + '_' + metric])
+                assert actual == expected, (rid, side, metric, actual, expected)
+                checked += 1
+        reports.append({'run': name, 'side': side, 'matched': sum(matched.values()),
+                        'eligible_violations': counts[summary['row_id']]['violating_requests']})
+    print(name, 'PASS', flush=True)
+
+out = {'assertions': checked, 'runs': reports,
+       'eligible_response_statuses': [{'sut': sut, 'fuzzer': fuzzer, 'side': side, 'status': status, 'count': n}
+                                    for (sut, fuzzer, side, status), n in sorted(statuses.items())],
+       'csv_sha256': hashlib.sha256((PILOT / 'pilot_results/strict_exposure.csv').read_bytes()).hexdigest()}
+(Path(__file__).parent / 'verification.json').write_text(json.dumps(out, indent=2) + '\n')
+print('PASS:', checked, 'row/side/metric assertions')

