+def analyse_run(cell, fuzzer, run, baseline, original, mutated, manifest, remember):
+    rows, counters, examples = [], defaultdict(Counter), {}
+    common = {'sut': cell['sut'], 'seed': cell['seed'], 'severity': cell['severity'],
