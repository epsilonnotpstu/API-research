+            method, path, status = q['method'], q['path'], int(s['status'])
+            template, _ = spec.match(path, method, q.get('origin'))
+            if (method.upper(), template) in ops:
+                st[f'{status // 100}xx'] += 1
+            text = (q.get('body') or {}).get('text') or ''
+            invalid_json = False
