    47	        status = rs.get('status') or 0
    48	        # mutated-op matching by template: the manifest path may contain {params}
    49	        for m, p in ops:
    50	            if rq.get('method') == m and re.fullmatch(re.sub(r'\{[^/]+\}', '[^/]+', p), rq.get('path') or ''):
    51	                st[f'{status // 100}xx'] += 1
    52	                break
    53	        if rq.get('method') == 'PUT' and rq.get('path') == '/customer/contacts':
    54	            t = (rq.get('body') or {}).get('text') or ''
    55	            if '"_links"' in t:
    56	                links += 1
    57	                links500 += status == 500
    58	    return st, links, links500
