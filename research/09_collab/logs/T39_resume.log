+    assert len(runs) == 7 and new_count == 13 and partner_count == 0
+    return {'runs': len(runs), 'NEW': new_count, 'raw_mutated_NEW': raw_mutated_new,
+            'with_same_kind_op_VANISHED': partner_count,
