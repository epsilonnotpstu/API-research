+    for p in list((ROOT/'08_experiments/tools').glob('*.py')) + list((ROOT/'08_experiments/E1_pilot/harness_v2').rglob('*')) + list(TREE.rglob('*.java')) + list(TREE.rglob('pom.xml')):
+        if p.is_file() and '__pycache__' not in p.parts:
+            inputs[str(p.relative_to(ROOT))] = sha(p.read_bytes())
+    for p in [EMB/'openapi-swagger/market.json',EMB/'dockerfiles/market.dockerfile',EMB/'dockerfiles/market.yaml',EMB/'dist/market-sut.jar',TREE/'market-rest/target/market-sut.jar',ROOT/'08_experiments/E1_pilot/pilot_results/fuzzer_trajectory_overlap.csv']:
+        inputs[str(p.relative_to(ROOT))] = sha(p.read_bytes())
+    for seed in (1,3):
+        p=ROOT/f'08_experiments/E1_pilot/runs/market/20261114T183929Z_batch_940129_mutated_REQUEST_STRICT_p30_s{seed}/compose.log'
+        inputs[str(p.relative_to(ROOT))] = sha(p.read_bytes())
+    dump('protected_sha256.json',inputs)
+
+
+def findings():
+    data=json.loads((OUT/'aggregates.json').read_text())
+    summaries=json.loads((OUT/'traffic_summary.json').read_text())
+    contacts=[json.loads(l) for l in (OUT/'contacts.jsonl').open()]
+    output=[]
+    for seed in (1,3):
+        fresh=f'20261114T183929Z_batch_940129_mutated_REQUEST_STRICT_p30_s{seed}'
+        base=f'20261114T183929Z_batch_940129_baseline_NONE_p0_s{seed}'
+        fs=next(r for r in summaries if r['run']==fresh)
+        bs=next(r for r in summaries if r['run']==base)
+        valid=[r for r in contacts if r['run']==fresh and r['eligible']]
+        good=[r for r in contacts if r['run']==base and r['status']==200]
+        output.append({'seed':seed,'fresh_run':fresh,'baseline_run':base,
+            'fresh_eligible_contacts':{k:v for k,v in data[fresh]['eligible_contacts'].items() if k!='lines'},
+            'baseline_accepted_contacts':{k:v for k,v in data[base]['accepted_contacts'].items() if k!='lines'},
+            'fresh_contacts_status':fs['contacts_status'], 'baseline_contacts_status':bs['contacts_status'],
+            'baseline_all_eligible_accepted_ops':data[base]['all_eligible_accepted_ops'],
+            'baseline_array_error_count':sum(r['run']==base and r['links_shape']=='array' and r['response_kind']=='Expected relation name' for r in contacts),
+            'fresh_phone_breach':sum(any(p.endswith('/phone/maxLength') for p in r['breaches']) for r in valid),
+            'fresh_address_breach':sum(any(p.endswith('/address/maxLength') for p in r['breaches']) for r in valid),
+            'fresh_all_error_markers':all(all(r['response_evidence'].values()) for r in valid),
+            'first_fresh_example':valid[0], 'first_baseline_accepted_example':good[0],
+            'first_empty_links_example':next(r for r in valid if r['links_count']==0)})
+    for seed in (1,2,3):
+        run=f'20261114T104059Z_batch_339514_mutated_REQUEST_STRICT_p30_s{seed}'
+        summary=next(r for r in summaries if r['run']==run)
+        output.append({'seed':seed,'schemathesis_run':run,'contacts_status':summary['contacts_status'],
+            'eligible_contacts_status':summary['contacts_eligible_status'],
+            'accepted_by_operation':data[run]['all_eligible_accepted_ops'],
+            'first_accepted_by_operation':data[run]['first_accepted_by_op']})
+    run='20261114T183929Z_batch_940129_mutated_REQUEST_STRICT_p30_s2'
+    summary=next(r for r in summaries if r['run']==run)
+    output.append({'seed':2,'evomaster_run':run,'eligible_status':summary['eligible_status'],
+        'contacts_status':summary['contacts_status'],'accepted_contacts_n':data[run]['accepted_contacts']['n'],
+        'accepted_contacts_links_shapes':data[run]['accepted_contacts']['counts']['links_shape']})
+    with (OUT/'findings.jsonl').open('w') as f:
+        for row in output:
+            f.write(json.dumps(row,ensure_ascii=False)+'\n')
+
+
+if __name__ == '__main__':
+    provenance()
+    aggregates()
+    findings()
+    freeze()
diff --git a/research/09_collab/logs/T35_scratch/verify.py b/research/09_collab/logs/T35_scratch/verify.py
new file mode 100644
index 0000000000000000000000000000000000000000..74baf892feaadcc88b3dbc25145ab22d060afdf0
--- /dev/null
+++ b/research/09_collab/logs/T35_scratch/verify.py
@@ -0,0 +1,106 @@
+"""Independent direct-schema recount and read-only/secret checks for T35."""
+import base64
+import hashlib
+import json
+from pathlib import Path
+
+import jsonschema
+import yaml
+
+ROOT = Path(__file__).resolve().parents[3]
+OUT = Path(__file__).resolve().parent
+EMB = ROOT/'08_experiments/_external/emb'
+
+
+def resolved(document, node):
+    if isinstance(node,dict):
+        if '$ref' in node:
+            target = document
+            for part in node['$ref'][2:].split('/'):
+                target = target[part.replace('~1','/').replace('~0','~')]
+            return resolved(document,target)
+        return {k:resolved(document,v) for k,v in node.items()}
+    if isinstance(node,list):
+        return [resolved(document,v) for v in node]
+    return node
+
+
+def main():
+    rows=[]
+    for seed,expected_fresh,expected_good in [(1,392,81),(3,361,74)]:
+        fresh=f'20261114T183929Z_batch_940129_mutated_REQUEST_STRICT_p30_s{seed}'
+        base=f'20261114T183929Z_batch_940129_baseline_NONE_p0_s{seed}'
+        rp=ROOT/'08_experiments/E1_pilot/runs/market'/fresh
+        old=json.loads((rp/'spec.original.json').read_text())
+        new=json.loads((rp/'spec.test.json').read_text())
+        schema=resolved(old,old['paths']['/customer/contacts']['put']['parameters'][0]['schema'])
+        validator=jsonschema.Draft4Validator(schema)
+        ns=new['paths']['/customer/contacts']['put']['parameters'][0]['schema']
+        assert ns['required']==['_links','address','phone']
+        assert ns['properties']['phone']['maxLength']==1
+        for run in (fresh,base):
+            violations,good=[],[]
+            with (ROOT/'08_experiments/E1_pilot/runs/market'/run/'exchanges.jsonl').open() as f:
+                for n,line in enumerate(f,1):
+                    ex=json.loads(line)
+                    q=ex['request']
+                    if q['method']!='PUT' or q['path']!='/customer/contacts':
+                        continue
+                    try:
+                        body=json.loads(q['body']['text'])
+                    except (ValueError,KeyError):
+                        continue
+                    if not isinstance(body,dict) or not validator.is_valid(body):
+                        continue
+                    if len(body.get('phone',''))>1 or len(body.get('address',''))>1:
+                        violations.append(n)
+                        if 200<=ex['response']['status']<300:
+                            assert '_links' not in body
+                            good.append(n)
+                        if run==fresh:
+                            assert isinstance(body['_links'],list)
+                            assert next(iter(body))=='_links'
+                            assert ex['response']['status']==500
+                            text=ex['response']['body']['text']
+                            assert all(v in text for v in ('Expected relation name','com.fasterxml.jackson.databind.JsonMappingException','market.dto.ContactsDTO','_links'))
+            if run==fresh:
+                assert len(violations)==expected_fresh and not good
+            else:
+                assert len(good)==expected_good
+            rows.append({'run':run,'direct_body_length_violations':len(violations),
+                         'accepted_length_violations':len(good),'first_violation_line':violations[0]})
+    hashes=json.loads((OUT/'protected_sha256.json').read_text())
+    mismatches=[p for p,digest in hashes.items() if hashlib.sha256((ROOT/p).read_bytes()).hexdigest()!=digest]
+    assert not mismatches
+    # Search output files for fixture header values, encoded tokens, and decoded components.
+    # Values are only held in memory and are never written or printed.
+    fixture=yaml.safe_load((EMB/'auth/market-auth.yaml').read_text())
+    secrets=set()
+    for role in fixture['auth']:
+        for h in role.get('fixedHeaders',[]):
+            v=h.get('value','')
+            if not isinstance(v,str) or not v:
+                continue
+            secrets.add(v)
+            if v.lower().startswith('basic '):
+                token=v.split(' ',1)[1]
+                secrets.add(token)
+                decoded=base64.b64decode(token).decode()
+                secrets.add(decoded)
+                secrets.update(s for s in decoded.split(':') if len(s)>=6)
+    targets=[p for p in OUT.iterdir() if p.is_file()]+[ROOT/'09_collab/reports/T35_report.md']
+    secret_hits=[]
+    for p in targets:
+        if p.exists() and any(v in p.read_text() for v in secrets):
+            secret_hits.append(str(p.relative_to(ROOT)))
+    assert not secret_hits
+    result={'independent_recount':rows,'protected_files_checked':len(hashes),
+            'protected_hash_mismatches':mismatches,'secret_scan_files':sum(p.exists() for p in targets),
+            'secret_scan_hit_files':secret_hits,'execution':'offline Python only; no Java/class execution',
+            'total_exchanges':sum(x['total'] for x in json.loads((OUT/'traffic_summary.json').read_text()))}
+    (OUT/'verification.json').write_text(json.dumps(result,indent=2)+'\n')
+    print(json.dumps(result,indent=2))
+
+
+if __name__=='__main__':
+    main()
