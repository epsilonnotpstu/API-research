    43	
    44		/**
    45		 * Updating contacts.
    46		 *
    47		 * @return updated contacts
    48		 */
    49		@PutMapping
    50		public ContactsDTO updateContacts(Principal principal, @RequestBody @Valid ContactsDTO contactsDto) {
    51			String login = principal.getName();
    52			Contacts changedContacts = contactsDtoAssembler.toDomain(contactsDto);
    53			contactsService.updateUserContacts(changedContacts, login);
    54			return toDto(changedContacts);
