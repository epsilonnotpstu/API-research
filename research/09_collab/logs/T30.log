   137	def metrics(rows, manifest, excluded_ops=()):
   138	    result = {key:0 for key in METRICS}
   139	    expected = set(manifest['expected_conformance_signal'])
   140	    ops = {(o['method'].upper(),o['path']) for o in manifest['operations']}
   141	    signal_new = signal_inc = 0; present = False; l1 = Counter(); seen = set()
   142	    for row in rows:
   143	        if (row['method'],row['template']) in excluded_ops: continue
   144	        c.require(row['fingerprint'] not in seen, 'Duplicate attributed fingerprint'); seen.add(row['fingerprint'])
   145	        c.require(row['mode'] == 'fresh' and row['status'] in ('NEW','VANISHED','PERSISTENT'), 'Non-fresh/unknown status')
   146	        before, after = int(row['baseline_occurrences']), int(row['mutated_occurrences'])
   147	        c.require(before >= 0 and after >= 0, 'Negative occurrences')
   148	        c.require((before == 0 and after > 0) if row['status'] == 'NEW' else
   149	                  (before > 0 and after == 0) if row['status'] == 'VANISHED' else (before > 0 and after > 0), 'Status/count mismatch')
   150	        mapped = (row['method'], row['template']) in ops
   151	        c.require(row['op_mutated'] == str(mapped), 'Affected-operation flag differs from manifest')
   152	        scope = 'mutated' if mapped else 'non_mutated'
   153	        direction = row['status'] if row['status'] != 'PERSISTENT' else ('INCREASED' if after > before else 'DECREASED' if after < before else None)
   154	        if direction: result[scope + '_' + direction] += 1
   155	        if mapped and row['status'] == 'NEW': l1[row['label_L1']] += 1
   156	        if mapped and row['kind'] in expected:
   157	            present |= after > 0
   158	            signal_new += row['status'] == 'NEW'
   159	            signal_inc += direction == 'INCREASED'
   160	    result.update(expected_signals=json.dumps(sorted(expected)), expected_signal_observed=bool(signal_new or signal_inc),
   161	                  expected_signal_present_mutant=present, expected_signal_NEW=signal_new, expected_signal_INCREASED=signal_inc,
   162	                  fresh_L1_NEW_mutated=json.dumps(dict(sorted(l1.items()))), triage_status='NOT_APPLICABLE_P001_CLI',
   163	                  triage_L1_NEW_mutated='', causal_kill_status='NEEDS_INDEPENDENT_WITNESS')
