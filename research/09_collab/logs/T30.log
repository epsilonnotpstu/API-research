+                if (value['method'].upper(),value['template']) not in excluded:
+                    data[role].append(value)
+    rows = load_attribute().attribute(data['control'], data[second], manifest, mode='fresh')
+    return [{k:str(v) for k,v in row.items()} for row in rows]
