+    assert 'exec 8<"$HERE/../harness/.run.lock"' in common
+    run = (HERE / "run_pilot.sh").read_text()
+    for marker in ('SCHEMA_CHECKS', '--request-timeout', 'explicit,generate', 'acquire_run_lock',
