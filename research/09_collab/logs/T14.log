--- /dev/null
+++ b/research/08_experiments/E1_pilot/harness_v2/common.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+# Trusted, non-secret configuration shared by the v2 scripts.
+load_sut() {
+    case ${1:-} in scout-api|swagger-petstore|market) ;; *) echo 'Unsupported SUT' >&2; return 2;; esac
+    # Only checked-in configurations from the allowlist are sourced.
+    source "$HERE/suts/$1.env"
+    export EMB_DIR="$EXP/_external/emb" TOOLS_DIR="$EXP/tools"
+    export SUT_ID SUT_SERVICE INTERNAL_PORT SUT_IMAGE COMPOSE_FILE DOCKERFILE
+    export JAR_SOURCE SPEC_SOURCE AUTH_SOURCE
+    export HEALTH_PATH=${HEALTH_PATH:-$HEALTH_PATH_DEFAULT}
+    export BASE_PATH=${BASE_PATH:-$BASE_PATH_DEFAULT}
+    export PILOT_AUTH_ROLE=${AUTH_ROLE:-$AUTH_ROLE_DEFAULT}
+    # These interpolate into the original EMB Compose port declarations.
+    export HOST_PORT=127.0.0.1:18080 JACOCO_PORT=127.0.0.1:16300
+}
+
+acquire_run_lock() {
+    exec 9>"$HERE/.run.lock"
+    flock -n 9 || { echo 'Another v2 pilot/preparation is running' >&2; return 1; }
+    # Share the existing v1 lock without writing or truncating any v1 file.
+    if [[ -f $HERE/../harness/.run.lock ]]; then
+        exec 8<"$HERE/../harness/.run.lock"
+        flock -n 8 || { echo 'The v1 pilot is running; retry after it finishes' >&2; return 1; }
+    fi
+}
diff --git a/research/08_experiments/E1_pilot/harness_v2/derecurse.py b/research/08_experiments/E1_pilot/harness_v2/derecurse.py
new file mode 100644
index 0000000000000000000000000000000000000000..9230cbef0ae15684f1bf41bf48ee08bddecddf46
--- /dev/null
+++ b/research/08_experiments/E1_pilot/harness_v2/derecurse.py
@@ -0,0 +1,70 @@
+"""Cut schema-reference DFS back edges in a COPY used only for generation.
+
+Supports Swagger definitions and OpenAPI components/schemas, including both
+namespaces in one document and escaped schema names. External refs and refs to
+non-schema components are left intact. Conformance must use the original spec.
+"""
+import copy
+import json
+from pathlib import Path
+import sys
+
+
+def escape(value):
+    return str(value).replace("~", "~0").replace("/", "~1")
+
+
+def derecurse(document):
+    spec = copy.deepcopy(document)
+    schemas = {}
+    for prefix, group in (
+        ("#/definitions/", spec.get("definitions", {})),
+        ("#/components/schemas/", spec.get("components", {}).get("schemas", {})),
+    ):
+        for name, schema in group.items():
+            schemas[prefix + escape(name)] = schema
+    state, cuts = {}, []
+
+    def walk(node, location):
+        if isinstance(node, dict):
+            ref = node.get("$ref")
+            if isinstance(ref, str) and ref in schemas:
+                if state.get(ref) == "active":
+                    # Preserve the existing harness's object replacement policy.
+                    node.clear()
+                    node.update({"type": "object", "x-derecursed-from": ref})
+                    cuts.append({"in": location, "ref": ref})
+                    return
+                visit(ref)
+            # Siblings can themselves contain recursive refs (notably OAS 3.1).
+            for key, value in node.items():
+                walk(value, location + "/" + escape(key))
+        elif isinstance(node, list):
+            for index, value in enumerate(node):
+                walk(value, location + "/" + str(index))
+
+    def visit(ref):
+        if state.get(ref) == "done":
+            return
+        state[ref] = "active"
+        walk(schemas[ref], ref)
+        state[ref] = "done"
+
+    for ref in sorted(schemas):
+        visit(ref)
+    return spec, cuts
+
+
+def main(src, dst):
+    result, cuts = derecurse(json.loads(Path(src).read_text(encoding="utf-8")))
+    # Exclusive creation prevents accidental replacement of a generator snapshot.
+    with Path(dst).open("x", encoding="utf-8") as stream:
+        json.dump(result, stream, indent=2)
+        stream.write("\n")
+    print(json.dumps(cuts))
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 3:
+        raise SystemExit("Usage: derecurse.py IN.json OUT.json")
+    main(*sys.argv[1:])
