     1	"""Cut schema-reference DFS back edges in a COPY used only for generation.
     2	
     3	Supports Swagger definitions and OpenAPI components/schemas, including both
     4	namespaces in one document and escaped schema names. External refs and refs to
     5	non-schema components are left intact. Conformance must use the original spec.
     6	"""
     7	import copy
     8	import json
     9	from pathlib import Path
    10	import sys
    11	
    12	
    13	def escape(value):
    14	    return str(value).replace("~", "~0").replace("/", "~1")
    15	
    16	
    17	def derecurse(document):
    18	    spec = copy.deepcopy(document)
    19	    schemas = {}
    20	    for prefix, group in (
    21	        ("#/definitions/", spec.get("definitions", {})),
    22	        ("#/components/schemas/", spec.get("components", {}).get("schemas", {})),
    23	    ):
    24	        for name, schema in group.items():
    25	            schemas[prefix + escape(name)] = schema
    26	    state, cuts = {}, []
    27	
    28	    def walk(node, location):
    29	        if isinstance(node, dict):
    30	            ref = node.get("$ref")
    31	            if isinstance(ref, str) and ref in schemas:
    32	                if state.get(ref) == "active":
    33	                    # Preserve the existing harness's object replacement policy.
    34	                    node.clear()
    35	                    node.update({"type": "object", "x-derecursed-from": ref})
    36	                    cuts.append({"in": location, "ref": ref})
    37	                    return
    38	                visit(ref)
    39	            # Siblings can themselves contain recursive refs (notably OAS 3.1).
    40	            for key, value in node.items():
    41	                walk(value, location + "/" + escape(key))
    42	        elif isinstance(node, list):
    43	            for index, value in enumerate(node):
    44	                walk(value, location + "/" + str(index))
    45	
    46	    def visit(ref):
    47	        if state.get(ref) == "done":
    48	            return
    49	        state[ref] = "active"
    50	        walk(schemas[ref], ref)
    51	        state[ref] = "done"
    52	
    53	    for ref in sorted(schemas):
    54	        visit(ref)
    55	    return spec, cuts
    56	
    57	
    58	def main(src, dst):
