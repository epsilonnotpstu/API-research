diff --git a/research/08_experiments/E1_pilot/harness_v2/static_validate.py b/research/08_experiments/E1_pilot/harness_v2/static_validate.py
new file mode 100644
index 0000000000000000000000000000000000000000..b1f6ee9b5e3da099e31f9bab1677d8de7b561ec1
--- /dev/null
+++ b/research/08_experiments/E1_pilot/harness_v2/static_validate.py
@@ -0,0 +1,144 @@
+"""T14 static validation and the explicitly permitted stdlib derecurse tests.
+
+No harness scripts, third-party project code, Docker, Java, network, or SUT
+commands are executed. Run from any directory with /usr/bin/python3 -I -B.
+"""
+import ast
+import datetime
+import hashlib
+import json
+from pathlib import Path
+import re
+import subprocess
+import sys
+
+import yaml
+
+HERE = Path(__file__).resolve().parent
+EXP = HERE.parents[1]
+EMB = EXP / "_external" / "emb"
+SUTS = ("scout-api", "swagger-petstore", "market")
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    print("T14 validation:", datetime.datetime.now(datetime.timezone.utc).isoformat(), flush=True)
+    for path in sorted(HERE.glob("*.sh")):
+        subprocess.run(["bash", "-n", str(path)], check=True)
+        source = path.read_text()
+        if path.name != "common.sh":
+            assert "set -euo pipefail" in source, path.name
+            assert path.stat().st_mode & 0o111, path.name
+        for code in re.findall(r"<<'PY'\n(.*?)^PY$", source, re.M | re.S):
+            ast.parse(code, filename=path.name + ":heredoc")
+        for code in re.findall(r" -c '([^']*)'", source):
+            ast.parse(code, filename=path.name + ":inline")
+        assert not re.search(r"docker\s+(?:system|container|image|volume)\s+prune", source)
+        assert not re.search(r"(?:pip\s+install|curl[^\n]+\|\s*(?:bash|sh))", source)
+        print("PASS SHELL/INLINE_AST", path.name, flush=True)
+    for path in sorted(HERE.glob("*.py")):
+        ast.parse(path.read_text(), filename=path.name)
+        print("PASS PYTHON_AST", path.name, flush=True)
+
+    fixture_values = set()
+    fixture_tokens = set()
+    public_roles = set()
+    for sut in SUTS:
+        path = HERE / "suts" / f"{sut}.env"
+        config = dict(line.split("=", 1) for line in path.read_text().splitlines()
+                      if line and not line.startswith("#"))
+        assert config["SUT_ID"] == sut
+        assert config["SUT_IMAGE"] == f"r1-{sut}-sut:pilot"
+        assert config["SUT_SERVICE"] == f"sut-{sut}"
+        assert config["INTERNAL_PORT"] == "8080"
+        for key in ("HEALTH_PATH_DEFAULT", "BASE_PATH_DEFAULT"):
+            assert config[key].startswith("/")
+        for key in ("JAR_SOURCE", "COMPOSE_FILE", "DOCKERFILE", "SPEC_SOURCE"):
+            assert (EMB / config[key]).is_file(), (sut, key)
+        assert (EMB / config["JAR_SOURCE"]).stat().st_size > 0
+        original = yaml.safe_load((EMB / config["COMPOSE_FILE"]).read_text())
+        override = yaml.safe_load((HERE / f"compose.override.{sut}.yaml").read_text())
+        service = override["services"][config["SUT_SERVICE"]]
+        proxy = override["services"]["mitmproxy"]
+        assert service["image"] == config["SUT_IMAGE"]
+        assert service["build"]["dockerfile"] == config["DOCKERFILE"]
+        assert service["build"]["context"] == "${EMB_DIR:?Set EMB_DIR}"
+        assert proxy["entrypoint"] == ["mitmdump"]
+        assert f"reverse:http://{config['SUT_SERVICE']}:8080" in proxy["command"]
+        assert proxy["environment"]["MITM_FULLLOG_FILE"] == "exchanges.jsonl"
+        # This validates the port interpolation inputs, not Docker's merge engine.
+        assert original["services"]["mitmproxy"]["ports"] == ["${HOST_PORT:-8080}:8080"]
+        assert original["services"][config["SUT_SERVICE"]]["ports"] == ["${JACOCO_PORT:-6300}:6300"]
+        assert all("ports" not in entry for entry in override["services"].values())
+        spec = json.loads((EMB / config["SPEC_SOURCE"]).read_text())
+        count = sum(method in {"get", "put", "post", "delete", "patch", "head", "options", "trace"}
+                    for item in spec["paths"].values() for method in item)
+        if config["AUTH_ROLE_DEFAULT"] != "none":
+            auth = yaml.safe_load((EMB / config["AUTH_SOURCE"]).read_text())
+            selected = [role for role in auth["auth"] if role["name"] == config["AUTH_ROLE_DEFAULT"]]
+            assert len(selected) == 1 and len(selected[0]["fixedHeaders"]) == 1
+            assert selected[0]["fixedHeaders"][0]["name"].lower() == "authorization"
+            for role in auth["auth"]:
+                public_roles.add(role["name"])
+                for header in role.get("fixedHeaders", []):
+                    value = header["value"]
+                    fixture_values.add(value)
+                    fixture_tokens.add(value.split(" ", 1)[-1])
+        else:
+            assert config["AUTH_SOURCE"] == ""
+            assert not (EMB / "auth" / f"{sut}-auth.yaml").exists()
+        print(f"PASS CONFIG:{sut} jar/paths/YAML/proxy/auth-shape; declared_operations={count}; "
+              f"spec_version={spec.get('swagger', spec.get('openapi'))}", flush=True)
+
+    common = (HERE / "common.sh").read_text()
+    assert "HOST_PORT=127.0.0.1:18080 JACOCO_PORT=127.0.0.1:16300" in common
+    assert 'exec 8<"$HERE/../harness/.run.lock"' in common
+    run = (HERE / "run_pilot.sh").read_text()
+    for marker in ('SCHEMA_CHECKS', '--request-timeout', 'explicit,generate', 'acquire_run_lock',
+                   'mkdir "$run_dir"', '--no-build', 'derecurse.py" "$original_spec"',
+                   'mutation_gen', 'Generator mutation selected different operations',
+                   'redact_auth.py', 'run_metadata.py', 'jacococli.jar'):
+        assert marker in run, marker
+    batch = (HERE / "run_batch.sh").read_text()
+    assert 'PILOT_RUN_ID="$id"' in batch and 'baseline=$LAST_RUN' in batch
+    analysis = (HERE / "analyse_run.sh").read_text()
+    for marker in ('schema_checks', 'harness_sha256', 'auth_source', 'r["sut"]',
+                   'Current tool differs', 'generator-input.json', 'mkdir "$analysis"'):
+        assert marker in analysis, marker
+    print("PASS PRESERVED_FIXES loopback/locks/image-reuse/de-recursion/checks/timeout/no-shrink/provenance/exclusive-output", flush=True)
+
+    snapshot = json.loads((HERE / "source-harness-sha256.json").read_text())
+    for name, expected in snapshot.items():
+        assert digest(HERE.parent / "harness" / name) == expected, name
+    print(f"PASS SOURCE_HARNESS_UNCHANGED {len(snapshot)} original file digests", flush=True)
+    # Public role identifiers are explicitly required in these non-secret configs.
+    # Do not mistake a plain role identifier for a copied Authorization header.
+    fixture_values.update(fixture_tokens - public_roles)
+    outputs = list(HERE.rglob("*"))
+    report = EXP.parent / "09_collab" / "reports" / "T14_report.md"
+    if report.exists():
+        outputs.append(report)
+    for path in outputs:
+        if path.is_file():
+            data = path.read_bytes()
+            assert not any(value.encode() in data for value in fixture_values if value), path.name
+    print("PASS SECRET_ABSENCE no EMB full fixed-header values or non-role tokens in v2 artifacts; "
+          "public role identifiers permitted; values withheld", flush=True)
+    print("BEGIN DERECURSE UNIT TESTS", flush=True)
+    subprocess.run(["/usr/bin/python3", "-I", "-B", str(HERE / "test_derecurse.py")],
+                   check=True, stderr=subprocess.STDOUT)
+    print("PASS ALL STATIC CHECKS AND PERMITTED UNIT TESTS", flush=True)
+    print("NOT EXECUTED: harness orchestration, Docker, Compose, Java, Schemathesis, SUTs, "
+          "network/downloads, builds, dependency installs, tool-pipeline execution.", flush=True)
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except Exception:
+        # Keep fixture/parser exceptions from echoing input credential values.
+        print("FAIL STATIC VALIDATION; inspect this validator and the last completed check", file=sys.stderr)
+        raise SystemExit(1) from None
diff --git a/research/08_experiments/E1_pilot/harness_v2/test_derecurse.py b/research/08_experiments/E1_pilot/harness_v2/test_derecurse.py
new file mode 100644
index 0000000000000000000000000000000000000000..f21db102b5751387cddc8c77bee29be9f8696e9c
--- /dev/null
+++ b/research/08_experiments/E1_pilot/harness_v2/test_derecurse.py
@@ -0,0 +1,121 @@
+"""Standard-library regression tests; no generator, Docker, or SUT execution."""
+import copy
+import importlib.util
+import json
+from pathlib import Path
+import unittest
+
+HERE = Path(__file__).resolve().parent
+MODULE_SPEC = importlib.util.spec_from_file_location("derecurse_v2", HERE / "derecurse.py")
+MODULE = importlib.util.module_from_spec(MODULE_SPEC)
+MODULE_SPEC.loader.exec_module(MODULE)
+derecurse = MODULE.derecurse
+
+
+def schema_spec(group, oas3=False):
+    header = {"openapi": "3.0.4", "components": {"schemas": group}} if oas3 else {
+        "swagger": "2.0", "definitions": group}
+    header["paths"] = {"/things": {"get": {"responses": {"200": {"description": "OK"}}}}}
+    return header
+
+
+class DerecurseTests(unittest.TestCase):
+    def assert_stable(self, original, expected_cuts):
+        snapshot = copy.deepcopy(original)
+        output, cuts = derecurse(original)
+        self.assertEqual(original, snapshot, "caller document was modified")
+        self.assertEqual(len(cuts), expected_cuts)
+        self.assertEqual(output["paths"], original["paths"])
+        again, again_cuts = derecurse(output)
+        self.assertEqual(again, output)
+        self.assertEqual(again_cuts, [], "a supported cycle remains")
+        self.assertEqual(derecurse(original), (output, cuts), "nondeterministic output")
+        return output, cuts
+
+    def test_swagger_self_cycle(self):
+        source = schema_spec({"Node": {"type": "object", "properties": {
+            "next": {"$ref": "#/definitions/Node"}}}})
+        output, cuts = self.assert_stable(source, 1)
+        self.assertEqual(cuts[0]["in"], "#/definitions/Node/properties/next")
+        self.assertEqual(output["definitions"]["Node"]["properties"]["next"], {
+            "type": "object", "x-derecursed-from": "#/definitions/Node"})
+
+    def test_oas3_mutual_cycle(self):
+        output, cuts = self.assert_stable(schema_spec({
+            "A": {"properties": {"b": {"$ref": "#/components/schemas/B"}}},
+            "B": {"properties": {"a": {"$ref": "#/components/schemas/A"}}},
+        }, True), 1)
+        self.assertEqual(cuts[0]["ref"], "#/components/schemas/A")
+        self.assertEqual(output["components"]["schemas"]["A"]["properties"]["b"], {
+            "$ref": "#/components/schemas/B"})
+
+    def test_three_node_cycle_in_array_and_composition(self):
+        self.assert_stable(schema_spec({
+            "A": {"allOf": [{"$ref": "#/components/schemas/B"}]},
+            "B": {"type": "array", "items": {"$ref": "#/components/schemas/C"}},
+            "C": {"additionalProperties": {"$ref": "#/components/schemas/A"}},
+        }, True), 1)
+
+    def test_acyclic_shared_reference_is_unchanged(self):
+        source = schema_spec({
+            "A": {"allOf": [{"$ref": "#/definitions/Leaf"}, {"$ref": "#/definitions/Leaf"}]},
+            "B": {"$ref": "#/definitions/Leaf"}, "Leaf": {"type": "string"},
+        })
+        output, _ = self.assert_stable(source, 0)
+        self.assertEqual(output, source)
+
+    def test_escaped_schema_names(self):
+        _, cuts = self.assert_stable(schema_spec({"A/B~C": {"$ref": "#/components/schemas/A~1B~0C"}}, True), 1)
+        self.assertEqual(cuts[0]["in"], "#/components/schemas/A~1B~0C")
+
+    def test_both_schema_namespaces_are_processed(self):
+        source = schema_spec({"Node": {"$ref": "#/definitions/Node"}}, True)
+        source["definitions"] = {"Node": {"$ref": "#/definitions/Node"}}
+        # The OAS schema points across namespaces; only the real back edge is cut.
+        output, _ = self.assert_stable(source, 1)
+        self.assertEqual(output["components"]["schemas"]["Node"], {"$ref": "#/definitions/Node"})
+
+    def test_equal_basenames_do_not_alias(self):
+        source = schema_spec({"Node": {"properties": {
+            "parameter": {"$ref": "#/components/parameters/Node"}}}}, True)
+        source["components"]["parameters"] = {"Node": {"name": "q", "in": "query"}}
+        self.assertEqual(self.assert_stable(source, 0)[0], source)
+
+    def test_independent_cycles_in_both_namespaces(self):
+        source = schema_spec({"Node": {"$ref": "#/components/schemas/Node"}}, True)
+        source["definitions"] = {"Node": {"$ref": "#/definitions/Node"}}
+        self.assert_stable(source, 2)
+
+    def test_external_and_dangling_refs_are_untouched(self):
+        source = schema_spec({"Node": {"allOf": [
+            {"$ref": "other.json#/definitions/Node"}, {"$ref": "#/definitions/Absent"}]}})
+        self.assertEqual(self.assert_stable(source, 0)[0], source)
+
+    def test_schema_ref_siblings_are_walked(self):
+        source = schema_spec({"A": {"$ref": "#/components/schemas/B", "properties": {
+            "next": {"$ref": "#/components/schemas/A"}}}, "B": {"type": "object"}}, True)
+        _, cuts = self.assert_stable(source, 1)
+        self.assertEqual(cuts[0]["in"], "#/components/schemas/A/properties/next")
+
+    def test_independent_cycles(self):
+        self.assert_stable(schema_spec({
+            "A": {"$ref": "#/definitions/A"}, "B": {"$ref": "#/definitions/B"}}), 2)
+
+    def test_spec_without_schema_components(self):
+        source = {"openapi": "3.0.4", "paths": {}}
+        self.assertEqual(self.assert_stable(source, 0)[0], source)
+
+    def test_actual_sut_documents_static_transform(self):
+        emb = HERE.parents[1] / "_external" / "emb"
+        for sut in ("scout-api", "swagger-petstore", "market"):
+            with self.subTest(sut=sut):
+                source = json.loads((emb / "openapi-swagger" / f"{sut}.json").read_text())
+                output, cuts = derecurse(source)
+                self.assert_stable(source, len(cuts))
+                self.assertEqual(output["paths"], source["paths"])
+                if sut == "scout-api":
+                    self.assertGreater(len(cuts), 0, "scout regression fixture lost its cycles")
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
diff --git a/research/09_collab/reports/T14_report.md b/research/09_collab/reports/T14_report.md
new file mode 100644
index 0000000000000000000000000000000000000000..8117c0a41761c40c2cec42f23c6b9a2542a3865c
--- /dev/null
+++ b/research/09_collab/reports/T14_report.md
@@ -0,0 +1,77 @@
+# T14 — Multi-SUT harness v2: হস্তান্তর প্রতিবেদন
+
+## কাজের পরিধি ও অবস্থা
+
+T14-এর write-only deliverable প্রস্তুত: `scout-api`, `swagger-petstore`, ও `market`-এর জন্য নতুন `harness_v2/`, per-SUT config, generalized preparation/run/batch/analysis, OpenAPI 3 derecursion ও unit tests, exact execution commands এবং প্রথম execution-এর যাচাইতালিকা। এটি script/static-validation পর্যায়ের সমাপ্তি; নতুন SUT execution-এর ফল দাবি করা হচ্ছে না। প্রমাণ: `09_collab/tasks/T14.md:1–20`; `08_experiments/E1_pilot/harness_v2/README.md:1–97`; `08_experiments/E1_pilot/harness_v2/static_checks.txt:2–39`।
