"""Break $ref cycles in a Swagger 2.0 / OpenAPI 3 spec for the *generator input only*.

Recursive schemas (e.g. scout-api: Activity <-> ActivityProperties) make
Schemathesis/hypothesis-jsonschema data generation stall for minutes per
operation. A back-edge $ref found by DFS over the definitions is replaced with
an unconstrained object. Conformance checking always uses the untouched spec.

Usage: python3 derecurse.py IN.json OUT.json   (prints the cut edges as JSON)
"""
import json
import sys


def main(src, dst):
    spec = json.load(open(src, encoding='utf-8'))
    defs = spec.get('definitions') or spec.get('components', {}).get('schemas') or {}
    cuts = []

    def walk(node, stack, where):
        if isinstance(node, dict):
            ref = node.get('$ref')
            if isinstance(ref, str) and ref.startswith('#/'):
                name = ref.rsplit('/', 1)[-1]
                if name in stack:  # back edge: cut here
                    node.clear()
                    node.update({'type': 'object', 'x-derecursed-from': ref})
                    cuts.append({'in': where, 'ref': ref})
                return
            for key, value in node.items():
                walk(value, stack, where)
        elif isinstance(node, list):
            for value in node:
                walk(value, stack, where)

    def visit(name, stack):
        walk(defs[name], stack + [name], name)
        # descend into remaining (non-cut) refs
        for ref_name in sorted(refs(defs[name])):
            if ref_name in defs and ref_name not in stack + [name]:
                visit(ref_name, stack + [name])

    def refs(node, acc=None):
        acc = set() if acc is None else acc
        if isinstance(node, dict):
            if isinstance(node.get('$ref'), str):
                acc.add(node['$ref'].rsplit('/', 1)[-1])
            for value in node.values():
                refs(value, acc)
        elif isinstance(node, list):
            for value in node:
                refs(value, acc)
        return acc

    for name in sorted(defs):
        visit(name, [])
    json.dump(spec, open(dst, 'w', encoding='utf-8'), indent=2)
    print(json.dumps(cuts))


if __name__ == '__main__':
    main(*sys.argv[1:3])
"""Redact the runtime benchmark credential from streaming and saved artifacts."""
import os
from pathlib import Path
import sys


def secrets():
    header = os.environ.get('PILOT_AUTH_REDACT', '')
    value = header.partition(':')[2].strip()
    token = value.split(' ', 1)[-1]
    return sorted({s for s in (header, value, token) if s}, key=len, reverse=True)


def clean(data, needles):
    for needle in needles:
        data = data.replace(needle.encode(), b'<redacted>')
    return data


def main():
    needles = secrets()
    if len(sys.argv) == 1:
        for line in sys.stdin.buffer:
            sys.stdout.buffer.write(clean(line, needles))
            sys.stdout.buffer.flush()
        return
    directory = Path(sys.argv[1])
    for path in directory.rglob('*'):
        if not path.is_file() or path.suffix == '.exec':
            continue
        data = path.read_bytes()
        redacted = clean(data, needles)
        if redacted != data:
            path.write_bytes(redacted)


if __name__ == '__main__':
    main()
# Paths are absolute env substitutions: independent of Compose's first-file directory.
services:
  sut-scout-api:
    # Fixed tag: built once, reused by every run so image IDs stay comparable.
    image: r1-scout-sut:pilot
    build:
      context: ${EMB_DIR:?Set EMB_DIR}
      dockerfile: dockerfiles/scout-api.dockerfile
  mitmproxy:
    user: "${PILOT_UID:?Set PILOT_UID}:${PILOT_GID:?Set PILOT_GID}"
    environment:
      MITM_LOG_DIR: /custom-logs
      MITM_FULLLOG_FILE: exchanges.jsonl
      MITM_MAX_BODY: ${MITM_MAX_BODY:-65536}
    # The image entrypoint runs usermod, which fails for a non-root user; call mitmdump directly.
    entrypoint: ["mitmdump"]
    command:
      - --mode
      - reverse:http://sut-scout-api:8080
      - --listen-host
      - 0.0.0.0
      - --listen-port
      - "8080"
      - --set
      - keep_host_header=true
      - --set
      - confdir=/tmp/mitmproxy
      - -s
      - /addons/mitm_fulllog.py
    volumes:
      - ${PILOT_LOG_DIR:?Set PILOT_LOG_DIR}:/custom-logs
      - ${TOOLS_DIR:?Set TOOLS_DIR}:/addons:ro
"""Write atomic, standard-library-only provenance for a pilot (called by run_pilot.sh)."""
import datetime
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() else None


def main():
    (run, emb, sut, source, mode, fault, severity, seed, budget, examples, image,
     project, started, phase, schema_rc, coverage_rc, cleanup_rc, harness_rc,
     health, base_path) = sys.argv[1:]
    run, emb = Path(run), Path(emb)
    commit = subprocess.check_output(['git', '-C', str(emb), 'rev-parse', 'HEAD'], text=True).strip()
    dirty = subprocess.check_output(['git', '-C', str(emb), 'status', '--porcelain'], text=True)
    images = {}
    for path in sorted(run.glob('*-image.json')):
        try:
            inspected = json.loads(path.read_text())[0]
            images[path.stem] = {'id': inspected['Id'], 'repo_digests': inspected.get('RepoDigests', []),
                                'repo_tags': inspected.get('RepoTags', [])}
        except (ValueError, IndexError, KeyError) as error:
            images[path.stem] = {'inspection_error': str(error)}
    files = {p.name: sha(p) for p in sorted(run.iterdir())
             if p.is_file() and p.name != 'run.json' and not p.name.endswith('.tmp')}
    data = {
        'run_id': run.name, 'sut': sut, 'source_spec': source,
        'source_sha256': sha(next(run.glob('spec.original.*'), Path(source))),
        'mode': mode, 'fault': fault, 'severity': int(severity), 'seed': int(seed),
        'budget_seconds': int(budget), 'max_examples': int(examples),
        'schemathesis_image': image, 'compose_project': project,
        'started_at': started, 'updated_at': datetime.datetime.now(datetime.timezone.utc).isoformat(),
        'finished_at': None if harness_rc == 'pending' else datetime.datetime.now(datetime.timezone.utc).isoformat(),
        'phase': phase, 'schemathesis_exit': schema_rc, 'coverage_exit': coverage_rc,
        'cleanup_exit': cleanup_rc, 'harness_exit': harness_rc,
        'complete': harness_rc == '0', 'emb_commit': commit, 'emb_status_porcelain': dirty,
        'health_path': health, 'base_path': base_path, 'auth': os.environ.get('PILOT_AUTH_ROLE', 'none (pilot assumption)'),
        'request_timeout_ms': int(os.environ.get('PILOT_REQUEST_TIMEOUT_MS', '10000')),
        'hypothesis_phases': os.environ.get('PILOT_HYPOTHESIS_PHASES', 'explicit,generate'),
        'logger_max_body': int(os.environ['MITM_MAX_BODY']),
        'host_port': os.environ['HOST_PORT'], 'jacoco_port': os.environ['JACOCO_PORT'],
        'sut_jar_sha256': sha(emb / 'dist' / f'{sut}-sut.jar'),
        'jacoco_agent_sha256': sha(emb / 'dist' / 'jacocoagent.jar'),
        'jacoco_cli_sha256': sha(emb / 'dist' / 'jacococli.jar'),
        'images': images, 'file_sha256': files,
        'tool_sha256': {p.name: sha(p) for p in sorted((emb.parent.parent / 'tools').glob('*.py'))},
        'harness_sha256': {p.name: sha(p) for p in sorted(Path(__file__).parent.iterdir()) if p.is_file() and not p.name.startswith('.')},
        'limitations': ['fresh traffic is observational', 'fixed seed does not guarantee identical traffic',
                         'transport-error and truncation coverage require review',
                         'locally built SUT may have only image ID, no registry digest'],
    }
    tmp = run / 'run.json.tmp'
    tmp.write_text(json.dumps(data, indent=2) + '\n')
    tmp.replace(run / 'run.json')


if __name__ == '__main__':
    main()
