diff --git a/research/08_experiments/E1_pilot/harness_v2/test_derecurse.py b/research/08_experiments/E1_pilot/harness_v2/test_derecurse.py
new file mode 100644
index 0000000000000000000000000000000000000000..f21db102b5751387cddc8c77bee29be9f8696e9c
--- /dev/null
+++ b/research/08_experiments/E1_pilot/harness_v2/test_derecurse.py
@@ -0,0 +1,121 @@
+"""Standard-library regression tests; no generator, Docker, or SUT execution."""
+import copy
+import importlib.util
+import json
+from pathlib import Path
+import unittest
+
+HERE = Path(__file__).resolve().parent
+MODULE_SPEC = importlib.util.spec_from_file_location("derecurse_v2", HERE / "derecurse.py")
+MODULE = importlib.util.module_from_spec(MODULE_SPEC)
+MODULE_SPEC.loader.exec_module(MODULE)
+derecurse = MODULE.derecurse
+
+
+def schema_spec(group, oas3=False):
+    header = {"openapi": "3.0.4", "components": {"schemas": group}} if oas3 else {
+        "swagger": "2.0", "definitions": group}
+    header["paths"] = {"/things": {"get": {"responses": {"200": {"description": "OK"}}}}}
+    return header
+
+
+class DerecurseTests(unittest.TestCase):
+    def assert_stable(self, original, expected_cuts):
+        snapshot = copy.deepcopy(original)
+        output, cuts = derecurse(original)
+        self.assertEqual(original, snapshot, "caller document was modified")
+        self.assertEqual(len(cuts), expected_cuts)
+        self.assertEqual(output["paths"], original["paths"])
+        again, again_cuts = derecurse(output)
+        self.assertEqual(again, output)
+        self.assertEqual(again_cuts, [], "a supported cycle remains")
+        self.assertEqual(derecurse(original), (output, cuts), "nondeterministic output")
+        return output, cuts
+
+    def test_swagger_self_cycle(self):
+        source = schema_spec({"Node": {"type": "object", "properties": {
+            "next": {"$ref": "#/definitions/Node"}}}})
+        output, cuts = self.assert_stable(source, 1)
+        self.assertEqual(cuts[0]["in"], "#/definitions/Node/properties/next")
+        self.assertEqual(output["definitions"]["Node"]["properties"]["next"], {
+            "type": "object", "x-derecursed-from": "#/definitions/Node"})
+
+    def test_oas3_mutual_cycle(self):
+        output, cuts = self.assert_stable(schema_spec({
+            "A": {"properties": {"b": {"$ref": "#/components/schemas/B"}}},
+            "B": {"properties": {"a": {"$ref": "#/components/schemas/A"}}},
+        }, True), 1)
+        self.assertEqual(cuts[0]["ref"], "#/components/schemas/A")
+        self.assertEqual(output["components"]["schemas"]["A"]["properties"]["b"], {
+            "$ref": "#/components/schemas/B"})
+
+    def test_three_node_cycle_in_array_and_composition(self):
+        self.assert_stable(schema_spec({
+            "A": {"allOf": [{"$ref": "#/components/schemas/B"}]},
+            "B": {"type": "array", "items": {"$ref": "#/components/schemas/C"}},
+            "C": {"additionalProperties": {"$ref": "#/components/schemas/A"}},
+        }, True), 1)
+
+    def test_acyclic_shared_reference_is_unchanged(self):
+        source = schema_spec({
+            "A": {"allOf": [{"$ref": "#/definitions/Leaf"}, {"$ref": "#/definitions/Leaf"}]},
+            "B": {"$ref": "#/definitions/Leaf"}, "Leaf": {"type": "string"},
+        })
+        output, _ = self.assert_stable(source, 0)
+        self.assertEqual(output, source)
+
+    def test_escaped_schema_names(self):
+        _, cuts = self.assert_stable(schema_spec({"A/B~C": {"$ref": "#/components/schemas/A~1B~0C"}}, True), 1)
+        self.assertEqual(cuts[0]["in"], "#/components/schemas/A~1B~0C")
+
+    def test_both_schema_namespaces_are_processed(self):
+        source = schema_spec({"Node": {"$ref": "#/definitions/Node"}}, True)
+        source["definitions"] = {"Node": {"$ref": "#/definitions/Node"}}
+        # The OAS schema points across namespaces; only the real back edge is cut.
+        output, _ = self.assert_stable(source, 1)
+        self.assertEqual(output["components"]["schemas"]["Node"], {"$ref": "#/definitions/Node"})
+
+    def test_equal_basenames_do_not_alias(self):
+        source = schema_spec({"Node": {"properties": {
+            "parameter": {"$ref": "#/components/parameters/Node"}}}}, True)
+        source["components"]["parameters"] = {"Node": {"name": "q", "in": "query"}}
+        self.assertEqual(self.assert_stable(source, 0)[0], source)
+
+    def test_independent_cycles_in_both_namespaces(self):
+        source = schema_spec({"Node": {"$ref": "#/components/schemas/Node"}}, True)
+        source["definitions"] = {"Node": {"$ref": "#/definitions/Node"}}
+        self.assert_stable(source, 2)
+
+    def test_external_and_dangling_refs_are_untouched(self):
+        source = schema_spec({"Node": {"allOf": [
+            {"$ref": "other.json#/definitions/Node"}, {"$ref": "#/definitions/Absent"}]}})
+        self.assertEqual(self.assert_stable(source, 0)[0], source)
+
+    def test_schema_ref_siblings_are_walked(self):
+        source = schema_spec({"A": {"$ref": "#/components/schemas/B", "properties": {
+            "next": {"$ref": "#/components/schemas/A"}}}, "B": {"type": "object"}}, True)
+        _, cuts = self.assert_stable(source, 1)
+        self.assertEqual(cuts[0]["in"], "#/components/schemas/A/properties/next")
+
+    def test_independent_cycles(self):
+        self.assert_stable(schema_spec({
+            "A": {"$ref": "#/definitions/A"}, "B": {"$ref": "#/definitions/B"}}), 2)
+
+    def test_spec_without_schema_components(self):
+        source = {"openapi": "3.0.4", "paths": {}}
+        self.assertEqual(self.assert_stable(source, 0)[0], source)
+
+    def test_actual_sut_documents_static_transform(self):
+        emb = HERE.parents[1] / "_external" / "emb"
+        for sut in ("scout-api", "swagger-petstore", "market"):
+            with self.subTest(sut=sut):
+                source = json.loads((emb / "openapi-swagger" / f"{sut}.json").read_text())
+                output, cuts = derecurse(source)
+                self.assert_stable(source, len(cuts))
+                self.assertEqual(output["paths"], source["paths"])
+                if sut == "scout-api":
+                    self.assertGreater(len(cuts), 0, "scout regression fixture lost its cycles")
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)

diff --git a/research/08_experiments/E1_pilot/harness_v2/auth_header.py b/research/08_experiments/E1_pilot/harness_v2/auth_header.py
new file mode 100644
index 0000000000000000000000000000000000000000..c7b764440863e952a2b11c211cd8fd638b9726f2
--- /dev/null
+++ b/research/08_experiments/E1_pilot/harness_v2/auth_header.py
@@ -0,0 +1,27 @@
+"""Read one EMB fixed Authorization header at runtime, never include values in errors."""
+from pathlib import Path
+import sys
+
+import yaml
+
+
+def main():
+    try:
+        config = yaml.safe_load(Path(sys.argv[1]).read_text(encoding="utf-8"))
+        roles = [role for role in config["auth"] if role["name"] == sys.argv[2]]
+        if len(roles) != 1:
+            raise ValueError
+        headers = roles[0]["fixedHeaders"]
+        # This harness supports the fixed-header fixtures used by these SUTs only.
+        if len(headers) != 1 or headers[0]["name"].lower() != "authorization":
+            raise ValueError
+        name, value = headers[0]["name"], headers[0]["value"]
+        if not isinstance(value, str) or not value or any(c in name + value for c in "\r\n"):
+            raise ValueError
+    except Exception:
+        raise SystemExit("Cannot load a single fixed Authorization header for the selected role") from None
+    print(name + ": " + value)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/research/08_experiments/E1_pilot/harness_v2/common.sh b/research/08_experiments/E1_pilot/harness_v2/common.sh
new file mode 100644
index 0000000000000000000000000000000000000000..ea4cbf99620399ef4c81ff60b58d8ce116d34ed6
--- /dev/null
+++ b/research/08_experiments/E1_pilot/harness_v2/common.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+# Trusted, non-secret configuration shared by the v2 scripts.
+load_sut() {
+    case ${1:-} in scout-api|swagger-petstore|market) ;; *) echo 'Unsupported SUT' >&2; return 2;; esac
+    # Only checked-in configurations from the allowlist are sourced.
+    source "$HERE/suts/$1.env"
+    export EMB_DIR="$EXP/_external/emb" TOOLS_DIR="$EXP/tools"
+    export SUT_ID SUT_SERVICE INTERNAL_PORT SUT_IMAGE COMPOSE_FILE DOCKERFILE
+    export JAR_SOURCE SPEC_SOURCE AUTH_SOURCE
+    export HEALTH_PATH=${HEALTH_PATH:-$HEALTH_PATH_DEFAULT}
+    export BASE_PATH=${BASE_PATH:-$BASE_PATH_DEFAULT}
+    export PILOT_AUTH_ROLE=${AUTH_ROLE:-$AUTH_ROLE_DEFAULT}
+    # These interpolate into the original EMB Compose port declarations.
+    export HOST_PORT=127.0.0.1:18080 JACOCO_PORT=127.0.0.1:16300
+}
+
+acquire_run_lock() {
+    exec 9>"$HERE/.run.lock"
+    flock -n 9 || { echo 'Another v2 pilot/preparation is running' >&2; return 1; }
+    # Share the existing v1 lock without writing or truncating any v1 file.
+    if [[ -f $HERE/../harness/.run.lock ]]; then
+        exec 8<"$HERE/../harness/.run.lock"
+        flock -n 8 || { echo 'The v1 pilot is running; retry after it finishes' >&2; return 1; }
+    fi
+}
diff --git a/research/08_experiments/E1_pilot/harness_v2/derecurse.py b/research/08_experiments/E1_pilot/harness_v2/derecurse.py
new file mode 100644
index 0000000000000000000000000000000000000000..9230cbef0ae15684f1bf41bf48ee08bddecddf46
--- /dev/null
+++ b/research/08_experiments/E1_pilot/harness_v2/derecurse.py
@@ -0,0 +1,70 @@
+"""Cut schema-reference DFS back edges in a COPY used only for generation.
+
+Supports Swagger definitions and OpenAPI components/schemas, including both
+namespaces in one document and escaped schema names. External refs and refs to
+non-schema components are left intact. Conformance must use the original spec.
+"""
+import copy
+import json
+from pathlib import Path
+import sys
+
+
+def escape(value):
+    return str(value).replace("~", "~0").replace("/", "~1")
+
+
+def derecurse(document):
+    spec = copy.deepcopy(document)
+    schemas = {}
+    for prefix, group in (
+        ("#/definitions/", spec.get("definitions", {})),
+        ("#/components/schemas/", spec.get("components", {}).get("schemas", {})),
+    ):
+        for name, schema in group.items():
+            schemas[prefix + escape(name)] = schema
+    state, cuts = {}, []
+
+    def walk(node, location):
+        if isinstance(node, dict):
+            ref = node.get("$ref")
+            if isinstance(ref, str) and ref in schemas:
+                if state.get(ref) == "active":
+                    # Preserve the existing harness's object replacement policy.
+                    node.clear()
+                    node.update({"type": "object", "x-derecursed-from": ref})
+                    cuts.append({"in": location, "ref": ref})
+                    return
+                visit(ref)
+            # Siblings can themselves contain recursive refs (notably OAS 3.1).
+            for key, value in node.items():
+                walk(value, location + "/" + escape(key))
+        elif isinstance(node, list):
+            for index, value in enumerate(node):
+                walk(value, location + "/" + str(index))
+
+    def visit(ref):
+        if state.get(ref) == "done":
+            return
+        state[ref] = "active"
+        walk(schemas[ref], ref)
+        state[ref] = "done"
+
+    for ref in sorted(schemas):
+        visit(ref)
+    return spec, cuts
+
+
+def main(src, dst):
+    result, cuts = derecurse(json.loads(Path(src).read_text(encoding="utf-8")))
+    # Exclusive creation prevents accidental replacement of a generator snapshot.
+    with Path(dst).open("x", encoding="utf-8") as stream:
+        json.dump(result, stream, indent=2)
+        stream.write("\n")
+    print(json.dumps(cuts))
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 3:
+        raise SystemExit("Usage: derecurse.py IN.json OUT.json")
+    main(*sys.argv[1:])
diff --git a/research/08_experiments/E1_pilot/harness_v2/run_batch.sh b/research/08_experiments/E1_pilot/harness_v2/run_batch.sh
new file mode 100644
index 0000000000000000000000000000000000000000..f2f5c63183355b8cac1df41818e5eba8237b1ab0
--- /dev/null
+++ b/research/08_experiments/E1_pilot/harness_v2/run_batch.sh
@@ -0,0 +1,47 @@
+#!/usr/bin/env bash
+# One baseline and four mutation conditions for each requested seed.
+set -euo pipefail
+HERE=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
+EXP=$(cd -- "$HERE/../.." && pwd)
+[[ $# -ge 1 ]] || { echo 'Usage: run_batch.sh SUT [SEEDS ...]' >&2; exit 2; }
+source "$HERE/common.sh"
+sut=$1
+shift
+load_sut "$sut"
+seeds=("$@")
+if ((${#seeds[@]} == 0)); then seeds=(1 2 3); fi
+declare -A seen=()
+for seed in "${seeds[@]}"; do
+    [[ $seed =~ ^(0|[1-9][0-9]*)$ ]] || { echo 'Invalid seed' >&2; exit 2; }
+    [[ ! ${seen[$seed]+present} ]] || { echo 'Duplicate seed' >&2; exit 2; }
+    seen[$seed]=1
+done
+export MAX_EXAMPLES=${MAX_EXAMPLES:-100}
+export SCHEMA_CHECKS=${SCHEMA_CHECKS:-all}
+budget=${BUDGET_SECONDS:-300}
+severity=${SEVERITY:-30}
+[[ $budget =~ ^[1-9][0-9]*$ && $severity =~ ^[1-9][0-9]?$|^100$ ]] || { echo 'Invalid budget/severity' >&2; exit 2; }
+spec="$EMB_DIR/$SPEC_SOURCE"
+runs="$EXP/E1_pilot/runs/$sut"
+batch_id="$(date -u +%Y%m%dT%H%M%SZ)_batch_$$"
+mkdir -p "$runs/batches"
+batch_dir="$runs/batches/$batch_id"
+mkdir "$batch_dir"
+printf 'seed\tmode\tfault\trun_dir\n' >"$batch_dir/runs.tsv"
+run_one() {
+    local mode=$1 fault=$2 percent=$3 seed=$4 id
+    id="${batch_id}_${mode}_${fault}_p${percent}_s${seed}"
+    # Exact path reserved by run_pilot's exclusive mkdir; never guess from old runs.
+    LAST_RUN="$runs/$id"
+    PILOT_RUN_ID="$id" "$HERE/run_pilot.sh" "$sut" "$spec" "$mode" "$fault" "$percent" "$seed" "$budget"
+    printf '%s\t%s\t%s\t%s\n' "$seed" "$mode" "$fault" "$LAST_RUN" >>"$batch_dir/runs.tsv"
+}
+for seed in "${seeds[@]}"; do
+    run_one baseline NONE 0 "$seed"
+    baseline=$LAST_RUN
+    for fault in REQUEST_LOOSE REQUEST_STRICT RESPONSE_ORACLE METHOD_SEM; do
+        run_one mutated "$fault" "$severity" "$seed"
+        "$HERE/analyse_run.sh" "$LAST_RUN" "$baseline" --mode both
+    done
+done
+echo "Batch complete: $batch_dir/runs.tsv"
