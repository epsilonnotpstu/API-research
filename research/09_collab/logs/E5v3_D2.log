FILE K12/source/market-core/src/main/java/market/dto/assembler/ProductDtoAssembler.java
1: package market.dto.assembler;
3: import market.domain.Product;
4: import market.dto.ProductDTO;
5: import org.springframework.data.domain.Page;
6: import org.springframework.data.domain.PageImpl;
7: import org.springframework.hateoas.server.RepresentationModelAssembler;
9: import java.util.List;
11: public class ProductDtoAssembler implements RepresentationModelAssembler  {
13: @Override
14: public ProductDTO toModel(Product product) {
15: ProductDTO dto = new ProductDTO();
16: dto.setProductId(product.getId());
17: dto.setDistillery(product.getDistillery() == null ? null : product.getDistillery().getTitle());
18: dto.setName(product.getName());
19: dto.setAge(product.getAge());
20: dto.setAlcohol(product.getAlcohol());
21: dto.setPrice(product.getPrice());
22: dto.setVolume(product.getVolume());
23: dto.setDescription(product.getDescription());
24: dto.setAvailable(product.isAvailable());
25: return dto;
26: }
28: public PageImpl  toModel(Page  page) {
29: List  dtoList = page.map(this::toModel).toList();
30: return new PageImpl<>(dtoList, page.getPageable(), page.getTotalElements());
31: }
33: public Product dtoDomain(ProductDTO dto) {
34: return new Product.Builder()
35: .setName(dto.getName())
36: .setAge(dto.getAge())
37: .setAlcohol(dto.getAlcohol())
38: .setPrice(dto.getPrice())
39: .setVolume(dto.getVolume())
40: .setDescription(dto.getDescription())
41: .setAvailable(dto.isAvailable())
42: .build();
43: }
44: }

FILE K12/source/market-rest/src/main/java/market/rest/ProductsRestController.java
21: @RestController
22: @RequestMapping(value = "products")
23: @ExposesResourceFor(ProductDTO.class)
24: public class ProductsRestController {
26: private final ProductService productService;
27: private final ProductDtoAssembler productAssembler = new ProductDtoAssembler();
29: public ProductsRestController(ProductService productService) {
30: this.productService = productService;
31: }
33: /**
34: * All the existing products, sorted by id.
35: */
36: @GetMapping
37: public Collection  getProducts() {
38: return productService.findAll().stream()
39: .sorted(Comparator.comparing(Product::getId))
40: .map(productAssembler::toModel)
41: .peek(this::addSelfLink)
42: .collect(Collectors.toList());
43: }
45: private void addSelfLink(ProductDTO dto) {
46: dto.add(linkTo(methodOn(getClass()).getProduct(dto.getProductId())).withRel("self"));
47: }
49: /**
50: * Viewing a single product.
51: *
52: * @return product with the specified id
53: * @throws UnknownEntityException if the product with the specified id doesn't exist
54: */
55: @GetMapping(value = "/{productId}")
56: public ProductDTO getProduct(@PathVariable long productId) {
57: return productService.findById(productId)
58: .map(productAssembler::toModel)
59: .map(this::addListLink)
60: .orElseThrow(() -> new UnknownEntityException(ProductDTO.class, productId));
