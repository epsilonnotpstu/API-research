56:         doAuth(authResult, response, Permission.rating_set_own);
57:         activityRatingDao.all(authResult.getUser()).forEach(activityRating -> {
58:             boolean shouldBeSetAsFavourite = properties.getIdList().stream().anyMatch(aLong -> aLong == activityRating.getActivity().getId());
59:             boolean isFavourite = activityRating.isFavourite() != null && activityRating.isFavourite().booleanValue();
60:             if (shouldBeSetAsFavourite != isFavourite) {
61:                 activityRating.setFavourite(shouldBeSetAsFavourite);
