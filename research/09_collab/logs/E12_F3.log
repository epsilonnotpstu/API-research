100: 		return api.SendError(ctx, err)
101: 	}
102: 
103: 	payload, err = convertInstanceToPayload(instance)
104: 	if err != nil {
105: 		return api.SendError(ctx, err)
106: 	}
107: 
108: 	return operation.NewGetInstanceOK().WithPayload(payload)
109: }

