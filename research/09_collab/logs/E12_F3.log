    for locator in row['evidence_locators'].split('; '):
        path,line=locator.rsplit(':',1)
        assert path.startswith(row['item_id']+'/')
        assert '/contract/' in path or '/impl/' in path
        assert 1<=int(line)<=len(Path(path).read_text().splitlines())
assert Path('report_F3.md').stat().st_size>0
