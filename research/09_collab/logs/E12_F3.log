892:     private static boolean enforceMergeThingCommand(final Enforcer policyEnforcer,
893:             final MergeThing command, final ResourceKey thingResourceKey,
894:             final AuthorizationContext authorizationContext) {
895:         if (policyEnforcer.hasUnrestrictedPermissions(thingResourceKey, authorizationContext, Permission.WRITE)) {
896:             // unrestricted permissions at thingResourceKey level
897:             return true;
898:         } else if (policyEnforcer.hasPartialPermissions(thingResourceKey, authorizationContext, Permission.WRITE)) {
899:             // in case of partial permissions at thingResourceKey level check all leaves of merge patch for
900:             // unrestricted permissions
901:             final Set<ResourceKey> resourceKeys = calculateLeaves(command.getPath(), command.getValue());
902:             return policyEnforcer.hasUnrestrictedPermissions(resourceKeys, authorizationContext, Permission.WRITE);
903:         } else {
904:             // not even partial permission
905:             return false;
906:         }
907:     }
908: 
909:     private static Set<ResourceKey> calculateLeaves(final JsonPointer path, final JsonValue value) {
910:         if (value.isObject()) {
911:             return value.asObject().stream()
912:                     .map(f -> calculateLeaves(path.append(f.getKey().asPointer()), f.getValue()))
913:                     .reduce(new HashSet<>(), ThingCommandEnforcement::addAll, ThingCommandEnforcement::addAll);
914:         } else {
915:             return Set.of(PoliciesResourceType.thingResource(path));
