96: 	}
97: 	repository := fmt.Sprintf("%s/%s", params.ProjectName, params.RepositoryName)
98: 	a, err := s.artCtl.GetByReference(ctx, repository, params.Reference, nil)
99: 	if err != nil {
100: 		return s.SendError(ctx, err)
101: 	}
102: 
103: 	bytes, err := s.scanCtl.GetScanLog(ctx, a, params.ReportID)
104: 	if err != nil {
105: 		return s.SendError(ctx, err)
106: 	}
107: 
108: 	if bytes == nil {
109: 		// Not found
110: 		return s.SendError(ctx, errors.NotFoundError(nil).WithMessage("report with uuid %s does not exist", params.ReportID))
111: 	}
112: 
113: 	return operation.NewGetReportLogOK().WithPayload(string(bytes))
114: }

