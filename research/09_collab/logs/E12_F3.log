from pathlib import Path
import csv

def evidence(item, kind, suffix, line):
    matches=[p for p in (Path(item)/kind).rglob(Path(suffix).name) if str(p).endswith(suffix)]
    assert len(matches)==1,(item,kind,suffix,matches)
    p=matches[0]
    assert 1<=line<=len(p.read_text().splitlines()),(p,line)
    return f'{p}:{line}'

records=[]
def add(item,label,confidence,refs,rationale):
    assert len(rationale.split())<=40,(item,len(rationale.split()))
    refs=[evidence(item,*r) for r in refs]
    records.append(dict(item_id=item,L1=label,confidence=confidence,evidence_locators='; '.join(refs),rationale=rationale))

