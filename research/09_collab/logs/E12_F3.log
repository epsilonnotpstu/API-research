70:         ResponseEntity.BodyBuilder response = putDefaultHeaders(result, ResponseEntity.status(ACCEPTED));
71:         putExtraRedirectHeaders(result, response);
72:         response.body(result.getCause());
73:         return responseForRedirection(result, response);
74:     }
75: 
76:     protected ResponseEntity<Map<String, String>> responseForRedirection(FacadeResultRedirectable<?, ?> result, ResponseEntity.BodyBuilder response) {
77:         return setCookieHeaders(result, response)
78:                        .header(AUTHORIZATION_SESSION_ID, result.getAuthorizationSessionId())
79:                        .header(REDIRECT_CODE, result.getRedirectCode())
80:                        .header(PSU_CONSENT_SESSION, "BAR")
81:                        .location(result.getRedirectionTo())
82:                        .body(ImmutableMap.of("msg", "Please use redirect link in 'Location' header"));
83:     }
84: 
85:     protected <E> ResponseEntity<E> handleError(FacadeRedirectErrorResult<?, ?> result) {
86:         ResponseEntity.BodyBuilder response = putDefaultHeaders(result, ResponseEntity.status(ACCEPTED));
87:         return putExtraRedirectHeaders(result, response).build();
88:     }
89: 
90:     protected <T, F> ResponseEntity<T> handleSuccess(FacadeSuccessResult<F> result, FacadeResponseBodyToRestBodyMapper<T, F> mapper) {
91:         ResponseEntity.BodyBuilder response = putDefaultHeaders(result, ResponseEntity.status(OK));
92:         return response.body(mapper.map(result.getBody()));
93:     }
94: 
95:     protected ResponseEntity.BodyBuilder putDefaultHeaders(FacadeResult<?> result, ResponseEntity.BodyBuilder builder) {
96:         builder
97:                 .header(X_REQUEST_ID, null == result.getXRequestId() ? null : result.getXRequestId().toString())
98:                 .header(SERVICE_SESSION_ID, result.getServiceSessionId());
99:         return builder;
100:     }
101: 
102:     protected ResponseEntity.BodyBuilder putExtraRedirectHeaders(FacadeResultRedirectable<?, ?> result, ResponseEntity.BodyBuilder builder) {
103:         result.getHeaders().forEach(builder::header);
104:         return builder;
105:     }
106: 
107:     private ResponseEntity.BodyBuilder setCookieHeaders(FacadeResultRedirectable<?, ?> result, ResponseEntity.BodyBuilder builder) {
108:         if (Strings.isNullOrEmpty(result.getToken())) {
109:             return builder;
110:         }
111: 
112:         String redirectPath = fromAspspRedirectPath(result.getAuthorizationSessionId(), result.getRedirectCode());
113:         ResponseCookie responseCookie = cookieBuilderTemplate.builder(result.getToken(),
114:                                                                      redirectPath,
115:                                                                      cookieProperties.getRedirectMaxAge())
116:                                                .build();
117: 
118:         builder.header(COOKIE_TTL, Long.toString(cookieProperties.getRedirectMaxAge().getSeconds()))
119:                 .header(SET_COOKIE, responseCookie.toString());
120: 
121:         return builder;
122:     }
123: 
124:     public String fromAspspRedirectPath(String authorizationId, String redirectState) {
125:         return UriComponentsBuilder.fromPath(cookieProperties.getRedirectPathTemplate())
126:                        .buildAndExpand(ImmutableMap.of(UriExpandConst.AUTHORIZATION_SESSION_ID, authorizationId,
127:                                                        UriExpandConst.REDIRECT_STATE, redirectState))
128:                        .toUriString();
129:     }
130: }

