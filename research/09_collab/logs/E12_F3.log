726: 	tasks, err := bc.listScanTasks(ctx, reportUUIDs)
727: 	if err != nil {
728: 		return nil, err
729: 	}
730: 
731: 	if len(tasks) == 0 {
732: 		return nil, nil
733: 	}
734: 
735: 	reportUUIDToTasks := map[string]*task.Task{}
736: 	for _, t := range tasks {
737: 		if !scanTaskForArtifacts(t, artifactMap) {
738: 			return nil, errors.NotFoundError(nil).WithMessage("scan log with uuid: %s not found", uuid)
739: 		}
740: 		for _, reportUUID := range getReportUUIDs(t.ExtraAttrs) {
741: 			reportUUIDToTasks[reportUUID] = t
742: 		}
743: 	}
744: 
745: 	errs := map[string]error{}
746: 	logs := make(map[string][]byte, len(tasks))
747: 
748: 	var (
749: 		mu sync.Mutex
750: 		wg sync.WaitGroup
751: 	)
752: 	for _, reportUUID := range reportUUIDs {
753: 		wg.Add(1)
754: 
755: 		go func(reportUUID string) {
756: 			defer wg.Done()
757: 
758: 			task, ok := reportUUIDToTasks[reportUUID]
759: 			if !ok {
760: 				return
761: 			}
762: 
763: 			log, err := bc.taskMgr.GetLog(ctx, task.ID)
764: 
765: 			mu.Lock()
766: 			defer mu.Unlock()
767: 
768: 			if err != nil {
769: 				errs[reportUUID] = err
770: 			} else {
771: 				logs[reportUUID] = log
772: 			}
773: 		}(reportUUID)
774: 	}
775: 	wg.Wait()
776: 
777: 	if len(reportUUIDs) == 1 {
778: 		return logs[reportUUIDs[0]], errs[reportUUIDs[0]]
779: 	}
780: 
781: 	if len(errs) == len(reportUUIDs) {
782: 		for _, err := range errs {
783: 			return nil, err
784: 		}
785: 	}
786: 
787: 	var b bytes.Buffer
788: 
789: 	multiLogs := len(logs) > 1
790: 	for _, reportUUID := range reportUUIDs {
791: 		log, ok := logs[reportUUID]
792: 		if !ok || len(log) == 0 {
793: 			continue
794: 		}
795: 
796: 		if multiLogs {
797: 			if b.Len() > 0 {
798: 				b.WriteString("\n\n\n\n")
799: 			}
800: 			b.WriteString(fmt.Sprintf("---------- Logs of report %s ----------\n", reportUUID))
801: 		}
802: 
803: 		b.Write(log)
804: 	}
805: 
806: 	return b.Bytes(), nil
807: }
