144:     )
145:     @ApiResponse(responseCode = "500", description = "Internal server error")
146:     public Response getEnvironmentPermissions() {
147:         Map<String, char[]> permissions = new HashMap<>();
148:         if (isAuthenticated()) {
149:             final String username = getAuthenticatedUser();
150:             // Search for the environment in any  case to make sure it exists
151:             // We use the env resolved from context to make sure the hrid has been resolved
152:             final EnvironmentEntity environmentEntity = environmentService.findById(GraviteeContext.getCurrentEnvironment());
153:             if (isAdmin()) {
154:                 final char[] rights = new char[] { CREATE.getId(), READ.getId(), UPDATE.getId(), DELETE.getId() };
155:                 for (EnvironmentPermission perm : EnvironmentPermission.values()) {
156:                     permissions.put(perm.getName(), rights);
157:                 }
158:             } else {
159:                 permissions.putAll(
160:                     membershipService.getUserMemberPermissions(GraviteeContext.getExecutionContext(), environmentEntity, username)
161:                 );
163:         }
164:         return Response.ok(permissions).build();
165:     }
