93: 	if err := api.RequireSysAdmin(ctx); err != nil {
94: 		return api.SendError(ctx, err)
95: 	}
96: 
97: 	var payload *models.Instance
98: 	instance, err := api.preheatCtl.GetInstanceByName(ctx, params.PreheatInstanceName)
