74: func (api *preheatAPI) DeleteInstance(ctx context.Context, params operation.DeleteInstanceParams) middleware.Responder {
75: 	if err := api.RequireSysAdmin(ctx); err != nil {
76: 		return api.SendError(ctx, err)
77: 	}
78: 
79: 	instance, err := api.preheatCtl.GetInstanceByName(ctx, params.PreheatInstanceName)
80: 	if err != nil {
81: 		return api.SendError(ctx, err)
82: 	}
83: 
84: 	err = api.preheatCtl.DeleteInstance(ctx, instance.ID)
85: 	if err != nil {
86: 		return api.SendError(ctx, err)
87: 	}
88: 
89: 	return operation.NewDeleteInstanceOK()
90: }
91: 
