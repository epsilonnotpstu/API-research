   221	                              'before_exists': key in before, 'after_exists': key in after,
   222	                              'before': copy.deepcopy(before.get(key)), 'after': copy.deepcopy(after.get(key))})
   223	            else:
   224	                edits.extend(document_edits(before[key], after[key], p))
