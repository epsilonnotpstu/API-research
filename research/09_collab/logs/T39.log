   300	def schema_problems(spec, schema, value, direction, prefix=''):
   301	    for err in spec.errors(schema, value, direction):
   302	        pointer = prefix + '/' + '/'.join(str(p).replace('~', '~0').replace('/', '~1') for p in err.schema_path)
   303	        for identity in error_identity(err):
   304	            yield pointer, err.message, identity
