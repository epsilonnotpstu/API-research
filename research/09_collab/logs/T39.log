+
+def check(value):
+    global checks
+    assert value
+    checks += 1
+
+
+def read(name):
+    return list(csv.DictReader((P / name).open()))
+
+
+def kinds(text):
+    return {k: int(v) for k, v in (part.rsplit(':', 1) for part in text.split(';') if part)}
+
+
