   209	    def match(self, path, method=None, origin=None):
   210	        fallback = None
   211	        for rx, template, names, route_method, route_origin in self.routes:
   212	            if fallback and template != fallback[0]:
   213	                break  # A concrete path wins even when its method is undocumented.
   214	            if origin and route_origin and authority(origin) != route_origin \
   215	                    and not (self.deploy and authority(origin) == self.deploy):
   216	                continue
   217	            m = rx.match(path)
   218	            if m:
   219	                result = (template, {n: unquote(v) for n, v in zip(names, m.groups())})
   220	                if method is None or method.lower() == route_method:
   221	                    return result
   222	                fallback = fallback or result
   223	        if fallback and method and method.lower() in self.raw['paths'][fallback[0]]:
   224	            # That method exists, but its effective server did not match.
   225	            return None, {}
   226	        return fallback or (None, {})
   227	
   228	    def operation(self, template, method):
   229	        item = self.raw['paths'][template]
   230	        op = item.get(method.lower())
   231	        if op is None:
   232	            return None, []
   233	        resolved = [specmut.resolve(self.raw, p, preserve_schemas=True) for p in item.get('parameters', []) + op.get('parameters', [])]
   234	        params = {(p.get('name'), p.get('in')): p for p in resolved}
   235	        return specmut.resolve(self.raw, op, preserve_schemas=True), list(params.values())
   236	
   237	    def response_entry(self, op, status):
   238	        responses = op.get('responses', {})
   239	        return responses.get(str(status)) or responses.get(f'{str(status)[0]}XX') or responses.get('default')
   240	
   241	    def response_schema(self, op, status, ctype=''):
   242	        resp = self.response_entry(op, status)
   243	        if resp is None:
   244	            return False, None
   245	        return True, select_media(resp.get('content', {}), ctype)[1] if self.oas3 else resp.get('schema')
   246	
   247	    def allowed_media(self, op, status):
   248	        resp = self.response_entry(op, status) or {}
   249	        if self.oas3:
   250	            return list(resp.get('content', {})) or None
   251	        produces = op.get('produces') or self.raw.get('produces')
   252	        return produces if produces and 'schema' in resp else None
   253	
   254	    def errors(self, schema, instance, direction):
   255	        key = (json.dumps(schema, sort_keys=True), direction)
   256	        if key not in self._validators:
   257	            self._validators[key] = validator(schema, self.dialect, self.strict if direction == 'response' else False,
   258	                                              direction, self.raw, self._resolvers.get(direction))
   259	            # Reuse the normalized source document; each validator still has its
   260	            # own root schema, while reference targets share direction/policy.
   261	            self._resolvers[direction] = self._validators[key]._ref_resolver
   262	        return self._validators[key].iter_errors(instance)
   263	
   264	
   265	def coerce(value, schema, values=None, delimiter=',', explode=False):
   266	    if not isinstance(schema, dict):
   267	        return value
   268	    t = schema.get('type')
   269	    if isinstance(t, list):
   270	        t = next((x for x in t if x != 'null'), None)
   271	    if t == 'array':
   272	        raw = (values if values is not None else [value]) if explode else (value.split(delimiter) if isinstance(value, str) else [value])
   273	        return [coerce(x, schema.get('items', {})) for x in raw]
   274	    try:
   275	        if t == 'integer':
   276	            return int(value)
   277	        if t == 'number':
   278	            return float(value)
   279	        if t == 'boolean':
   280	            return {'true': True, 'false': False}[value.lower()]
   281	    except (ValueError, KeyError, AttributeError, TypeError):
   282	        return value
   283	    return value
   284	
   285	
   286	def error_identity(err):
   287	    """Array indices normalize to '*'; object keys and offending property remain distinct."""
   288	    loc = '/' + '/'.join('*' if isinstance(p, int) else str(p).replace('~', '~0').replace('/', '~1') for p in err.absolute_path)
   289	    properties = ['']
   290	    if err.validator == 'required' and isinstance(err.instance, dict):
   390	    elif body_schema is not None:
   391	        try:
   392	            body = parse_body(text, ctype or media)
   393	        except ValueError:
   394	            problems.append(('/requestBody/parse', 'request body is not valid JSON', {'keyword': 'parse'}))
   395	        except LookupError as exc:
   396	            problems.uncheckable.append(str(exc))
   397	        else:
   398	            try:
   399	                problems.extend(schema_problems(spec, body_schema, body, 'request', '/requestBody'))
   400	            except Exception as exc:
   401	                problems.uncheckable.append('request body schema: ' + str(exc))
   402	    return problems
   403	
   404	
   405	def media_matches(ctype, allowed):
   406	    allowed = allowed.split(';')[0].strip().lower()
   407	    if allowed in ('*/*', ctype):
   408	        return True
   409	    a_type, _, a_sub = allowed.partition('/')
   410	    c_type, _, _ = ctype.partition('/')
   411	    return a_type == c_type and a_sub == '*'
   412	
   413	
   414	def check(spec, exchange):
   415	    req, resp = exchange['request'], exchange['response']
   416	    method, status = req['method'].upper(), int(resp['status'])
   417	    template, path_params = spec.match(req['path'], method, req.get('origin'))
   418	
   419	    def v(kind, pointer='', message='', identity=None):
   420	        identity = identity or {}
   421	        parts = [method, template or req['path'], str(status), kind, pointer,
   422	                 identity.get('keyword', ''), identity.get('instance_location', ''), identity.get('property', '')]
   423	        return {'kind': kind, 'method': method, 'template': template or req['path'], 'status': status,
   424	                'pointer': pointer, 'message': message[:300], **identity,
   425	                'fingerprint': json.dumps(parts, ensure_ascii=False, separators=(',', ':'))}
   426	
   427	    if template is None:
   428	        return [v('UNDOCUMENTED_OPERATION', message='path not in spec')]
   429	    op, params = spec.operation(template, method)
   430	    if op is None:
   431	        return [v('UNDOCUMENTED_OPERATION', message='method not in spec')]
   432	    out = []
   433	    if status >= 500:
   434	        out.append(v('SERVER_ERROR'))
   435	    headers = {k.lower(): val for k, val in resp.get('headers', {}).items()}
   436	    ctype = headers.get('content-type', '').split(';')[0].strip().lower()
   437	    documented, schema = spec.response_schema(op, status, ctype)
   438	    if not documented:
   439	        out.append(v('UNDOCUMENTED_STATUS'))
   440	    else:
   441	        allowed = spec.allowed_media(op, status)
   442	        if allowed and ctype and not any(media_matches(ctype, a) for a in allowed):
   443	            out.append(v('RESPONSE_CONTENT_TYPE', message=f'{ctype} not in {allowed}'))
   444	    capture = resp.get('body', {})
   445	    text = capture.get('text', '')
   446	    if documented and schema is not None:
   447	        media = ctype or (select_media((spec.response_entry(op, status) or {}).get('content', {}), '')[0] if spec.oas3 else 'application/json')
   448	        if capture.get('truncated') or capture.get('decode_error'):
   449	            out.append(v('RESPONSE_UNCHECKABLE', message='response body capture is incomplete or undecodable'))
   450	        elif not text and not (media or '').startswith('text/'):
   451	            out.append(v('RESPONSE_PARSE', message='documented response body is missing'))
   452	        else:
   453	            try:
   454	                body = parse_body(text, media)
   455	            except ValueError:
   456	                out.append(v('RESPONSE_PARSE', message='body is not valid JSON'))
   457	            except LookupError as exc:
   458	                out.append(v('RESPONSE_UNCHECKABLE', message=str(exc)))
   459	            else:
   460	                try:
   461	                    out.extend(v('RESPONSE_SCHEMA', ptr, msg, identity)
   462	                               for ptr, msg, identity in schema_problems(spec, schema, body, 'response'))
   463	                except Exception as exc:
   464	                    out.append(v('RESPONSE_UNCHECKABLE', message='response schema: ' + str(exc)))
   465	    problems = request_problems(spec, params, op, exchange, path_params)
   466	    if problems.uncheckable:
   467	        out.append(v('REQUEST_UNCHECKABLE', message='; '.join(problems.uncheckable)))
   468	    if problems and 200 <= status < 300:
   469	        out.extend(v('INVALID_ACCEPTED', ptr, msg, identity) for ptr, msg, identity in problems)
   470	    if not problems and not problems.uncheckable and status in spec.reject:
   471	        out.append(v('VALID_REJECTED'))
   472	    return out
   473	
   474	
   475	def main(spec_path, exchanges_path, deploy_origin=None, reject_statuses=(400, 422)):
   476	    spec = Spec(specmut.load_spec(spec_path), deploy_origin=deploy_origin, reject_statuses=reject_statuses)
   477	    with open(exchanges_path, encoding='utf-8') as f:
   478	        for i, line in enumerate(f):
   479	            for violation in check(spec, json.loads(line)):
   480	                violation['exchange'] = i
   481	                print(json.dumps(violation))
   482	
   483	
   484	if __name__ == '__main__':
   485	    # Usage: conformance.py SPEC EXCHANGES [--deploy-origin URL] [--reject-statuses 400,422] [--no-int-formats]
   486	    args = sys.argv[1:]
   487	    deploy, reject = None, (400, 422)
   488	    if '--no-int-formats' in args:
   489	        args.remove('--no-int-formats')
   490	        INT_FORMATS = False
   491	    if '--deploy-origin' in args:
   492	        i = args.index('--deploy-origin')
   493	        deploy = args[i + 1]
   494	        del args[i:i + 2]
   495	    if '--reject-statuses' in args:
   496	        i = args.index('--reject-statuses')
   497	        reject = tuple(int(x) for x in args[i + 1].split(','))
   498	        del args[i:i + 2]
   499	    main(args[0], args[1], deploy, reject)
