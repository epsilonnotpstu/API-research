   207	def document_edits(before, after, pointer):
   208	    """Complete patch relative to the original operation, including structural inlining.
   209	
   210	    Explicit existence bits distinguish JSON null from a missing member. Edits are
   211	    sequential and reversible; before/after remain for existing CSV/CLI consumers.
   212	    """
   213	    if before == after:
   214	        return []
   215	    if isinstance(before, dict) and isinstance(after, dict):
   216	        edits = []
   217	        for key in sorted(set(before) | set(after)):
   218	            p = pointer + ptr(key)
   219	            if key not in before or key not in after:
