   228	                for e in document_edits(b, a, pointer + ptr(i))]
   229	    return [{'pointer': pointer, 'op': 'replace', 'before_exists': True, 'after_exists': True,
   230	             'before': copy.deepcopy(before), 'after': copy.deepcopy(after)}]
