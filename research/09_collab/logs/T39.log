   323	def request_problems(spec, params, op, exchange, path_params):
   324	    problems = RequestProblems()
   325	    req = exchange['request']
   326	    headers = {k.lower(): v for k, v in req.get('headers', {}).items()}
   327	    for p in params:
   328	        loc, name = p.get('in'), p.get('name')
   329	        schema = p.get('schema') if 'schema' in p else {k: p[k] for k in PARAM_SCHEMA_KEYS if k in p}
   330	        if loc == 'body':
   331	            continue
   332	        all_vals = None
   333	        if loc == 'path':
   334	            present, raw = name in path_params, path_params.get(name)
   335	        elif loc == 'query':
   336	            vals = req.get('query', {}).get(name)
   337	            all_vals = vals if isinstance(vals, list) else [vals] if vals is not None else []
   338	            present, raw = bool(all_vals), all_vals[0] if all_vals else None
   339	        elif loc == 'header':
   340	            raw = headers.get(name.lower())
   341	            present = raw is not None
   342	        elif loc == 'cookie':
   343	            if headers.get('cookie') == '<redacted>':
   344	                problems.uncheckable.append('cookie values are redacted')
   345	                continue
   346	            cookies = SimpleCookie()
   347	            cookies.load(headers.get('cookie', ''))
   348	            present = name in cookies
   349	            raw = cookies[name].value if present else None
   350	        else:
   351	            problems.uncheckable.append('unsupported parameter location: ' + str(loc))
   352	            continue
   353	        prefix = '/parameters' + specmut.ptr(loc, name)
   354	        if not present:
   355	            if p.get('required'):
   356	                problems.append((prefix + '/required', f'missing required {loc} parameter {name}',
   357	                                 {'keyword': 'required', 'instance_location': prefix, 'property': name}))
   358	            continue
   359	        if 'content' in p or (isinstance(schema, dict) and (schema.get('type') == 'object' or '$ref' in schema)):
   360	            problems.uncheckable.append('unsupported parameter serialization: ' + str(name))
   361	            continue
   362	        js = to_json_schema(schema, spec.dialect, direction='request')
   363	        delim = {'ssv': ' ', 'tsv': '\t', 'pipes': '|'}.get(p.get('collectionFormat'), ',')
   364	        delim = {'spaceDelimited': ' ', 'pipeDelimited': '|'}.get(p.get('style'), delim)
   365	        explode = (spec.oas3 and loc in ('query', 'cookie') and p.get('style', 'form') == 'form' and p.get('explode', True)) or p.get('collectionFormat') == 'multi'
   366	        value = coerce(raw, js, all_vals, delim, explode)
   367	        try:
   368	            problems.extend(schema_problems(spec, schema, value, 'request', prefix))
   369	        except Exception as exc:
   370	            problems.uncheckable.append('parameter schema: ' + str(exc))
   371	    body_schema, required, media = None, False, None
   372	    ctype = headers.get('content-type', '').split(';')[0].strip().lower()
   373	    if spec.oas3 and 'requestBody' in op:
   374	        rb = op['requestBody']
   375	        required = rb.get('required', False)
   376	        media, body_schema = select_media(rb.get('content', {}), ctype)
   377	        if rb.get('content') and ctype and media is None:
   378	            problems.append(('/requestBody/content', 'undocumented request Content-Type', {'keyword': 'contentType'}))
   379	    else:
   380	        bp = next((p for p in params if p.get('in') == 'body'), {})
   381	        body_schema, required = bp.get('schema'), bp.get('required', False)
   382	        media = ctype or next(iter(op.get('consumes', spec.raw.get('consumes', ['application/json']))), 'application/json')
   383	    capture = req.get('body', {})
   384	    text = capture.get('text', '')
   385	    if capture.get('truncated') or capture.get('decode_error'):
   386	        problems.uncheckable.append('request body capture is incomplete or undecodable')
   387	    elif not text:
   388	        if required:
   389	            problems.append(('/requestBody/required', 'missing required request body', {'keyword': 'required', 'property': 'requestBody'}))
   390	    elif body_schema is not None:
   391	        try:
   392	            body = parse_body(text, ctype or media)
   393	        except ValueError:
   394	            problems.append(('/requestBody/parse', 'request body is not valid JSON', {'keyword': 'parse'}))
   395	        except LookupError as exc:
   396	            problems.uncheckable.append(str(exc))
   397	        else:
   398	            try:
   399	                problems.extend(schema_problems(spec, body_schema, body, 'request', '/requestBody'))
   400	            except Exception as exc:
   401	                problems.uncheckable.append('request body schema: ' + str(exc))
