   307	def parse_body(text, media):
   308	    media = (media or 'application/json').split(';')[0].lower()
   309	    if media == 'application/json' or media.endswith('+json') or media == '*/*':
   310	        return json.loads(text)
   311	    if media.startswith('text/'):
   312	        return text
   313	    raise LookupError('unsupported body encoding: ' + media)
