   292	        properties = [str(p) for p in err.validator_value if p not in err.instance and err.message == f'{p!r} is a required property'] or ['']
   293	    elif err.validator == 'additionalProperties' and isinstance(err.instance, dict):
   294	        props, patterns = err.schema.get('properties', {}), err.schema.get('patternProperties', {})
   295	        properties = sorted(str(p) for p in err.instance if p not in props and not any(re.search(rx, p) for rx in patterns)) or ['']
   296	    for prop in properties:
   297	        yield {'keyword': str(err.validator), 'instance_location': loc, 'property': prop}
