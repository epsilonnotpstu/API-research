   233	def select_operations(spec, fault, severity, seed, exclude=(), only=None):
   234	    """Sample the original candidate pool, independently of possible or retained edits."""
   235	    if not 0 <= severity <= 100:
   236	        raise ValueError('severity must be between 0 and 100')
   237	    ops = [(p, m) for p, m, _ in operations(spec) if p not in exclude]
   238	    if only is not None:
   239	        only = {(p, m.lower()) for p, m in only}
   240	        unknown = only - {(p, m) for p, m, _ in operations(spec)}
   241	        if unknown:
   242	            raise ValueError(f'--only-ops lists operations not in the spec: {sorted(unknown)}')
   243	        ops = [o for o in ops if o in only]
   244	    rng = random.Random(f'{seed}:{fault}')
   245	    k = max(1, round(len(ops) * severity / 100)) if ops and severity else 0
   246	    chosen = sorted(rng.sample(ops, k))
   247	    return chosen, len(ops)
