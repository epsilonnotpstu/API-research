   127	def analyse_pair(mut):
   128	    mut = mut.resolve(); pairs = c.paired_rows(mut / 'runs.tsv', allow_incomplete=True)
   129	    m = c.load(mut / 'manifest.json')
   130	    skipped = sorted({int(r['seed']) for r in c.ledger(mut / 'runs.tsv')} - set(pairs))
   131	    if skipped:
   132	        print('Skipping failed/incomplete seeds: ' + ','.join(map(str,skipped)),file=sys.stderr)
   133	    # Refuse before any output if an analysis already exists; partial output is evidence.
   134	    c.require(not any((mut / f'analysis-s{s}-{o}').exists() for s in pairs for o in ('default','sut')), 'Analysis output already exists; retain it and investigate, no implicit overwrite')
   135	    for seed, pair in sorted(pairs.items()):
   136	        report = vp.validate(pair['control'], pair['mutant'], mut)
   137	        validation_path = mut / f'pair-validation-s{seed}.json'
   138	        c.atomic_json(validation_path, report)
   139	        c.require(report['status'] == 'PASS', f'Pair validation failed for seed {seed}')
   140	        meta = c.load(pair['control'] / 'run.json')
   141	        for oracle in ('default','sut'):
   142	            reject = '400,406,422' if m['sut'] == 'market' and oracle == 'sut' else '400,422'
   143	            origin = f'http://{meta["sut_service"]}:{meta["internal_port"]}'
   144	            out = mut / f'analysis-s{seed}-{oracle}'; out.mkdir()
   145	            record = {'format':'e5-analysis-v1','status':'RUNNING','seed':seed,'sut':m['sut'],'oracle':oracle,
   146	                      'reject_statuses':reject,'deploy_origin':origin,'mode':'fresh',
   147	                      'control_run':str(pair['control']), 'mutant_run':str(pair['mutant']),
   148	                      'manifest_sha256':c.sha(mut / 'manifest.json'), 'pair_validation_sha256':c.sha(validation_path),
   149	                      'run_metadata_sha256':{r:c.sha(p / 'run.json') for r,p in pair.items()},
   150	                      'tool_sha256':meta['tool_sha256'], 'pipeline_sha256':trusted_files()}
   151	            c.atomic_json(out / 'analysis.json', record)
   152	            try:
   153	                for role in ('control','mutant'):
   154	                    tool('conformance.py', [pair['control'] / 'spec.original.json', pair[role] / 'exchanges.jsonl',
   155	                                           '--deploy-origin', origin,'--reject-statuses',reject],
   156	                         out / f'{role}.violations.jsonl', out / 'tools.log')
   157	                tool('attribute.py', [out / 'control.violations.jsonl', out / 'mutant.violations.jsonl', mut / 'manifest.json', '--mode','fresh'],
   158	                     out / 'attribution.csv', out / 'tools.log')
   159	                c.snapshot(c.TOOLS, meta['tool_sha256'])
   160	                equal = vp.validate(pair['control'], pair['mutant'], mut)
   161	                c.require(equal == report, 'Pair evidence changed during analysis')
   162	                record['status'] = 'COMPLETE'
   163	            except (OSError, ValueError, KeyboardInterrupt) as error:
   164	                record['status'] = 'FAIL'; record['error'] = str(error)
   165	            finally:
   166	                record['file_sha256'] = {p.name:c.sha(p) for p in out.iterdir() if p.is_file() and p.name != 'analysis.json'}
   167	                c.atomic_json(out / 'analysis.json', record)
   168	            c.require(record['status'] == 'COMPLETE', f'Analysis failed: {out}')
   169	    print(str(mut))
