def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    run = sub.add_parser('run'); run.add_argument('mut_dir', type=Path); run.add_argument('seeds', nargs='*')
    analysis = sub.add_parser('analyse'); analysis.add_argument('mut_dir', type=Path)
