1: package api
2: 
3: import (
4: 	"encoding/json"
5: 	"net/http"
6: 	"strings"
7: 	"time"
8: 
9: 	"github.com/datarhei/core/v16/http/api"
10: 	"github.com/datarhei/core/v16/http/handler/util"
11: 	"github.com/datarhei/core/v16/log"
12: 
13: 	"github.com/labstack/echo/v4"
14: )
15: 
16: // The EventsHandler type provides handler functions for retrieving details
17: // about the API version and build infos.
18: type EventsHandler struct {
19: 	events log.ChannelWriter
20: }
21: 
22: // NewEvents returns a new About type
23: func NewEvents(events log.ChannelWriter) *EventsHandler {
24: 	return &EventsHandler{
25: 		events: events,
26: 	}
27: }
28: 
29: // Events returns a stream of event
30: // @Summary Stream of events
31: // @Description Stream of event of whats happening in the core
32: // @ID events
33: // @Tags v16.?.?
34: // @Accept text/event-stream
35: // @Accept json-stream
36: // @Produce text/event-stream
37: // @Produce json-stream
38: // @Param filters body api.EventFilters false "Event filters"
39: // @Success 200 {object} api.Event
40: // @Security ApiKeyAuth
41: // @Router /api/v3/events [post]
42: func (h *EventsHandler) Events(c echo.Context) error {
43: 	filters := api.EventFilters{}
44: 
45: 	if err := util.ShouldBindJSON(c, &filters); err != nil {
46: 		return api.Err(http.StatusBadRequest, "Invalid JSON", "%s", err)
47: 	}
48: 
49: 	filter := map[string]*api.EventFilter{}
50: 
51: 	for _, f := range filters.Filters {
52: 		f := f
53: 
54: 		if err := f.Compile(); err != nil {
55: 			return api.Err(http.StatusBadRequest, "Invalid filter", "%s: %s", f.Component, err)
56: 		}
57: 
58: 		component := strings.ToLower(f.Component)
59: 		filter[component] = &f
60: 	}
61: 
62: 	ticker := time.NewTicker(5 * time.Second)
63: 	defer ticker.Stop()
64: 
65: 	req := c.Request()
66: 
67: 	contentType := "text/event-stream"
68: 	accept := req.Header.Get(echo.HeaderAccept)
69: 	if strings.Contains(accept, "application/x-json-stream") {
70: 		contentType = "application/x-json-stream"
71: 	}
72: 
73: 	res := c.Response()
74: 
75: 	res.Header().Set(echo.HeaderContentType, contentType+"; charset=UTF-8")
76: 	res.Header().Set(echo.HeaderCacheControl, "no-store")
77: 	res.WriteHeader(http.StatusOK)
78: 
79: 	evts, cancel := h.events.Subscribe()
80: 	defer cancel()
81: 
82: 	enc := json.NewEncoder(res)
83: 	enc.SetIndent("", "")
84: 
85: 	done := make(chan struct{})
86: 
87: 	filterEvent := func(event *api.Event) bool {
88: 		if len(filter) == 0 {
89: 			return true
90: 		}
91: 
92: 		f, ok := filter[event.Component]
93: 		if !ok {
94: 			return false
95: 		}
96: 
97: 		return event.Filter(f)
98: 	}
99: 
100: 	event := api.Event{}
101: 
102: 	if contentType == "text/event-stream" {
103: 		res.Write([]byte(":keepalive\n\n"))
104: 		res.Flush()
105: 
106: 		for {
107: 			select {
108: 			case <-done:
109: 				return nil
110: 			case <-ticker.C:
111: 				res.Write([]byte(":keepalive\n\n"))
112: 				res.Flush()
113: 			case e := <-evts:
114: 				event.Marshal(&e)
115: 
116: 				if !filterEvent(&event) {
117: 					continue
118: 				}
119: 
120: 				res.Write([]byte("event: " + event.Component + "\ndata: "))
121: 				if err := enc.Encode(event); err != nil {
122: 					close(done)
123: 				}
124: 				res.Write([]byte("\n"))
125: 				res.Flush()
126: 			}
127: 		}
128: 	} else {
129: 		res.Write([]byte("{\"event\": \"keepalive\"}\n"))
130: 		res.Flush()
131: 
132: 		for {
133: 			select {
134: 			case <-done:
135: 				return nil
136: 			case <-ticker.C:
137: 				res.Write([]byte("{\"event\": \"keepalive\"}\n"))
138: 				res.Flush()
139: 			case e := <-evts:
140: 				event.Marshal(&e)
141: 
142: 				if !filterEvent(&event) {
143: 					continue
144: 				}
145: 
146: 				if err := enc.Encode(event); err != nil {
147: 					close(done)
148: 				}
149: 				res.Flush()
150: 			}
151: 		}
152: 	}
153: }

