14: // OAuth2IntrospectionPOST handles POST requests to the OAuth 2.0 Introspection endpoint.
15: //
16: // https://datatracker.ietf.org/doc/html/rfc7662
17: func OAuth2IntrospectionPOST(ctx *middlewares.AutheliaCtx, rw http.ResponseWriter, req *http.Request) {
18: 	var (
19: 		requestID uuid.UUID
20: 		responder oauthelia2.IntrospectionResponder
21: 		err       error
22: 	)
23: 	if _, err = ctx.IssuerURL(); err != nil {
24: 		ctx.GetLogger().WithError(err).Errorf("Error occurred determining issuer")
25: 
26: 		ctx.ReplyStatusCode(fasthttp.StatusInternalServerError)
27: 
28: 		return
29: 	}
30: 
31: 	if requestID, err = uuid.NewRandom(); err != nil {
32: 		ctx.Providers.OpenIDConnect.WriteIntrospectionError(ctx, rw, oauthelia2.ErrServerError)
33: 
34: 		return
35: 	}
36: 
37: 	ctx.GetLogger().Debugf("Introspection Request with id '%s' is being processed", requestID)
38: 
39: 	if responder, err = ctx.Providers.OpenIDConnect.NewIntrospectionRequest(ctx, req, oidc.NewSessionWithRequestedAt(ctx.GetClock().Now())); err != nil {
40: 		ctx.GetLogger().Errorf("Introspection Request with id '%s' failed with error: %s", requestID, oauthelia2.ErrorToDebugRFC6749Error(err))
41: 
42: 		ctx.Providers.OpenIDConnect.WriteIntrospectionError(ctx, rw, err)
43: 
44: 		return
45: 	}
46: 
47: 	ctx.GetLogger().Tracef("Introspection Request with id '%s' yielded a %s (active: %t) requested at %s created with request id '%s' on client with id '%s'", requestID, responder.GetTokenUse(), responder.IsActive(), responder.GetAccessRequester().GetRequestedAt().String(), responder.GetAccessRequester().GetID(), responder.GetAccessRequester().GetClient().GetID())
48: 
49: 	ctx.Providers.OpenIDConnect.WriteIntrospectionResponse(ctx, rw, responder)
50: }

