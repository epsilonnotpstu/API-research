189: // effectiveEnricherModels maps a flag's enabled effective enrichers to the API
190: // read model: its own flag-scoped enrichers plus the enabled server built-ins.
191: func effectiveEnricherModels(flag *entity.Flag) []*models.Enricher {
192: 	entries := enabledEnrichers(effectiveEnrichers(flag))
193: 	out := make([]*models.Enricher, 0, len(entries))
194: 	for i := range entries {
195: 		e := &entries[i]
196: 		namespace := e.namespace
197: 		enabled := e.enabled
198: 		out = append(out, &models.Enricher{
199: 			Namespace:  &namespace,
200: 			Scope:      string(e.scope),
201: 			Enabled:    &enabled,
202: 			Properties: e.properties,
203: 			Config:     e.config,
204: 		})
205: 	}
206: 	return out
207: }
208: 
209: // mapFlagWithEnrichers maps a flag and attaches its effective enricher catalog.
210: // It is the default for the e2rMapFlag indirection in crud.go; tests can still
211: // stub that var to bypass mapping entirely.
212: func mapFlagWithEnrichers(f *entity.Flag) (*models.Flag, error) {
213: 	r, err := e2r.MapFlag(f)
214: 	if err != nil {
215: 		return nil, err
216: 	}
217: 	r.Enrichers = effectiveEnricherModels(f)
218: 	return r, nil
219: }
220: 
221: // mapFlagsWithEnrichers maps flags and attaches each effective enricher catalog.
222: func mapFlagsWithEnrichers(fs []entity.Flag) ([]*models.Flag, error) {
223: 	ret := make([]*models.Flag, len(fs))
224: 	for i := range fs {
225: 		r, err := mapFlagWithEnrichers(&fs[i])
226: 		if err != nil {
227: 			return nil, err
228: 		}
229: 		ret[i] = r
230: 	}
231: 	return ret, nil
232: }

