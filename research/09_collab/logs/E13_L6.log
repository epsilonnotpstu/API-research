101: func (c *APIController) getImageMetadata(
102: 	ctx context.Context, registry *types.Registry, image string,
103: 	artifactType *artifact.ArtifactType,
104: ) (*types.ImageMetadata, error) {
105: 	img, err := c.ImageStore.GetByNameAndType(ctx, registry.ID, image, artifactType)
106: 	if err != nil {
107: 		return nil, err
108: 	}
109: 	downloadCount, err := c.DownloadStatRepository.GetTotalDownloadsForImage(ctx, img.ID)
110: 	if err != nil {
111: 		return nil, err
112: 	}
113: 	imgMetadata := &types.ImageMetadata{
114: 		Name:          image,
115: 		RegistryUUID:  registry.UUID,
116: 		UUID:          img.UUID,
117: 		DownloadCount: downloadCount,
118: 		RepoName:      registry.Name,
119: 		PackageType:   registry.PackageType,
120: 		CreatedAt:     img.CreatedAt,
121: 		ArtifactType:  img.ArtifactType,
122: 	}
123: 	//nolint:nestif
124: 	if registry.PackageType == artifact.PackageTypeDOCKER || registry.PackageType == artifact.PackageTypeHELM {
125: 		if c.UntaggedImagesEnabled(ctx) {
126: 			latestManifest, err := c.ManifestStore.GetLatestManifest(ctx, registry.ID, image)
127: 			if err != nil {
128: 				return nil, err
129: 			}
130: 			imgMetadata.LatestVersion = latestManifest.Digest.String()
131: 			imgMetadata.ModifiedAt = latestManifest.CreatedAt
132: 		} else {
133: 			latestTag, err := c.TagStore.GetLatestTag(ctx, registry.ID, image)
134: 			if err != nil {
135: 				return nil, err
136: 			}
137: 			imgMetadata.LatestVersion = latestTag.Name
138: 			imgMetadata.ModifiedAt = latestTag.UpdatedAt
139: 		}
140: 	} else {
141: 		latestArtifact, err := c.ArtifactStore.GetLatestByImageID(ctx, img.ID)
142: 		if err != nil {
143: 			return nil, err
144: 		}
145: 		imgMetadata.LatestVersion = latestArtifact.Version
146: 		imgMetadata.ModifiedAt = latestArtifact.UpdatedAt
147: 	}
148: 	return imgMetadata, nil
149: }

