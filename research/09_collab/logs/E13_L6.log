11: 		return 0, nil
12: 	}
13: 
14: 	maxDepth, err := strconv.ParseInt(q.Get("max-depth"), 0, 0)
15: 	if err != nil {
16: 		return 0, fmt.Errorf("unable to parse 'max-depth' query parameter to int: %s", err)
