51: // Logs the error and message, returns either the provided message.
52: // Always logs the full message with error as warning.
53: //
54: //nolint:unparam // revisit error processing
55: func ProcessSQLErrorf(ctx context.Context, err error, format string, args ...any) error {
56: 	// If it's a known error, return converted error instead.
57: 	translatedError := err
58: 	switch {
59: 	case errors.Is(err, sql.ErrNoRows):
60: 		translatedError = store.ErrResourceNotFound
61: 	case isSQLUniqueConstraintError(err):
62: 		translatedError = store.ErrDuplicate
63: 	case isSQLForeignKeyViolationError(err):
64: 		translatedError = store.ErrForeignKeyViolation
65: 	default:
66: 	}
67: 
68: 	//nolint:errorlint // we want to match exactly here.
69: 	if translatedError != err {
70: 		log.Ctx(ctx).Debug().Err(err).Msgf("translated sql error to: %s", translatedError)
71: 	}
72: 
73: 	return fmt.Errorf("%s: %w", fmt.Sprintf(format, args...), translatedError)
74: }

