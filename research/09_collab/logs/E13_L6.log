12: )
13: 
14: func ShouldBindJSONValidation(c echo.Context, obj interface{}, validate bool) error {
15: 	req := c.Request()
16: 
17: 	if req.ContentLength == 0 {
18: 		return fmt.Errorf("request doesn't contain any content")
19: 	}
20: 
21: 	ctype := req.Header.Get(echo.HeaderContentType)
22: 
23: 	if !strings.HasPrefix(ctype, echo.MIMEApplicationJSON) {
24: 		return fmt.Errorf("request doesn't contain JSON content")
25: 	}
26: 
27: 	body, err := io.ReadAll(req.Body)
28: 	if err != nil {
29: 		return err
30: 	}
31: 
32: 	if err := json.Unmarshal(body, obj); err != nil {
33: 		return json.FormatError(body, err)
34: 	}
35: 
36: 	if validate {
37: 		return c.Validate(obj)
38: 	}
39: 
40: 	return nil
41: }
42: 
43: // ShouldBindJSON binds the body data of the request to the given object. An error is
44: // returned if the body data is not valid JSON or the validation of the unmarshalled
45: // data failed.
46: func ShouldBindJSON(c echo.Context, obj interface{}) error {
47: 	return ShouldBindJSONValidation(c, obj, true)
48: }
49: 
50: func PathWildcardParam(c echo.Context) string {
51: 	return "/" + PathParam(c, "*")
52: }
53: 
54: func PathParam(c echo.Context, name string) string {
55: 	param := c.Param(name)
56: 
57: 	param, err := url.PathUnescape(param)
58: 	if err != nil {
59: 		return ""
60: 	}
61: 
62: 	return param
63: }
64: 
65: func DefaultQuery(c echo.Context, name, defValue string) string {
66: 	param := c.QueryParam(name)
67: 
68: 	if len(param) == 0 {
69: 		return defValue
70: 	}
71: 
72: 	param, err := url.QueryUnescape(param)
73: 	if err != nil {
74: 		return defValue
75: 	}
76: 
77: 	return param
78: }

