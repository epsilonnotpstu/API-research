181: 
182:         serviceFacade.authorizeAccess(lookup -> {
183:             final Authorizable parameterContext = lookup.getParameterContext(parameterContextId);
184:             final NiFiUser user = NiFiUserUtils.getNiFiUser();
185:             parameterContext.authorize(authorizer, RequestAction.READ, user);
186:             parameterContext.authorize(authorizer, RequestAction.WRITE, user);
187:         });
188:     }
