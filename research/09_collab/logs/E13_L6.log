459: 	if q == nil {
460: 		q = &RelationQuery{}
461: 	}
462: 
463: 	if query.Has("subject") {
464: 		return nil, errors.WithStack(ErrDroppedSubjectKey)
465: 	}
466: 
467: 	// reset subject
468: 	q.SubjectID = nil
469: 	q.SubjectSet = nil
470: 
471: 	switch {
472: 	case !query.Has(subjectIDKey) && !query.Has(subjectSetNamespaceKey) && !query.Has(subjectSetObjectKey) && !query.Has(subjectSetRelationKey):
473: 		// was not queried for the subject
474: 	case query.Has(subjectIDKey) && query.Has(subjectSetNamespaceKey) && query.Has(subjectSetObjectKey) && query.Has(subjectSetRelationKey):
475: 		return nil, errors.WithStack(ErrDuplicateSubject)
476: 	case query.Has(subjectIDKey):
477: 		q.SubjectID = pointerx.String(query.Get(subjectIDKey))
478: 	case query.Has(subjectSetNamespaceKey) && query.Has(subjectSetObjectKey) && query.Has(subjectSetRelationKey):
479: 		q.SubjectSet = &SubjectSet{
480: 			Namespace: query.Get(subjectSetNamespaceKey),
481: 			Object:    query.Get(subjectSetObjectKey),
482: 			Relation:  query.Get(subjectSetRelationKey),
483: 		}
484: 	default:
485: 		return nil, errors.WithStack(ErrIncompleteSubject)
486: 	}
487: 
488: 	q.Object = query.Get("object")
489: 	q.Relation = query.Get("relation")
490: 	q.Namespace = query.Get("namespace")
