39: // Validate checks storage invariants only: a namespace and well-formed JSON
40: // config. Namespace scope and config schema are validated by the handler
41: // registry, which owns the namespace implementations.
42: func (e *Enricher) Validate() error {
43: 	if e == nil {
44: 		return fmt.Errorf("enricher is required")
45: 	}
46: 	if strings.TrimSpace(e.Namespace) == "" {
47: 		return fmt.Errorf("enricher namespace is required")
48: 	}
49: 	if trimmed := strings.TrimSpace(e.ConfigJSON); trimmed != "" && !json.Valid([]byte(trimmed)) {
50: 		return fmt.Errorf("enricher config is not valid JSON")
51: 	}
52: 	return nil
53: }
54: 
55: // SetConfig marshals cfg into ConfigJSON for the given namespace.
56: func (e *Enricher) SetConfig(namespace string, cfg any) error {
57: 	if strings.TrimSpace(namespace) == "" {
58: 		return fmt.Errorf("enricher namespace is required")
59: 	}
60: 	b, err := json.Marshal(cfg)
61: 	if err != nil {
62: 		return fmt.Errorf("encoding enricher config: %w", err)
63: 	}
64: 	e.Namespace = namespace
65: 	e.ConfigJSON = string(b)
66: 	return nil
67: }
68: 
69: // DecodeConfig unmarshals ConfigJSON into dest.
70: func (e *Enricher) DecodeConfig(dest any) error {
71: 	if strings.TrimSpace(e.ConfigJSON) == "" {
72: 		return fmt.Errorf("enricher config is required")
73: 	}
74: 	if err := json.Unmarshal([]byte(e.ConfigJSON), dest); err != nil {
75: 		return fmt.Errorf("invalid enricher config: %w", err)
76: 	}
77: 	return nil
78: }

