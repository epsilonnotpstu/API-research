from pathlib import Path
import re
def clean(s):
    if re.search(r'@author|[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}|-----BEGIN .*PRIVATE KEY|(?i:password|secret|api[_-]?key|access[_-]?token)\\s*[:=]\\s*[\"\\']["'^"'"\\']+[\"\\']|authelia_(?:at|rt|id)_|eyJ[A-Za-z0-9_-]{20,}',s):
        return '[REDACTED credential-looking content or personal attribution]'
    return s
def show(path,a=1,b=None):
    ls=Path(path).read_text(errors='replace').splitlines()
    print('\\nFILE '+str(path))
    for n in range(max(1,a),min(len(ls),b or len(ls))+1): print(f'{n}: {clean(ls[n-1])}')
def scan(root,pattern,c=4):
    root=Path(root)
    paths=[root] if root.is_file() else sorted(p for p in root.rglob('*') if p.is_file())
    for p in paths:
        ls=p.read_text(errors='replace').splitlines()
        hits=[i for i,s in enumerate(ls) if re.search(pattern,s)]
        ns=set(j for i in hits for j in range(max(0,i-c),min(len(ls),i+c+1)))
        if ns:
            print('\\nFILE '+str(p))
            last=-2
            for j in sorted(ns):
                if j>last+1: print('...')
                print(f'{j+1}: {clean(ls[j])}'); last=j

