108: // effectiveEnrichers returns globals followed by the flag's own enrichers: the
109: // full catalog, including namespaces disabled by env (used by validation).
110: func effectiveEnrichers(flag *entity.Flag) []enricher {
111: 	return append(globalEnrichers(), flagEnrichers(flag)...)
112: }
113: 
114: // enabledEnrichers filters to enrichers whose env switch is on. This is the
115: // catalog the UI lists and the set the eval pipeline runs.
116: func enabledEnrichers(entries []enricher) []enricher {
117: 	out := make([]enricher, 0, len(entries))
118: 	for i := range entries {
119: 		if entries[i].enabled {
120: 			out = append(out, entries[i])
121: 		}
122: 	}
123: 	return out
124: }

