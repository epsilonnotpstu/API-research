34:   public Response toResponse(SubscriptionsException exception) {
35:     // Using a switch expression below forces us to decide on an HTTP status every time we add a new
36:     // ErrorCode.
37:     var status =
38:         switch (exception.getCode()) {
39:           case VALIDATION_FAILED_ERROR -> Status.BAD_REQUEST;
40:           default -> Status.INTERNAL_SERVER_ERROR;
41:         };
42:     return Response.status(status)
43:         .entity(
44:             new Error()
45:                 .code(exception.getCode().getCode())
46:                 .status(String.valueOf(status.getStatusCode()))
47:                 .title(exception.getMessage())
48:                 .detail(exception.getDetail()))
49:         .build();

