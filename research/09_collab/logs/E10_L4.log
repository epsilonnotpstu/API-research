12: @Slf4j
13: @RestControllerAdvice
14: @RequiredArgsConstructor
15: public class GlobalExceptionHandler {
16: 
17:     private final ApiErrorResponseCreator apiErrorResponseCreator;
18:     private final ErrorDebugMessageCreator errorDebugMessageCreator;
19: 
20:     @ExceptionHandler(MethodArgumentNotValidException.class)
21:     @ResponseStatus(HttpStatus.BAD_REQUEST)
22:     public ApiErrorResponse handleMethodArgumentNotValidException(final MethodArgumentNotValidException exception) {
23:         String message = exception
24:                 .getBindingResult()
25:                 .getAllErrors().stream()
26:                 .map(error -> String.format("{ ErrorMessage: %s }", error.getDefaultMessage()))
27:                 .toList()
28:                 .toString();
29: 
30:         ApiErrorResponse apiErrorResponse = apiErrorResponseCreator.buildResponse(message, HttpStatus.BAD_REQUEST);
31:         log.error("Handle method argument not valid exception: failed: message: {}, debugMessage: {}.",
32:                 message, errorDebugMessageCreator.buildErrorDebugMessage(exception));
33: 
34:         return apiErrorResponse;
35:     }
36: }
