63: // swagger:route GET /self-service/login/methods/password public completeSelfServiceLoginFlowWithPasswordMethod
64: //
65: // Complete Login Flow with Username/Email Password Method
66: //
67: // Use this endpoint to complete a login flow by sending an identity's identifier and password. This endpoint
68: // behaves differently for API and browser flows.
69: //
70: // API flows expect `application/json` to be sent in the body and responds with
71: //   - HTTP 200 and a application/json body with the session token on success;
72: //   - HTTP 302 redirect to a fresh login flow if the original flow expired with the appropriate error messages set;
73: //   - HTTP 400 on form validation errors.
74: //
75: // Browser flows expect `application/x-www-form-urlencoded` to be sent in the body and responds with
76: //   - a HTTP 302 redirect to the post/after login URL or the `return_to` value if it was set and if the login succeeded;
77: //   - a HTTP 302 redirect to the login UI URL with the flow ID containing the validation errors otherwise.
78: //
79: // More information can be found at [ORY Kratos User Login and User Registration Documentation](https://www.ory.sh/docs/next/kratos/self-service/flows/user-login-user-registration).
80: //
81: //     Schemes: http, https
82: //
83: //     Consumes:
84: //     - application/json
85: //     - application/x-www-form-urlencoded
86: //
87: //     Produces:
88: //     - application/json
89: //
90: //     Responses:
91: //       200: loginViaApiResponse
92: //       302: emptyResponse
93: //       400: loginFlow
94: //       500: genericError
95: func (s *Strategy) handleLogin(w http.ResponseWriter, r *http.Request, _ httprouter.Params) {

