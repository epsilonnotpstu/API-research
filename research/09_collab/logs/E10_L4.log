from pathlib import Path
import re
def safe(s):
    if re.search(r'(?i)(@author|copyright|SPDX-FileCopyrightText|[\\w.+-]+@[\\w.-]+\\.[a-z]{2,}|(?:password|secret|api[_-]?key|access[_-]?token)\\s*[:=]\\s*[\"\\x27]["'^"'"\\x27]+)',s):
        return '[REDACTED attribution/credential-looking line]'
    return s
def show(path, pattern=None, context=5):
    p=Path(path)
    lines=p.read_text().splitlines()
    hits=range(len(lines)) if pattern is None else [i for i,s in enumerate(lines) if re.search(pattern,s,re.I)]
    indexes=set()
    for i in hits:
        indexes.update(range(max(0,i-context),min(len(lines),i+context+1)))
    print('\\nFILE',path)
    for i in sorted(indexes): print(str(i+1)+': '+safe(lines[i]))
def scan(root, pattern, context=3, names=None):
    for p in sorted(Path(root).rglob('*')):
        if p.is_file() and (names is None or re.search(names,p.name)):
            try: content=p.read_text()
            except UnicodeError: continue
            if re.search(pattern,content,re.I): show(str(p),pattern,context)

