+          "mutated_file_sha256": sha(proof / "source" / site["file"]),
+          "java_compile": "not_run", "sut_execution": "not_run"}
+(OUT / "verification.json").write_text(json.dumps(result, indent=2) + "\n")
+print(json.dumps(result))

