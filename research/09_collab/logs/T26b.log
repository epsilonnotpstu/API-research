+        if build:
+            result = (os.path.relpath(directory, root), os.path.relpath(build, root))
+            break
+        if directory == directory.parent:
+            result = (None, None)
+            break
+        directory = directory.parent
+    else:
+        result = cache[directory]
+    for parent in walked:
+        cache[parent] = result
+    return result
