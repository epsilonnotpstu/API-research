+    bases = [document.get('basePath', '')]
+    bases.extend(urlsplit(s.get('url', '')).path for s in document.get('servers', []) if isinstance(s, dict))
+    return sorted({normalize(b) for b in bases if isinstance(b, str) and normalize(b) != '/'})
