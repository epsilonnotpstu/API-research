394:                     BridgeContentType.KAFKA_JSON, error.toJson().toBuffer());
395:             return;
396:         }
397: 
398:         this.setSubscribeHandler(subscribeResult -> {
399:             if (subscribeResult.succeeded()) {
400:                 HttpUtils.sendResponse(routingContext, HttpResponseStatus.NO_CONTENT.code(), null, null);
401:             }
402:         });
403: 
404:         if (bodyAsJson.containsKey("topics")) {
