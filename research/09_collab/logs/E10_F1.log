181:     private void doSeekTo(RoutingContext routingContext, JsonObject bodyAsJson, HttpOpenApiOperations seekToType) {
182:         JsonArray seekPartitionsList = bodyAsJson.getJsonArray("partitions");
183: 
184:         Set<TopicPartition> set = seekPartitionsList.stream()
185:                 .map(JsonObject.class::cast)
186:                 .map(json -> new TopicPartition(json.getString("topic"), json.getInteger("partition")))
187:                 .collect(Collectors.toSet());
188: 
189:         Handler<AsyncResult<Void>> seekHandler = done -> {
190:             if (done.succeeded()) {
191:                 HttpUtils.sendResponse(routingContext, HttpResponseStatus.NO_CONTENT.code(), null, null);
192:             } else {
193:                 int code = handleError(done.cause());
194:                 HttpBridgeError error = new HttpBridgeError(
195:                     code,
196:                     done.cause().getMessage()
197:                 );
198:                 HttpUtils.sendResponse(routingContext, code,
199:                         BridgeContentType.KAFKA_JSON, error.toJson().toBuffer());
200:             }
201:         };
202: 
203:         if (seekToType == HttpOpenApiOperations.SEEK_TO_BEGINNING) {
204:             this.seekToBeginning(set, seekHandler);
205:         } else {
206:             this.seekToEnd(set, seekHandler);
207:         }
208:     }
