"""Property checks for specmut over a folder of real specs (e.g. EMB openapi-swagger/).

Usage: python3 test_specmut.py SPEC_DIR
Checks, for every spec x fault class:
  1. the mutated spec serialises to JSON;
  2. locality: operations not listed in the manifest are byte-identical to the original;
  3. manifest fidelity: every recorded edit's `after` value is present at its pointer
     (or the key is absent when `after` is None);
  4. determinism: the same seed yields the same manifest.
"""
import glob
import json
import sys
from pathlib import Path

import specmut


def get(doc, pointer):
    node = doc
    for part in pointer.lstrip('/').split('/'):
        part = part.replace('~1', '/').replace('~0', '~')
        if isinstance(node, list):
            node = node[int(part)]
        elif isinstance(node, dict) and part in node:
            node = node[part]
        else:
            raise KeyError(pointer)
    return node


def check(spec_path, fault, severity=30, seed=7):
    base = specmut.load_spec(spec_path)
    mutated, manifest, n_ops = specmut.mutate(base, fault, severity, seed)
    json.dumps(mutated, default=str)
    touched = {(m['path'], m['method']) for m in manifest}
    if fault == 'METHOD_SEM':
        touched |= {(m['path'], e['after']) for m in manifest for e in m['edits']}
    for path, method, op in specmut.operations(base):
        if (path, method) not in touched:
            assert mutated['paths'][path].get(method) == op, f'locality broken at {method} {path}'
    for m in manifest:
        for e in m['edits']:
            if fault == 'METHOD_SEM':
                assert e['after'] in mutated['paths'][m['path']]
                continue
            try:
                value = get(mutated, e['pointer'])
                assert e['after'] is not None and value == e['after'], f'{e["pointer"]}: {value!r} != {e["after"]!r}'
            except KeyError:
                assert e['after'] is None, f'missing pointer {e["pointer"]}'
    again = specmut.mutate(base, fault, severity, seed)[1]
    assert again == manifest, 'non-deterministic'
    return n_ops, len(manifest), sum(len(m['edits']) for m in manifest)


def main(spec_dir):
    failures, rows = [], []
    for spec_path in sorted(glob.glob(f'{spec_dir}/*.json') + glob.glob(f'{spec_dir}/*.yaml')):
        fmt = 'oas3' if specmut.is_oas3(specmut.load_spec(spec_path)) else 'sw2'
        for fault in specmut.FAULTS:
            try:
                rows.append((Path(spec_path).stem, fmt, fault) + check(spec_path, fault))
            except Exception as exc:  # report and continue
                failures.append((Path(spec_path).stem, fault, repr(exc)[:200]))
    for r in rows:
        print(f'{r[0]:28s} {r[1]:4s} {r[2]:16s} ops={r[3]:4d} mutated={r[4]:3d} edits={r[5]:5d}')
    print(f'\n{len(rows)} passed, {len(failures)} failed')
    for f in failures:
        print('FAIL', *f)
    return 1 if failures else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1]))
"""End-to-end check of specmut -> conformance -> attribute in replay mode.

For every spec in SPEC_DIR and every fault class we synthesise exchanges from the
*original* spec (one schema-valid request/response per documented operation, with
an extra undeclared response property, plus a deliberately out-of-range variant),
check them against the original and the mutated spec, and attribute the diff.

Because traffic is identical in both checks, every NEW or VANISHED fingerprint
must sit on an operation listed in the manifest; anything else is a pipeline bug.

Usage: python3 test_pipeline.py SPEC_DIR
"""
import glob
import json
import sys
from pathlib import Path

import attribute
import conformance
import specmut


def instance(schema, depth=0):
    """Minimal schema-valid instance (best effort) for an inlined schema."""
    if not isinstance(schema, dict) or depth > 6:
        return None
    if 'enum' in schema and schema['enum']:
        return schema['enum'][0]
    for key in ('allOf', 'oneOf', 'anyOf'):
        if schema.get(key):
            return instance(schema[key][0], depth + 1)
    t = schema.get('type')
    if isinstance(t, list):
        t = next((x for x in t if x != 'null'), None)
    if t == 'object' or (t is None and 'properties' in schema):
        obj = {k: instance(v, depth + 1) for k, v in schema.get('properties', {}).items()}
        obj = {k: v for k, v in obj.items() if v is not None or k in schema.get('required', [])}
        return obj
    if t == 'array':
        item = instance(schema.get('items', {}), depth + 1)
        return [item] * max(1, schema.get('minItems', 1)) if item is not None else []
    if t in ('integer', 'number'):
        lo = schema.get('minimum', 1)
        hi = schema.get('maximum', lo + 10)
        val = lo if lo <= hi else hi
        return int(val) if t == 'integer' else float(val)
    if t == 'boolean':
        return True
    if t == 'string':
        fmt = schema.get('format')
        if fmt == 'date-time':
            return '2026-01-01T00:00:00Z'
        if fmt == 'date':
            return '2026-01-01'
        if fmt in ('uuid',):
            return '123e4567-e89b-12d3-a456-426614174000'
        if fmt == 'email':
            return 'a@b.co'
        n = max(1, schema.get('minLength', 1))
        return 'a' * min(n, schema.get('maxLength', n))
    return None


def exchanges_for(spec_obj):
    sp = conformance.Spec(spec_obj)
    out = []
    for template in spec_obj.get('paths', {}):
        for method in list(spec_obj['paths'][template]):
            if method not in specmut.HTTP_METHODS:
                continue
            op, params = sp.operation(template, method)
            path, query = sp.base + template, {}
            for p in params:
                schema = p.get('schema') or {k: p[k] for k in conformance.PARAM_SCHEMA_KEYS if k in p}
                val = instance(schema) if schema else 'a'
                if p.get('in') == 'path':
                    path = path.replace('{' + p['name'] + '}', str(val if val is not None else 'a'))
                elif p.get('in') == 'query':
                    query[p['name']] = [str(val).lower() if isinstance(val, bool) else str(val)]
            code = next((c for c in op.get('responses', {}) if str(c).startswith('2')), None)
            if code is None:
                continue
            _, schema = sp.response_schema(op, int(code))
            body = instance(schema) if schema else None
            if isinstance(body, dict):
                body['zz_undeclared'] = 1  # tolerated unless additionalProperties is false
            text = json.dumps(body) if body is not None else ''
            ex = {'request': {'method': method.upper(), 'path': path, 'query': query, 'headers': {},
                              'body': {'text': ''}},
                  'response': {'status': int(code), 'headers': {}, 'body': {'text': text, 'truncated': False}}}
            out.append(ex)
            if query:  # out-of-range variant: every query param gets a long string
                bad = json.loads(json.dumps(ex))
                bad['request']['query'] = {k: ['x' * 300] for k in query}
                out.append(bad)
    return out


def run(spec_path, fault, seed=3):
    base = specmut.load_spec(spec_path)
    mutated, manifest, _ = specmut.mutate(base, fault, 50, seed)
    exchanges = exchanges_for(base)
    b_spec, m_spec = conformance.Spec(base), conformance.Spec(mutated)
    b_viol = [v for ex in exchanges for v in conformance.check(b_spec, ex)]
    m_viol = [v for ex in exchanges for v in conformance.check(m_spec, ex)]
    rows = attribute.attribute(b_viol, m_viol, {'mutations': manifest})
    bad = [r for r in rows if r['status'] in ('NEW', 'VANISHED') and not r['op_mutated']]
    new = sum(r['status'] == 'NEW' for r in rows)
    gone = sum(r['status'] == 'VANISHED' for r in rows)
    return len(exchanges), len(manifest), new, gone, bad


def main(spec_dir):
    total_bad, summary = 0, {}
    for spec_path in sorted(glob.glob(f'{spec_dir}/*.json') + glob.glob(f'{spec_dir}/*.yaml')):
        for fault in specmut.FAULTS:
            try:
                n_ex, n_mut, new, gone, bad = run(spec_path, fault)
            except Exception as exc:
                print('ERROR', Path(spec_path).stem, fault, repr(exc)[:200])
                total_bad += 1
                continue
            s = summary.setdefault(fault, [0, 0, 0, 0])
            s[0] += n_mut; s[1] += new; s[2] += gone; s[3] += len(bad)
            for r in bad[:3]:
                print('UNEXPLAINED', Path(spec_path).stem, fault, r['status'], r['fingerprint'][:150])
            total_bad += len(bad)
    print('\nfault             mutated_ops  NEW  VANISHED  unexplained')
    for fault, (m, n, g, b) in summary.items():
        print(f'{fault:17s} {m:11d} {n:4d} {g:9d} {b:12d}')
    print('PASS' if total_bad == 0 else f'FAIL ({total_bad})')
    return 1 if total_bad else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1]))
"""Empirical look at the 147 confirmed faults of P001 (Martin-Lopez et al., FSE 2022) for R1.

Data: P001 supplementary material, Zenodo 10.5281/zenodo.6941292 (CC-BY 4.0), files
results-all/faultClustersConfirmedBugs_<api>.csv (one representative test per confirmed
fault, with full response body), additional/bugs_reported.csv, and the specs under
results-replication/resources/taas_eval/<API>/openapi.(yaml|json).

Outputs (to OUT_DIR):
  oas_violation_types.csv   violation-message types per OAS-disconformity fault (multi-label)
  developer_response.csv    reported / confirmed / fixed by P001 oracle category
  replay_agreement.csv      does tools/conformance.py reproduce P001's verdict per fault?
  summary.json              headline counts

Usage: python3 p001_oas_analysis.py P001_DIR OUT_DIR
"""
import glob
import json
import re
import sys
from collections import Counter
from pathlib import Path
from urllib.parse import unquote_plus

import pandas as pd

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'tools'))
import conformance  # noqa: E402
import specmut  # noqa: E402

MESSAGE_TYPES = [  # (type, regex on one ' --- '-separated message); order matters
    ('STATUS_UNDEFINED', r'Response status \d+ not defined'),
    ('CONTENT_TYPE', r'Content-Type header'),
    ('NO_BODY', r'no response body found'),
    ('MISSING_REQUIRED', r'missing required properties'),
    ('ADDITIONAL_PROPERTIES', r'not allowed by the schema'),
    ('TYPE_NULL', r'instance type \(null\) does not match'),
    ('TYPE_MISMATCH', r'instance type \(\w+\) does not match'),
    ('PATTERN', r'ECMA 262 regex'),
    ('ENUM', r'not found in enum'),
    ('FORMAT', r'invalid against requested date format|not a valid (email|hostname|IPv)'),
    ('NUMERIC_RANGE', r'numeric instance is (lower|greater|not strictly)'),
    ('LENGTH', r'is too (short|long)|array is too'),
    ('PARSE', r'Unable to parse JSON'),
    ('COMPOSITION', r'failed to match (exactly one|at least one|all required) schema'),
    ('INT_OVERFLOW', r'leads to overflow'),
]
CATEGORY_SHORT = {
    'OAS disconformity': 'F_OAS',
    'This faulty test case was expecting a 4XX status code(individual_parameter_constraint': 'F_2XXP',
    'This faulty test case was expecting a 4XX status code(inter_parameter_dependency': 'F_2XXD',
    "This test case's input was (possibly) correct": 'F_400',
    'Status code 5XX with invalid request': 'F_5XXI',
    'Status code 5XX with valid request': 'F_5XXV',
}
OUR_KIND_FOR = {'F_OAS': {'RESPONSE_SCHEMA', 'UNDOCUMENTED_STATUS', 'RESPONSE_CONTENT_TYPE', 'RESPONSE_PARSE'}, 'F_2XXP': {'INVALID_ACCEPTED'},
                'F_2XXD': {'INVALID_ACCEPTED'}, 'F_400': {'VALID_REJECTED'},
                'F_5XXI': {'SERVER_ERROR'}, 'F_5XXV': {'SERVER_ERROR'}}


def message_types(fail_reason):
    text = str(fail_reason).split(':', 1)[-1]
    types = set()
    for msg in filter(None, (m.strip() for m in text.split(' --- '))):
        types.add(next((t for t, rx in MESSAGE_TYPES if re.search(rx, msg, re.I)), 'OTHER'))
    return types


def kv(cell):
    if not isinstance(cell, str):
        return {}
    out = {}
    for part in filter(None, cell.split(';')):
        k, _, v = part.partition('=')
        out[unquote_plus(k)] = unquote_plus(v)
    return out


def exchange(row, spec):
    path = row['path']
    for k, v in kv(row['pathParameters']).items():
        path = path.replace('{' + k + '}', v)
    body = row['responseBody'] if isinstance(row['responseBody'], str) else ''
    return {'request': {'method': row['httpMethod'], 'path': spec.base + path,
                        'query': {k: [v] for k, v in kv(row['queryParameters']).items()},
                        'headers': {k.lower(): v for k, v in kv(row['headerParameters']).items()},
                        'body': {'text': row['bodyParameter'] if isinstance(row['bodyParameter'], str) else ''}},
            'response': {'status': int(row['statusCode']),
                         'headers': {'content-type': row['outputContentType_y']} if isinstance(row['outputContentType_y'], str) else {},
                         'body': {'text': body, 'truncated': False}}}


def main(p001_dir, out_dir):
    p001, out = Path(p001_dir), Path(out_dir)
    out.mkdir(parents=True, exist_ok=True)
    specs = {re.sub(r'__openapi\.(yaml|json)$', '', f.name).lower(): f for f in (p001 / 'specs').iterdir()}
    frames = []
    for f in sorted(glob.glob(str(p001 / 'faultClustersConfirmedBugs_*.csv'))):
        d = pd.read_csv(f, low_memory=False)
        d['api_file'] = Path(f).stem.split('_', 1)[1]
        frames.append(d)
    df = pd.concat(frames, ignore_index=True)
    df['oracle'] = df['failReasonCategory'].map(CATEGORY_SHORT).fillna('OTHER')

    # 1. violation-message types of OAS faults
    oas = df[df.oracle == 'F_OAS'].copy()
    oas['types'] = oas['failReason'].map(message_types)
    rows = [{'api': r.api_file, 'testCaseId': r.testCaseId, 'operation': f'{r.httpMethod} {r.path}',
             'status': r.statusCode, 'types': ';'.join(sorted(r.types))} for r in oas.itertuples()]
    pd.DataFrame(rows).to_csv(out / 'oas_violation_types.csv', index=False)
    type_counts = Counter(t for ts in oas['types'] for t in ts)

    # 2. developer response by oracle category
    bugs = pd.read_csv(p001 / 'bugs_reported.csv')
    j = df.merge(bugs, on='testCaseId', how='left', suffixes=('', '_bug'))
    def flag(col, val):
        return j[col].astype(str).str.lower().eq(val)
    j['dev_replied'], j['dev_confirmed'], j['dev_fixed'] = flag('replied', 'true'), flag('confirmed', 'true'), flag('fixed', 'true')
    dev = j.groupby('oracle').agg(faults=('testCaseId', 'size'), reported=('reported', lambda s: s.astype(str).str.lower().eq('true').sum()),
                                  replied=('dev_replied', 'sum'), confirmed=('dev_confirmed', 'sum'),
                                  fixed=('dev_fixed', 'sum')).reset_index()
    dev.to_csv(out / 'developer_response.csv', index=False)

    # 3. replay agreement with tools/conformance.py
    agree = []
    cache = {}
    for r in df.itertuples():
        key = r.api_file.lower()
        if key not in specs:
            continue
        row = {'api': r.api_file, 'testCaseId': r.testCaseId, 'p001_oracle': r.oracle,
               'p001_types': ';'.join(sorted(message_types(r.failReason))) if r.oracle == 'F_OAS' else ''}
        for mode, strict in (('default', False), ('strict', True)):
            if (key, mode) not in cache:
                cache[(key, mode)] = conformance.Spec(specmut.load_spec(str(specs[key])), strict_additional=strict)
            spec = cache[(key, mode)]
            try:
                kinds = {v['kind'] for v in conformance.check(spec, exchange(r._asdict(), spec))}
                err = ''
            except Exception as exc:  # keep going; report
                kinds, err = set(), repr(exc)[:120]
            row[f'our_kinds_{mode}'] = ';'.join(sorted(kinds))
            row[f'reproduced_{mode}'] = bool(kinds & OUR_KIND_FOR.get(r.oracle, set()))
            row[f'error_{mode}'] = err
        agree.append(row)
    ag = pd.DataFrame(agree)
    ag.to_csv(out / 'replay_agreement.csv', index=False)
    by_oracle = ag.groupby('p001_oracle')[['reproduced_default', 'reproduced_strict']].agg(['sum', 'size']).reset_index()
    by_oracle.columns = ['_'.join(c).strip('_') for c in by_oracle.columns]
    oas_ag = ag[ag.p001_oracle == 'F_OAS']
    addl = oas_ag[oas_ag.p001_types.str.contains('ADDITIONAL_PROPERTIES')]

    summary = {
        'faults_total': int(len(df)), 'faults_by_oracle': df['oracle'].value_counts().to_dict(),
        'oas_faults_by_message_type': dict(type_counts.most_common()),
        'oas_faults_multi_type': int((oas['types'].map(len) > 1).sum()),
        'developer_response': dev.to_dict(orient='records'),
        'replay_reproduced_by_oracle': by_oracle.to_dict(orient='records'),
        'replay_errors': int((ag['error_default'] != '').sum() + (ag['error_strict'] != '').sum()),
        'additional_properties_faults': {'n': int(len(addl)),
                                         'reproduced_default': int(addl.reproduced_default.sum()),
                                         'reproduced_strict': int(addl.reproduced_strict.sum())},
    }
    (out / 'summary.json').write_text(json.dumps(summary, indent=1, default=int))
    print(json.dumps(summary, indent=1, default=int))


if __name__ == '__main__':
    main(*sys.argv[1:3])

