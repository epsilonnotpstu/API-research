+KEYWORDS_FOR = {
+    'MISSING_REQUIRED': 'required', 'ADDITIONAL_PROPERTIES': 'additionalProperties',
+    'TYPE_NULL': 'type', 'TYPE_MISMATCH': 'type', 'PATTERN': 'pattern',
+    'ENUM': 'enum', 'FORMAT': 'format', 'STATUS_UNDEFINED': 'UNDOCUMENTED_STATUS',
