+        props = ['']
+        if typ in ('MISSING_REQUIRED', 'ADDITIONAL_PROPERTIES'):
+            tail = message.split('properties', 1)[-1]
+            props = re.findall(r'"([^"\n]*)"', tail) or ['UNMAPPED_PROPERTY']
+        for prop in props:
