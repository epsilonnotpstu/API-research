+                for e in document_edits(b, a, pointer + ptr(i))]
+    return [{'pointer': pointer, 'op': 'replace', 'before_exists': True, 'after_exists': True,
+             'before': copy.deepcopy(before), 'after': copy.deepcopy(after)}]
