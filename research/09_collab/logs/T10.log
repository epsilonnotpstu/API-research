+def apply_manifest(base, manifest):
+    """Verify every before-value and reconstruct the complete output document."""
+    import copy
+    doc = copy.deepcopy(base)
+    for m in manifest:
+        for e in m['edits']:
+            if e.get('op') == 'move':
+                item = doc['paths'][m['path']]
+                assert item[e['before']] == e['value']
