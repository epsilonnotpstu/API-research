+all_meta = {p.parent.resolve(): read(p) for p in RUNS.glob('*/*_baseline_NONE_p0_s*/run.json')}
+matches = []
+equality_fields = ('sut_image', 'sut_jar_sha256', 'source_sha256', 'request_timeout_ms',
