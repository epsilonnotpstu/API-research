    43	        spec = c.Spec(json.load(open(spec_path)), deploy_origin=f'http://{SERVICE[sut]}:8080')
    44	        out, n = [], 0
    45	        for line in open(run / 'exchanges.jsonl'):
    46	            out.extend(c.check(spec, json.loads(line)))
    47	            n += 1
    48	        if not cache:
    49	            return out, n
    50	        _cache.clear() if len(_cache) > 4 else None
    51	        _cache[key] = (out, n)
    52	    return _cache[key]
    53	
    54	
    55	def counts(rows):
