     1	#!/usr/bin/env python3
     2	"""Traffic-trajectory overlap: mutated run vs its paired baseline, and the same-seed replicate (Claude, 2026-11-15).
     3	
     4	Why: EvoMaster with a fixed seed is nearly deterministic. Same-seed replicate baselines repeat the baseline's request
     5	sequence almost exactly (cwa: byte-equal request sequence). A mutated run, though, changes the generator input
     6	(the mutated spec), and that can move the search trajectory away from the baseline. Which noise reference fits
     7	depends on how far the mutated run's traffic diverges:
     8	  - near-identical traffic (e.g. RESPONSE_ORACLE): fresh ~ replay on the same traffic -> the same-seed reference fits;
     9	  - diverged traffic: the trajectory is effectively a different one -> the cross-seed reference fits better.
    10	The conservative rule, 'beyond_both', requires checkable NEW > max(cross-seed ref, same-seed ref when available).
    11	
    12	Request key = (method, path, sorted query JSON, body text[:2000], response status).
    13	Positional identity = share of index-aligned exchanges with an equal key, over min(len).
    14	Jaccard = |A∩B| / |A∪B| over the distinct-key sets.
    15	Output: fuzzer_trajectory_overlap.csv and a summary on stdout. Offline, reads runs only, own Python only.
    16	"""
    17	import csv
    18	import json
    19	from collections import defaultdict
    20	from pathlib import Path
    21	
    22	HERE = Path(__file__).resolve().parent
    23	RUNS = HERE.parent / 'runs'
    24	
    25	
    26	def seq(run):
    27	    out = []
    28	    for line in open(run / 'exchanges.jsonl'):
    29	        e = json.loads(line)
    30	        rq, rs = e.get('request') or {}, e.get('response') or {}
    31	        out.append((rq.get('method'), rq.get('path'), json.dumps(rq.get('query'), sort_keys=True),
    32	                    str(rq.get('body'))[:2000], rs.get('status')))
    33	    return out
    34	
    35	
    36	def overlap(a, b):
    37	    n = min(len(a), len(b))
    38	    pos = sum(x == y for x, y in zip(a, b)) / n if n else 0.0
    39	    sa, sb = set(a), set(b)
    40	    jac = len(sa & sb) / len(sa | sb) if sa | sb else 0.0
    41	    return round(pos, 3), round(jac, 3)
    42	
    43	
    44	def baseline_of(run):
    45	    inputs = [p for p in run.glob('analysis-*/inputs.txt') if not p.parent.name.endswith('-sut')]
