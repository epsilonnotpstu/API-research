index 0000000000000000000000000000000000000000..92747179078dee33b9d6e7309661e9db86582411
--- /dev/null
+++ b/research/09_collab/logs/T34_scratch/codex/key_probes.py
@@ -0,0 +1,64 @@
+"""Synthetic checks of the reviewed trajectory key; fixtures contain no secrets."""
+import copy
+import importlib.util
+import json
+import statistics
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[4]
+HERE = Path(__file__).resolve().parent
+path = ROOT / '08_experiments/E1_pilot/pilot_results/fuzzer_trajectory_overlap.py'
+spec = importlib.util.spec_from_file_location('reviewed_trajectory', path)
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+
+
+def key(e, label):
+    p = HERE / 'fixtures' / label
+    p.mkdir(parents=True, exist_ok=True)
+    (p / 'exchanges.jsonl').write_text(json.dumps(e) + '\n')
+    return module.seq(p)[0]
+
+
+base = {'request': {'method': 'POST', 'origin': 'http://example.test:8080', 'path': '/items', 'query': {},
+                    'headers': {'content-type': 'application/json'},
+                    'body': {'text': '{}', 'truncated': False, 'size': 2, 'base64': 'e30=', 'decode_error': False}},
+        'response': {'status': 200, 'body': {'text': '{"ok":true}'}}}
+results = {}
+a = key(base, 'base')
+e = copy.deepcopy(base)
+e['response']['status'] = 500
+results['identical_request_different_response_status_key_equal'] = a == key(e, 'response_status')
+e = copy.deepcopy(base)
+e['request']['headers']['content-type'] = 'text/plain'
+results['different_content_type_key_equal'] = a == key(e, 'content_type')
+e = copy.deepcopy(base)
+e['request']['origin'] = 'http://other.test:8080'
+results['different_origin_key_equal'] = a == key(e, 'origin')
+e = copy.deepcopy(base)
+e['response']['body']['text'] = '{"ok":false}'
+results['different_response_body_key_equal'] = a == key(e, 'response_body')
+e = copy.deepcopy(base)
+e['request']['body'] = dict(reversed(list(e['request']['body'].items())))
+results['same_body_object_reordered_metadata_key_equal'] = a == key(e, 'body_order')
+e = copy.deepcopy(base)
+e['request']['body']['text'] = 'x' * 2500 + 'A'
+e['request']['body']['size'] = 2501
+f = copy.deepcopy(e)
+f['request']['body']['text'] = 'x' * 2500 + 'B'
+results['distinct_body_tail_key_equal'] = key(e, 'tail_a') == key(f, 'tail_b')
+results['prefix_versus_prefix_plus_99_extra_requests_overlap'] = module.overlap([a], [a] * 100)
+results['printed_median_of_0_and_1'] = sorted([0.0, 1.0])[2 // 2]
+results['correct_median_of_0_and_1'] = statistics.median([0.0, 1.0])
+assert results == {
+    'identical_request_different_response_status_key_equal': False,
+    'different_content_type_key_equal': True,
+    'different_origin_key_equal': True,
+    'different_response_body_key_equal': True,
+    'same_body_object_reordered_metadata_key_equal': False,
+    'distinct_body_tail_key_equal': True,
+    'prefix_versus_prefix_plus_99_extra_requests_overlap': (1.0, 1.0),
+    'printed_median_of_0_and_1': 1.0, 'correct_median_of_0_and_1': 0.5,
+}
+(HERE / 'key_probes.json').write_text(json.dumps(results, indent=2) + '\n')
+print(json.dumps(results, indent=2))
diff --git a/research/09_collab/logs/T34_scratch/codex/recount.py b/research/09_collab/logs/T34_scratch/codex/recount.py
new file mode 100644
index 0000000000000000000000000000000000000000..98adea2b9cb7c8da850230f46339eb821e80e9bd
--- /dev/null
+++ b/research/09_collab/logs/T34_scratch/codex/recount.py
@@ -0,0 +1,106 @@
+"""Independent CSV-only T34 recount. No project imports or exchange reads."""
+import csv
+import hashlib
+import itertools
+import json
+from collections import Counter, defaultdict
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[4]
+HERE = Path(__file__).resolve().parent
+RESULTS = ROOT / '08_experiments/E1_pilot/pilot_results'
+NAMES = ['fuzzer_compare', 'fuzzer_noise_cross_seed', 'fuzzer_controlled_cells',
+         'fuzzer_noise_same_seed', 'fuzzer_trajectory_overlap']
+tables = {n: list(csv.DictReader((RESULTS / (n + '.csv')).open())) for n in NAMES}
+checks = Counter()
+
+
+def check(test):
+    checks['assertions'] += 1
+    assert test
+
+
+cross = {r['run']: r for r in tables['fuzzer_noise_cross_seed']}
+same = {r['run']: r for r in tables['fuzzer_noise_same_seed']}
+source = {r['run']: r for r in tables['fuzzer_compare']}
+groups = defaultdict(lambda: defaultdict(list))
+for r in cross.values():
+    groups[tuple(r[k] for k in ('sut', 'fault', 'severity', 'seed'))][r['fuzzer']].append(r)
+expected = {}
+for k, g in groups.items():
+    for e, s in itertools.product(g['evomaster'], g['schemathesis']):
+        expected[e['run'], s['run']] = (k, e['manifest_sig'] == s['manifest_sig'])
+check(len(expected) == len(tables['fuzzer_controlled_cells']))
+controlled = defaultdict(lambda: [0, 0, 0])
+uses = defaultdict(Counter)
+for line, r in enumerate(tables['fuzzer_controlled_cells'], 2):
+    e, s = cross[r['evo_run']], cross[r['sch_run']]
+    k, ctl = expected[r['evo_run'], r['sch_run']]
+    check(tuple(r[x] for x in ('sut', 'fault', 'severity', 'seed')) == k)
+    check((r['controlled'] == 'True') == ctl)
+    check(int(r['evo_fresh_checkable_NEW']) == int(e['fresh_mut_NEW_checkable']))
+    check(int(r['sch_fresh_checkable_NEW']) == int(s['fresh_mut_NEW_checkable']))
+    es = int(e['fresh_mut_NEW_checkable']) > int(e['noise_max_mut_NEW_checkable'])
+    ss = int(s['fresh_mut_NEW_checkable']) > int(s['noise_max_mut_NEW_checkable'])
+    check((r['evo_signal'] == 'True') == es)
+    check((r['sch_signal'] == 'True') == ss)
+    a = controlled[(r['controlled'], r['sut'], r['fault'])]
+    a[0] += es
+    a[1] += ss
+    a[2] += 1
+    uses[r['controlled']][r['evo_run']] += 1
+
+same_totals = defaultdict(lambda: [0, 0, 0])
+for r in same.values():
+    b = int(r['fresh_mut_NEW_checkable']) > int(r['same_seed_max_NEW_checkable'])
+    check((r['beyond_same_seed_ref'] == 'True') == b)
+    check(r['fresh_mut_NEW_checkable'] == source[r['run']]['fresh_mut_NEW_checkable'])
+    a = same_totals[r['sut'], r['fault']]
+    a[0] += b
+    a[1] += 1
+    a[2] = max(a[2], int(r['same_seed_max_NEW_checkable']))
+
+trajectory = defaultdict(list)
+for r in tables['fuzzer_trajectory_overlap']:
+    x = source[r['run']]
+    check(r['fresh_mut_NEW_checkable'] == x['fresh_mut_NEW_checkable'])
+    cr, sr = cross.get(r['run']), same.get(r['run'])
+    refs = []
+    for row, field, val_field, flag in [(cr, 'noise_max_mut_NEW_checkable', 'cross_ref_max', 'beyond_cross'),
+                                       (sr, 'same_seed_max_NEW_checkable', 'same_ref_max', 'beyond_same')]:
+        if row:
+            ref = int(row[field])
+            refs.append(ref)
+            check(int(r[val_field]) == ref)
+            check((r[flag] == 'True') == (int(x['fresh_mut_NEW_checkable']) > ref))
+        else:
+            check(r[flag] == '' and r[val_field] == '')
+    check((r['beyond_both'] == 'True') == (int(x['fresh_mut_NEW_checkable']) > max(refs)))
+    trajectory[r['fuzzer'], r['fault']].append(r)
+
+summary = {
+    'row_counts': {n: len(t) for n, t in tables.items()},
+    'controlled_by_sut_fault': [{'controlled': k[0], 'sut': k[1], 'fault': k[2],
+                               'evo_beyond': v[0], 'sch_beyond': v[1], 'pairs': v[2]}
+                              for k, v in sorted(controlled.items())],
+    'controlled_totals': {ctl: {'evo_beyond': sum(v[0] for k, v in controlled.items() if k[0] == ctl),
+                              'sch_beyond': sum(v[1] for k, v in controlled.items() if k[0] == ctl),
+                              'pairs': sum(v[2] for k, v in controlled.items() if k[0] == ctl),
+                              'unique_evo_runs': len(uses[ctl]),
+                              'repeated_evo_runs': {k: v for k, v in uses[ctl].items() if v > 1}}
+                          for ctl in ('True', 'False')},
+    'same_seed_by_sut_fault': [{'sut': k[0], 'fault': k[1], 'beyond': v[0], 'runs': v[1], 'max_ref': v[2]}
+                             for k, v in sorted(same_totals.items())],
+    'same_seed_total_beyond': sum(v[0] for v in same_totals.values()),
+    'replicate_counts': dict(Counter(r['replicates'] for r in same.values())),
+    'trajectory': [{'fuzzer': k[0], 'fault': k[1], 'runs': len(a),
+                    'true_median_pos': __import__('statistics').median(float(x['pos_identity_vs_base']) for x in a),
+                    'true_median_jaccard': __import__('statistics').median(float(x['jaccard_vs_base']) for x in a),
+                    **{flag: [sum(x[flag] == 'True' for x in a), sum(x[flag] != '' for x in a)]
+                       for flag in ('beyond_cross', 'beyond_same', 'beyond_both')}}
+                   for k, a in sorted(trajectory.items())],
+    'checks': dict(checks),
+    'input_sha256': {n + '.csv': hashlib.sha256((RESULTS / (n + '.csv')).read_bytes()).hexdigest() for n in NAMES},
+}
+(HERE / 'recount.json').write_text(json.dumps(summary, indent=2) + '\n')
+print(json.dumps(summary, indent=2))
diff --git a/research/09_collab/logs/T34_scratch/codex/spot_check.py b/research/09_collab/logs/T34_scratch/codex/spot_check.py
new file mode 100644
index 0000000000000000000000000000000000000000..4950e1ea9601764a737b39dcd51ae9f8766b97d8
--- /dev/null
+++ b/research/09_collab/logs/T34_scratch/codex/spot_check.py
@@ -0,0 +1,142 @@
+"""Exactly three T34 rows: small cwa/market runs; independent fingerprint-set recount.
+
+Only the repository's checker is reused. No raw requests, bodies or headers are emitted.
+"""
+import csv
+import hashlib
+import json
+import re
+import sys
+from collections import Counter
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[4]
+HERE = Path(__file__).resolve().parent
+RESULTS = ROOT / '08_experiments/E1_pilot/pilot_results'
+RUNS = RESULTS.parent / 'runs'
+sys.path.insert(0, str(ROOT / '08_experiments/tools'))
+import conformance as checker
+
+checker.INT_FORMATS = True
+tables = {name: {r['run']: r for r in csv.DictReader((RESULTS / (name + '.csv')).open())}
+          for name in ['fuzzer_compare', 'fuzzer_noise_same_seed', 'fuzzer_noise_cross_seed', 'fuzzer_trajectory_overlap']}
+all_matches = json.loads((HERE / 'replicate_matches.json').read_text())
+targets = [('cwa-verification', 'RESPONSE_ORACLE', '1'), ('market', 'RESPONSE_ORACLE', '2'),
+           ('market', 'REQUEST_STRICT', '2')]
+cache = {}
+inputs = {}
+assertions = 0
+
+
+def assert_equal(a, b):
+    global assertions
+    assertions += 1
+    assert a == b, (a, b)
+
+
+def canonical(x):
+    return json.dumps(x, sort_keys=True, separators=(',', ':'))
+
+
+def evaluate(run, spec_path, sut):
+    key = str(run), str(spec_path)
+    if key in cache:
+        return cache[key]
+    spec = checker.Spec(json.loads(spec_path.read_text()), deploy_origin=f'http://sut-{sut}:8080')
+    violations, oldkeys, fullkeys, req_only_keys, details = {}, [], [], [], Counter()
+    body_prefixes = {}
+    for line in (run / 'exchanges.jsonl').open():
+        e = json.loads(line)
+        rq, rs = e.get('request') or {}, e.get('response') or {}
+        for v in checker.check(spec, e):
+            if v['fingerprint'] not in violations:
+                violations[v['fingerprint']] = [v, 0]
+            violations[v['fingerprint']][1] += 1
+        body = rq.get('body')
+        body_text = body.get('text', '') if isinstance(body, dict) else str(body)
+        details['body_repr_over_2000'] += len(str(body)) > 2000
+        details['body_truncated_by_logger'] += bool(isinstance(body, dict) and body.get('truncated'))
+        details['requests'] += 1
+        old = (rq.get('method'), rq.get('path'), json.dumps(rq.get('query'), sort_keys=True),
+               str(body)[:2000], rs.get('status'))
+        oldkeys.append(old)
+        # Hash only in-memory comparison keys; do not emit sensitive request data.
+        fullkeys.append(hashlib.sha256(canonical(rq).encode()).hexdigest())
+        req_only_keys.append(old[:-1])
+        bh = hashlib.sha256(body_text.encode()).hexdigest()
+        body_prefixes.setdefault(old, set()).add(bh)
+    details['old_key_groups_with_distinct_full_body'] = sum(len(x) > 1 for x in body_prefixes.values())
+    p = run / 'exchanges.jsonl'
+    inputs[str(p.relative_to(ROOT))] = {'sha256': hashlib.sha256(p.read_bytes()).hexdigest(),
+                                       'lines': details['requests']}
+    out = violations, oldkeys, fullkeys, req_only_keys, dict(details)
+    cache[key] = out
+    return out
+
+
+def compare(a, b, manifest):
+    ops = {(m['method'].upper(), m['path']) for m in manifest['mutations']}
+    ops |= {(str(e['after']).upper(), m['path']) for m in manifest['mutations']
+            if m['fault'] == 'METHOD_SEM' for e in m['edits']}
+    counts = Counter()
+    for fp, (v, n) in b.items():
+        side = 'mut' if (v['method'], v['template']) in ops else 'unmut'
+        if fp not in a:
+            counts[side + '_NEW'] += 1
+            counts[side + '_NEW_checkable'] += not v['kind'].endswith('_UNCHECKABLE')
+        elif n > a[fp][1]:
+            counts[side + '_INCREASED'] += 1
+        elif n < a[fp][1]:
+            counts[side + '_DECREASED'] += 1
+    return counts
+
+
+def overlap(a, b):
+    n = min(len(a), len(b))
+    s, t = set(a), set(b)
+    return [round(sum(x == y for x, y in zip(a, b)) / n, 3) if n else 0,
+            round(len(s & t) / len(s | t), 3) if s | t else 0]
+
+
+out = []
+for sut, fault, seed in targets:
+    r = next(r for r in tables['fuzzer_compare'].values() if
+             (r['sut'], r['fault'], r['seed'], r['fuzzer']) == (sut, fault, seed, 'evomaster'))
+    run = RUNS / sut / r['run']
+    match = next(x for x in all_matches if x['run'] == r['run'])
+    base, rep = [RUNS / sut / match[k] for k in ('baseline', 'replicate')]
+    manifest = json.loads((run / 'manifest.json').read_text())
+    bv, bk, bf, bq, bd = evaluate(base, base / 'spec.original.json', sut)
+    mv, mk, mf, mq, md = evaluate(run, run / 'spec.test.json', sut)
+    rv, _, _, _, _ = evaluate(base, run / 'spec.test.json', sut)
+    pv, pk, pf, pq, pd = evaluate(rep, rep / 'spec.original.json', sut)
+    fresh, replay, same = [compare(bv, x, manifest) for x in (mv, rv, pv)]
+    assert_equal(len(bk), int(r['baseline_exchanges']))
+    assert_equal(len(mk), int(r['mutated_exchanges']))
+    for k in ('mut_NEW', 'mut_NEW_checkable', 'mut_INCREASED', 'unmut_NEW', 'unmut_INCREASED', 'unmut_DECREASED'):
+        assert_equal(fresh[k], int(r['fresh_' + k]))
+    assert_equal(replay['mut_NEW'], int(r['replay_mut_NEW']))
+    assert_equal(sum(replay[k] for k in ('unmut_NEW', 'unmut_INCREASED', 'unmut_DECREASED')), int(r['replay_unmut_changes']))
+    sr = tables['fuzzer_noise_same_seed'][r['run']]
+    assert_equal(same['mut_NEW'], int(sr['same_seed_max_NEW']))
+    assert_equal(same['mut_NEW_checkable'], int(sr['same_seed_max_NEW_checkable']))
+    peers = [p for p in sorted(base.parent.glob(re.match(r'(.*_baseline_NONE_p0_s)\d+$', base.name).group(1) + '*'))
+             if p != base and (p / 'exchanges.jsonl').is_file() and json.loads((p / 'run.json').read_text()).get('complete')]
+    peer_counts = [compare(bv, evaluate(p, p / 'spec.original.json', sut)[0], manifest) for p in peers]
+    cr = tables['fuzzer_noise_cross_seed'][r['run']]
+    assert_equal(max(x['mut_NEW_checkable'] for x in peer_counts), int(cr['noise_max_mut_NEW_checkable']))
+    tr = tables['fuzzer_trajectory_overlap'][r['run']]
+    assert_equal(overlap(bk, mk), [float(tr['pos_identity_vs_base']), float(tr['jaccard_vs_base'])])
+    out.append({'sut': sut, 'fault': fault, 'seed': seed, 'run': run.name,
+                'baseline': base.name, 'replicate': rep.name, 'cross_peers': [p.name for p in peers],
+                'fresh_counts': dict(fresh), 'replay_counts': dict(replay), 'same_counts': dict(same),
+                'cross_checkable_NEW': [x['mut_NEW_checkable'] for x in peer_counts],
+                'sequence_lengths': [len(bk), len(mk), len(pk)],
+                'old_key_overlap_mutated': overlap(bk, mk), 'full_request_overlap_mutated': overlap(bf, mf),
+                'request_only_overlap_mutated': overlap(bq, mq),
+                'old_key_overlap_replicate': overlap(bk, pk), 'full_request_overlap_replicate': overlap(bf, pf),
+                'full_request_sequence_equal_replicate': bf == pf,
+                'body_key_details': {'baseline': bd, 'mutated': md, 'replicate': pd}})
+result = {'row_count': len(out), 'assertions': assertions, 'rows': out, 'raw_inputs': inputs}
+(HERE / 'spot_check.json').write_text(json.dumps(result, indent=2) + '\n')
+print(json.dumps({k: v for k, v in result.items() if k != 'raw_inputs'}, indent=2))
diff --git a/research/09_collab/logs/T34_scratch/codex/verify_logs.py b/research/09_collab/logs/T34_scratch/codex/verify_logs.py
new file mode 100644
index 0000000000000000000000000000000000000000..7f98967c6c37386d1f6aced375b36f3e91c295a6
--- /dev/null
+++ b/research/09_collab/logs/T34_scratch/codex/verify_logs.py
@@ -0,0 +1,49 @@
+"""Compare independent recount with Claude stdout, without reading exchanges."""
+import json
+import re
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+s = json.loads((HERE / 'recount.json').read_text())
+cc = (HERE.parent / 'claude_run_cc.log').read_text().splitlines()
+ss = (HERE.parent / 'claude_run_ss.log').read_text().splitlines()
+checks = 0
+ctl = None
+for line in cc:
+    if line.startswith('== controlled'):
+        ctl = 'True'
+    elif line.startswith('== manifest'):
+        ctl = 'False'
+    m = re.match(r'\s+(\S+)\s+(\S+)\s+\| EvoMaster (\d+)/(\d+) \| Schemathesis (\d+)/(\d+)', line)
+    if m:
+        sut, fault, e, n, sch, n2 = m.groups()
+        row = next(x for x in s['controlled_by_sut_fault'] if (x['controlled'], x['sut'], x['fault']) == (ctl, sut, fault))
+        assert [int(e), int(sch), int(n), int(n2)] == [row['evo_beyond'], row['sch_beyond'], row['pairs'], row['pairs']]
+        checks += 1
+    m = re.match(r'\s+TOTAL \| EvoMaster (\d+)/(\d+) \| Schemathesis (\d+)/(\d+)', line)
+    if m:
+        e, n, sch, n2 = map(int, m.groups())
+        row = s['controlled_totals'][ctl]
+        assert [e, sch, n, n2] == [row['evo_beyond'], row['sch_beyond'], row['pairs'], row['pairs']]
+        checks += 1
+for line in ss:
+    m = re.match(r'\s+(\S+)\s+(\S+)\s+\| (\d+) \| (\d+)/(\d+) \| (\d+)$', line)
+    if m:
+        sut, fault, n, b, n2, maxref = m.groups()
+        row = next(x for x in s['same_seed_by_sut_fault'] if (x['sut'], x['fault']) == (sut, fault))
+        assert list(map(int, [n, b, n2, maxref])) == [row['runs'], row['beyond'], row['runs'], row['max_ref']]
+        checks += 1
+assert checks == 35
+hashes = json.loads((HERE / 'reviewed_hashes.json').read_text())
+root = HERE.parents[3]
+import hashlib
+unchanged = all(hashlib.sha256((root / p).read_bytes()).hexdigest() == h for p, h in hashes.items())
+assert unchanged
+for name, h in s['input_sha256'].items():
+    assert hashlib.sha256((root / '08_experiments/E1_pilot/pilot_results' / name).read_bytes()).hexdigest() == h
+result = {'stdout_group_and_total_checks': checks, 'csv_assertions': s['checks']['assertions'],
+          'protected_files': len(hashes), 'protected_hashes_unchanged': unchanged,
+          'spot_check_rows': 3, 'spot_check_assertions': json.loads((HERE / 'spot_check.json').read_text())['assertions'],
+          'raw_exchange_files_read_in_spot_check': len(json.loads((HERE / 'spot_check.json').read_text())['raw_inputs'])}
+(HERE / 'verification.json').write_text(json.dumps(result, indent=2) + '\n')
+print(json.dumps(result, indent=2))

