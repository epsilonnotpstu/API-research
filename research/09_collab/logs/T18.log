index 0000000000000000000000000000000000000000..8a347b03dd23d2cb8ca449f63cb0f4af1a4e21cf
--- /dev/null
+++ b/research/09_collab/logs/T18_scratch/audit.py
@@ -0,0 +1,125 @@
+"""Audit every captured T18 diagnostic without retaining credential values."""
+import collections
+import hashlib
+import json
+from pathlib import Path
+import re
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from replay import OUT, ROOT, RUN, SOURCE, save
+
+
+def main():
+    xs = [json.loads(s) for s in (RUN / 'exchanges.jsonl').read_text().splitlines()]
+    mapping = json.loads((OUT / 'exchange_map.json').read_text())
+    cases = []
+    reasons = collections.Counter()
+    for iid, lines in mapping.items():
+        for n in lines:
+            x = xs[n - 1]
+            req, resp = x['request'], x['response']
+            invalid_headers = {k: sorted({ord(c) for c in value
+                                         if (ord(c) < 32 and c != '\t') or ord(c) == 127})
+                               for k, value in req['headers'].items()}
+            invalid_headers = {k: v for k, v in invalid_headers.items() if v}
+            record = {'item_id': iid, 'exchange_line': n,
+                      'invalid_header_control_codepoints': invalid_headers}
+            text = req.get('body', {}).get('text', '')
+            body = json.loads(text) if text else None
+            if iid == 'C001':
+                assert 'x-schemathesis-probe' in req['headers']
+                assert 'x-schemathesis-probe-null' in invalid_headers
+                label, category, roots = 'TEST', 'capability_probe', ['RC01']
+            elif iid == 'C002':
+                assert isinstance(body, dict)
+                missing = [k for k in ('key', 'keyType') if k not in body]
+                pattern = []
+                if body.get('keyType') == 'GUID' and isinstance(body.get('key'), str):
+                    if not re.fullmatch('[0-9A-Fa-f]{64}', body['key']):
+                        pattern.append('GUID_key')
+                if 'keyDob' in body and not re.fullmatch('[XxA-Fa-f0-9][A-Fa-f0-9]{63}', body['keyDob']):
+                    pattern.append('keyDob')
+                if body.get('keyType') == 'TELETAN' and isinstance(body.get('key'), str):
+                    # Invalid alphabet fails independently of configured length and database state.
+                    if any(c not in '23456789ABCDEFGHJKMNPQRSTUVWXYZ' for c in body['key']):
+                        pattern.append('TELETAN_key_alphabet')
+                record.update({'missing_required_fields': missing,
+                               'source_pattern_violations': pattern})
+                if invalid_headers:
+                    assert resp['body']['size'] == 435
+                    assert '<html' in resp['body']['text'].lower()
+                    label, category, roots = 'TEST', 'invalid_HTTP_header', ['RC04']
+                else:
+                    assert not resp['body']['text'] and (missing or pattern)
+                    label, category = 'SPEC', 'missing_request_constraints'
+                    roots = (['RC02'] if missing else []) + (['RC03'] if pattern else [])
+                    reasons.update('missing_' + k for k in missing)
+                    reasons.update(pattern)
+            elif iid in ('C003', 'C006'):
+                assert not invalid_headers
+                assert re.fullmatch('[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89aAbB][a-f0-9]{3}-[a-f0-9]{12}',
+                                    body['registrationToken'])
+                assert not resp['body']['text']
+                assert req['headers'].get('cwa-fake') != '1'
+                label, category, roots = 'TEST', 'unestablished_registration_token_state', ['RC05']
+            elif iid == 'C004':
+                assert resp['status'] == 201
+                assert 'authorization' in req['headers']
+                label, category, roots = 'TEST', 'unsupported_object_header_validation', ['RC06']
+            elif iid == 'C005':
+                assert resp['status'] == 404 and not resp['body']['text']
+                assert not resp['body'].get('truncated') and not resp['body'].get('decode_error')
+                label, category, roots = 'SPEC', 'unwanted_error_body_schema', ['RC07']
+            proposed = {'capability_probe': 'T-PROBE',
+                        'invalid_HTTP_header': 'T-GEN-INVALID-HTTP',
+                        'unestablished_registration_token_state': 'T-ORACLE-STATE',
+                        'unsupported_object_header_validation': 'T-ORACLE-COVERAGE'}.get(category, '')
+            record.update({'L1': label, 'category': category, 'root_cause_ids': roots,
+                           'L2': ('S-REQ-LOOSE' if iid == 'C002' else 'S-RESP-MISSING') if label == 'SPEC' else '',
+                           'proposed_L2': proposed})
+            cases.append(record)
+    logs = (RUN / 'compose.log').read_text().splitlines()
+    phrases = {
+        'unknown_registration_token_tan': 'VerificationAppSession not found for the registration token',
+        'unknown_registration_token_testresult': 'Returning the test result for the registration token failed',
+        'invalid_tan': 'No Tan found or Tan is invalid',
+        'teletan_generated': 'The teleTAN is generated.',
+        'invalid_GUID_syntax': 'The hashed guid has no valid pattern',
+        'invalid_TELETAN_syntax': 'The teleTAN is not valid to the syntax constraints.',
+        'capture_encoding_error': 'UnicodeEncodeError:',
+        'firewall_error': 'RequestRejectedException:',
+    }
+    locations = {name: [n for n, line in enumerate(logs, 1) if phrase in line]
+                 for name, phrase in phrases.items()}
+    assert len(locations['unknown_registration_token_tan']) == 80
+    assert len(locations['unknown_registration_token_testresult']) == 80
+    assert len(locations['invalid_tan']) == 100
+    assert len(locations['teletan_generated']) == 100
+    # These are operation/category corroborations, not unique request/log identity joins.
+    locations['join_scope'] = 'operation/category counts and source flow; no exact exchange identity join'
+    locations['backend_error_matches'] = {
+        phrase: [n for n, line in enumerate(logs, 1) if phrase in line]
+        for phrase in ['UnknownHostException', 'ConnectException', 'FeignException']}
+    save('log_locations.json', locations)
+    save('case_labels.json', cases)
+    summary = {'status': 'PASS', 'diagnostic_cases': len(cases),
+               'L1_cases': dict(collections.Counter(c['L1'] for c in cases)),
+               'C002_source_constraint_reasons_overlapping': dict(reasons),
+               'C002_leaf_counts': dict(collections.Counter(c['L1'] for c in cases if c['item_id'] == 'C002')),
+               'root_case_memberships': dict(collections.Counter(r for c in cases for r in c['root_cause_ids'])),
+               'all_C003_C006_requests_precede_teletan_creation': max(mapping['C003'] + mapping['C006']) < min(mapping['C004']),
+               'successful_registrationToken_responses': sum(x['request']['path'] == '/version/v1/registrationToken' and 200 <= x['response']['status'] < 300 for x in xs),
+               'external_execution': False}
+    save('case_summary.json', summary)
+    evidence = [RUN / f for f in ['spec.original.json', 'generator-input.json', 'exchanges.jsonl', 'compose.log']]
+    evidence += list(SOURCE.rglob('*.java'))
+    evidence += [ROOT / f for f in ['08_experiments/tools/conformance.py', '08_experiments/tools/specmut.py',
+                                  '08_experiments/R1_triage_codebook.md', '09_collab/tasks/T18.md',
+                                  '08_experiments/E2_labelling/cwa-verification_baseline_s1_blind.csv']]
+    save('input_sha256.json', {str(p.relative_to(ROOT)): hashlib.sha256(p.read_bytes()).hexdigest() for p in evidence})
+    print(json.dumps(summary, indent=2))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/research/09_collab/logs/T18_scratch/freeze.py b/research/09_collab/logs/T18_scratch/freeze.py
new file mode 100644
index 0000000000000000000000000000000000000000..3add8231c288c81bf22df342a06b3a247dd5a31a
--- /dev/null
+++ b/research/09_collab/logs/T18_scratch/freeze.py
@@ -0,0 +1,65 @@
+"""Freeze validated T18 deliverables, then update only the T18 board status/log."""
+from datetime import datetime, timedelta, timezone
+import hashlib
+import json
+from pathlib import Path
+import re
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from replay import OUT, ROOT, save
+from write_labels import LABELS, ROOTS
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    validation = json.loads((OUT / 'validation.json').read_text())
+    assert validation['status'] == 'PASS'
+    inputs = json.loads((OUT / 'input_sha256.json').read_text())
+    manifest = json.loads((OUT / 'sha256_manifest.json').read_text())
+    assert all(digest(ROOT / rel) == sha for rel, sha in inputs.items())
+    assert all(digest(ROOT / rel) == sha for rel, sha in manifest.items())
+    report = ROOT / '09_collab/reports/T18_report.md'
+    frozen = {'status': 'FROZEN', 'utc': datetime.now(timezone.utc).isoformat(),
+              'validation': 'PASS', 'manifest_files_unchanged': len(manifest),
+              'input_files_unchanged': len(inputs),
+              'deliverables_sha256': {str(p.relative_to(ROOT)): digest(p) for p in [LABELS, ROOTS, report]},
+              'manifest_sha256': digest(OUT / 'sha256_manifest.json'),
+              'report_citations_checked': validation['report_citations_checked'],
+              'blind_labels_A_opened': False, 'blind_pilot_RESULTS_reports_opened': False,
+              'external_execution': False}
+    save('freeze.json', frozen)
+    for rel, line in re.findall(r'`((?:08_experiments|09_collab)/[^`]+):(\d+)`', report.read_text()):
+        contents = (ROOT / rel).read_text().splitlines()
+        assert 1 <= int(line) <= len(contents) and contents[int(line) - 1].strip()
+    board = ROOT / '09_collab/COLLAB_BOARD.md'
+    original = board.read_text()
+    matches = re.findall(r'^\| T18 \|.*$', original, re.M)
+    assert len(matches) == 1
+    row = matches[0]
+    cells = row.split('|')
+    assert cells[5].strip() == 'IN PROGRESS'
+    cells[5] = ' DONE '
+    updated = original.replace(row, '|'.join(cells), 1)
+    local = datetime.now(timezone(timedelta(hours=6))).strftime('%Y-%m-%d %H:%M +06')
+    log = (f'\n- {local} | Codex | T18 | DONE: six blind labels under v0.4: TEST 4, SPEC 1, '
+           'SPEC_PARTIAL 1 (C002: 62 SPEC + 7 invalid-HTTP TEST); zero BOTH candidates, seven root families. '
+           'Exact deploy-origin CLI replay: 430 captured exchanges/430 diagnostics, all six blind counts match. '
+           '483 CSV/root locators, 74 report citations, reciprocal roots, aggregation and 56 input hashes PASS; '
+           'outputs frozen before final board read. C003/C006 are state-oracle false positives, C004 is header coverage, '
+           'C005 is intentional empty 404 vs body schema. Log encoding losses limit claims to captured traffic; '
+           'no unique request/log identity joins claimed. No labels_A/RESULTS report opened, external execution, '
+           'or writes to runs/harness/tools. Evidence: E2_labelling/cwa-verification_baseline_s1_labels_codex.csv:C001-C006; '
+           'cwa-verification_root_causes_codex.csv:RC01-RC07; reports/T18_report.md; '
+           'logs/T18_scratch/validation.json and freeze.json.\n')
+    board.write_text(updated + log)
+    assert all(digest(ROOT / rel) == sha for rel, sha in frozen['deliverables_sha256'].items())
+    print(json.dumps({'status': 'DONE', 'frozen_utc': frozen['utc'], 'manifest_files': len(manifest),
+                      'report_citations': validation['report_citations_checked']}))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/research/09_collab/logs/T18_scratch/validate.py b/research/09_collab/logs/T18_scratch/validate.py
new file mode 100644
index 0000000000000000000000000000000000000000..ca3a167220cb605398a5ff8fecfc5ae3b9f8200e
--- /dev/null
+++ b/research/09_collab/logs/T18_scratch/validate.py
@@ -0,0 +1,127 @@
+"""Validate T18 item coverage, replay, aggregation, evidence, and provenance."""
+import collections
+import csv
+import hashlib
+import json
+from pathlib import Path
+import re
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from replay import OUT, ROOT, RUN, save, normalize
+from write_labels import LABELS, ROOTS, HEADERS
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    with LABELS.open() as f:
+        reader = csv.DictReader(f)
+        assert reader.fieldnames == HEADERS
+        rows = list(reader)
+    with ROOTS.open() as f:
+        reader = csv.DictReader(f)
+        assert reader.fieldnames == ['root_cause_id', 'description', 'fix_site', 'items']
+        roots = list(reader)
+    blind = list(csv.DictReader((ROOT / '08_experiments/E2_labelling/cwa-verification_baseline_s1_blind.csv').open()))
+    assert [r['item_id'] for r in rows] == [r['item_id'] for r in blind] == [f'C{i:03d}' for i in range(1, 7)]
+    cases = json.loads((OUT / 'case_labels.json').read_text())
+    cli = [json.loads(s) for s in (OUT / 'replay_cli.jsonl').read_text().splitlines()]
+    fp_map = {normalize(b['fingerprint']): b['item_id'] for b in blind}
+    replay = [(fp_map[d['fingerprint']], d['exchange'] + 1) for d in cli]
+    assert collections.Counter(replay) == collections.Counter((c['item_id'], c['exchange_line']) for c in cases)
+    assert len(replay) == 430
+    assert len({line for iid, line in replay}) == 430
+    root_map = {r['root_cause_id']: r for r in roots}
+    assert len(root_map) == len(roots) == 7
+    locator_count = 0
+    evidence_files = set()
+
+    def locator(value):
+        nonlocal locator_count
+        match = re.fullmatch(r'(.+):(\d+)', value)
+        assert match, value
+        rel, n = match.group(1), int(match.group(2))
+        path = ROOT / rel
+        assert 'labels_A' not in path.name
+        assert not ('pilot_results' in path.parts and 'RESULTS' in path.name)
+        text = path.read_text().splitlines()
+        assert 1 <= n <= len(text) and text[n - 1].strip(), value
+        evidence_files.add(rel)
+        locator_count += 1
+
+    for r, b in zip(rows, blind):
+        iid = r['item_id']
+        children = [c for c in cases if c['item_id'] == iid]
+        assert len(children) == int(b['occurrences'])
+        leaf_labels = {c['L1'] for c in children}
+        expected = 'SPEC_PARTIAL' if leaf_labels == {'SPEC', 'TEST'} else next(iter(leaf_labels))
+        assert r['L1'] == expected
+        assert r['L1'] != 'BOTH' and r['both_candidate'] == 'false'
+        assert r['confidence'] == '3'
+        assert r['rationale'].startswith('⚠️') and len(r['rationale'].split()) <= 30
+        assert r['L2'] in ('', 'S-REQ-LOOSE', 'S-RESP-MISSING')
+        assert not (r['L2'] and r['proposed_L2'])
+        declared_roots = set(r['root_cause_id'].split(';'))
+        assert declared_roots == {rid for c in children for rid in c['root_cause_ids']}
+        assert all(iid in root_map[rid]['items'].split(';') for rid in declared_roots)
+        locs = r['evidence_locators'].split(';')
+        assert {f'{RUN.relative_to(ROOT)}/exchanges.jsonl:{c["exchange_line"]}' for c in children} <= set(locs)
+        for loc in locs:
+            locator(loc)
+    for r in roots:
+        rid = r['root_cause_id']
+        assert r['fix_site'] in ('test', 'spec')
+        assert set(r['items'].split(';')) == {row['item_id'] for row in rows if rid in row['root_cause_id'].split(';')}
+        for path, line in re.findall(r'((?:08_experiments|09_collab)/[A-Za-z0-9_./-]+):(\d+)', r['description']):
+            locator(f'{path}:{line}')
+    inputs = json.loads((OUT / 'input_sha256.json').read_text())
+    assert all(digest(ROOT / rel) == sha for rel, sha in inputs.items())
+    count = collections.Counter(c['L1'] for c in cases if c['item_id'] == 'C002')
+    assert count == {'SPEC': 62, 'TEST': 7}
+    bad = [c['exchange_line'] for c in cases if c['item_id'] == 'C002' and c['L1'] == 'TEST']
+    assert bad == [164, 188, 189, 190, 191, 192, 193]
+    spec = json.loads((RUN / 'spec.original.json').read_text())
+    request_schema = spec['components']['schemas']['RegistrationTokenRequest']
+    assert 'required' not in request_schema
+    assert all('pattern' not in value for value in request_schema['properties'].values())
+    log_locations = json.loads((OUT / 'log_locations.json').read_text())
+    assert len(log_locations['capture_encoding_error']) == 71
+    assert len(log_locations['firewall_error']) == 2
+    result = {'status': 'PASS', 'items': 6, 'captured_exchanges': 430, 'diagnostic_cases': 430,
+              'exact_CLI_replay': True, 'per_item_counts_exact': True,
+              'L1': dict(collections.Counter(r['L1'] for r in rows)),
+              'case_L1': dict(collections.Counter(c['L1'] for c in cases)),
+              'C002_leaf_labels': dict(count), 'C002_invalid_HTTP_lines': bad,
+              'root_rows': len(roots), 'both_candidates': 0,
+              'evidence_locators_checked': locator_count,
+              'distinct_evidence_files': len(evidence_files),
+              'max_rationale_words': max(len(r['rationale'].split()) for r in rows),
+              'input_hashes_checked': len(inputs), 'inputs_unchanged': True,
+              'exact_request_log_identity_joins_claimed': False,
+              'blinding': {'labels_A_opened': False, 'pilot_RESULTS_reports_opened': False,
+                           'board_used_as_label_evidence': False},
+              'execution_boundary': {'external_code_or_SUT_executed': False,
+                                     'harness_or_tools_written': False, 'runs_written': False,
+                                     'basis': 'operator record of this task; read-only input hashes also checked'}}
+    save('validation.json', result)
+    # The final freeze overwrites this placeholder only after all report citations are checked.
+    save('freeze.json', {'status': 'pending final SHA-256 freeze'})
+    report = ROOT / '09_collab/reports/T18_report.md'
+    cites = re.findall(r'`((?:08_experiments|09_collab)/[^`]+):(\d+)`', report.read_text())
+    for path, line in cites:
+        locator(f'{path}:{line}')
+    result['report_citations_checked'] = len(cites)
+    save('validation.json', result)
+    manifest_paths = [LABELS, ROOTS, report] + sorted(OUT.glob('*.py'))
+    manifest_paths += [OUT / name for name in ['replay_summary.json', 'case_labels.json', 'case_summary.json',
+                                              'label_summary.json', 'log_locations.json', 'input_sha256.json',
+                                              'replay_cli.jsonl', 'validation.json']]
+    save('sha256_manifest.json', {str(p.relative_to(ROOT)): digest(p) for p in manifest_paths})
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == '__main__':
+    main()
