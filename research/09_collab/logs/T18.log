   120	  public ResponseEntity<RegistrationToken> generateRegistrationTokenByTeleTan(
   121	    String teleTan, String fake, TeleTanType teleTanType) {
   122	    if (checkRegistrationTokenAlreadyExistForTeleTan(teleTan)) {
   123	      log.warn("The registration token already exists for this TeleTAN.");
   124	      return ResponseEntity.badRequest().build();
   125	    } else {
