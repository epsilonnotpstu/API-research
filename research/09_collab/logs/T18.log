new file mode 100644
index 0000000000000000000000000000000000000000..ca3a167220cb605398a5ff8fecfc5ae3b9f8200e
--- /dev/null
+++ b/research/09_collab/logs/T18_scratch/validate.py
@@ -0,0 +1,127 @@
+"""Validate T18 item coverage, replay, aggregation, evidence, and provenance."""
+import collections
+import csv
+import hashlib
+import json
+from pathlib import Path
+import re
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from replay import OUT, ROOT, RUN, save, normalize
+from write_labels import LABELS, ROOTS, HEADERS
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    with LABELS.open() as f:
+        reader = csv.DictReader(f)
+        assert reader.fieldnames == HEADERS
+        rows = list(reader)
+    with ROOTS.open() as f:
+        reader = csv.DictReader(f)
+        assert reader.fieldnames == ['root_cause_id', 'description', 'fix_site', 'items']
+        roots = list(reader)
+    blind = list(csv.DictReader((ROOT / '08_experiments/E2_labelling/cwa-verification_baseline_s1_blind.csv').open()))
+    assert [r['item_id'] for r in rows] == [r['item_id'] for r in blind] == [f'C{i:03d}' for i in range(1, 7)]
+    cases = json.loads((OUT / 'case_labels.json').read_text())
+    cli = [json.loads(s) for s in (OUT / 'replay_cli.jsonl').read_text().splitlines()]
+    fp_map = {normalize(b['fingerprint']): b['item_id'] for b in blind}
+    replay = [(fp_map[d['fingerprint']], d['exchange'] + 1) for d in cli]
+    assert collections.Counter(replay) == collections.Counter((c['item_id'], c['exchange_line']) for c in cases)
+    assert len(replay) == 430
+    assert len({line for iid, line in replay}) == 430
+    root_map = {r['root_cause_id']: r for r in roots}
+    assert len(root_map) == len(roots) == 7
+    locator_count = 0
+    evidence_files = set()
+
+    def locator(value):
+        nonlocal locator_count
+        match = re.fullmatch(r'(.+):(\d+)', value)
+        assert match, value
+        rel, n = match.group(1), int(match.group(2))
+        path = ROOT / rel
+        assert 'labels_A' not in path.name
+        assert not ('pilot_results' in path.parts and 'RESULTS' in path.name)
+        text = path.read_text().splitlines()
+        assert 1 <= n <= len(text) and text[n - 1].strip(), value
+        evidence_files.add(rel)
+        locator_count += 1
+
+    for r, b in zip(rows, blind):
+        iid = r['item_id']
+        children = [c for c in cases if c['item_id'] == iid]
+        assert len(children) == int(b['occurrences'])
+        leaf_labels = {c['L1'] for c in children}
+        expected = 'SPEC_PARTIAL' if leaf_labels == {'SPEC', 'TEST'} else next(iter(leaf_labels))
+        assert r['L1'] == expected
+        assert r['L1'] != 'BOTH' and r['both_candidate'] == 'false'
+        assert r['confidence'] == '3'
+        assert r['rationale'].startswith('⚠️') and len(r['rationale'].split()) <= 30
+        assert r['L2'] in ('', 'S-REQ-LOOSE', 'S-RESP-MISSING')
+        assert not (r['L2'] and r['proposed_L2'])
+        declared_roots = set(r['root_cause_id'].split(';'))
+        assert declared_roots == {rid for c in children for rid in c['root_cause_ids']}
+        assert all(iid in root_map[rid]['items'].split(';') for rid in declared_roots)
+        locs = r['evidence_locators'].split(';')
+        assert {f'{RUN.relative_to(ROOT)}/exchanges.jsonl:{c["exchange_line"]}' for c in children} <= set(locs)
+        for loc in locs:
+            locator(loc)
+    for r in roots:
+        rid = r['root_cause_id']
+        assert r['fix_site'] in ('test', 'spec')
+        assert set(r['items'].split(';')) == {row['item_id'] for row in rows if rid in row['root_cause_id'].split(';')}
+        for path, line in re.findall(r'((?:08_experiments|09_collab)/[A-Za-z0-9_./-]+):(\d+)', r['description']):
+            locator(f'{path}:{line}')
+    inputs = json.loads((OUT / 'input_sha256.json').read_text())
+    assert all(digest(ROOT / rel) == sha for rel, sha in inputs.items())
+    count = collections.Counter(c['L1'] for c in cases if c['item_id'] == 'C002')
+    assert count == {'SPEC': 62, 'TEST': 7}
+    bad = [c['exchange_line'] for c in cases if c['item_id'] == 'C002' and c['L1'] == 'TEST']
+    assert bad == [164, 188, 189, 190, 191, 192, 193]
+    spec = json.loads((RUN / 'spec.original.json').read_text())
+    request_schema = spec['components']['schemas']['RegistrationTokenRequest']
+    assert 'required' not in request_schema
+    assert all('pattern' not in value for value in request_schema['properties'].values())
+    log_locations = json.loads((OUT / 'log_locations.json').read_text())
+    assert len(log_locations['capture_encoding_error']) == 71
+    assert len(log_locations['firewall_error']) == 2
+    result = {'status': 'PASS', 'items': 6, 'captured_exchanges': 430, 'diagnostic_cases': 430,
+              'exact_CLI_replay': True, 'per_item_counts_exact': True,
+              'L1': dict(collections.Counter(r['L1'] for r in rows)),
+              'case_L1': dict(collections.Counter(c['L1'] for c in cases)),
+              'C002_leaf_labels': dict(count), 'C002_invalid_HTTP_lines': bad,
+              'root_rows': len(roots), 'both_candidates': 0,
+              'evidence_locators_checked': locator_count,
+              'distinct_evidence_files': len(evidence_files),
+              'max_rationale_words': max(len(r['rationale'].split()) for r in rows),
+              'input_hashes_checked': len(inputs), 'inputs_unchanged': True,
+              'exact_request_log_identity_joins_claimed': False,
+              'blinding': {'labels_A_opened': False, 'pilot_RESULTS_reports_opened': False,
+                           'board_used_as_label_evidence': False},
+              'execution_boundary': {'external_code_or_SUT_executed': False,
+                                     'harness_or_tools_written': False, 'runs_written': False,
+                                     'basis': 'operator record of this task; read-only input hashes also checked'}}
+    save('validation.json', result)
+    # The final freeze overwrites this placeholder only after all report citations are checked.
+    save('freeze.json', {'status': 'pending final SHA-256 freeze'})
+    report = ROOT / '09_collab/reports/T18_report.md'
+    cites = re.findall(r'`((?:08_experiments|09_collab)/[^`]+):(\d+)`', report.read_text())
+    for path, line in cites:
+        locator(f'{path}:{line}')
+    result['report_citations_checked'] = len(cites)
+    save('validation.json', result)
+    manifest_paths = [LABELS, ROOTS, report] + sorted(OUT.glob('*.py'))
+    manifest_paths += [OUT / name for name in ['replay_summary.json', 'case_labels.json', 'case_summary.json',
+                                              'label_summary.json', 'log_locations.json', 'input_sha256.json',
+                                              'replay_cli.jsonl', 'validation.json']]
+    save('sha256_manifest.json', {str(p.relative_to(ROOT)): digest(p) for p in manifest_paths})
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/research/09_collab/logs/T18_scratch/write_labels.py b/research/09_collab/logs/T18_scratch/write_labels.py
new file mode 100644
index 0000000000000000000000000000000000000000..72161566a6b0a43c988fa839c38d2cee66a77b22
--- /dev/null
+++ b/research/09_collab/logs/T18_scratch/write_labels.py
@@ -0,0 +1,94 @@
+"""Materialize the independent T18 decisions using the established CSV schema."""
+import collections
+import csv
+import json
+from pathlib import Path
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from replay import OUT, ROOT, RUN, SOURCE, save
+
+LABELS = ROOT / '08_experiments/E2_labelling/cwa-verification_baseline_s1_labels_codex.csv'
+ROOTS = ROOT / '08_experiments/E2_labelling/cwa-verification_root_causes_codex.csv'
+HEADERS = ['item_id', 'L1', 'L2', 'proposed_L2', 'confidence', 'evidence_types',
+           'evidence_locators', 'root_cause_id', 'both_candidate', 'rationale']
+
+
+def ref(path, line):
+    return f'{path.relative_to(ROOT)}:{line}'
+
+
+def main():
+    mapping = json.loads((OUT / 'exchange_map.json').read_text())
+    cases = json.loads((OUT / 'case_labels.json').read_text())
+    spec = RUN / 'spec.original.json'
+    checker = ROOT / '08_experiments/tools/conformance.py'
+    book = ROOT / '08_experiments/R1_triage_codebook.md'
+    logs = RUN / 'compose.log'
+    definitions = {
+        'C001': ('TEST', '', 'T-PROBE', 'RC01',
+                 [(checker, 395), (book, 226), (logs, 382)],
+                 'The null-byte capability probe fails HTTP parsing at an undocumented base path; treating setup traffic as an API operation contaminates the sample.'),
+        'C002': ('SPEC_PARTIAL', 'S-REQ-LOOSE', '', 'RC02;RC03;RC04',
+                 [(spec, 314), (SOURCE / 'model/RegistrationTokenRequest.java', 47),
+                  (SOURCE / 'validator/RegistrationTokenRequestValidator.java', 60),
+                  (SOURCE / 'service/HashingService.java', 37),
+                  (SOURCE / 'service/TanService.java', 82),
+                  (SOURCE / 'model/RegistrationTokenRequest.java', 53), (book, 226), (book, 229)],
+                 'Sixty-two rejections expose omitted required fields or source validation patterns; seven requests contain illegal header controls. SPEC plus TEST aggregates to SPEC_PARTIAL.'),
+        'C003': ('TEST', '', 'T-ORACLE-STATE', 'RC05',
+                 [(spec, 57), (SOURCE / 'controller/ExternalTanController.java', 154),
+                  (SOURCE / 'service/AppSessionService.java', 155), (logs, 250), (checker, 438)],
+                 'Syntactically valid generated tokens lack established application sessions. Source, documented 400, and missing-session logs support rejection; the oracle assumes schema validity guarantees success.'),
+        'C004': ('TEST', '', 'T-ORACLE-COVERAGE', 'RC06',
+                 [(spec, 170), (spec, 357), (checker, 327), (checker, 434),
+                  (SOURCE / 'controller/InternalTanController.java', 142), (logs, 1398)],
+                 'The checker cannot validate object-shaped Authorization header serialization. All responses succeed with 201; this diagnostic records oracle coverage rather than an observed implementation failure.'),
+        'C005': ('SPEC', 'S-RESP-MISSING', '', 'RC07',
+                 [(spec, 232), (checker, 418),
+                  (SOURCE / 'controller/InternalTanController.java', 120),
+                  (SOURCE / 'controller/VerificationExceptionHandler.java', 93), (logs, 1731)],
+                 'The declared 404 object body conflicts with deliberate empty exception-handler responses. Remove the error response content schema; the not-found status itself is intended.'),
+        'C006': ('TEST', '', 'T-ORACLE-STATE', 'RC05',
+                 [(spec, 105), (SOURCE / 'controller/ExternalTestStateController.java', 149),
+                  (SOURCE / 'controller/ExternalTestStateController.java', 111),
+                  (SOURCE / 'service/AppSessionService.java', 155), (logs, 532), (checker, 438)],
+                 'All generated tokens are syntactically valid but lack application sessions. Missing-token logs corroborate deliberate 400 rejection before any backend call; the oracle ignores business state.'),
+    }
+    rows = []
+    for iid, (label, l2, proposed, roots, evidence, rationale) in definitions.items():
+        locators = [ref(RUN / 'exchanges.jsonl', n) for n in mapping[iid]]
+        locators += [ref(path, line) for path, line in evidence]
+        rows.append(dict(zip(HEADERS, [iid, label, l2, proposed, '3',
+                    'E-OBS;E-CODE-INTENT;E-LOG' if iid != 'C001' else 'E-OBS;E-LOG',
+                    ';'.join(locators), roots, 'false', '⚠️ ' + rationale])))
+    with LABELS.open('w', newline='') as f:
+        writer = csv.DictWriter(f, fieldnames=HEADERS)
+        writer.writeheader()
+        writer.writerows(rows)
+    root_definitions = [
+        ('RC01', 'A capability probe contaminates undocumented-operation diagnostics.', 'test', 'C001', [(RUN / 'exchanges.jsonl', 1)]),
+        ('RC02', 'RegistrationTokenRequest omits required key and keyType despite explicit non-null validation.', 'spec', 'C002', [(spec, 314), (SOURCE / 'model/RegistrationTokenRequest.java', 47), (SOURCE / 'model/RegistrationTokenRequest.java', 59)]),
+        ('RC03', 'RegistrationTokenRequest omits GUID, keyDob and conditional TELETAN syntax constraints enforced by source validation.', 'spec', 'C002', [(spec, 317), (SOURCE / 'validator/RegistrationTokenRequestValidator.java', 63), (SOURCE / 'model/RegistrationTokenRequest.java', 53), (SOURCE / 'service/TanService.java', 82)]),
+        ('RC04', 'Illegal HTTP header controls are mistaken for schema-valid business requests.', 'test', 'C002', [(RUN / 'exchanges.jsonl', 164), (book, 226), (checker, 438)]),
+        ('RC05', 'VALID_REJECTED assumes syntactic token validity establishes persistent application-session state.', 'test', 'C003;C006', [(checker, 438), (SOURCE / 'controller/ExternalTanController.java', 154), (SOURCE / 'controller/ExternalTestStateController.java', 149), (logs, 250), (logs, 532)]),
+        ('RC06', 'Object-shaped Authorization header validation is outside the checker serialization coverage.', 'test', 'C004', [(spec, 170), (checker, 327)]),
+        ('RC07', 'The 404 response advertises object content while the intentional exception response is empty.', 'spec', 'C005', [(spec, 232), (SOURCE / 'controller/VerificationExceptionHandler.java', 93)]),
+    ]
+    with ROOTS.open('w', newline='') as f:
+        writer = csv.writer(f)
+        writer.writerow(['root_cause_id', 'description', 'fix_site', 'items'])
+        for rid, description, site, items, evidence in root_definitions:
+            writer.writerow([rid, '⚠️ ' + description + ' Evidence: ' + ';'.join(ref(p, n) for p, n in evidence), site, items])
+    summary = {'items': len(rows), 'L1': dict(collections.Counter(r['L1'] for r in rows)),
+               'strict_L1': dict(collections.Counter('UNDECIDABLE' if r['L1'] == 'SPEC_PARTIAL' else r['L1'] for r in rows)),
+               'lenient_L1': dict(collections.Counter('SPEC' if r['L1'] == 'SPEC_PARTIAL' else r['L1'] for r in rows)),
+               'root_causes': len(root_definitions), 'both_candidates': 0,
+               'diagnostic_cases': len(cases),
+               'max_rationale_words': max(len(r['rationale'].split()) for r in rows)}
+    save('label_summary.json', summary)
+    print(json.dumps(summary, indent=2))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/research/09_collab/logs/T18_scratch/write_report.py b/research/09_collab/logs/T18_scratch/write_report.py
new file mode 100644
index 0000000000000000000000000000000000000000..c9bd6a4147448f337f773303371752a55ae832ae
--- /dev/null
+++ b/research/09_collab/logs/T18_scratch/write_report.py
@@ -0,0 +1,57 @@
+"""Write the short Bengali T18 report from frozen-scope local evidence."""
+from pathlib import Path
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from replay import ROOT, RUN, SOURCE
+
+
+def cite(path, line):
+    rel = str(path.relative_to(ROOT))
+    return f'`{rel}:{line}`'
+
+
+def main():
+    spec = RUN / 'spec.original.json'
+    logs = RUN / 'compose.log'
+    raw = RUN / 'exchanges.jsonl'
+    scratch = ROOT / '09_collab/logs/T18_scratch'
+    labels = ROOT / '08_experiments/E2_labelling/cwa-verification_baseline_s1_labels_codex.csv'
+    roots = ROOT / '08_experiments/E2_labelling/cwa-verification_root_causes_codex.csv'
+    checker = ROOT / '08_experiments/tools/conformance.py'
+    book = ROOT / '08_experiments/R1_triage_codebook.md'
+    report = f'''T18 — cwa-verification blind labeller B (codebook v0.4)
+
+দুটি CSV-তে C001–C006-এর primary label ও সাতটি root-cause family লেখা হয়েছে। ফল: TEST ৪, SPEC ১, SPEC_PARTIAL ১; সব confidence ৩ এবং `both_candidate=false`। Strict scoring: TEST ৪ / SPEC ১ / UNDECIDABLE ১; lenient: TEST ৪ / SPEC ২। Labeller নিজে BOTH দেয়নি। Evidence: {cite(labels, 2)}, {cite(labels, 3)}, {cite(labels, 4)}, {cite(labels, 5)}, {cite(labels, 6)}, {cite(labels, 7)}; {cite(roots, 2)}; aggregation ও notation: {cite(book, 218)}, {cite(book, 229)}।
+
+পদ্ধতি: saved original spec-এর বিরুদ্ধে নিজের checker replay-তে `--deploy-origin http://sut-cwa-verification:8080` ব্যবহার করেছি; spec-এর localhost authority অপরিবর্তিত। Blind fingerprint-এর বাইরের JSON string খুলে তুলনা করলে ৪৩০ captured exchange-এ ছয়টি exact fingerprint, ৪৩০ diagnostic occurrence এবং প্রত্যেক blind count মেলে; unmatched শূন্য। Original ও generator spec structurally identical। Evidence: {cite(checker, 182)}, {cite(checker, 443)}, {cite(spec, 13)}, {cite(scratch / 'replay_summary.json', 1)}।
+
+| Item | Primary L1 / L2 | Occurrences | সিদ্ধান্ত |
+|---|---|---:|---|
+| C001 | TEST / proposed T-PROBE | ১ | null-byte capability probe |
+| C002 | SPEC_PARTIAL / S-REQ-LOOSE | ৬৯ | ৬২ SPEC + ৭ TEST |
+| C003 | TEST / proposed T-ORACLE-STATE | ৮০ | session না থাকা generated token |
+| C004 | TEST / proposed T-ORACLE-COVERAGE | ১০০ | object-shaped Authorization header checker-এর আওতার বাইরে |
+| C005 | SPEC / S-RESP-MISSING | ১০০ | ইচ্ছাকৃত empty 404-এ ভুল object-body schema |
+| C006 | TEST / proposed T-ORACLE-STATE | ৮০ | session না থাকা generated token |
+
+টেবিলের occurrence evidence: {cite(scratch / 'replay_summary.json', 10)}; occurrence-ভিত্তিক label: {cite(scratch / 'case_labels.json', 1)}। মোট message attribution TEST ২৬৮, SPEC ১৬২; এগুলো independent bug-এর সংখ্যা নয় ({cite(scratch / 'case_summary.json', 4)})।
+
+⚠️ C002-এর ৬২টি application rejection-এ অন্তত একটি explicit validation constraint schema-তে নেই: `key` অনুপস্থিত ৩৩টি, `keyType` ৪৪টি, GUID pattern ১১টি, keyDob pattern ১৬টি, TELETAN alphabet ২টি; counts overlap করে। Source-এ @NotNull, @Pattern এবং conditional validator আছে; schema-তে required key/keyType ও সংশ্লিষ্ট patterns নেই। অঘোষিত property আছে বলেই এই attribution দেওয়া হয়নি। বাকি সাতটিতে header control codepoint ২৫ অথবা ১৪ এবং HTML 400 আছে—এগুলো সত্যিই invalid HTTP, container-এর বৈধ-input policy ambiguity নয়। ফলে §10.4 অনুযায়ী SPEC_PARTIAL। Evidence: {cite(spec, 314)}; {cite(SOURCE / 'model/RegistrationTokenRequest.java', 47)}, {cite(SOURCE / 'model/RegistrationTokenRequest.java', 53)}, {cite(SOURCE / 'model/RegistrationTokenRequest.java', 59)}; {cite(SOURCE / 'validator/RegistrationTokenRequestValidator.java', 60)}, {cite(SOURCE / 'service/HashingService.java', 37)}, {cite(SOURCE / 'service/TanService.java', 82)}; {cite(raw, 164)}, {cite(raw, 188)}; {cite(scratch / 'case_summary.json', 8)}; {cite(book, 226)}, {cite(book, 229)}।
+
+⚠️ C003/C006-এর token-গুলো UUID pattern মেনে চললেও persistent session থাকার প্রমাণ নেই; দুই operation-এর ৮০টি করে log সরাসরি missing-session rejection দেখায়। Source সেই অবস্থায় deliberate 400 দেয়, backend result call-এর আগে। Captured traffic-এ কোনো registrationToken creation সফল হয়নি; TAN/testresult requests teleTAN creation-এরও আগে হয়েছে। অতএব `VALID_REJECTED` এখানে state না বোঝা oracle-এর false positive—IMPL বা ENV নয়। Evidence: {cite(raw, 2)}, {cite(raw, 82)}; {cite(spec, 57)}, {cite(spec, 105)}; {cite(logs, 250)}, {cite(logs, 532)}; {cite(SOURCE / 'controller/ExternalTanController.java', 108)}, {cite(SOURCE / 'controller/ExternalTanController.java', 154)}, {cite(SOURCE / 'controller/ExternalTestStateController.java', 102)}, {cite(SOURCE / 'controller/ExternalTestStateController.java', 149)}; {cite(scratch / 'case_summary.json', 31)}।
+
+⚠️ C004-এর ১০০টি response 201; checker object/ref header-কে স্পষ্টভাবে uncheckable করে। Unit হলো coverage diagnostic, header model-এর আদর্শ serialization নির্ধারণ নয়। C005-এর ১০০টি 404-এ capture সম্পূর্ণ কিন্তু body খালি; controller ও ResponseEntity<Void> handler সেটিই ইচ্ছাকৃতভাবে করে। তাই C005-এর response content schema সরানোই repair; আলাদা code defect-এর প্রমাণ নেই, BOTH candidate নয়। Evidence: {cite(checker, 327)}, {cite(spec, 170)}, {cite(logs, 1398)}; {cite(raw, 331)}, {cite(spec, 232)}, {cite(SOURCE / 'controller/InternalTanController.java', 120)}, {cite(SOURCE / 'controller/VerificationExceptionHandler.java', 93)}। C001-এর probe header ও GET / → 400 evidence: {cite(raw, 1)}, {cite(logs, 382)}।
+
+Root CSV-তে RC01 probe, RC02 missing required fields, RC03 omitted conditional patterns, RC04 invalid HTTP, RC05 state oracle, RC06 header coverage এবং RC07 unwanted response-body schema আলাদা; C002 একাধিক root বহন করে। Fix sites কেবল spec/test। Evidence: {cite(roots, 2)}, {cite(roots, 3)}, {cite(roots, 4)}, {cite(roots, 5)}, {cite(roots, 6)}, {cite(roots, 7)}, {cite(roots, 8)}। নতুন proposed `T-ORACLE-STATE` মানে schema-valid input থেকেই business-state validity ধরে নেওয়া। `T-ORACLE-COVERAGE`-এর body-only উদাহরণকে এখানে unsupported parameter serialization পর্যন্ত বিস্তৃত করার প্রস্তাব; `T-PROBE` ও mixed C002-এর leaf `T-GEN-INVALID-HTTP` §10.5-এর pending নাম। কোনো নতুন L2-কে অনুমোদিত ধরে নেওয়া হয়নি ({cite(checker, 327)}, {cite(checker, 438)}, {cite(book, 233)}; {cite(scratch / 'case_labels.json', 1)})।
+
