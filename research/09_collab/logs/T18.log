    27	import org.apache.commons.codec.digest.DigestUtils;
    28	import org.springframework.stereotype.Component;
    29	
    30	/**
    31	 * This class represents the hashing service for providing and check a hash string.
    32	 */
    33	@Slf4j
    34	@Component
    35	public class HashingService {
    36	
    37	  private static final String GUID_HASH_PATTERN = "^[0-9A-Fa-f]{64}$";
    38	  private static final Pattern PATTERN = Pattern.compile(GUID_HASH_PATTERN);
    39	
    40	  /**
    41	   * Calculates the SHA-256 digest and returns the value as a hex string.
    42	   *
    43	   * @param toHash that will be Hashed
    44	   * @return the hash of the supplied string
    45	   */
    46	  public String hash(String toHash) {
    47	    log.debug("Hash process has been called.");
    48	    return DigestUtils.sha256Hex(toHash);
    49	  }
    50	
    51	  /**
    52	   * Calculates the SHA-256 digest and returns an check digit.
    53	   *
    54	   * @param toHash that will be Hashed
    55	   * @return the check digit
    56	   */
    57	  public String getCheckDigit(String toHash) {
    58	    log.info("get check digit process has been called.");
    59	    return DigestUtils.sha256Hex(toHash).substring(0, 1).toUpperCase().replace("0", "G").replace("1", "H");
    60	  }
    61	
    62	  /**
    63	   * Returns true if the String is resembles a SHA256 Pattern.
    64	   *
    65	   * @param toValidate String that will be checked to match the pattern of a SHA256 Hash
    66	   * @return Boolean if the String Matches the Pattern
    67	   */
    68	  public boolean isHashValid(String toValidate) {
    69	    Matcher matcher = PATTERN.matcher(toValidate);
    70	    boolean matches = matcher.matches();
    71	    if (!matches) {
    72	      log.warn("The hashed guid has no valid pattern");
    73	    }
    74	    return matches;
    75	  }
    76	}
