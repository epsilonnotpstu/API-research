    55	  @Override
    56	  public boolean isValid(RegistrationTokenRequest request, ConstraintValidatorContext arg1) {
    57	
    58	    String key = request.getKey();
    59	    RegistrationTokenKeyType keyType = request.getKeyType();
    60	    if (key == null || keyType == null) {
    61	      return false;
