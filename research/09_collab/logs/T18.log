   382	def check(spec, exchange):
   383	    req, resp = exchange['request'], exchange['response']
   384	    method, status = req['method'].upper(), int(resp['status'])
   385	    template, path_params = spec.match(req['path'], method, req.get('origin'))
   386	
   387	    def v(kind, pointer='', message='', identity=None):
   388	        identity = identity or {}
   389	        parts = [method, template or req['path'], str(status), kind, pointer,
   390	                 identity.get('keyword', ''), identity.get('instance_location', ''), identity.get('property', '')]
   391	        return {'kind': kind, 'method': method, 'template': template or req['path'], 'status': status,
   392	                'pointer': pointer, 'message': message[:300], **identity,
   393	                'fingerprint': json.dumps(parts, ensure_ascii=False, separators=(',', ':'))}
   394	
   395	    if template is None:
   396	        return [v('UNDOCUMENTED_OPERATION', message='path not in spec')]
   397	    op, params = spec.operation(template, method)
   398	    if op is None:
   399	        return [v('UNDOCUMENTED_OPERATION', message='method not in spec')]
   400	    out = []
   401	    if status >= 500:
   402	        out.append(v('SERVER_ERROR'))
   403	    headers = {k.lower(): val for k, val in resp.get('headers', {}).items()}
   404	    ctype = headers.get('content-type', '').split(';')[0].strip().lower()
   405	    documented, schema = spec.response_schema(op, status, ctype)
   406	    if not documented:
   407	        out.append(v('UNDOCUMENTED_STATUS'))
   408	    else:
   409	        allowed = spec.allowed_media(op, status)
   410	        if allowed and ctype and not any(media_matches(ctype, a) for a in allowed):
   411	            out.append(v('RESPONSE_CONTENT_TYPE', message=f'{ctype} not in {allowed}'))
   412	    capture = resp.get('body', {})
   413	    text = capture.get('text', '')
   414	    if documented and schema is not None:
   415	        media = ctype or (select_media((spec.response_entry(op, status) or {}).get('content', {}), '')[0] if spec.oas3 else 'application/json')
   416	        if capture.get('truncated') or capture.get('decode_error'):
   417	            out.append(v('RESPONSE_UNCHECKABLE', message='response body capture is incomplete or undecodable'))
   418	        elif not text and not (media or '').startswith('text/'):
   419	            out.append(v('RESPONSE_PARSE', message='documented response body is missing'))
   420	        else:
   421	            try:
   422	                body = parse_body(text, media)
   423	            except ValueError:
   424	                out.append(v('RESPONSE_PARSE', message='body is not valid JSON'))
   425	            except LookupError as exc:
   426	                out.append(v('RESPONSE_UNCHECKABLE', message=str(exc)))
   427	            else:
   428	                try:
