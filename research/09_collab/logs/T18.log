"""Replay the project oracle for T16; retain locators without credential values."""
import bisect
import collections
import csv
import hashlib
import json
from pathlib import Path
import re
import sys

OUT = Path(__file__).resolve().parent
ROOT = OUT.parents[2]
sys.path.insert(0, str(ROOT / '08_experiments/tools'))
import conformance

RUNS = {
 'swagger-petstore': '08_experiments/E1_pilot/runs/swagger-petstore/20261114T021748Z_batch_1701236_baseline_NONE_p0_s1',
 'market': '08_experiments/E1_pilot/runs/market/20261114T023303Z_batch_1724645_baseline_NONE_p0_s1',
}

def fingerprint(raw):
    value = raw
    for _ in range(3):
        if isinstance(value, list):
            return json.dumps(value,ensure_ascii=False,separators=(',',':'))
        value = json.loads(value)
    raise ValueError('fingerprint did not decode to an array')

def structure(value, depth=0):
    if depth > 3:
        return type(value).__name__
    if isinstance(value,dict):
        return {k:structure(v,depth+1) for k,v in value.items() if len(k)<50 and k.isascii()}
    if isinstance(value,list):
        return [structure(v,depth+1) for v in value[:3]]
    return type(value).__name__

def public_error(text):
    # Record only fixed API error text and validator metadata, never user values.
    fixed = ['No status provided','No tags provided','No Name provided','No name provided',
             'No Pet provided','No petId provided','No User provided','No Username provided',
             'No username provided','No Order provided','No file uploaded','Pet not found','User not found']
    for phrase in fixed:
        if phrase in text:
            return phrase
    try:
        value=json.loads(text)
    except ValueError:
        return 'non-JSON error body'
    if isinstance(value,dict):
        return {'keys':list(value), 'field_error_names':sorted(set(re.findall(r'"field"\s*:\s*"([A-Za-z_][A-Za-z0-9_.]*)"',text)))}
    return type(value).__name__

def spec_index(source):
    newline=[-1]+[m.start() for m in re.finditer('\n',source)]
    decoder=json.JSONDecoder(); loc={}
    def scan(pos,pointer):
        while source[pos].isspace():pos+=1
        loc[pointer]=bisect.bisect_left(newline,pos)
        if source[pos] not in '{[':return decoder.raw_decode(source,pos)[1]
        obj=source[pos]=='{';pos+=1;n=0
        while True:
            while source[pos].isspace() or source[pos]==',':pos+=1
            if source[pos] in '}]':return pos+1
            if obj:
                key,pos=decoder.raw_decode(source,pos)
                while source[pos].isspace() or source[pos]==':':pos+=1
                key=key.replace('~','~0').replace('/','~1')
            else:key=str(n)
            pos=scan(pos,pointer+'/'+key);n+=1
    scan(0,'');return loc

def main():
    for sut,run_rel in RUNS.items():
        run=ROOT/run_rel
        spec_data=json.loads((run/'spec.original.json').read_text())
        oracle=conformance.Spec(spec_data)
        items=list(csv.DictReader((ROOT/f'08_experiments/E2_labelling/{sut}_baseline_s1_blind.csv').open()))
        by_fp={fingerprint(i['fingerprint']):i['item_id'] for i in items}
        matches={i['item_id']:[] for i in items}; unknown=collections.Counter(); meta={}
        all_violations=[]
        for n,raw in enumerate((run/'exchanges.jsonl').open(),1):
            x=json.loads(raw);req,resp=x['request'],x['response']
            template,pp=oracle.match(req['path'],req['method'],req.get('origin'))
            op,params=oracle.operation(template,req['method']) if template else (None,[])
            problems=conformance.request_problems(oracle,params,op,x,pp) if op else []
            rb=req.get('body',{});text=rb.get('text','')
            try:body=json.loads(text) if text else None
            except ValueError:body=None
            response_text=resp.get('body',{}).get('text','')
            meta[str(n)]={'method':req['method'],'template':template,'status':resp['status'],
                         'timestamp':x.get('ts'),
                         'query_names':list(req.get('query',{})),
                         'content_type':req.get('headers',{}).get('content-type',''),
                         'response_content_type':resp.get('headers',{}).get('content-type',''),
                         'body_size':rb.get('size'), 'body_truncated':rb.get('truncated'),
                         'body_decode_error':rb.get('decode_error'),'body_shape':structure(body),
                         'response_sha256':hashlib.sha256(response_text.encode()).hexdigest(),
                         'response_size':resp.get('body',{}).get('size'),
                         'response_error':public_error(response_text) if int(resp['status'])>=400 else None,
                         'request_problems':[{'pointer':p,'keyword':i.get('keyword')} for p,m,i in problems],
                         'request_uncheckable':getattr(problems,'uncheckable',[])}
            for v in conformance.check(oracle,x):
                iid=by_fp.get(v['fingerprint'])
                if iid:matches[iid].append(n)
                else:unknown[v['fingerprint']]+=1
                all_violations.append({'item_id':iid,'exchange_line':n,'kind':v['kind'],'pointer':v['pointer']})
        mapped=[]
        for item in items:
            iid=item['item_id'];assert len(matches[iid])==int(item['occurrences']),(sut,iid,len(matches[iid]),item['occurrences'])
            mapped.append({'item_id':iid,'exchange_lines':matches[iid]})
        assert not unknown,(sut,unknown)
        for name,value in [('exchange_map',mapped),('exchange_meta',meta),('diagnostics',all_violations),
                           ('spec_locations',spec_index((run/'spec.original.json').read_text()))]:
            (OUT/f'{sut}_{name}.json').write_text(json.dumps(value,indent=2,ensure_ascii=True)+'\n')
        summary={'sut':sut,'run':run_rel,'exchanges':n,'items':len(items),'diagnostic_occurrences':len(all_violations),
                 'exact_occurrence_counts':True,'unmatched_fingerprints':dict(unknown),
                 'fingerprint_outer_JSON_string_normalized':True,
                 'oracle_version':spec_data.get('openapi',spec_data.get('swagger')),'base':oracle.base}
        (OUT/f'{sut}_replay_summary.json').write_text(json.dumps(summary,indent=2)+'\n')
        print(json.dumps(summary))
        for item,mapped_item in zip(items,mapped):
            sample=meta[str(mapped_item['exchange_lines'][0])]
            print(item['item_id'],item['kind'],item['status'],'n',len(mapped_item['exchange_lines']),
                  'ex',mapped_item['exchange_lines'][:3], 'type',sample['content_type'],
                  'error',sample['response_error'])

if __name__=='__main__':main()
"""Check captured exchanges against Swagger 2 / OpenAPI 3 schemas.

Usage: python3 conformance.py SPEC EXCHANGES.jsonl > violations.jsonl
Fingerprints identify constraints and normalized instance locations; occurrences
are counted separately by attribute.py. Incomplete request evidence is explicit.
"""
import copy
import datetime
import json
import re
import sys
import warnings
from http.cookies import SimpleCookie
from pathlib import Path
from urllib.parse import unquote, urlsplit

import jsonschema
sys.path.insert(0, str(Path(__file__).resolve().parent))
import specmut

FORMAT_CHECKER = copy.deepcopy(jsonschema.Draft4Validator.FORMAT_CHECKER)


@FORMAT_CHECKER.checks('date', raises=ValueError)
def _date(value):
    return not isinstance(value, str) or bool(re.fullmatch(r'\d{4}-\d{2}-\d{2}', value) and datetime.date.fromisoformat(value))


@FORMAT_CHECKER.checks('date-time', raises=ValueError)
def _date_time(value):
    if not isinstance(value, str):
        return True
    if not re.fullmatch(r'\d{4}-\d{2}-\d{2}[Tt]\d{2}:\d{2}:\d{2}(?:\.\d+)?(?:[Zz]|[+-](?:[01]\d|2[0-3]):[0-5]\d)', value):
        return False
    # datetime cannot represent RFC3339 leap seconds: check the preceding second.
    normalized = re.sub(r':60(?=[.Zz+-])', ':59', value).upper().replace('Z', '+00:00')
    return bool(datetime.datetime.fromisoformat(normalized))


def is_31(version):
    return isinstance(version, str) and version.startswith('3.1')


def to_json_schema(schema, oas3, strict_additional=False, direction=None):
    """Visit schema positions only, preserving property names and literal JSON data."""
    s = copy.deepcopy(schema)

    def fix(node):
        if not isinstance(node, dict):
            return
        if not is_31(oas3):
            nullable = node.pop('nullable', False) if oas3 else False
            if (nullable or node.get('x-nullable') is True) and 'type' in node:
                t = node['type']
                node['type'] = list(dict.fromkeys(([t] if isinstance(t, str) else t) + ['null']))
        props = node.get('properties', {})
        if direction and isinstance(node.get('required'), list):
            ignored = 'readOnly' if direction == 'request' else 'writeOnly'
            node['required'] = [k for k in node['required']
                                if not isinstance(props.get(k), dict) or not props[k].get(ignored)]
        if strict_additional and isinstance(props, dict) and 'properties' in node and 'additionalProperties' not in node:
            node['additionalProperties'] = False
        if isinstance(node.get('pattern'), str):
            try:
                re.compile(node['pattern'])
            except re.error:
                node['x-unchecked-pattern'] = node.pop('pattern')
        for key in ('properties', 'patternProperties', '$defs', 'definitions', 'dependentSchemas'):
            for sub in node.get(key, {}).values():
                fix(sub)
        for key in ('items', 'additionalItems', 'additionalProperties', 'contains', 'not', 'if', 'then', 'else',
                    'unevaluatedProperties', 'unevaluatedItems', 'propertyNames'):
            sub = node.get(key)
            if isinstance(sub, list):
                for child in sub:
                    fix(child)
            else:
                fix(sub)
        for key in ('allOf', 'anyOf', 'oneOf', 'prefixItems'):
            for sub in node.get(key, []):
                fix(sub)
    fix(s)
    return s


def validator(schema, oas3, strict_additional=False, direction=None, root=None, resolver=None):
    cls = jsonschema.Draft202012Validator if is_31(oas3) else jsonschema.Draft4Validator
    normalized = to_json_schema(schema, oas3, strict_additional, direction)
    options = {'format_checker': FORMAT_CHECKER}
    if resolver is not None:
        options['resolver'] = resolver
    elif root is not None:
        # The resolver is local-only. External references are uncheckable, never fetched.
        context = copy.deepcopy(root)
        def normalize_document(node):
            if isinstance(node, dict):
                for k, v in list(node.items()):
                    if k == 'schema':
                        node[k] = to_json_schema(v, oas3, strict_additional, direction)
                    else:
                        normalize_document(v)
            elif isinstance(node, list):
                for child in node:
                    normalize_document(child)
        normalize_document(context)
        if 'definitions' in context:
            context['definitions'] = {k: to_json_schema(v, oas3, strict_additional, direction)
                                      for k, v in root['definitions'].items()}
        if 'schemas' in context.get('components', {}):
            context['components']['schemas'] = {k: to_json_schema(v, oas3, strict_additional, direction)
                                                for k, v in root['components']['schemas'].items()}
        with warnings.catch_warnings():
            warnings.simplefilter('ignore', DeprecationWarning)
            class LocalResolver(jsonschema.RefResolver):
                def resolve_remote(self, uri):
                    raise ValueError('external reference is outside the local-only validation scope: ' + uri)
            options['resolver'] = LocalResolver.from_schema(context)
    return cls(normalized, **options)


PARAM_SCHEMA_KEYS = ('type', 'format', 'enum', 'minimum', 'maximum', 'exclusiveMinimum', 'exclusiveMaximum',
                     'minLength', 'maxLength', 'pattern', 'items', 'minItems', 'maxItems', 'multipleOf')


def server_base(server):
    url = server.get('url', '')
    for name, variable in server.get('variables', {}).items():
        url = url.replace('{' + name + '}', str(variable.get('default', '{' + name + '}')))
    return urlsplit(url).path.rstrip('/'), authority(url)


def authority(url):
    parsed = urlsplit(url)
    if not parsed.netloc:
        return ''
    return f'{parsed.hostname}:{parsed.port or (443 if parsed.scheme == "https" else 80)}'


def select_media(content, ctype):
    if not content:
        return None, None
    if not ctype:
        key = 'application/json' if 'application/json' in content else next(iter(content))
        return key, content[key].get('schema')
    matches = [k for k in content if media_matches(ctype, k)]
    if not matches:
        return None, None
    key = max(matches, key=lambda k: (k.split(';')[0].strip().lower() == ctype, k != '*/*'))
    return key, content[key].get('schema')


