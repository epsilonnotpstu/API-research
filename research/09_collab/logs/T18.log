   138	          scheduledExecutor.schedule(() -> deferredResult.setResult(ResponseEntity.ok(
   139	            generateReturnTestResult(LabTestResult.POSITIVE.getTestResult(),
   140	              appSession.get().getCreatedAt().toEpochSecond(ZoneOffset.UTC), null))),
   141	            fakeDelayService.realDelayTest(), MILLISECONDS);
   142	          return deferredResult;
   143	        default:
   144	          stopWatch.stop();
   145	          throw new VerificationServerException(HttpStatus.BAD_REQUEST,
   146	            "Unknown source of trust inside the appsession for the registration token");
   147	      }
   148	    }
   149	    log.info("The registration token doesn't exist.");
   150	    throw new VerificationServerException(HttpStatus.BAD_REQUEST,
   151	      "Returning the test result for the registration token failed");
   152	  }
   153	
   154	  private TestResult generateReturnTestResult(Integer testResult, Long sc, String labId) {
   155	    return new TestResult(testResult,sc, labId, RandomStringUtils.randomAlphanumeric(RESPONSE_PADDING_LENGTH));
   156	  }
   157	}
