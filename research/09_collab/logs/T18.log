   129	      appSession.setTeleTanHash(hashingService.hash(teleTan));
   130	      appSession.setSourceOfTrust(AppSessionSourceOfTrust.TELETAN);
   131	      appSession.setTeleTanType(teleTanType);
   132	      saveAppSession(appSession);
   133	      log.info("Returning the successfully created registration token.");
   134	      return ResponseEntity.status(HttpStatus.CREATED).body(
   135	        getBackwardCompatibleRegistrationToken(registrationToken, fake));
   136	    }
   137	  }
