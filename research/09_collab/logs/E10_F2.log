import pathlib,re,json,csv
def show(path,start=1,end=None):
 p=pathlib.Path(path); lines=p.read_text().splitlines()
 print(\"\\nFILE \"+str(p))
 for n,line in enumerate(lines,1):
  if n<start or (end is not None and n>end): continue
  if re.search(r'@author|copyright|[\\w.+-]+@[\\w.-]+\\.[A-Za-z]{2,}|-----BEGIN .*PRIVATE|(?i:api[_-]?key|client[_-]?secret|password)\\s*[:=]\\s*[\"\\']["'^"'"\\']+[\"\\']',line,re.I): line=\"[REDACTED]\"
  print(f\"{n}: {line}\")
def hits(root,pattern,context=3):
 for p in sorted(pathlib.Path(root).rglob(\"*\")):
  if not p.is_file(): continue
  lines=p.read_text().splitlines(); ix=set()
  for n,l in enumerate(lines):
   if re.search(pattern,l,re.I): ix.update(range(max(0,n-context),min(len(lines),n+context+1)))
  if ix:
   print(\"\\nFILE \"+str(p))
   for n in sorted(ix):
    l=lines[n]
    if re.search(r'@author|copyright|[\\w.+-]+@[\\w.-]+\\.[A-Za-z]{2,}|-----BEGIN .*PRIVATE|(?i:api[_-]?key|client[_-]?secret|password)\\s*[:=]\\s*[\"\\']["'^"'"\\']+[\"\\']',l,re.I): l=\"[REDACTED]\"
    print(f\"{n+1}: {l}\")

