8: func bearerTokenFromRequest(r *http.Request) (string, bool) {
9: 	parts := strings.Split(r.Header.Get("Authorization"), " ")
10: 
11: 	if len(parts) == 2 && strings.ToLower(parts[0]) == "bearer" {
12: 		return parts[1], true
13: 	}
14: 
15: 	return "", false
16: }

