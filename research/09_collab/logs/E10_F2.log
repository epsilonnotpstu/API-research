394:                     BridgeContentType.KAFKA_JSON, error.toJson().toBuffer());
395:             return;
396:         }
397: 
398:         this.setSubscribeHandler(subscribeResult -> {
399:             if (subscribeResult.succeeded()) {
400:                 HttpUtils.sendResponse(routingContext, HttpResponseStatus.NO_CONTENT.code(), null, null);
401:             }
402:         });
403: 
404:         if (bodyAsJson.containsKey("topics")) {
405:             JsonArray topicsList = bodyAsJson.getJsonArray("topics");
406:             this.topicSubscriptions.addAll(
407:                 topicsList.stream()
408:                         .map(String.class::cast)
409:                         .map(topic -> new SinkTopicSubscription(topic))
410:                         .collect(Collectors.toList())
411:             );
412:             this.subscribe(false);
413:         } else if (bodyAsJson.containsKey("topic_pattern")) {
414:             Pattern pattern = Pattern.compile(bodyAsJson.getString("topic_pattern"));
415:             this.subscribe(pattern, false);
416:         }
417:     }

