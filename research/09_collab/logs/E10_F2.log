15: /**
16:  * Provides some utility methods for HTTP request/response
17:  */
18: public class HttpUtils {
19: 
20:     private static final Logger log = LoggerFactory.getLogger(HttpUtils.class);
21: 
22:     /**
23:      * Send an HTTP response
24:      *
25:      * @param routingContext the routing context used to send the HTTP response
26:      * @param statusCode the HTTP status code
27:      * @param contentType the content-type to set in the HTTP response
28:      * @param body the body to set in the HTTP response
29:      */
30:     public static void sendResponse(RoutingContext routingContext, int statusCode, String contentType, Buffer body) {
31:         if (!routingContext.response().closed() && !routingContext.response().ended()) {
32:             routingContext.response().setStatusCode(statusCode);
33:             if (body != null) {
34:                 log.debug("[{}] Response: body = {}", routingContext.get("request-id"), Json.decodeValue(body));
35:                 routingContext.response().putHeader(HttpHeaderNames.CONTENT_TYPE, contentType);
36:                 routingContext.response().putHeader(HttpHeaderNames.CONTENT_LENGTH, String.valueOf(body.length()));
37:                 routingContext.response().write(body);
38:             }
39:             routingContext.response().end();
40:         } else if (routingContext.response().ended()) {
41:             log.warn("[{}] Response: already ended!", routingContext.get("request-id").toString());
42:         }
43:     }
44: 
45:     /**
46:      * Send a file over an HTTP response
47:      *
48:      * @param routingContext the routing context used to send the HTTP response
49:      * @param statusCode the HTTP status code
50:      * @param contentType the content-type to set in the HTTP response
51:      * @param filename path to the file to send
52:      */
53:     public static void sendFile(RoutingContext routingContext, int statusCode, String contentType, String filename) {
54:         if (!routingContext.response().closed() && !routingContext.response().ended()) {
55:             routingContext.response().setStatusCode(statusCode);
56:             log.debug("[{}] Response: filename = {}", routingContext.get("request-id"), filename);
57:             routingContext.response().putHeader(HttpHeaderNames.CONTENT_TYPE, contentType).sendFile(filename);
58:         } else if (routingContext.response().ended()) {
59:             log.warn("[{}] Response: already ended!", routingContext.get("request-id").toString());
60:         } 
61:     }
62: }

