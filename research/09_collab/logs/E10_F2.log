206:   private InstanceData asTallyHostViewApiInstance(
207:       TallyInstanceView tallyInstanceView, List<String> measurements) {
208:     var instance = new InstanceData();
209:     List<Double> measurementList = new ArrayList<>();
210:     instance.setId(tallyInstanceView.getKey().getInstanceId().toString());
211:     instance.setDisplayName(tallyInstanceView.getDisplayName());
212:     if (Objects.nonNull(tallyInstanceView.getHostBillingProvider())) {
213:       instance.setBillingProvider(tallyInstanceView.getHostBillingProvider().asOpenApiEnum());
214:     }
215:     for (String uom : measurements) {
216:       if (tallyInstanceView.getKey().getUom().equals(Measurement.Uom.fromValue(uom))) {
217:         measurementList.add(
218:             tallyInstanceView.getMonthlyTotals().values().stream().findFirst().orElse(0.0));
219:       } else {
220:         measurementList.add(0.0);
221:       }
222:     }
223:     instance.setCategory(tallyInstanceView.getKey().getMeasurementType().name());
224:     instance.setBillingAccountId(tallyInstanceView.getHostBillingAccountId());
225:     instance.setMeasurements(measurementList);
226:     instance.setLastSeen(tallyInstanceView.getLastSeen());
227:     instance.setNumberOfGuests(tallyInstanceView.getNumOfGuests());
228:     return instance;
229:   }
