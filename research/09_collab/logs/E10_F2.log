34:   public Response toResponse(ContractsException exception) {
35:     // Using a switch expression below forces us to decide on an HTTP status every time we add a new
36:     // ErrorCode.
37:     var status =
38:         switch (exception.getCode()) {
39:           case CONTRACT_EXISTS -> Status.CONFLICT;
