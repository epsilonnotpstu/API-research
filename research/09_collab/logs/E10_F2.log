32: 
33:     @Override
34:     public ResponseEntity<InlineResponse200> bankSearchGET(String authorization, UUID xRequestID, String keyword,
35:                                                            Integer start, Integer max) {
36:         if (start == null) {
37:             start = DEFAULT_START;
38:         }
39:         if (max == null) {
40:             max = DEFAULT_MAX;
41:         }
42:         List<Bank> banks = bankService.getBanks(keyword, start, max);
43:         if (banks.isEmpty()) {
44:             return new ResponseEntity<>(HttpStatus.NOT_FOUND);
45:         }
46: 
47:         InlineResponse200 inlineResponse200 = new InlineResponse200();
48:         banks.forEach(it -> inlineResponse200.addBankDescriptorItem(toBankDescriptor(it)));
49:         inlineResponse200.setKeyword(keyword);
50:         inlineResponse200.setMax(max);
51:         inlineResponse200.setStart(start);
52:         return new ResponseEntity<>(inlineResponse200, HttpStatus.OK);
53:     }
54: 
55:     @Override
56:     public ResponseEntity<InlineResponse2001> bankProfileGET(String authorization,
57:                                                              UUID xRequestID,
58:                                                              String bankId) {
59:         Optional<BankProfile> bankProfile = bankService.getBankProfile(bankId);
60:         if (!bankProfile.isPresent()) {
61:             return new ResponseEntity<>(HttpStatus.NOT_FOUND);
62:         }
63:         InlineResponse2001 inlineResponse2001 = new InlineResponse2001();
64:         BankProfileDescriptor bankProfileDescriptor = new BankProfileDescriptor();
65:         bankProfileDescriptor.setBankName(bankProfile.get().getBank().getName());
66:         bankProfileDescriptor.setBic(bankProfile.get().getBank().getBic());
67:         if (StringUtils.isNotEmpty(bankProfile.get().getServices())) {
68:             bankProfileDescriptor.serviceList(Arrays.asList(bankProfile.get().getServices().split(",")));
69:         }
70:         inlineResponse2001.setBankProfileDescriptor(bankProfileDescriptor);
71:         return new ResponseEntity<>(inlineResponse2001, HttpStatus.OK);
72:     }
73: 
74:     private BankDescriptor toBankDescriptor(Bank bank) {
75:         BankDescriptor bankDescriptor = new BankDescriptor();
76:         bankDescriptor.setBankCode(bank.getBankCode());
77:         bankDescriptor.setBankName(bank.getName());
78:         bankDescriptor.setBic(bank.getBic());
79:         bankDescriptor.setUuid(bank.getUuid());
80:         return bankDescriptor;
81:     }
82: }
