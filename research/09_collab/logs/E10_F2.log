20: @RequiredArgsConstructor
21: public class PageableProductsProvider {
22: 
23:     private final ProductInfoRepository productInfoRepository;
24:     private final ProductInfoDtoConverter productInfoDtoConverter;
25: 
26:     @Transactional(propagation = Propagation.REQUIRED, isolation = Isolation.READ_COMMITTED, readOnly = true)
27:     public ProductListWithPaginationInfoDto getProducts(final Integer page,
28:                                                         final Integer size,
29:                                                         final String sortAttribute,
30:                                                         final String sortDirection) {
31:         Pageable pageable = createPageableObject(page, size, sortAttribute, sortDirection);
32: 
33:         Page<ProductInfoDto> productsWithPageInfo = productInfoRepository
34:                 .findAll(pageable)
35:                 .map(productInfoDtoConverter::toDto);
36: 
37:         return productInfoDtoConverter.toProductPaginationDto(productsWithPageInfo);
38:     }
39: 
40:     private Pageable createPageableObject(final Integer page,
41:                                           final Integer size,
42:                                           final String sortAttribute,
43:                                           final String sortDirection) {
44:         Sort sort;
45:         if (sortDirection.equalsIgnoreCase(Sort.Direction.ASC.name()))
46:             sort = Sort.by(sortAttribute).ascending();
47:         else
48:             sort = Sort.by(sortAttribute).descending();
49: 
50:         return PageRequest.of(page, size, sort);
51:     }
52: }

