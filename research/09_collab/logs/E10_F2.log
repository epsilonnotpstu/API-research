import pathlib,re,json,csv
def show(path,start=1,end=None):
 p=pathlib.Path(path); lines=p.read_text().splitlines()
 print(\"\\nFILE \"+str(p))
 for n,line in enumerate(lines,1):
  if n<start or (end is not None and n>end): continue
  if re.search(r'@author|copyright|[\\w.+-]+@[\\w.-]+\\.[A-Za-z]{2,}|-----BEGIN .*PRIVATE|(?i:api[_-]?key|client[_-]?secret|password)\\s*[:=]\\s*[\"\\']["'^"'"\\']+[\"\\']',line,re.I): line=\"[REDACTED]\"
