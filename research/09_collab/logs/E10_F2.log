  assert p.is_file(),path
  assert 1<=int(num)<=len(p.read_text().splitlines()),loc
  locators+=1
print('PASS: 40 rows; exact item order; unique IDs; allowed labels and confidence; rationales <=40 words; all evidence locators valid and item-local.')
print('Label distribution:',dict(collections.Counter(r['L1'] for r in rows)))
print('Confidence distribution:',dict(sorted(collections.Counter(r['confidence'] for r in rows).items())))
print('Evidence locators:',locators)
print('Longest rationale:',max(len(r['rationale'].split()) for r in rows),'words')
