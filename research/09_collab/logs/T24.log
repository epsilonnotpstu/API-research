   308	class RequestProblems(list):
   309	    """List compatibility for existing callers, plus explicit evidence completeness."""
   310	    def __init__(self):
   311	        super().__init__()
   312	        self.uncheckable = []
   313	
   314	
   315	def request_problems(spec, params, op, exchange, path_params):
   316	    problems = RequestProblems()
   317	    req = exchange['request']
   318	    headers = {k.lower(): v for k, v in req.get('headers', {}).items()}
   319	    for p in params:
   320	        loc, name = p.get('in'), p.get('name')
   321	        schema = p.get('schema') if 'schema' in p else {k: p[k] for k in PARAM_SCHEMA_KEYS if k in p}
   322	        if loc == 'body':
   323	            continue
   324	        all_vals = None
   325	        if loc == 'path':
   326	            present, raw = name in path_params, path_params.get(name)
   327	        elif loc == 'query':
   328	            vals = req.get('query', {}).get(name)
   329	            all_vals = vals if isinstance(vals, list) else [vals] if vals is not None else []
   330	            present, raw = bool(all_vals), all_vals[0] if all_vals else None
   331	        elif loc == 'header':
   332	            raw = headers.get(name.lower())
   333	            present = raw is not None
   334	        elif loc == 'cookie':
   335	            if headers.get('cookie') == '<redacted>':
   336	                problems.uncheckable.append('cookie values are redacted')
   337	                continue
   338	            cookies = SimpleCookie()
   339	            cookies.load(headers.get('cookie', ''))
   340	            present = name in cookies
   341	            raw = cookies[name].value if present else None
   342	        else:
   343	            problems.uncheckable.append('unsupported parameter location: ' + str(loc))
   344	            continue
   345	        prefix = '/parameters' + specmut.ptr(loc, name)
   346	        if not present:
   347	            if p.get('required'):
   348	                problems.append((prefix + '/required', f'missing required {loc} parameter {name}',
   349	                                 {'keyword': 'required', 'instance_location': prefix, 'property': name}))
   350	            continue
   351	        if 'content' in p or (isinstance(schema, dict) and (schema.get('type') == 'object' or '$ref' in schema)):
   352	            problems.uncheckable.append('unsupported parameter serialization: ' + str(name))
   353	            continue
   354	        js = to_json_schema(schema, spec.dialect, direction='request')
   355	        delim = {'ssv': ' ', 'tsv': '\t', 'pipes': '|'}.get(p.get('collectionFormat'), ',')
   356	        delim = {'spaceDelimited': ' ', 'pipeDelimited': '|'}.get(p.get('style'), delim)
   357	        explode = (spec.oas3 and loc in ('query', 'cookie') and p.get('style', 'form') == 'form' and p.get('explode', True)) or p.get('collectionFormat') == 'multi'
   358	        value = coerce(raw, js, all_vals, delim, explode)
   359	        try:
   360	            problems.extend(schema_problems(spec, schema, value, 'request', prefix))
   361	        except Exception as exc:
   362	            problems.uncheckable.append('parameter schema: ' + str(exc))
   363	    body_schema, required, media = None, False, None
   364	    ctype = headers.get('content-type', '').split(';')[0].strip().lower()
   365	    if spec.oas3 and 'requestBody' in op:
   366	        rb = op['requestBody']
   367	        required = rb.get('required', False)
   368	        media, body_schema = select_media(rb.get('content', {}), ctype)
   369	        if rb.get('content') and ctype and media is None:
   370	            problems.append(('/requestBody/content', 'undocumented request Content-Type', {'keyword': 'contentType'}))
   371	    else:
   372	        bp = next((p for p in params if p.get('in') == 'body'), {})
   373	        body_schema, required = bp.get('schema'), bp.get('required', False)
   374	        media = ctype or next(iter(op.get('consumes', spec.raw.get('consumes', ['application/json']))), 'application/json')
   375	    capture = req.get('body', {})
   376	    text = capture.get('text', '')
   377	    if capture.get('truncated') or capture.get('decode_error'):
   378	        problems.uncheckable.append('request body capture is incomplete or undecodable')
   379	    elif not text:
   380	        if required:
   381	            problems.append(('/requestBody/required', 'missing required request body', {'keyword': 'required', 'property': 'requestBody'}))
   382	    elif body_schema is not None:
   383	        try:
   384	            body = parse_body(text, ctype or media)
   385	        except ValueError:
   386	            problems.append(('/requestBody/parse', 'request body is not valid JSON', {'keyword': 'parse'}))
   387	        except LookupError as exc:
   388	            problems.uncheckable.append(str(exc))
   389	        else:
   390	            try:
   391	                problems.extend(schema_problems(spec, body_schema, body, 'request', '/requestBody'))
   392	            except Exception as exc:
   393	                problems.uncheckable.append('request body schema: ' + str(exc))
   394	    return problems
