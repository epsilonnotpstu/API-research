     1	#!/usr/bin/env python3
     2	"""List operations whose response oracle is actually exercised in a baseline run.
     3	
     4	An operation is eligible when the baseline exchanges contain at least one 2xx response
     5	with a non-empty body for it. RESPONSE_ORACLE mutations on other operations can never
     6	fire (the checker only validates 2xx bodies), which made Batch-2 results seed-dependent.
     7	
     8	Usage:
     9	  python3 eligible_ops.py BASELINE_RUN_DIR [--base-path /api] --out eligible.json
    10	Output: JSON {"source_run": ..., "criterion": ..., "operations": [[path, method], ...]}
    11	"""
    12	import argparse
    13	import json
    14	import re
    15	import sys
    16	from pathlib import Path
    17	
    18	sys.path.insert(0, str(Path(__file__).resolve().parent))
    19	import copy  # noqa: E402
    20	from specmut import load_spec, operations, mutate_response, mutate_loose, LOOSE_KEYS  # noqa: E402
    21	
    22	# Constraints our checker evaluates; 'format' (e.g. int64) is not enforced by conformance.py.
    23	CHECKED_LOOSE_KEYS = (set(LOOSE_KEYS) - {'format'}) | {'required'}
    24	
    25	
    26	def loose_effective(spec, path, method):
    27	    """True if REQUEST_LOOSE would remove at least one request constraint the checker evaluates."""
    28	    s = copy.deepcopy(spec)
    29	    edits = []
    30	    mutate_loose(s, path, method, s['paths'][path][method], edits)
    31	    return any(e['pointer'].rsplit('/', 1)[-1] in CHECKED_LOOSE_KEYS and e.get('before') not in (None, False)
    32	               for e in edits)
    33	
    34	
    35	def oracle_mutable(spec, path, method):
    36	    """True if RESPONSE_ORACLE would edit a 2xx response schema of this operation."""
    37	    s = copy.deepcopy(spec)
    38	    edits = []
    39	    mutate_response(s, path, method, s['paths'][path][method], edits)
    40	    return any('/responses/2' in e['pointer'] for e in edits)
    41	
    42	
    43	def template_matcher(spec):
    44	    pats = []
    45	    for path, method, _ in operations(spec):
    46	        rx = '^' + re.sub(r'\\\{[^}]+\\\}', '[^/]+', re.escape(path)) + '$'
    47	        literal = path.count('{')
    48	        pats.append((literal, path, method, re.compile(rx)))
    49	    pats.sort(key=lambda x: x[0])  # literal paths before templated ones
    50	    return pats
    51	
    52	
    53	def main():
    54	    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    55	    ap.add_argument('run_dir')
    56	    ap.add_argument('--base-path', default='')
    57	    ap.add_argument('--min-count', type=int, default=1)
    58	    ap.add_argument('--any-schema', action='store_true',
    59	                    help='do not require a 2xx response schema that RESPONSE_ORACLE can edit')
    60	    ap.add_argument('--fault', choices=('RESPONSE_ORACLE', 'REQUEST_LOOSE'), default='RESPONSE_ORACLE',
    61	                    help='REQUEST_LOOSE: spec-only pool of operations with a checker-evaluated request constraint')
    62	    ap.add_argument('--out', required=True)
    63	    a = ap.parse_args()
    64	    run = Path(a.run_dir)
    65	    spec_file = next(run.glob('spec.original.*'))
    66	    spec = load_spec(str(spec_file))
    67	    if a.fault == 'REQUEST_LOOSE':
    68	        ops = sorted((p, m) for p, m, _ in operations(spec) if loose_effective(spec, p, m))
    69	        Path(a.out).write_text(json.dumps({'source_run': run.name, 'spec': spec_file.name, 'fault': a.fault,
    70	            'criterion': 'REQUEST_LOOSE removes >=1 checker-evaluated request constraint (' +
    71	                         ', '.join(sorted(CHECKED_LOOSE_KEYS)) + ')',
    72	            'operations': [list(k) for k in ops]}, indent=2), encoding='utf-8')
    73	        print(f'{len(ops)} eligible operations -> {a.out}')
    74	        return
    75	    pats = template_matcher(spec)
    76	    base = a.base_path.rstrip('/')
    77	    counts = {}
    78	    with open(run / 'exchanges.jsonl', encoding='utf-8') as f:
    79	        for line in f:
    80	            ex = json.loads(line)
    81	            st = ex['response']['status']
    82	            body = (ex['response'].get('body') or {})
    83	            if not 200 <= st < 300 or not body.get('size'):
    84	                continue
    85	            p = ex['request']['path'].split('?')[0]
    86	            if base and p.startswith(base):
    87	                p = p[len(base):] or '/'
    88	            m = ex['request']['method'].lower()
    89	            for _, tpath, tmethod, rx in pats:
    90	                if tmethod == m and rx.match(p):
    91	                    counts[(tpath, tmethod)] = counts.get((tpath, tmethod), 0) + 1
    92	                    break
    93	    observed = sorted(k for k, v in counts.items() if v >= a.min_count)
    94	    ops = observed if a.any_schema else [k for k in observed if oracle_mutable(spec, *k)]
    95	    out = {'source_run': run.name, 'spec': spec_file.name,
    96	           'criterion': f'>= {a.min_count} baseline 2xx response(s) with non-empty body'
    97	                        + ('' if a.any_schema else ' AND an editable 2xx response schema'),
    98	           'observed_without_editable_schema': [f'{m.upper()} {p}' for p, m in observed if (p, m) not in ops],
    99	           'operations': [list(k) for k in ops], 'counts': {f'{m.upper()} {p}': counts[(p, m)] for p, m in ops}}
   100	    Path(a.out).write_text(json.dumps(out, indent=2), encoding='utf-8')
   101	    print(f'{len(ops)} eligible operations -> {a.out}')
   102	
   103	
   104	if __name__ == '__main__':
   105	    main()
