+
+ROOT = Path('/home/afridi/Documents/API research/research')
+sys.path.insert(0, str(ROOT / '08_experiments/tools'))
+import conformance as c
+import eligible_ops
+import specmut
+
+ROWS = []
+def record(name, **data):
+    ROWS.append(dict(id=name, **data))
+
+def document(version, schema=None, location='query', body=False, response=False):
+    op = {'responses': {'200': {'description': 'ok'}, '400': {'description': 'bad'}}}
+    path = '/x/{q}' if location == 'path' else '/x'
+    d = {'info': {'title': 'T24', 'version': '1'}, 'paths': {path: {'get': op}}}
+    if version == '2.0':
+        d['swagger'] = version
+        if body:
+            op['parameters'] = [{'name': 'body', 'in': 'body', 'required': True, 'schema': schema}]
+        elif response:
+            op['responses']['200']['schema'] = schema
+        elif schema is not None:
+            op['parameters'] = [{'name': 'q', 'in': location, 'required': True, **schema}]
+    else:
+        d['openapi'] = version
+        if body:
+            op['requestBody'] = {'required': True, 'content': {'application/json': {'schema': schema}}}
+        elif response:
+            op['responses']['200']['content'] = {'application/json': {'schema': schema}}
+        elif schema is not None:
+            op['parameters'] = [{'name': 'q', 'in': location, 'required': True, 'schema': schema}]
+    return d
+
+def exchange(value=None, location='query', request='', response='', status=400, ctype=None):
+    e = {'request': {'method': 'GET', 'path': '/x', 'query': {}, 'headers': {}, 'body': {'text': request}},
+         'response': {'status': status, 'headers': {'content-type': 'application/json'}, 'body': {'text': response}}}
+    if value is not None:
+        if location == 'path': e['request']['path'] = '/x/' + str(value)
+        elif location == 'query': e['request']['query'] = {'q': [str(value)]}
+        elif location == 'header': e['request']['headers'] = {'Q': str(value)}
+        elif location == 'cookie': e['request']['headers'] = {'Cookie': 'q=' + str(value)}
+    if ctype: e['request']['headers']['content-type'] = ctype
+    return e
+
+def check(d, e):
+    return c.check(c.Spec(d), e)
+
+boundary_count = 0
+for version in ('2.0', '3.0.3', '3.1.0'):
+    for location in ('query', 'path', 'header', 'cookie'):
+        if version == '2.0' and location == 'cookie': continue
+        for fmt, (lo, hi) in c.INT_RANGES.items():
+            for value in (lo - 1, lo, hi, hi + 1):
+                d = document(version, {'type': 'integer', 'format': fmt}, location)
+                result = check(d, exchange(value, location))
+                valid = lo <= value <= hi
+                assert ('VALID_REJECTED' in [v['kind'] for v in result]) == valid, (version, location, value, result)
+                result2 = check(d, exchange(value, location, status=200))
+                assert ('INVALID_ACCEPTED' in [v['kind'] for v in result2]) != valid
+                boundary_count += 2
+record('parameter_boundaries', assertions=boundary_count)
+
+body_count = 0
+for version in ('2.0', '3.0.3', '3.1.0'):
+    for fmt, (lo, hi) in c.INT_RANGES.items():
+        for value in (lo - 1, lo, hi, hi + 1, 10 ** 1000):
+            valid = lo <= value <= hi
+            schema = {'type': 'integer', 'format': fmt}
+            request = check(document(version, schema, body=True), exchange(request=json.dumps(value)))
+            response = check(document(version, schema, response=True), exchange(response=json.dumps(value), status=200))
+            assert ('VALID_REJECTED' in [v['kind'] for v in request]) == valid
+            assert ('RESPONSE_SCHEMA' in [v['kind'] for v in response]) != valid
+            body_count += 2
+record('json_body_boundaries', assertions=body_count, large_integer_digits=1001)
+
+for version in ('3.0.3', '3.1.0'):
+    schema = {'type': 'integer', 'format': 'int64'}
+    for text in ('1.0', '9223372036854775808.0', '1e100', '-1e100'):
+        req = check(document(version, schema, body=True), exchange(request=text))
+        resp = check(document(version, schema, response=True), exchange(response=text, status=200))
+        record('float_json', version=version, text=text, request_kinds=[v['kind'] for v in req], response_kinds=[v['kind'] for v in resp])
+        assert ('VALID_REJECTED' in [v['kind'] for v in req]) == (version == '3.1.0')
+
+for location in ('query', 'path', 'header', 'cookie'):
+    schema = {'type': 'number', 'format': 'int64'}
+    out = check(document('3.0.3', schema, location), exchange(2 ** 63, location))
+    assert 'VALID_REJECTED' in [v['kind'] for v in out]
+    record('number_parameter', location=location, kinds=[v['kind'] for v in out])
+for value in (2 ** 63, float(2 ** 63), 0.5, True):
+    errors = list(c.validator({'type': 'number', 'format': 'int64'}, '3.1.0').iter_errors(value))
+    record('number_representation', value=repr(value), errors=[e.validator for e in errors])
+
+for version in ('3.0.3', '3.1.0'):
+    for value in (None, 2 ** 63, True):
+        schema = {'type': ['integer', 'null'], 'format': 'int64'}
+        errors = list(c.validator(schema, version).iter_errors(value))
+        assert [e.validator for e in errors] == ([] if value is None else ['type'] if value is True else ['format'])
+        record('nullable_bool', version=version, value=repr(value), errors=[e.validator for e in errors])
+
+for version in ('2.0', '3.0.3', '3.1.0'):
+    schema = {'type': 'array', 'items': {'type': 'integer', 'format': 'int32'}}
+    d = document(version, schema)
+    if version != '2.0': d['paths']['/x']['get']['parameters'][0]['explode'] = False
+    errors = check(d, exchange('1,2147483648', status=200))
+    assert [v['keyword'] for v in errors] == ['format']
+    response = check(document(version, schema, response=True), exchange(response='[1,2147483648]', status=200))
+    assert [v['kind'] for v in response] == ['RESPONSE_SCHEMA']
+    record('arrays', version=version, parameter=errors, response=response)
+
+d = document('3.0.3')
+d['paths']['/x']['get']['requestBody'] = {'required': True, 'content': {'application/x-www-form-urlencoded': {'schema': {'type': 'object', 'properties': {'q': {'type': 'integer', 'format': 'int64'}}}}}}
+form3 = check(d, exchange(request='q=9223372036854775808', ctype='application/x-www-form-urlencoded'))
+d = document('2.0', {'type': 'integer', 'format': 'int64'}, 'formData')
+form2 = check(d, exchange(request='q=9223372036854775808', ctype='application/x-www-form-urlencoded'))
+assert [v['kind'] for v in form3] == ['REQUEST_UNCHECKABLE']
+assert [v['kind'] for v in form2] == ['REQUEST_UNCHECKABLE']
+record('form3', violations=form3); record('form2', violations=form2)
+
+d = document('3.0.3', {'type': 'integer', 'format': 'int64'}, 'path')
+original = copy.deepcopy(d)
+edits = []
+specmut.mutate_loose(d, '/x/{q}', 'get', d['paths']['/x/{q}']['get'], edits)
+base = check(original, exchange(2 ** 63, 'path'))
+mutated = check(d, exchange(2 ** 63, 'path'))
+assert not eligible_ops.loose_effective(original, '/x/{q}', 'get')
+assert [v['kind'] for v in base] == []
+assert [v['kind'] for v in mutated] == ['VALID_REJECTED']
+record('format_only_pool', eligible=False, edits=edits, base=base, mutated=mutated)
+
+sp = c.Spec(document('3.0.3', {'type': 'integer', 'format': 'int64'}))
+e = exchange(2 ** 63)
+out = []
+for policy in (True, False, True):
+    c.INT_FORMATS = policy
+    out.append([v['kind'] for v in c.check(sp, e)])
+c.INT_FORMATS = True
+assert out == [[], ['VALID_REJECTED'], []]
+record('cached_validator_global', policy_sequence=[True,False,True], outputs=out)
+
+for value in (True, False, 'x', None, 0.5):
+    assert c.FORMAT_CHECKER.conforms(value, 'int64')
+record('format_nonints', values=['True','False','x','None','0.5'], conforms=True)
+
+out = Path('/tmp/T24_review/probes.json')
+out.write_text(json.dumps({'python':sys.version, 'jsonschema':importlib.metadata.version('jsonschema'), 'records':ROWS}, indent=2))
+print(json.dumps({'records':len(ROWS), 'parameter_assertions':boundary_count, 'body_assertions':body_count, 'sha256':hashlib.sha256(out.read_bytes()).hexdigest()}))
+for row in ROWS:
+    if row['id'] != 'arrays': print(json.dumps(row))
