+        record('nullable_bool', version=version, value=repr(value), errors=[e.validator for e in errors])
+
+for version in ('2.0', '3.0.3', '3.1.0'):
+    schema = {'type': 'array', 'items': {'type': 'integer', 'format': 'int32'}}
+    d = document(version, schema)
+    if version != '2.0': d['paths']['/x']['get']['parameters'][0]['explode'] = False
+    errors = check(d, exchange('1,2147483648', status=200))
+    assert [v['keyword'] for v in errors] == ['format']
+    response = check(document(version, schema, response=True), exchange(response='[1,2147483648]', status=200))
