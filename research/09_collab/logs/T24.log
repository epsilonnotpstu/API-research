   467	def main(spec_path, exchanges_path, deploy_origin=None, reject_statuses=(400, 422)):
   468	    spec = Spec(specmut.load_spec(spec_path), deploy_origin=deploy_origin, reject_statuses=reject_statuses)
   469	    with open(exchanges_path, encoding='utf-8') as f:
   470	        for i, line in enumerate(f):
   471	            for violation in check(spec, json.loads(line)):
   472	                violation['exchange'] = i
   473	                print(json.dumps(violation))
   474	
   475	
