   117	def walk_schema(node, pointer):
   118	    """Yield (pointer, schema-dict) for a schema and its nested properties/items."""
   119	    if not isinstance(node, dict):
   120	        return
   121	    yield pointer, node
   122	    for name, sub in node.get('properties', {}).items():
   123	        yield from walk_schema(sub, pointer + '/properties' + ptr(name))
   124	    if isinstance(node.get('items'), dict):
   125	        yield from walk_schema(node['items'], f'{pointer}/items')
   126	    # allOf is monotone; editing oneOf/not/conditional branches is not generally so.
   127	    for i, sub in enumerate(node.get('allOf', [])):
   128	        yield from walk_schema(sub, f'{pointer}/allOf/{i}')
