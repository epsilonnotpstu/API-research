   246	    def errors(self, schema, instance, direction):
   247	        key = (json.dumps(schema, sort_keys=True), direction)
   248	        if key not in self._validators:
   249	            self._validators[key] = validator(schema, self.dialect, self.strict if direction == 'response' else False,
   250	                                              direction, self.raw, self._resolvers.get(direction))
   251	            # Reuse the normalized source document; each validator still has its
   252	            # own root schema, while reference targets share direction/policy.
   253	            self._resolvers[direction] = self._validators[key]._ref_resolver
   254	        return self._validators[key].iter_errors(instance)
