+
+for value in (True, False, 'x', None, 0.5):
+    assert c.FORMAT_CHECKER.conforms(value, 'int64')
+record('format_nonints', values=['True','False','x','None','0.5'], conforms=True)
+
+out = Path('/tmp/T24_review/probes.json')
+out.write_text(json.dumps({'python':sys.version, 'jsonschema':importlib.metadata.version('jsonschema'), 'records':ROWS}, indent=2))
+print(json.dumps({'records':len(ROWS), 'parameter_assertions':boundary_count, 'body_assertions':body_count, 'sha256':hashlib.sha256(out.read_bytes()).hexdigest()}))
