   292	def schema_problems(spec, schema, value, direction, prefix=''):
   293	    for err in spec.errors(schema, value, direction):
   294	        pointer = prefix + '/' + '/'.join(str(p).replace('~', '~0').replace('/', '~1') for p in err.schema_path)
   295	        for identity in error_identity(err):
   296	            yield pointer, err.message, identity
