   299	def parse_body(text, media):
   300	    media = (media or 'application/json').split(';')[0].lower()
   301	    if media == 'application/json' or media.endswith('+json') or media == '*/*':
   302	        return json.loads(text)
   303	    if media.startswith('text/'):
   304	        return text
   305	    raise LookupError('unsupported body encoding: ' + media)
