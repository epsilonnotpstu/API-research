   257	def coerce(value, schema, values=None, delimiter=',', explode=False):
   258	    if not isinstance(schema, dict):
   259	        return value
   260	    t = schema.get('type')
   261	    if isinstance(t, list):
   262	        t = next((x for x in t if x != 'null'), None)
   263	    if t == 'array':
   264	        raw = (values if values is not None else [value]) if explode else (value.split(delimiter) if isinstance(value, str) else [value])
   265	        return [coerce(x, schema.get('items', {})) for x in raw]
   266	    try:
   267	        if t == 'integer':
   268	            return int(value)
   269	        if t == 'number':
   270	            return float(value)
   271	        if t == 'boolean':
   272	            return {'true': True, 'false': False}[value.lower()]
   273	    except (ValueError, KeyError, AttributeError, TypeError):
   274	        return value
   275	    return value
