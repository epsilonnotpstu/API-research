   278	def error_identity(err):
   279	    """Array indices normalize to '*'; object keys and offending property remain distinct."""
   280	    loc = '/' + '/'.join('*' if isinstance(p, int) else str(p).replace('~', '~0').replace('/', '~1') for p in err.absolute_path)
   281	    properties = ['']
   282	    if err.validator == 'required' and isinstance(err.instance, dict):
   283	        # jsonschema emits one error per missing property; match its own quoted name.
   284	        properties = [str(p) for p in err.validator_value if p not in err.instance and err.message == f'{p!r} is a required property'] or ['']
   285	    elif err.validator == 'additionalProperties' and isinstance(err.instance, dict):
   286	        props, patterns = err.schema.get('properties', {}), err.schema.get('patternProperties', {})
   287	        properties = sorted(str(p) for p in err.instance if p not in props and not any(re.search(rx, p) for rx in patterns)) or ['']
   288	    for prop in properties:
   289	        yield {'keyword': str(err.validator), 'instance_location': loc, 'property': prop}
