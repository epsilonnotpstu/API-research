   397	def media_matches(ctype, allowed):
   398	    allowed = allowed.split(';')[0].strip().lower()
   399	    if allowed in ('*/*', ctype):
   400	        return True
   401	    a_type, _, a_sub = allowed.partition('/')
   402	    c_type, _, _ = ctype.partition('/')
   403	    return a_type == c_type and a_sub == '*'
   404	
