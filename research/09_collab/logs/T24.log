    93	        params[i] = p = resolve(spec, p)
    94	        base = ptr('paths', path, method, 'parameters', i)
    95	        if 'schema' in p:
    96	            yield base + '/schema', p, 'schema'
    97	        else:  # Swagger 2.0 non-body parameter: constraints live on the parameter itself
    98	            yield base, params, i
    99	    if is_oas3(spec) and 'requestBody' in op:
