   406	def check(spec, exchange):
   407	    req, resp = exchange['request'], exchange['response']
   408	    method, status = req['method'].upper(), int(resp['status'])
   409	    template, path_params = spec.match(req['path'], method, req.get('origin'))
   410	
   411	    def v(kind, pointer='', message='', identity=None):
   412	        identity = identity or {}
   413	        parts = [method, template or req['path'], str(status), kind, pointer,
   414	                 identity.get('keyword', ''), identity.get('instance_location', ''), identity.get('property', '')]
   415	        return {'kind': kind, 'method': method, 'template': template or req['path'], 'status': status,
   416	                'pointer': pointer, 'message': message[:300], **identity,
   417	                'fingerprint': json.dumps(parts, ensure_ascii=False, separators=(',', ':'))}
   418	
   419	    if template is None:
   420	        return [v('UNDOCUMENTED_OPERATION', message='path not in spec')]
   421	    op, params = spec.operation(template, method)
   422	    if op is None:
   423	        return [v('UNDOCUMENTED_OPERATION', message='method not in spec')]
   424	    out = []
   425	    if status >= 500:
   426	        out.append(v('SERVER_ERROR'))
   427	    headers = {k.lower(): val for k, val in resp.get('headers', {}).items()}
   428	    ctype = headers.get('content-type', '').split(';')[0].strip().lower()
   429	    documented, schema = spec.response_schema(op, status, ctype)
   430	    if not documented:
   431	        out.append(v('UNDOCUMENTED_STATUS'))
   432	    else:
   433	        allowed = spec.allowed_media(op, status)
   434	        if allowed and ctype and not any(media_matches(ctype, a) for a in allowed):
   435	            out.append(v('RESPONSE_CONTENT_TYPE', message=f'{ctype} not in {allowed}'))
   436	    capture = resp.get('body', {})
   437	    text = capture.get('text', '')
   438	    if documented and schema is not None:
   439	        media = ctype or (select_media((spec.response_entry(op, status) or {}).get('content', {}), '')[0] if spec.oas3 else 'application/json')
   440	        if capture.get('truncated') or capture.get('decode_error'):
   441	            out.append(v('RESPONSE_UNCHECKABLE', message='response body capture is incomplete or undecodable'))
   442	        elif not text and not (media or '').startswith('text/'):
   443	            out.append(v('RESPONSE_PARSE', message='documented response body is missing'))
   444	        else:
   445	            try:
   446	                body = parse_body(text, media)
   447	            except ValueError:
   448	                out.append(v('RESPONSE_PARSE', message='body is not valid JSON'))
   449	            except LookupError as exc:
   450	                out.append(v('RESPONSE_UNCHECKABLE', message=str(exc)))
   451	            else:
   452	                try:
   453	                    out.extend(v('RESPONSE_SCHEMA', ptr, msg, identity)
   454	                               for ptr, msg, identity in schema_problems(spec, schema, body, 'response'))
   455	                except Exception as exc:
   456	                    out.append(v('RESPONSE_UNCHECKABLE', message='response schema: ' + str(exc)))
   457	    problems = request_problems(spec, params, op, exchange, path_params)
   458	    if problems.uncheckable:
   459	        out.append(v('REQUEST_UNCHECKABLE', message='; '.join(problems.uncheckable)))
   460	    if problems and 200 <= status < 300:
   461	        out.extend(v('INVALID_ACCEPTED', ptr, msg, identity) for ptr, msg, identity in problems)
   462	    if not problems and not problems.uncheckable and status in spec.reject:
   463	        out.append(v('VALID_REJECTED'))
   464	    return out
   465	
