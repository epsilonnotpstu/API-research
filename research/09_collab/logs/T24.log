    83	def request_schemas(spec, path, method, op):
    84	    """Yield (pointer, container, key) for every request-side schema-bearing node, inlining refs."""
    85	    item = spec['paths'][path]
    86	    params = op.setdefault('parameters', [])
    87	    if 'parameters' in item:  # path-level params: copy into the operation to keep edits local
