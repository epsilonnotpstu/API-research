+from pathlib import Path
+import difflib
+import hashlib
+import json
+import subprocess
+import sys
+
+ROOT = Path('/home/afridi/Documents/API research/research')
+TMP = Path('/tmp/T24_review')
+TOOLS = ROOT / '08_experiments/tools'
+original = subprocess.run(['git','show','98d8ac5'], cwd=ROOT, capture_output=True, check=True).stdout
+(TMP / 'old_conformance.py').write_bytes(original)
+assert subprocess.run(['git','hash-object',str(TMP / 'old_conformance.py')],capture_output=True,check=True,text=True).stdout.strip().startswith('98d8ac5')
+wrapper = 'import runpy,sys; sys.path.insert(0,sys.argv.pop(1)); script=sys.argv.pop(1); sys.argv[0]=script; runpy.run_path(script,run_name="__main__")'
+def cli(script, args):
+    result = subprocess.run(['/usr/bin/python3','-I','-B','-c',wrapper,str(TOOLS),str(script),*map(str,args)],cwd=ROOT,capture_output=True)
+    assert result.returncode == 0, result.stderr.decode()
+    return result.stdout
+
+rows = []
+for sut in ('scout-api','swagger-petstore','market','cwa-verification'):
+    for p in sorted((ROOT / '08_experiments/E1_pilot/runs' / sut).glob('*/run.json')):
+        meta = json.loads(p.read_text())
+        specs = list(p.parent.glob('spec.test.*'))
+        if meta.get('mode') == 'baseline' and meta.get('complete') and len(specs) == 1 and 'sut_service' in meta: break
+    else: raise AssertionError(sut)
+    args = [specs[0],p.parent / 'exchanges.jsonl','--deploy-origin',f'http://{meta["sut_service"]}:{meta["internal_port"]}','--reject-statuses','400,422']
+    old = cli(TMP / 'old_conformance.py', args)
+    legacy = cli(TOOLS / 'conformance.py', args + ['--no-int-formats'])
+    current = cli(TOOLS / 'conformance.py', args)
+    assert old == legacy, sut
+    row = {'sut':sut,'run':str(p.parent.relative_to(ROOT)), 'spec':specs[0].name,
+           'exchanges':len(args[1].read_bytes().splitlines()), 'old_equals_legacy':True,
+           'old_lines':len(old.splitlines()), 'current_lines':len(current.splitlines()),
+           'legacy_sha256':hashlib.sha256(legacy).hexdigest(), 'current_equals_legacy':current == legacy,
+           'current_hash_matches_collection':hashlib.sha256((TOOLS / 'conformance.py').read_bytes()).hexdigest() == meta['tool_sha256']['conformance.py']}
+    rows.append(row)
+    print(json.dumps(row),flush=True)
+
+# A synthetic path overflow proves that the CLI flag is parsed and alters output.
+d = {'openapi':'3.1.0','info':{'title':'T24','version':'1'},'paths':{'/x/{q}':{'get':{'parameters':[{'in':'path','name':'q','required':True,'schema':{'type':'integer','format':'int64'}}],'responses':{'400':{'description':'bad'}}}}}}
+e = {'request':{'method':'GET','path':'/x/9223372036854775808','headers':{},'body':{'text':''}},'response':{'status':400,'headers':{},'body':{'text':''}}}
+(TMP / 'cli_spec.json').write_text(json.dumps(d))
+(TMP / 'cli_exchanges.jsonl').write_text(json.dumps(e)+'\n')
+args = [TMP / 'cli_spec.json', TMP / 'cli_exchanges.jsonl']
+old = cli(TMP / 'old_conformance.py',args)
+legacy = cli(TOOLS / 'conformance.py',args+['--no-int-formats'])
+current = cli(TOOLS / 'conformance.py',args)
+assert legacy == old and current == b'' and b'VALID_REJECTED' in legacy
+row = {'sut':'synthetic_path_overflow','old_equals_legacy':True,'default_empty':True,'legacy_kind':'VALID_REJECTED'}
+rows.append(row); print(json.dumps(row))
+(TMP / 'comparison.json').write_text(json.dumps(rows,indent=2))
