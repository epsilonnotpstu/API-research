   248	        if t == 'number':
   249	            return float(value)
   250	        if t == 'boolean':
   251	            return {'true': True, 'false': False}[value.lower()]
   252	    except (ValueError, KeyError, AttributeError, TypeError):
   253	        return value
   254	    return value
