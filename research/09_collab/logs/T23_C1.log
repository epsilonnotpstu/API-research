   183	            if fallback and template != fallback[0]:
   184	                break  # A concrete path wins even when its method is undocumented.
   185	            if origin and route_origin and authority(origin) != route_origin \
   186	                    and not (self.deploy and authority(origin) == self.deploy):
   187	                continue
   188	            m = rx.match(path)
   189	            if m:
   190	                result = (template, {n: unquote(v) for n, v in zip(names, m.groups())})
   191	                if method is None or method.lower() == route_method:
   192	                    return result
   193	                fallback = fallback or result
   194	        if fallback and method and method.lower() in self.raw['paths'][fallback[0]]:
   195	            # That method exists, but its effective server did not match.
   196	            return None, {}
   197	        return fallback or (None, {})
