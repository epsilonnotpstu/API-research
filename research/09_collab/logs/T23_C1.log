   174	                    base, origin = server_base(server)
   175	                    names = re.findall(r'\{([^/{}]+)\}', template)
   176	                    parts = re.split(r'\{[^/{}]+\}', template)
   177	                    rx = re.escape(base) + '([^/]+?)'.join(re.escape(p) for p in parts)
   178	                    self.routes.append((re.compile('^' + rx + '/?$'), template, names, method, origin))
   179	
   180	    def match(self, path, method=None, origin=None):
   181	        fallback = None
