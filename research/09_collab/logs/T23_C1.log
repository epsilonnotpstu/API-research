import json,collections
for k,r in [('K01','r1'),('K01','r2'),('K09','r1'),('K09','r2'),('K08','r1'),('K08','r2'),('K03','r2')]:
 out=collections.Counter(); examples={}
 with open(f'{k}/{r}/exchanges.jsonl') as f:
  for i,line in enumerate(f,1):
   e=json.loads(line);q=e['request'];p=q['path'];s=e['response']['status'];qu=q.get('query',{})
   key=None
   if k=='K09' and s==400 and q['method']=='GET' and '/pet/' in p and p.rsplit('/',1)[1].lstrip('-').isdigit(): key='GET numeric pet 400: overflow' if abs(int(p.rsplit('/',1)[1]))>2**63-1 else 'GET numeric pet 400: in range'
   if k=='K01' and q['method']=='GET' and p=='/api/v3/pet/findByTags' and s==400: key='tags 400 absent' if 'tags' not in qu else 'tags 400 present'
   if k=='K01' and q['method']=='GET' and p=='/api/v3/pet/findByStatus' and s==200:
    try:
     body=json.loads(e['response']['body']['text']);n=sum('name' not in o for o in body); key=f'list missing names {n}/{len(body)}'
    except Exception: pass
   if k=='K08' and p in ['/api/v1/activities','/api/v2/activities'] and qu.get('random')==[''] and s==200:key='empty random 200 '+p
   if k=='K03' and p=='/api/v1/activities' and s==200 and 'featured' in qu and any(v.lower() not in ('true','false') for v in qu['featured']):key='nonboolean featured 200'
   if key:out[key]+=1;examples.setdefault(key,[]);examples[key]=(examples[key]+[i])[:4]
 print(k,r,dict(out),examples)
