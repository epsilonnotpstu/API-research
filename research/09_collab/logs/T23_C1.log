   236	def coerce(value, schema, values=None, delimiter=',', explode=False):
   237	    if not isinstance(schema, dict):
   238	        return value
   239	    t = schema.get('type')
   240	    if isinstance(t, list):
   241	        t = next((x for x in t if x != 'null'), None)
   242	    if t == 'array':
   243	        raw = (values if values is not None else [value]) if explode else (value.split(delimiter) if isinstance(value, str) else [value])
