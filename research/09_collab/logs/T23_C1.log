   125	def server_base(server):
   126	    url = server.get('url', '')
   127	    for name, variable in server.get('variables', {}).items():
   128	        url = url.replace('{' + name + '}', str(variable.get('default', '{' + name + '}')))
   129	    return urlsplit(url).path.rstrip('/'), authority(url)
