    19	
    20	import java.util.List;
    21	import java.util.Locale;
    22	
    23	@ControllerAdvice(basePackages = "market.rest")
    24	@RestController
    25	public class RestExceptionHandler {
    26		private static final String ARGUMENT_VALIDATION_CODE = "Error.Validation.Parameter";
    27		private static final String NOT_EXIST_CODE = "NotExist";
    28	
    29		private static final Logger log = LogManager.getLogger(RestExceptionHandler.class);
    30	
    31		private final MessageSource messageSource;
    32	
    33		public RestExceptionHandler(MessageSource messageSource) {
    34			this.messageSource = messageSource;
    35		}
    36	
    37		@ExceptionHandler(Exception.class)
    38		@ResponseStatus(HttpStatus.INTERNAL_SERVER_ERROR)
    39		public RestErrorResponse otherExceptions(Exception e, WebRequest request) {
    40			RestErrorResponse response = new RestErrorResponse(e.getMessage(), request);
    41			log.error(response.toString(), e);
    42			return response;
    43		}
    44	
    45		@ExceptionHandler(AccessDeniedException.class)
    46		@ResponseStatus(HttpStatus.UNAUTHORIZED)
    47		public RestErrorResponse accessDeniedException(AccessDeniedException e, WebRequest request) {
    48			RestErrorResponse response = new RestErrorResponse(e.getMessage(), request);
    49			log.warn(response.toString());
    50			return response;
    51		}
    52	
    53		@ExceptionHandler(UnknownEntityException.class)
    54		@ResponseStatus(HttpStatus.NOT_FOUND)
    55		public RestErrorResponse unknownEntityException(UnknownEntityException e, WebRequest request) {
    56			String entityType = e.getEntityType();
    57			List<FieldError> fieldErrors = e.getFieldErrors();
    58			RestErrorResponse response = createLocalizedResponse(NOT_EXIST_CODE, entityType, fieldErrors, request);
    59			log.warn(response.toString());
    60			return response;
    61		}
    62	
    63		@ExceptionHandler(CustomNotValidException.class)
    64		@ResponseStatus(HttpStatus.NOT_ACCEPTABLE)
    65		public RestErrorResponse customNotValidException(CustomNotValidException e, WebRequest request) {
    66			String entityType = e.getEntityType();
    67			List<FieldError> fieldErrors = e.getFieldErrors();
    68			RestErrorResponse response = createLocalizedResponse(ARGUMENT_VALIDATION_CODE, entityType, fieldErrors, request);
    69			log.warn(response.toString());
    70			return response;
    71		}
    72	
    73		@ExceptionHandler(MethodArgumentNotValidException.class)
    74		@ResponseStatus(HttpStatus.NOT_ACCEPTABLE)
    75		public RestErrorResponse processValidationError(MethodArgumentNotValidException e, WebRequest request) {
    76			BindingResult result = e.getBindingResult();
    77			String objectName = result.getObjectName();
    78			List<FieldError> fieldErrors = result.getFieldErrors();
    79			RestErrorResponse response = createLocalizedResponse(ARGUMENT_VALIDATION_CODE, objectName, fieldErrors, request);
    80			log.warn(response.toString());
    81			return response;
    82		}
    83	
    84		private RestErrorResponse createLocalizedResponse(String localizationCode, String entityType,
    85			List<FieldError> fieldErrors, WebRequest request)
    86		{
    87			Locale currentLocale = LocaleContextHolder.getLocale();
    88			String localizedMessage = messageSource.getMessage(localizationCode, null, currentLocale);
    89			RestErrorResponse response = new RestErrorResponse(localizedMessage, entityType, request);
    90			return resolveFieldErrors(response, fieldErrors);
    91		}
    92	
    93		private RestErrorResponse resolveFieldErrors(RestErrorResponse response, List<FieldError> fieldErrors) {
    94			for (FieldError fieldError : fieldErrors) {
    95				String localizedErrorMessage = resolveErrorMessage(fieldError);
    96				response.addFieldError(fieldError.getField(), localizedErrorMessage);
    97			}
    98			return response;
    99		}
   100	
   101		private String resolveErrorMessage(FieldError fieldError) {
   102			Locale currentLocale = LocaleContextHolder.getLocale();
   103			String localizedErrorMessage = messageSource.getMessage(fieldError, currentLocale);
   104	
   105			if (localizedErrorMessage.equals(fieldError.getDefaultMessage())) {
   106				String[] fieldErrorCodes = fieldError.getCodes();
   107				if (fieldErrorCodes != null)
   108					localizedErrorMessage = fieldErrorCodes[0];
   109			}
   110			return localizedErrorMessage;
   111		}
   112	}
