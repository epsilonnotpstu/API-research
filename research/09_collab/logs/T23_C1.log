   139	def select_media(content, ctype):
   140	    if not content:
   141	        return None, None
   142	    if not ctype:
   143	        key = 'application/json' if 'application/json' in content else next(iter(content))
   144	        return key, content[key].get('schema')
   145	    matches = [k for k in content if media_matches(ctype, k)]
   146	    if not matches:
   147	        return None, None
   148	    key = max(matches, key=lambda k: (k.split(';')[0].strip().lower() == ctype, k != '*/*'))
   149	    return key, content[key].get('schema')
