   153	    def __init__(self, spec, strict_additional=False, deploy_origin=None, reject_statuses=(400, 422)):
   154	        self.raw, self.strict = spec, strict_additional
   155	        # Statuses that mean "request rejected as invalid" for VALID_REJECTED. Default: 400/422. A SUT-specific
   156	        # set (e.g. market's deliberate 406 for validation errors) must be justified by code evidence.
   157	        self.reject = tuple(reject_statuses)
   158	        # Exchanges captured from the deployment under test (e.g. http://sut-x:8080) are matched by path
   159	        # only: absolute spec servers such as http://localhost:8080 are dev placeholders for that deployment.
   160	        self.deploy = authority(deploy_origin) if deploy_origin else None
   161	        self.oas3 = specmut.is_oas3(spec)
   162	        self.dialect = spec.get('openapi', False) if self.oas3 else False
   163	        self.base = server_base((spec.get('servers') or [{}])[0])[0] if self.oas3 else spec.get('basePath', '').rstrip('/')
   164	        self._validators = {}
   165	        self._resolvers = {}
   166	        self.routes = []
   167	        for template in sorted(spec.get('paths', {}), key=lambda t: (t.count('{'), -len(t))):
   168	            item = spec['paths'][template]
   169	            for method in specmut.HTTP_METHODS:
   170	                if method not in item:
   171	                    continue
   172	                servers = item[method].get('servers', item.get('servers', spec.get('servers', [{}]))) if self.oas3 else [{'url': self.base}]
