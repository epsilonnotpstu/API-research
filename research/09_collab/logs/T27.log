   261	    gen=("$run_dir"/mutation_gen/*.manifest.json)
   262	    [[ ${#gen[@]} == 1 ]] || { echo 'Expected one generator mutation manifest' >&2; exit 1; }
   263	    /usr/bin/python3 -I -B -c 'import json,sys; a,b=(json.load(open(p)) for p in sys.argv[1:3]); k=lambda m: sorted((x["path"],x["method"]) for x in m["mutations"]); sys.exit(0 if k(a)==k(b) else "Generator mutation selected different operations")' "$run_dir/manifest.json" "${gen[0]}"
   264	    cp "${gen[0]%.manifest.json}.json" "$run_dir/generator-input.json"
   265	else
   266	    /usr/bin/python3 -I -B "$HERE/derecurse.py" "$test_spec" "$run_dir/generator-input.json" >"$run_dir/derecurse-cuts.json"
   267	fi
