   250	build_schemathesis_argv
   251	# mount the run directory, so the input and every output remain in this run.
   252	# Generator input only: cut recursive $ref back-edges (hypothesis-jsonschema stalls on them).
   253	# Conformance analysis keeps using spec.test.* (the untouched original or mutated spec).
   254	if [[ $mode == mutated ]]; then
   255	    # specmut inlines $refs into mutated operations, which would unroll recursive schemas again.
   256	    # So: de-recurse the ORIGINAL first, then apply the same mutation (same fault/severity/seed
   257	    # => same operations selected) to obtain the generator input.
   258	    /usr/bin/python3 -I -B "$HERE/derecurse.py" "$original_spec" "$run_dir/spec.derecursed.json" >"$run_dir/derecurse-cuts.json"
