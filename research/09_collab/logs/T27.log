   238	"${compose[@]}" stop --timeout 10 mitmproxy >>"$run_dir/compose-up.log" 2>&1
   239	if [[ -f $run_dir/exchanges.jsonl ]]; then mv "$run_dir/exchanges.jsonl" "$run_dir/readiness-exchanges.jsonl"; fi
   240	"${compose[@]}" start mitmproxy >>"$run_dir/compose-up.log" 2>&1
   241	# A host TCP check avoids adding a second HTTP readiness request to the exchange log.
   242	proxy_ready=0
   243	for ((attempt=1; attempt<=30; attempt++)); do
   244	    if (exec 8<>/dev/tcp/127.0.0.1/18080) 2>/dev/null; then proxy_ready=1; break; fi
   245	    sleep 1
   246	done
   247	((proxy_ready == 1)) || { echo 'Proxy did not restart' >&2; exit 1; }
