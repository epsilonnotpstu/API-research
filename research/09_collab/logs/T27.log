     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	# Pure argv builders. The caller supplies validated run settings; no subprocesses.
     4	build_schemathesis_argv() {
     5	    schema_cmd=(run "/work/$(basename "$test_spec")" --base-url "http://mitmproxy:8080$BASE_PATH" \
     6	        --checks "$SCHEMA_CHECKS" --hypothesis-seed "$seed" --hypothesis-max-examples "$MAX_EXAMPLES" \
     7	        --junit-xml /work/schemathesis.junit.xml --cassette-path /work/schemathesis-cassette.yaml \
     8	        --request-timeout "$REQUEST_TIMEOUT_MS" --hypothesis-phases "$PILOT_HYPOTHESIS_PHASES" --sanitize-output true)
     9	    # An unset or empty DATA_GEN preserves the original argv exactly.
    10	    if [[ -n ${DATA_GEN:-} ]]; then
    11	        [[ $DATA_GEN =~ ^(positive|negative|all)$ ]] || { echo 'Invalid DATA_GEN' >&2; return 2; }
    12	        schema_cmd+=(--data-generation-method "$DATA_GEN")
    13	    fi
    14	}
    15	
    16	build_evomaster_argv() {
    17	    schema_cmd=(--blackBox true --problemType REST --base http://mitmproxy:8080 \
    18	        --schema /work/spec.test.json --seed "$seed" --stoppingCriterion TIME --maxTime "${budget}s" \
    19	        --outputFolder /work/evomaster/tests --outputFormat JAVA_JUNIT_5 \
    20	        --writeStatistics true --statisticsFile /work/evomaster/statistics.csv \
    21	        --appendToStatisticsFile false --ratePerMinute 0 --schemaOracles true \
    22	        --tcpTimeoutMs "$REQUEST_TIMEOUT_MS" --createConfigPathIfMissing false)
    23	}
    24	
    25	record_fuzzer_argv() {
    26	    local destination=$1 header_flag=$2
    27	    printf '%s\n' "${schema_cmd[@]}" >"$destination"
    28	    if [[ -n $AUTH_HEADER ]]; then
    29	        printf '%s\n' "$header_flag" '<redacted>' >>"$destination"
    30	        schema_cmd+=("$header_flag" "$AUTH_HEADER")
    31	    fi
    32	}

