#!/usr/bin/env bash
set -euo pipefail
HERE=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
EXP=$(cd -- "$HERE/../.." && pwd)
[[ $# == 2 || $# == 4 ]] || { echo 'Usage: analyse_run.sh MUTATED_RUN BASELINE_RUN [--mode both|fresh|replay]' >&2; exit 2; }
run_dir=$(realpath -- "$1"); baseline=$(realpath -- "$2"); mode=both
if [[ $# == 4 ]]; then [[ $3 == --mode ]] || { echo 'Expected --mode' >&2; exit 2; }; mode=$4; fi
case $mode in both|fresh|replay) ;; *) echo 'Invalid analysis mode' >&2; exit 2;; esac
sut=$(/usr/bin/python3 -I -B -c 'import json,sys; print(json.load(open(sys.argv[1]))["sut"])' "$run_dir/run.json")
source "$HERE/common.sh"
load_sut "$sut"
# Validate before producing analysis; incomplete runs need a separate, manual audit.
/usr/bin/python3 -I -B - "$run_dir" "$baseline" "$EXP/tools" "$HERE" <<'PY'
import hashlib, json, pathlib, sys
run, base, tools, harness = map(pathlib.Path, sys.argv[1:])
r, b = (json.loads((p / 'run.json').read_text()) for p in (run, base))
if not (r['complete'] and b['complete'] and r['mode'] == 'mutated' and b['mode'] == 'baseline'):
    raise SystemExit('Need complete mutated and baseline runs; inspect run.json and logs')
for key in ('sut', 'sut_jar_sha256', 'emb_commit', 'source_sha256', 'base_path', 'auth',
            'max_examples', 'budget_seconds', 'seed', 'schemathesis_image', 'logger_max_body',
            'request_timeout_ms', 'hypothesis_phases', 'schema_checks', 'harness_version',
            'sut_service', 'sut_image', 'internal_port', 'auth_source', 'auth_source_sha256',
            'health_path', 'harness_sha256', 'emb_config_sha256',
            'jacoco_agent_sha256', 'jacoco_cli_sha256'):
    if r[key] != b[key]:
        raise SystemExit(f'Incompatible runs: {key}')
for key in ('schema-image', f'sut-{r["sut"]}-image', 'mitmproxy-image'):
    if r['images'][key]['id'] != b['images'][key]['id']:
        raise SystemExit(f'Image changed between runs: {key}')
if r['tool_sha256'] != b['tool_sha256']:
    raise SystemExit('Tool snapshots differ between runs')
for name, digest in r['tool_sha256'].items():
    path = tools / name
    if not path.is_file() or hashlib.sha256(path.read_bytes()).hexdigest() != digest:
        raise SystemExit(f'Current tool differs from collection: {name}')
for name, digest in r['harness_sha256'].items():
    path = harness / name
    if not path.is_file() or hashlib.sha256(path.read_bytes()).hexdigest() != digest:
        raise SystemExit(f'Current harness differs from collection: {name}')
for directory, meta in ((run, r), (base, b)):
    specs = list(directory.glob('spec.test.*'))
    if len(specs) != 1:
        raise SystemExit('Expected exactly one spec.test snapshot')
    for name in ('exchanges.jsonl', specs[0].name, 'generator-input.json', 'sut-config.env'):
        digest = hashlib.sha256((directory / name).read_bytes()).hexdigest()
        if digest != meta['file_sha256'].get(name):
            raise SystemExit(f'Artifact changed: {directory / name}')
manifest = run / 'manifest.json'
if hashlib.sha256(manifest.read_bytes()).hexdigest() != r['file_sha256'].get('manifest.json'):
    raise SystemExit('Manifest changed since collection')
PY
# -I excludes ambient paths; explicitly add only the trusted local tools directory.
pytool() {
    /usr/bin/python3 -I -B -c 'import runpy,sys; sys.path.insert(0,sys.argv.pop(1)); script=sys.argv.pop(1); sys.argv[0]=script; runpy.run_path(script,run_name="__main__")' \
        "$EXP/tools" "$EXP/tools/$1" "${@:2}"
}
# T10 must deliver --mode. Never silently fall back to the unsafe pre-T10 CLI.
pytool attribute.py --help > /dev/null
base_specs=("$baseline"/spec.test.*); mut_specs=("$run_dir"/spec.test.*)
[[ ${#base_specs[@]} == 1 && -f ${base_specs[0]} && ${#mut_specs[@]} == 1 && -f ${mut_specs[0]} ]] || exit 1
analysis="$run_dir/analysis-$mode${ORACLE:+-$ORACLE}"
# Exchanges record the upstream SUT origin; absolute spec servers (e.g. localhost) are dev placeholders for it.
deploy_origin="http://$SUT_SERVICE:$INTERNAL_PORT"
# ORACLE=default forces the generic 400/422 rejection set even for SUTs with a code-justified override.
if [[ ${ORACLE:-sut} == default ]]; then reject_statuses=400,422; else reject_statuses=${REJECT_STATUSES_DEFAULT:-400,422}; fi
[[ $reject_statuses =~ ^[0-9]{3}(,[0-9]{3})*$ ]] || { echo "Invalid reject statuses" >&2; exit 2; }
mkdir "$analysis" # Refuse to overwrite earlier analysis.
pytool conformance.py "${base_specs[0]}" "$baseline/exchanges.jsonl" --deploy-origin "$deploy_origin" --reject-statuses "$reject_statuses" >"$analysis/baseline.violations.jsonl"
if [[ $mode == both || $mode == fresh ]]; then
    pytool conformance.py "${mut_specs[0]}" "$run_dir/exchanges.jsonl" --deploy-origin "$deploy_origin" --reject-statuses "$reject_statuses" >"$analysis/fresh.violations.jsonl"
    pytool attribute.py "$analysis/baseline.violations.jsonl" "$analysis/fresh.violations.jsonl" \
        "$run_dir/manifest.json" --mode fresh >"$analysis/fresh.attributed.csv"
fi
if [[ $mode == both || $mode == replay ]]; then
    pytool conformance.py "${mut_specs[0]}" "$baseline/exchanges.jsonl" --deploy-origin "$deploy_origin" --reject-statuses "$reject_statuses" >"$analysis/replay.violations.jsonl"
    pytool attribute.py "$analysis/baseline.violations.jsonl" "$analysis/replay.violations.jsonl" \
        "$run_dir/manifest.json" --mode replay >"$analysis/replay.attributed.csv"
fi
sha256sum "$EXP/tools/conformance.py" "$EXP/tools/attribute.py" "$EXP/tools/specmut.py" >"$analysis/tool-sha256.txt"
printf '%s\n' "baseline=$baseline" "mutated=$run_dir" "mode=$mode" "deploy_origin=$deploy_origin" "reject_statuses=$reject_statuses" >"$analysis/inputs.txt"
echo "Analysis: $analysis"
#!/usr/bin/env bash
# One baseline and four mutation conditions for each requested seed.
set -euo pipefail
HERE=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
EXP=$(cd -- "$HERE/../.." && pwd)
[[ $# -ge 1 ]] || { echo 'Usage: run_batch.sh SUT [SEEDS ...]' >&2; exit 2; }
source "$HERE/common.sh"
sut=$1
shift
load_sut "$sut"
seeds=("$@")
if ((${#seeds[@]} == 0)); then seeds=(1 2 3); fi
declare -A seen=()
for seed in "${seeds[@]}"; do
    [[ $seed =~ ^(0|[1-9][0-9]*)$ ]] || { echo 'Invalid seed' >&2; exit 2; }
    [[ ! ${seen[$seed]+present} ]] || { echo 'Duplicate seed' >&2; exit 2; }
    seen[$seed]=1
done
export MAX_EXAMPLES=${MAX_EXAMPLES:-100}
export SCHEMA_CHECKS=${SCHEMA_CHECKS:-all}
budget=${BUDGET_SECONDS:-300}
severity=${SEVERITY:-30}
[[ $budget =~ ^[1-9][0-9]*$ && $severity =~ ^[1-9][0-9]?$|^100$ ]] || { echo 'Invalid budget/severity' >&2; exit 2; }
spec="$EMB_DIR/$SPEC_SOURCE"
runs="$EXP/E1_pilot/runs/$sut"
batch_id="$(date -u +%Y%m%dT%H%M%SZ)_batch_$$"
mkdir -p "$runs/batches"
batch_dir="$runs/batches/$batch_id"
mkdir "$batch_dir"
printf 'seed\tmode\tfault\trun_dir\n' >"$batch_dir/runs.tsv"
run_one() {
    local mode=$1 fault=$2 percent=$3 seed=$4 id
    id="${batch_id}_${mode}_${fault}_p${percent}_s${seed}"
    # Exact path reserved by run_pilot's exclusive mkdir; never guess from old runs.
    LAST_RUN="$runs/$id"
    PILOT_RUN_ID="$id" "$HERE/run_pilot.sh" "$sut" "$spec" "$mode" "$fault" "$percent" "$seed" "$budget"
    printf '%s\t%s\t%s\t%s\n' "$seed" "$mode" "$fault" "$LAST_RUN" >>"$batch_dir/runs.tsv"
}
for seed in "${seeds[@]}"; do
    run_one baseline NONE 0 "$seed"
    baseline=$LAST_RUN
    # FAULTS (space-separated) selects a subset; default = all four classes.
    for fault in ${FAULTS:-REQUEST_LOOSE REQUEST_STRICT RESPONSE_ORACLE METHOD_SEM}; do
        case $fault in REQUEST_LOOSE|REQUEST_STRICT|RESPONSE_ORACLE|METHOD_SEM) ;; *) echo "Invalid fault: $fault" >&2; exit 2;; esac
        # ORACLE_POOL=baseline: RESPONSE_ORACLE mutates only operations with a 2xx body in this seed's baseline.
        # LOOSE_POOL=spec: REQUEST_LOOSE mutates only operations with a checker-evaluated request constraint.
        if [[ $fault == REQUEST_LOOSE && ${LOOSE_POOL:-all} == spec ]]; then
            /usr/bin/python3 -I -B "$TOOLS_DIR/eligible_ops.py" "$baseline" --fault REQUEST_LOOSE \
                --out "$batch_dir/eligible_loose_s$seed.json"
            ONLY_OPS="$batch_dir/eligible_loose_s$seed.json" run_one mutated "$fault" "$severity" "$seed"
        elif [[ $fault == RESPONSE_ORACLE && ${ORACLE_POOL:-all} == baseline ]]; then
            /usr/bin/python3 -I -B "$TOOLS_DIR/eligible_ops.py" "$baseline" --base-path "$BASE_PATH" \
                --out "$batch_dir/eligible_s$seed.json"
            ONLY_OPS="$batch_dir/eligible_s$seed.json" run_one mutated "$fault" "$severity" "$seed"
        else
            ONLY_OPS= run_one mutated "$fault" "$severity" "$seed"
        fi
        "$HERE/analyse_run.sh" "$LAST_RUN" "$baseline" --mode both
    done
done
echo "Batch complete: $batch_dir/runs.tsv"
# Non-secret values; all EMB paths are relative to EMB_DIR.
SUT_ID=cwa-verification
# pom.xml:7-8,282-283: repackage finalName overrides artifactId-version locally.
JAR_SOURCE=jdk_11_maven/cs/rest/cwa-verification-server/target/cwa-verification-sut.jar
COMPOSE_FILE=dockerfiles/cwa-verification.yaml
