                        '--base-url': 'http://mitmproxy:8080' + meta['base_path'], '--sanitize-output': 'true'}.items():
        equal(flag(name), value, 'Generator option differs: ' + name)
    if '-H' in argv:
        equal(flag('-H'), '<redacted>', 'Auth header not redacted')
    return argv


