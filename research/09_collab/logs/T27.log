+s = replace_once(s, "        'run_id': run.name, 'sut': sut, 'source_spec': source,", "        'fuzzer': fuzzer,\n        'run_id': run.name, 'sut': sut, 'source_spec': source,")
+s = replace_once(s, "    tmp = run / 'run.json.tmp'", '''    if fuzzer == 'evomaster':
