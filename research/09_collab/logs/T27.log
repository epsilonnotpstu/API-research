diff --git a/research/09_collab/logs/T27_scratch/build_and_validate.py b/research/09_collab/logs/T27_scratch/build_and_validate.py
new file mode 100644
index 0000000000000000000000000000000000000000..f0658acef40d8867ac13d25a0da5a6e93b1d40c6
--- /dev/null
+++ b/research/09_collab/logs/T27_scratch/build_and_validate.py
@@ -0,0 +1,88 @@
+"""Produce a patch, apply it to a temporary harness copy, and run offline checks."""
+import difflib
+import hashlib
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[3]
+SCRATCH = Path(__file__).resolve().parent
+EXP = ROOT / '08_experiments'
+LIVE = EXP / 'E1_pilot/harness_v2'
+STAGE = SCRATCH / 'staged/harness_v2'
+PROPOSAL = LIVE / 'proposals'
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+changed = []
+base = {}
+for candidate in sorted(STAGE.rglob('*')):
+    if not candidate.is_file():
+        continue
+    relative = candidate.relative_to(STAGE)
+    original = LIVE / relative
+    if original.is_file() and original.read_bytes() == candidate.read_bytes():
+        continue
+    label = 'E1_pilot/harness_v2/' + relative.as_posix()
+    if original.is_file():
+        base[label] = sha(original)
+    changed.append(label)
+
+patch = []
+for label in changed:
+    relative = Path(label).relative_to('E1_pilot/harness_v2')
+    original, candidate = LIVE / relative, STAGE / relative
+    patch.append(f'diff --git a/{label} b/{label}\n')
+    if not original.exists():
+        patch.append('new file mode ' + ('100755' if candidate.stat().st_mode & 0o111 else '100644') + '\n')
+    patch.extend(difflib.unified_diff(
+        original.read_text().splitlines(keepends=True) if original.exists() else [],
+        candidate.read_text().splitlines(keepends=True),
+        fromfile='a/' + label if original.exists() else '/dev/null', tofile='b/' + label))
+diff_path = PROPOSAL / 'harness.evomaster.proposed.diff'
+diff_path.write_text(''.join(patch))
+(PROPOSAL / 'harness.evomaster.base-sha256.json').write_text(json.dumps(base, indent=2) + '\n')
+
+temp_root = Path(tempfile.mkdtemp(prefix='T27-patch-validation-', dir='/tmp'))
+temp_exp = temp_root / 'research/08_experiments'
+temp_harness = temp_exp / 'E1_pilot/harness_v2'
+shutil.copytree(LIVE, temp_harness, ignore=shutil.ignore_patterns('.run.lock', '__pycache__'))
+# Static validators only read these existing source/spec/JAR files. They never execute them.
+(temp_exp / '_external').mkdir(parents=True)
+(temp_exp / '_external/emb').symlink_to(EXP / '_external/emb', target_is_directory=True)
+(temp_exp / 'E1_pilot/harness').symlink_to(EXP / 'E1_pilot/harness', target_is_directory=True)
+result = subprocess.run(['patch', '--batch', '--fuzz=0', '-p1', '-i', str(diff_path.resolve())],
+                        cwd=temp_exp, capture_output=True, text=True)
+(SCRATCH / 'patch-apply.txt').write_text(result.stdout + result.stderr)
+assert result.returncode == 0, result.stdout + result.stderr
+for label in changed:
+    relative = Path(label).relative_to('E1_pilot/harness_v2')
+    assert (temp_harness / relative).read_bytes() == (STAGE / relative).read_bytes(), label
+static = subprocess.run(['/usr/bin/python3', '-I', '-B', str(temp_harness / 'static_validate.py')],
+                        cwd=temp_exp, capture_output=True, text=True)
+(SCRATCH / 'static-tests.txt').write_text(static.stdout + static.stderr)
+shells = []
+for file in sorted(temp_harness.glob('*.sh')):
+    result = subprocess.run(['bash', '-n', str(file)], capture_output=True, text=True)
+    shells.append({'file': file.name, 'exit': result.returncode, 'stderr': result.stderr})
+initial = json.loads((SCRATCH / 'initial-harness-sha256.json').read_text())
+unchanged = {name: (LIVE / name).is_file() and sha(LIVE / name) == expected for name, expected in initial.items()}
+validation = {'temp_root': str(temp_root), 'changed_files': changed, 'patch_sha256': sha(diff_path),
+              'static_validate_exit': static.returncode, 'shell_checks': shells,
+              'original_harness_unchanged': unchanged, 'applied_files_match_stage': True,
+              'external_code_executed': False, 'network_used': False}
+(SCRATCH / 'validation.json').write_text(json.dumps(validation, indent=2) + '\n')
+print(json.dumps({'temp_root': str(temp_root), 'static_validate_exit': static.returncode,
+                  'original_files': len(unchanged), 'unchanged': all(unchanged.values()),
+                  'changed_files': changed}, indent=2))
+if static.returncode:
+    print(static.stdout[-10000:])
+    print(static.stderr[-10000:])
+assert static.returncode == 0
+assert all(item['exit'] == 0 for item in shells)
+assert all(unchanged.values())
diff --git a/research/09_collab/logs/T27_scratch/edit_stage.py b/research/09_collab/logs/T27_scratch/edit_stage.py
new file mode 100644
index 0000000000000000000000000000000000000000..fa6ee62062b95bc476eb306e2d9552739c1e02d4
--- /dev/null
+++ b/research/09_collab/logs/T27_scratch/edit_stage.py
@@ -0,0 +1,126 @@
+"""Prepare the review-only T27 source tree; never edit the live harness."""
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent / 'staged/harness_v2'
+
+
+def replace_once(text, old, new):
+    assert text.count(old) == 1, old[:100]
+    return text.replace(old, new, 1)
+
+
+p = HERE / 'run_pilot.sh'
+s = p.read_text()
+marker = 'for tool in docker curl java timeout flock git sha256sum grep /usr/bin/python3; do'
+s = replace_once(s, marker, '''# Select/validate the fuzzer before any Docker command or run-directory creation.
+export PILOT_FUZZER=${FUZZER:-schemathesis}
+case $PILOT_FUZZER in
+    schemathesis) ;;
+    evomaster)
+        /usr/bin/python3 -I -B "$HERE/evomaster_guard.py" options "$mode" "$seed" "$budget" "${DATA_GEN:-}" "${ONLY_OPS:-}"
+        ;;
+    *) echo 'Invalid FUZZER: use schemathesis or evomaster' >&2; exit 2;;
+esac
+source "$HERE/fuzzer_args.sh"
+''' + marker)
+s = replace_once(s, 'SCHEMA_IMAGE=schemathesis/schemathesis:3.39.16', '''SCHEMA_IMAGE=schemathesis/schemathesis:3.39.16
+if [[ $PILOT_FUZZER == evomaster ]]; then
+    export PILOT_EVOMASTER_IMAGE=webfuzzing/evomaster@sha256:de1f4387e809a309a4c61517f3340c3d0b733b78bbb86d0e3ebd217d343515ab
+    export PILOT_EVOMASTER_VERSION=6.2.0
+    # Keep schema-image.json / schemathesis_image as compatibility aliases for analysis.
+    SCHEMA_IMAGE=$PILOT_EVOMASTER_IMAGE
+fi''')
+old = '    echo "Run: $run_dir; harness exit=$rc; Schemathesis exit=$schema_rc; coverage exit=$coverage_rc"'
+s = replace_once(s, old, '''    if [[ $PILOT_FUZZER == evomaster ]]; then
+        echo "Run: $run_dir; harness exit=$rc; EvoMaster exit=$schema_rc; coverage exit=$coverage_rc"
+    else
+''' + old + '''
+    fi''')
+start = s.index('# A registry/DNS outage')
+end = s.index('phase=startup', start)
+original_preflight = s[start:end]
+s = s[:start] + '''if [[ $PILOT_FUZZER == evomaster ]]; then
+    /usr/bin/python3 -I -B "$HERE/evomaster_guard.py" schema "$run_dir/spec.test.json" "$BASE_PATH"
+    # The supervisor already pulled this immutable image. Never pull or run help here.
+    docker image inspect "$SCHEMA_IMAGE" >"$run_dir/schema-image.json"
+    cp "$run_dir/schema-image.json" "$run_dir/evomaster-image.json"
+else
+''' + original_preflight + '''fi
+''' + s[end:]
+start = s.index('schema_cmd=(run ')
+end = s.index('# mount the run directory', start)
+s = s[:start] + '''if [[ $PILOT_FUZZER == schemathesis ]]; then
+build_schemathesis_argv
+''' + s[end:]
+start = s.index('printf \'%s\\n\' "${schema_cmd[@]}" >"$run_dir/schemathesis-argv.txt"')
+end = s.index('metadata pending\nset +e', start)
+s = s[:start] + '''record_fuzzer_argv "$run_dir/schemathesis-argv.txt" -H
+else
+    # Compatibility snapshot required by analyse_run.sh; no de-recursion for EvoMaster.
+    cp "$run_dir/spec.test.json" "$run_dir/generator-input.json"
+    mkdir "$run_dir/evomaster"
+    build_evomaster_argv
+    record_fuzzer_argv "$run_dir/evomaster-argv.txt" --header0
+fi
+''' + s[end:]
+start = s.index('timeout --signal=INT --kill-after=20 "${budget}s" docker run')
+end = s.index('pilot_pipeline_rc=', start)
+default_execution = s[start:end]
+s = s[:start] + '''if [[ $PILOT_FUZZER == evomaster ]]; then
+    # maxTime bounds search; allow startup and generated-test/statistics serialization.
+    # A watchdog timeout is still incomplete, exactly as on the default path.
+    timeout --signal=INT --kill-after=20 "$((budget + 120))s" docker run --rm --name "$generator" \\
+        --user "$PILOT_UID:$PILOT_GID" --workdir /work/evomaster --network "${project}_default" \\
+        -v "$run_dir:/work" -v "$run_dir/spec.test.json:/work/spec.test.json:ro" \\
+        "$SCHEMA_IMAGE" "${schema_cmd[@]}" 2>&1 | /usr/bin/python3 -I -B "$HERE/redact_auth.py" >"$run_dir/evomaster.log"
+    pilot_pipeline_rc=("${PIPESTATUS[@]}")
+else
+''' + default_execution + '''    pilot_pipeline_rc=("${PIPESTATUS[@]}")
+fi
+''' + s[end:]
+# Capture PIPESTATUS immediately inside each branch; a completed 'if' loses it.
+s = replace_once(s, 'fi\npilot_pipeline_rc=("${PIPESTATUS[@]}")\nschema_rc=', 'fi\nschema_rc=')
+start = s.index('# Exit 1 includes test failures;')
+end = s.index('phase=complete', start)
+default_completion = s[start:end]
+s = s[:start] + '''if [[ $PILOT_FUZZER == evomaster ]]; then
+    case $schema_rc in
+        0|1) /usr/bin/python3 -I -B "$HERE/evomaster_guard.py" outputs "$run_dir/evomaster" ;;
+        124|137) echo 'Generation budget expired; partial run retained, do not treat as complete' >&2; exit "$schema_rc";;
+        *) echo "EvoMaster execution failed ($schema_rc)" >&2; exit "$schema_rc";;
+    esac
+else
+''' + default_completion + '''fi
+''' + s[end:]
+p.write_text(s)
+
+p = HERE / 'run_metadata.py'
+s = p.read_text()
+s = replace_once(s, "    data = {", "    fuzzer = os.environ.get('PILOT_FUZZER', 'schemathesis')\n    data = {")
