diff --git a/research/09_collab/logs/T27_scratch/build_and_validate.py b/research/09_collab/logs/T27_scratch/build_and_validate.py
new file mode 100644
index 0000000000000000000000000000000000000000..f0658acef40d8867ac13d25a0da5a6e93b1d40c6
--- /dev/null
+++ b/research/09_collab/logs/T27_scratch/build_and_validate.py
@@ -0,0 +1,88 @@
+"""Produce a patch, apply it to a temporary harness copy, and run offline checks."""
+import difflib
+import hashlib
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[3]
+SCRATCH = Path(__file__).resolve().parent
+EXP = ROOT / '08_experiments'
+LIVE = EXP / 'E1_pilot/harness_v2'
+STAGE = SCRATCH / 'staged/harness_v2'
+PROPOSAL = LIVE / 'proposals'
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+changed = []
+base = {}
+for candidate in sorted(STAGE.rglob('*')):
+    if not candidate.is_file():
+        continue
+    relative = candidate.relative_to(STAGE)
+    original = LIVE / relative
+    if original.is_file() and original.read_bytes() == candidate.read_bytes():
+        continue
+    label = 'E1_pilot/harness_v2/' + relative.as_posix()
+    if original.is_file():
+        base[label] = sha(original)
+    changed.append(label)
+
+patch = []
+for label in changed:
+    relative = Path(label).relative_to('E1_pilot/harness_v2')
+    original, candidate = LIVE / relative, STAGE / relative
+    patch.append(f'diff --git a/{label} b/{label}\n')
+    if not original.exists():
+        patch.append('new file mode ' + ('100755' if candidate.stat().st_mode & 0o111 else '100644') + '\n')
+    patch.extend(difflib.unified_diff(
+        original.read_text().splitlines(keepends=True) if original.exists() else [],
+        candidate.read_text().splitlines(keepends=True),
+        fromfile='a/' + label if original.exists() else '/dev/null', tofile='b/' + label))
+diff_path = PROPOSAL / 'harness.evomaster.proposed.diff'
+diff_path.write_text(''.join(patch))
+(PROPOSAL / 'harness.evomaster.base-sha256.json').write_text(json.dumps(base, indent=2) + '\n')
+
+temp_root = Path(tempfile.mkdtemp(prefix='T27-patch-validation-', dir='/tmp'))
+temp_exp = temp_root / 'research/08_experiments'
+temp_harness = temp_exp / 'E1_pilot/harness_v2'
+shutil.copytree(LIVE, temp_harness, ignore=shutil.ignore_patterns('.run.lock', '__pycache__'))
+# Static validators only read these existing source/spec/JAR files. They never execute them.
+(temp_exp / '_external').mkdir(parents=True)
+(temp_exp / '_external/emb').symlink_to(EXP / '_external/emb', target_is_directory=True)
+(temp_exp / 'E1_pilot/harness').symlink_to(EXP / 'E1_pilot/harness', target_is_directory=True)
+result = subprocess.run(['patch', '--batch', '--fuzz=0', '-p1', '-i', str(diff_path.resolve())],
+                        cwd=temp_exp, capture_output=True, text=True)
+(SCRATCH / 'patch-apply.txt').write_text(result.stdout + result.stderr)
+assert result.returncode == 0, result.stdout + result.stderr
+for label in changed:
+    relative = Path(label).relative_to('E1_pilot/harness_v2')
+    assert (temp_harness / relative).read_bytes() == (STAGE / relative).read_bytes(), label
+static = subprocess.run(['/usr/bin/python3', '-I', '-B', str(temp_harness / 'static_validate.py')],
+                        cwd=temp_exp, capture_output=True, text=True)
+(SCRATCH / 'static-tests.txt').write_text(static.stdout + static.stderr)
+shells = []
+for file in sorted(temp_harness.glob('*.sh')):
+    result = subprocess.run(['bash', '-n', str(file)], capture_output=True, text=True)
+    shells.append({'file': file.name, 'exit': result.returncode, 'stderr': result.stderr})
+initial = json.loads((SCRATCH / 'initial-harness-sha256.json').read_text())
+unchanged = {name: (LIVE / name).is_file() and sha(LIVE / name) == expected for name, expected in initial.items()}
+validation = {'temp_root': str(temp_root), 'changed_files': changed, 'patch_sha256': sha(diff_path),
+              'static_validate_exit': static.returncode, 'shell_checks': shells,
+              'original_harness_unchanged': unchanged, 'applied_files_match_stage': True,
+              'external_code_executed': False, 'network_used': False}
+(SCRATCH / 'validation.json').write_text(json.dumps(validation, indent=2) + '\n')
+print(json.dumps({'temp_root': str(temp_root), 'static_validate_exit': static.returncode,
+                  'original_files': len(unchanged), 'unchanged': all(unchanged.values()),
+                  'changed_files': changed}, indent=2))
+if static.returncode:
+    print(static.stdout[-10000:])
+    print(static.stderr[-10000:])
+assert static.returncode == 0
+assert all(item['exit'] == 0 for item in shells)
+assert all(unchanged.values())
diff --git a/research/09_collab/logs/T27_scratch/edit_stage.py b/research/09_collab/logs/T27_scratch/edit_stage.py
new file mode 100644
index 0000000000000000000000000000000000000000..fa6ee62062b95bc476eb306e2d9552739c1e02d4
--- /dev/null
+++ b/research/09_collab/logs/T27_scratch/edit_stage.py
@@ -0,0 +1,126 @@
+"""Prepare the review-only T27 source tree; never edit the live harness."""
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent / 'staged/harness_v2'
+
+
+def replace_once(text, old, new):
+    assert text.count(old) == 1, old[:100]
+    return text.replace(old, new, 1)
+
+
+p = HERE / 'run_pilot.sh'
+s = p.read_text()
+marker = 'for tool in docker curl java timeout flock git sha256sum grep /usr/bin/python3; do'
+s = replace_once(s, marker, '''# Select/validate the fuzzer before any Docker command or run-directory creation.
+export PILOT_FUZZER=${FUZZER:-schemathesis}
+case $PILOT_FUZZER in
+    schemathesis) ;;
+    evomaster)
+        /usr/bin/python3 -I -B "$HERE/evomaster_guard.py" options "$mode" "$seed" "$budget" "${DATA_GEN:-}" "${ONLY_OPS:-}"
+        ;;
+    *) echo 'Invalid FUZZER: use schemathesis or evomaster' >&2; exit 2;;
+esac
+source "$HERE/fuzzer_args.sh"
+''' + marker)
+s = replace_once(s, 'SCHEMA_IMAGE=schemathesis/schemathesis:3.39.16', '''SCHEMA_IMAGE=schemathesis/schemathesis:3.39.16
+if [[ $PILOT_FUZZER == evomaster ]]; then
+    export PILOT_EVOMASTER_IMAGE=webfuzzing/evomaster@sha256:de1f4387e809a309a4c61517f3340c3d0b733b78bbb86d0e3ebd217d343515ab
+    export PILOT_EVOMASTER_VERSION=6.2.0
+    # Keep schema-image.json / schemathesis_image as compatibility aliases for analysis.
+    SCHEMA_IMAGE=$PILOT_EVOMASTER_IMAGE
+fi''')
+old = '    echo "Run: $run_dir; harness exit=$rc; Schemathesis exit=$schema_rc; coverage exit=$coverage_rc"'
+s = replace_once(s, old, '''    if [[ $PILOT_FUZZER == evomaster ]]; then
+        echo "Run: $run_dir; harness exit=$rc; EvoMaster exit=$schema_rc; coverage exit=$coverage_rc"
+    else
+''' + old + '''
+    fi''')
+start = s.index('# A registry/DNS outage')
+end = s.index('phase=startup', start)
+original_preflight = s[start:end]
+s = s[:start] + '''if [[ $PILOT_FUZZER == evomaster ]]; then
+    /usr/bin/python3 -I -B "$HERE/evomaster_guard.py" schema "$run_dir/spec.test.json" "$BASE_PATH"
+    # The supervisor already pulled this immutable image. Never pull or run help here.
+    docker image inspect "$SCHEMA_IMAGE" >"$run_dir/schema-image.json"
+    cp "$run_dir/schema-image.json" "$run_dir/evomaster-image.json"
+else
+''' + original_preflight + '''fi
+''' + s[end:]
+start = s.index('schema_cmd=(run ')
+end = s.index('# mount the run directory', start)
+s = s[:start] + '''if [[ $PILOT_FUZZER == schemathesis ]]; then
+build_schemathesis_argv
+''' + s[end:]
+start = s.index('printf \'%s\\n\' "${schema_cmd[@]}" >"$run_dir/schemathesis-argv.txt"')
+end = s.index('metadata pending\nset +e', start)
+s = s[:start] + '''record_fuzzer_argv "$run_dir/schemathesis-argv.txt" -H
+else
+    # Compatibility snapshot required by analyse_run.sh; no de-recursion for EvoMaster.
+    cp "$run_dir/spec.test.json" "$run_dir/generator-input.json"
+    mkdir "$run_dir/evomaster"
+    build_evomaster_argv
+    record_fuzzer_argv "$run_dir/evomaster-argv.txt" --header0
+fi
+''' + s[end:]
+start = s.index('timeout --signal=INT --kill-after=20 "${budget}s" docker run')
+end = s.index('pilot_pipeline_rc=', start)
+default_execution = s[start:end]
+s = s[:start] + '''if [[ $PILOT_FUZZER == evomaster ]]; then
+    # maxTime bounds search; allow startup and generated-test/statistics serialization.
+    # A watchdog timeout is still incomplete, exactly as on the default path.
+    timeout --signal=INT --kill-after=20 "$((budget + 120))s" docker run --rm --name "$generator" \\
+        --user "$PILOT_UID:$PILOT_GID" --workdir /work/evomaster --network "${project}_default" \\
+        -v "$run_dir:/work" -v "$run_dir/spec.test.json:/work/spec.test.json:ro" \\
+        "$SCHEMA_IMAGE" "${schema_cmd[@]}" 2>&1 | /usr/bin/python3 -I -B "$HERE/redact_auth.py" >"$run_dir/evomaster.log"
+    pilot_pipeline_rc=("${PIPESTATUS[@]}")
+else
+''' + default_execution + '''    pilot_pipeline_rc=("${PIPESTATUS[@]}")
+fi
+''' + s[end:]
+# Capture PIPESTATUS immediately inside each branch; a completed 'if' loses it.
+s = replace_once(s, 'fi\npilot_pipeline_rc=("${PIPESTATUS[@]}")\nschema_rc=', 'fi\nschema_rc=')
+start = s.index('# Exit 1 includes test failures;')
+end = s.index('phase=complete', start)
+default_completion = s[start:end]
+s = s[:start] + '''if [[ $PILOT_FUZZER == evomaster ]]; then
+    case $schema_rc in
+        0|1) /usr/bin/python3 -I -B "$HERE/evomaster_guard.py" outputs "$run_dir/evomaster" ;;
+        124|137) echo 'Generation budget expired; partial run retained, do not treat as complete' >&2; exit "$schema_rc";;
+        *) echo "EvoMaster execution failed ($schema_rc)" >&2; exit "$schema_rc";;
+    esac
+else
+''' + default_completion + '''fi
+''' + s[end:]
+p.write_text(s)
+
+p = HERE / 'run_metadata.py'
+s = p.read_text()
+s = replace_once(s, "    data = {", "    fuzzer = os.environ.get('PILOT_FUZZER', 'schemathesis')\n    data = {")
+s = replace_once(s, "        'run_id': run.name, 'sut': sut, 'source_spec': source,", "        'fuzzer': fuzzer,\n        'run_id': run.name, 'sut': sut, 'source_spec': source,")
+s = replace_once(s, "    tmp = run / 'run.json.tmp'", '''    if fuzzer == 'evomaster':
+        # Legacy image key identifies the selected generator for unchanged analysis.
+        # Do not claim that Schemathesis ran in an EvoMaster collection.
+        data['schemathesis_exit'] = 'not_started'
+        data.update({
+            'evomaster_image': os.environ['PILOT_EVOMASTER_IMAGE'],
+            'evomaster_version': os.environ['PILOT_EVOMASTER_VERSION'],
+            'evomaster_exit': schema_rc,
+            'evomaster_argv_file': 'evomaster-argv.txt',
+            'evomaster_argv': ((run / 'evomaster-argv.txt').read_text().splitlines()
+                               if (run / 'evomaster-argv.txt').is_file() else []),
+            'evomaster_watchdog_seconds': int(budget) + 120,
+        })
+        data['file_sha256'].update({str(p.relative_to(run)): sha(p)
+                                   for p in sorted((run / 'evomaster').rglob('*')) if p.is_file()})
+        data['limitations'] = [line for line in data['limitations']
+                               if not line.startswith(('generator schema back edges',
+                                                       'equal mutation operation sets'))]
+        data['limitations'].append('EvoMaster uses spec.test unchanged; schema path checked against base_path')
+    tmp = run / 'run.json.tmp' ''')
+p.write_text(s)
+
+p = HERE / 'fuzzer_args.sh'
+s = p.read_text().replace('# Pure argv builders.', 'set -euo pipefail\n# Pure argv builders.')
+p.write_text(s)
+p.chmod(0o755)
diff --git a/research/09_collab/logs/T27_scratch/make_golden.py b/research/09_collab/logs/T27_scratch/make_golden.py
new file mode 100644
index 0000000000000000000000000000000000000000..bb680bb500e2b127f7c4c5a81bc204d61e047a12
--- /dev/null
+++ b/research/09_collab/logs/T27_scratch/make_golden.py
@@ -0,0 +1,71 @@
+"""Capture synthetic golden argv from the original, unmodified shell statements."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[3]
+LIVE = ROOT / '08_experiments/E1_pilot/harness_v2'
+STAGE = Path(__file__).resolve().parent / 'staged/harness_v2'
+source = (LIVE / 'run_pilot.sh').read_text()
+begin = source.index('schema_cmd=(run ')
+end = source.index('# mount the run directory', begin)
+builder = source[begin:end]
+begin = source.index('schema_cmd[1]=')
+end = source.index('metadata pending\nset +e', begin)
+recorder = source[begin:end]
+cases = []
+for name, updates in (
+    ('default-scout', {}),
+    ('default-explicit', {'FUZZER': 'schemathesis'}),
+    ('root-custom-checks', {'BASE_PATH': '/', 'SCHEMA_CHECKS': 'not_a_server_error', 'seed': '0'}),
+    ('petstore-positive-auth', {'BASE_PATH': '/api/v3', 'DATA_GEN': 'positive', 'AUTH_HEADER': 'X-Test: synthetic-t27'}),
+    ('negative', {'DATA_GEN': 'negative'}),
+    ('all-custom-timeout', {'DATA_GEN': 'all', 'REQUEST_TIMEOUT_MS': '123', 'MAX_EXAMPLES': '5'}),
+):
+    values = {'PATH': os.environ['PATH'], 'BASE_PATH': '/api', 'SCHEMA_CHECKS': 'all', 'seed': '7',
+              'MAX_EXAMPLES': '100', 'REQUEST_TIMEOUT_MS': '10000', 'PILOT_HYPOTHESIS_PHASES': 'explicit,generate',
+              'AUTH_HEADER': '', 'test_spec': '/synthetic/spec.test.json'}
+    values.update(updates)
+    with tempfile.TemporaryDirectory(prefix='t27-golden-') as directory:
+        values['run_dir'] = directory
+        result = subprocess.run(['bash', '-euc', builder + recorder + '\nprintf "%s\\0" "${schema_cmd[@]}"'],
+                                env=values, capture_output=True, check=True)
+        argv = result.stdout.decode().removesuffix('\0').split('\0')
+        recorded = (Path(directory) / 'schemathesis-argv.txt').read_text().splitlines()
+    cases.append({'name': name, 'environment': updates, 'argv': argv, 'recorded': recorded})
+
+fragments = {}
+for name, start, end in (
+    ('default-docker-argv', 'timeout --signal=INT --kill-after=20 "${budget}s" docker run', '>"$run_dir/schemathesis.log"'),
+    ('default-image-and-help', '# A registry/DNS outage', '\ndone'),
+    ('readiness-and-quarantine', '# Probe through the proxy', 'phase=generation'),
+    ('cleanup-and-coverage', 'finish() {', '    metadata "$rc"'),
+    ('mutation-candidate-pool', '    # Optional candidate pool', 'cp "$test_spec"'),
+    ('default-derecursion', '# mount the run directory', 'schema_cmd[1]='),
+    ('default-exit-semantics', '# Exit 1 includes test failures;', '\nesac'),
+):
+    begin = source.index(start)
+    stop = source.index(end, begin)
+    fragments[name] = {'start': start, 'end': end, 'sha256': hashlib.sha256(source[begin:stop].encode()).hexdigest()}
+(STAGE / 'fuzzer-golden.json').write_text(json.dumps({
+    'source': 'E1_pilot/harness_v2/run_pilot.sh',
+    'source_sha256': hashlib.sha256(source.encode()).hexdigest(),
+    'cases': cases, 'preserved_fragments': fragments,
+}, indent=2) + '\n')
+
+p = STAGE / 'static_validate.py'
+s = p.read_text().replace('T14/T17 static validation', 'T14/T17/T27 static validation')
+s = s.replace('T14/T17 validation:', 'T14/T17/T27 validation:')
+s = s.replace('    for marker in (\'SCHEMA_CHECKS\'', '    fuzzer_args = (HERE / "fuzzer_args.sh").read_text()\n    for marker in (\'SCHEMA_CHECKS\'')
+s = s.replace('        assert marker in run, marker', '        assert marker in run + fuzzer_args, marker')
+needle = '    print("PASS ALL STATIC CHECKS AND PERMITTED UNIT TESTS", flush=True)'
+assert s.count(needle) == 1
+s = s.replace(needle, '''    print("BEGIN FUZZER ARGV/ROUTING/REDACTION/PROVENANCE UNIT TESTS", flush=True)
+    subprocess.run(["/usr/bin/python3", "-I", "-B", str(HERE / "test_fuzzer_args.py")],
+                   check=True, stderr=subprocess.STDOUT)
+''' + needle)
+s = s.replace('Compose, Java, Schemathesis, SUTs, ', 'Compose, Java, Schemathesis, EvoMaster, SUTs, ')
+p.write_text(s)
diff --git a/research/09_collab/logs/T27_scratch/staged/harness_v2/evomaster_guard.py b/research/09_collab/logs/T27_scratch/staged/harness_v2/evomaster_guard.py
new file mode 100644
index 0000000000000000000000000000000000000000..f15271f715fa4b1e3d586bb1d0b84a1ec6458d5c
--- /dev/null
+++ b/research/09_collab/logs/T27_scratch/staged/harness_v2/evomaster_guard.py
@@ -0,0 +1,83 @@
+"""Validate EvoMaster-only settings and schema routing, without network or SUT code."""
+import json
+from pathlib import Path
+import sys
+from urllib.parse import urlsplit
+
+
+def validate_options(mode, seed, budget, data_gen, only_ops):
+    if data_gen:
+        raise ValueError("EvoMaster does not support DATA_GEN; unset it")
+    if only_ops and mode != "mutated":
+        raise ValueError("EvoMaster ONLY_OPS selects mutation candidates; requires mutated mode")
+    if not seed.isascii() or not seed.isdecimal() or not 0 <= int(seed) <= 9223372036854775807:
+        raise ValueError("EvoMaster seed must fit a non-negative Long")
+    if not budget.isascii() or not budget.isdecimal() or not 1 <= int(budget) <= 2147483527:
+        raise ValueError("EvoMaster budget exceeds the supported seconds range")
+
+
+def server_path(server):
+    url = server.get("url")
+    if not isinstance(url, str) or "{" in url or "}" in url:
+        raise ValueError("EvoMaster requires concrete schema server URLs")
+    parts = urlsplit(url)
+    if parts.query or parts.fragment or parts.username or parts.password:
+        raise ValueError("EvoMaster schema server URLs cannot contain credentials, query or fragment")
+    if parts.scheme and parts.scheme not in ("http", "https"):
+        raise ValueError("EvoMaster schema server URL must use HTTP(S)")
+    path = parts.path or "/"
+    if not path.startswith("/") or "//" in path or any(p in (".", "..") for p in path.split("/")):
+        raise ValueError("EvoMaster requires an absolute, normalized schema base path")
+    return path.rstrip("/") or "/"
+
+
+def validate_schema(document, base_path):
+    # --base replaces only the authority; EvoMaster infers the path from the schema.
+    # Reject ambiguous server overrides rather than risk direct/non-proxy traffic.
+    if "swagger" in document:
+        paths = {server_path({"url": document.get("basePath", "/")})}
+    elif "openapi" in document:
+        servers = document.get("servers", [{"url": "/"}])
+        if not isinstance(servers, list) or not servers:
+            raise ValueError("EvoMaster requires a nonempty schema servers list")
+        paths = {server_path(server) for server in servers}
+        for item in document.get("paths", {}).values():
+            if not isinstance(item, dict):
+                raise ValueError("EvoMaster requires object path items")
+            if "servers" in item or any(isinstance(op, dict) and "servers" in op for op in item.values()):
+                raise ValueError("EvoMaster path/operation server overrides are unsupported")
+    else:
+        raise ValueError("EvoMaster requires a Swagger/OpenAPI document")
+    expected = server_path({"url": base_path})
+    if paths != {expected}:
+        raise ValueError("EvoMaster schema base path differs from BASE_PATH; refusing a different target")
+
+
+def validate_outputs(directory):
+    directory = Path(directory)
+    stats = directory / "statistics.csv"
+    tests = directory / "tests"
+    if not stats.is_file() or not stats.stat().st_size:
+        raise ValueError("Missing EvoMaster statistics")
+    if not any(p.is_file() and p.stat().st_size for p in tests.rglob("*.java")):
+        raise ValueError("Missing EvoMaster generated tests")
+
+
+def main():
+    action, *args = sys.argv[1:]
+    if action == "options":
+        validate_options(*args)
+    elif action == "schema":
+        validate_schema(json.loads(Path(args[0]).read_text()), args[1])
+    elif action == "outputs":
+        validate_outputs(args[0])
+    else:
+        raise ValueError("Unknown EvoMaster validation action")
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except ValueError as error:
+        # Messages contain no supplied header, schema URL, or environment value.
+        raise SystemExit(str(error)) from None
