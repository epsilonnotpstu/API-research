# Non-secret values; all EMB paths are relative to EMB_DIR.
SUT_ID=scout-api
JAR_SOURCE=jdk_8_maven/cs/rest/original/scout-api/api/target/scout-api-sut.jar
COMPOSE_FILE=dockerfiles/scout-api.yaml
DOCKERFILE=dockerfiles/scout-api.dockerfile
SUT_SERVICE=sut-scout-api
INTERNAL_PORT=8080
# ⚠️ Runtime HTTP behavior is unverified in T14; see README.md evidence/assumptions.
HEALTH_PATH_DEFAULT=/admin/healthcheck
BASE_PATH_DEFAULT=/api
AUTH_ROLE_DEFAULT=administrator
AUTH_SOURCE=auth/scout-api-auth.yaml
SUT_IMAGE=r1-scout-api-sut:pilot
SPEC_SOURCE=openapi-swagger/scout-api.json
