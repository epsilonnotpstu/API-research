+#!/usr/bin/python3
+"""Write a final preservation proof and aggregate completion checks only."""
+import hashlib
+import json
+from pathlib import Path
+import runpy
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[1]
+KEY = HERE / 'key'
+R = runpy.run_path(str(HERE / 'review_t48.py'))
+
+
+def main():
+    R['guard']()
+    tests = json.loads((ROOT / '09_collab/logs/T48_scratch/test_summary.json').read_text())
+    assert tests['passed'] and tests['tests_run'] == 52 and tests['failures'] == tests['errors'] == 0
+    verification = json.loads((HERE / 'verification_t48.json').read_text())
+    assert all(verification['checks'].values())
+    log = json.loads((KEY / 'e10_build_log.json').read_text())
+    output = ROOT / '08_experiments/E2_labelling/e10_blind'
+    hashes = {p.relative_to(output).as_posix(): hashlib.sha256(p.read_bytes()).hexdigest()
+              for p in output.rglob('*') if p.is_file()}
+    assert hashes == log['package_hashes']
+    baseline = json.loads((KEY / 'preservation_t48_start.json').read_text())
+    final_hashes = {p: hashlib.sha256((HERE / p).read_bytes()).hexdigest() for p in baseline}
+    assert final_hashes == baseline
+    R['private_json'](KEY / 'preservation_t48_final.json',
+                      dict(unchanged=True, existing_key_files=sum(p.startswith('key/') for p in baseline),
+                           total_baseline_files=len(baseline), hashes=final_hashes))
+    references = json.loads((KEY / 'e10_reference_audit.json').read_text())
+    excluded = {pair['later'] + '/contract/' + p for pair in log['cross_item_pairs'] for p in pair['excluded']}
+    assert excluded == {r['target'] for r in references['missing_references']}
+    cross = json.loads((KEY / 'e10_cross_item_all.json').read_text())
+    checks = dict(existing_key_files_preserved=sum(p.startswith('key/') for p in baseline),
+                  all_baseline_files_preserved=len(baseline), frozen_pool_verified=True,
+                  tests=tests, package=verification['summary'], auth_fixtures=verification['auth_fixtures'],
+                  auth_value_variants=verification['auth_value_variants'], cross_item=cross['summary'],
+                  omitted_helper_occurrences=sum(len(d['omitted_helpers']) for d in log['items']),
+                  maximum_implementation_files=max(sum(p.startswith('impl/') for p in d['files']) for d in log['items']),
+                  references={k: v for k, v in references.items() if k != 'missing_references'},
+                  unresolved_reference_targets_equal_mandatory_cross_item_exclusions=True,
+                  old_blind_packages_read=False, existing_package_replacement=False,
+                  required_locators_preserved=True)
+    R['private_json'](HERE / 'checks_t48.json', checks)
+    print(json.dumps(checks))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/research/08_experiments/E7_mining/cross_audit_t48.py b/research/08_experiments/E7_mining/cross_audit_t48.py
new file mode 100644
index 0000000000000000000000000000000000000000..88eba0769b49b75ac8eab7712eb1b4baf9915ec9
--- /dev/null
+++ b/research/08_experiments/E7_mining/cross_audit_t48.py
@@ -0,0 +1,60 @@
+#!/usr/bin/python3
+"""Audit actual manifests across all generations without opening old packages."""
+import json
+from pathlib import Path
+import runpy
+
+HERE = Path(__file__).resolve().parent
+KEY = HERE / 'key'
+B = runpy.run_path(str(HERE / 'build_t48.py'))
+
+
+def main():
+    B['R']['guard']()
+    prior = B['B']['inputs']()
+    middle = [json.loads(p.read_text()) for p in sorted((KEY / 't47_items').glob('*.json'))]
+    new = B['R']['accepted']()
+    rows = prior + middle + new
+    logs = [(json.loads((KEY / name).read_text()), task) for name, task in
+            [('build_log.json', 'prior'), ('e8b_build_log.json', 'T47'), ('e10_build_log.json', 'T48')]]
+    details = {d['source_item']: dict(d, source_task=task) for log, task in logs for d in log['items']}
+    assert set(details) == {r['item_id'] for r in rows}
+    readers = {repo: B['B']['Git'](B['B']['M']['REPOS'][repo]) for repo in {r['repo'] for r in rows}}
+    changes = {r['item_id']: set(readers[r['repo']].changed(r['parent_commit'], r['fix_commit'])) for r in rows}
+    pairs = []
+    for earlier in rows:
+        for later in rows:
+            if earlier is later or earlier['repo'] != later['repo']:
+                continue
+            a, b = details[earlier['item_id']], details[later['item_id']]
+            paths = {p.split('/', 1)[1] for p in b['files']}
+            overlap = changes[earlier['item_id']] & paths
+            if not overlap or not readers[earlier['repo']].ancestor(earlier['fix_commit'], later['parent_commit']):
+                continue
+            retained = overlap & set(b['protected'])
+            if b['source_task'] == 'T48':
+                assert overlap == retained
+            pairs.append(dict(earlier=a['item_id'], later=b['item_id'], earlier_set=a['source_task'],
+                              later_set=b['source_task'], paths=sorted(overlap), retained_own_locators=sorted(retained)))
+    flagged = {p['later'] for p in pairs}
+    current = logs[-1][0]
+    # An item can remain flagged after its optional overlap was removed.
+    removed = {p['later'] for p in current['cross_item_pairs'] if p['excluded']}
+    for d in current['items']:
+        assert d['cross_item_flag'] == (d['item_id'] in flagged | removed)
+    affected = {p['later'] for p in pairs if p['earlier_set'] == 'T48' and p['later_set'] != 'T48'}
+    previously_flagged = {d['item_id'] for log, task in logs[:-1] for d in log['items'] if d['cross_item_flag']}
+    result = dict(all_items=len(rows), all_pairs=pairs, newly_affected_prior_items=sorted(affected),
+                  additional_prior_flags=sorted(affected - previously_flagged), V_flags_match=True,
+                  existing_keys_not_modified=True,
+                  summary=dict(pair_incidents=len(pairs), flagged_items=len(flagged | removed),
+                               incoming_to_V=sum(p['later_set'] == 'T48' for p in pairs),
+                               V_to_prior=sum(p['earlier_set'] == 'T48' and p['later_set'] != 'T48' for p in pairs),
+                               affected_prior_items=len(affected), additional_prior_flagged_items=len(affected - previously_flagged)))
+    B['R']['private_json'](KEY / 'e10_cross_item_all.json', result)
+    B['R']['guard']()
+    print(json.dumps(result['summary']))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/research/08_experiments/E7_mining/finalize_t48.py b/research/08_experiments/E7_mining/finalize_t48.py
new file mode 100644
index 0000000000000000000000000000000000000000..f2ec28d22e32386672b15196ebf765e2e5a9996e
--- /dev/null
+++ b/research/08_experiments/E7_mining/finalize_t48.py
@@ -0,0 +1,148 @@
+#!/usr/bin/python3
+"""Audit the two-pass continuation and the strictly sequential preview ledger."""
+from collections import Counter
+import csv
+import hashlib
+import io
+import json
+from pathlib import Path
+import runpy
+
+HERE = Path(__file__).resolve().parent
+KEY = HERE / 'key'
+R = runpy.run_path(str(HERE / 'review_t48.py'))
+
+
+def validate_previews(ordered, events, evidence_ids):
+    """Reject lookahead, missing finals, reopened candidates and unlogged evidence."""
+    ordinal = {d['candidate_id']: i for i, d in enumerate(ordered)}
+    assert len(ordinal) == len(ordered)
+    seen = set()
+    previous_index = -1
+    for sequence, event in enumerate(events, 1):
+        cid = event['candidate_id']
+        assert event['sequence'] == sequence
+        assert cid in ordinal, 'Preview without final decision'
+        index = ordinal[cid]
+        assert index >= previous_index, 'Preview reopened a completed candidate'
+        assert event['final_decisions_before'] == index, 'Lookahead before the prior final decision'
+        assert (event['repo'], event['rank']) == (ordered[index]['repo'], ordered[index]['rank'])
+        seen.add(cid)
+        previous_index = index
+    assert seen == set(ordinal), 'Final decision without a preview'
+    assert evidence_ids == set(ordinal), 'Unrecorded patch preview'
+    return seen
+
+
+def audit():
+    R['guard']()
+    new = R['accepted']()
+    previous = R['previous_items']()
+    old_counts = Counter(r['repo'] for r in previous)
+    decisions = R['decisions']()
+    by_pair = {(d['repo'], d['rank']): d for d in decisions}
+    assert len(by_pair) == len(decisions)
+    by_candidate = {}
+    for row in new:
+        by_candidate.setdefault(row['candidate_id'], []).append(row)
+    rows = {(r['repo'], r['rank']): r for r in R['sources']()}
+    expected = []
+    new_counts = Counter()
+    phase_counts = {1: Counter(), 2: Counter()}
+    phase_accepts = {1: Counter(), 2: Counter()}
+    total = 0
+    for phase, repo, rank in R['plan']():
+        if total >= 40:
+            break
+        if old_counts[repo] + new_counts[repo] >= 10:
+            continue
+        pair = repo, rank
+        assert pair in by_pair, 'Missing individual ranked decision: ' + str(pair)
+        d = by_pair[pair]
+        row = rows[pair]
+        assert d['candidate_id'] == row['candidate_id']
+        assert d['reason_code'] in R['CODES']
+        assert 0 < len(d['reason'].split()) <= 25
+        assert hashlib.sha256((HERE / d['review_evidence']).read_bytes()).hexdigest() == d['patch_sha256']
+        additions = by_candidate.get(d['candidate_id'], [])
+        assert bool(additions) == (d['review_status'] == 'accepted') == (d['reason_code'] == 'ACCEPT')
+        assert all(a['repo'] == repo and a['rank'] == rank for a in additions)
+        total += len(additions)
+        new_counts[repo] += len(additions)
+        phase_counts[phase][repo] += 1
+        phase_accepts[phase][repo] += len(additions)
+        assert old_counts[repo] + new_counts[repo] <= 10
+        expected.append(pair)
+    assert set(expected) == set(by_pair), 'Decision lies outside the permitted stopping prefix'
+    assert total == len(new)
+    ordered = [by_pair[pair] for pair in expected]
+
+    # Every view must belong to the one candidate currently under final decision.
+    events = [json.loads(p.read_text()) for p in sorted((KEY / 't48_previews').glob('*.json'))]
+    evidence_ids = {p.stem for p in (KEY / 't48_evidence').glob('*.diff')}
+    seen = validate_previews(ordered, events, evidence_ids)
+
+    old = list(csv.DictReader(io.StringIO((HERE.parent / 'E6_realfix/combined_accepted.csv').read_text())))
+    identities = [(r['repo'], r['operation'], r['fix_family']) for r in old + previous + new]
+    assert len(identities) == len(set(identities))
+    for row in new:
+        assert row['source_task'] == 'T48' and row['set'] == 'new'
+        assert row['proposition'].startswith(row['operation'] + ': contract says ')
+        assert '; implementation does ' in row['proposition']
+        check = json.loads(row['proposition_check'])
+        assert check['contract'] and check['implementation']
+        for loc in sum(check.values(), []):
+            assert loc.rsplit(':', 2)[0] == row['parent_commit']
+
+    yields = []
+    for prior in R['prior_yield']():
+        repo = prior['repo']
+        reviewed = [d['rank'] for d in ordered if d['repo'] == repo]
+        last = max(reviewed, default=int(prior['last_reviewed_rank']))
+        combined = old_counts[repo] + new_counts[repo]
+        stopped = ('combined repo cap' if combined >= 10 else
+                   'available pool exhausted' if last >= int(prior['pool2']) else
+                   'top 250' if last >= 250 else
+                   'T48 target reached' if total >= 40 else 'rank limit reached')
+        yields.append(dict(repo=repo, pool2=int(prior['pool2']),
+                           previous_last_rank=int(prior['last_reviewed_rank']),
+                           reviewed_phase1=phase_counts[1][repo], reviewed_phase2=phase_counts[2][repo],
+                           reviewed_T48=len(reviewed), last_reviewed_rank=last,
+                           accepted_previous=old_counts[repo], accepted_T48=new_counts[repo],
+                           accepted_combined=combined, stopped=stopped))
+    triaged = len(list((KEY / 't48_triage').glob('*.json')))
+    final = ordered[-1]
+    summary = dict(reviewed=len(ordered), accepted_T48=len(new),
+                   accepted_candidates=len(by_candidate), accepted_previous=len(previous),
+                   accepted_combined_new=len(previous) + len(new),
+                   reason_code_counts=dict(Counter(d['reason_code'] for d in ordered)),
+                   review_status_counts=dict(Counter(d['review_status'] for d in ordered)),
+                   T48_direction_counts=dict(Counter(r['truth_direction'] for r in new)),
+                   combined_new_direction_counts=dict(Counter(r['truth_direction'] for r in previous + new)),
+                   phase1_reviewed=sum(phase_counts[1].values()), phase2_reviewed=sum(phase_counts[2].values()),
+                   phase1_accepted=sum(phase_accepts[1].values()), phase2_accepted=sum(phase_accepts[2].values()),
+                   stopping_reason=('T48 acceptance threshold reached after the complete final candidate.' if total >= 40
+                                    else 'Every repository exhausted, capped or reviewed to its permitted rank limit.'),
+                   final_repo=final['repo'], final_rank=final['rank'],
+                   preview_record=dict(events=len(events), unique_candidates=len(seen),
+                                       outside_final_prefix=0, without_final_decision=0,
+                                       lookahead_before_prior_decision=0, chronological_sequence_verified=True),
+                   conservative_static_triage=triaged, additional_model_patch_reviews=len(ordered) - triaged,
+                   frozen_pool_verified=True, existing_key_verified=True, rank_order_verified=True,
+                   two_pass_order_verified=True, caps_verified=True, dedup_verified=True)
+    return ordered, yields, summary
+
+
+def main():
+    decisions, yields, summary = audit()
+    for path, rows in [(KEY / 'review_decisions_t48.csv', decisions), (HERE / 'yield_t48.csv', yields)]:
+        with path.open('x', newline='') as stream:
+            writer = csv.DictWriter(stream, list(rows[0]))
+            writer.writeheader()
+            writer.writerows(rows)
+    R['private_json'](HERE / 'summary_t48.json', summary)
+    print(json.dumps(summary))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/research/08_experiments/E7_mining/reference_audit_t48.py b/research/08_experiments/E7_mining/reference_audit_t48.py
new file mode 100644
index 0000000000000000000000000000000000000000..7a38abd90f9753ddf1c74dc85153c0cf93e3e328
--- /dev/null
+++ b/research/08_experiments/E7_mining/reference_audit_t48.py
@@ -0,0 +1,56 @@
+#!/usr/bin/python3
+"""Inventory local references after mandatory cross-item file exclusions."""
+import argparse
+import json
+from pathlib import Path
+import posixpath
+import re
+import runpy
+
+HERE = Path(__file__).resolve().parent
+B = runpy.run_path(str(HERE / 'build_t48.py'))
+
+
+def audit():
+    output = B['OUT']
+    missing = []
+    local = remote = 0
+    for path in output.rglob('*'):
+        if not path.is_file() or len(path.relative_to(output).parts) < 3 or path.relative_to(output).parts[1] != 'contract':
+            continue
+        for ref in B['B']['references'](path.read_bytes()):
+            filename = ref.partition('#')[0]
+            if not filename:
+                continue
+            if re.match(r'^[a-zA-Z][\w+.-]*:', filename):
+                remote += 1
+                continue
+            local += 1
+            target = Path(posixpath.normpath(str(path.parent / filename)))
+            if not target.is_file():
+                missing.append(dict(source=str(path.relative_to(output)), reference=ref,
+                                    target=str(target.relative_to(output))))
+    # Sorting makes the audit independent of filesystem enumeration order.
+    missing.sort(key=lambda row: (row['source'], row['reference'], row['target']))
+    return dict(local_file_reference_incidents=local, remote_reference_incidents=remote,
+                missing_reference_incidents=len(missing), affected_items=len({r['source'].split('/')[0] for r in missing}),
+                missing_references=missing)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--verify', action='store_true')
+    args = parser.parse_args()
+    result = audit()
+    path = HERE / 'key/e10_reference_audit.json'
+    if args.verify:
+        existing = json.loads(path.read_text())
+        existing['missing_references'].sort(key=lambda row: (row['source'], row['reference'], row['target']))
+        assert result == existing
+    else:
+        B['R']['private_json'](path, result)
+    print(json.dumps({k: v for k, v in result.items() if k != 'missing_references'}))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/research/08_experiments/E7_mining/run_tests_t48.py b/research/08_experiments/E7_mining/run_tests_t48.py
