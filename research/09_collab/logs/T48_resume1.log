        k=r['repo'],r['operation'],r['fix_family'];require(k not in dedup,'Duplicate repo/operation/family');dedup.add(k)
        require(r['truth_direction'] in {'SPEC','IMPL','BOTH'},'Invalid recorded direction')
    return new+old

