    72	def request_schemas(spec, path, method, op):
    73	    """Yield (pointer, container, key) for every request-side schema-bearing node, inlining refs."""
    74	    item = spec['paths'][path]
    75	    params = op.setdefault('parameters', [])
    76	    if 'parameters' in item:  # path-level params: copy into the operation to keep edits local
    77	        names = {(p.get('name'), p.get('in')) for p in params if isinstance(p, dict)}
    78	        params.extend(copy.deepcopy(p) for p in item['parameters'] if (p.get('name'), p.get('in')) not in names)
