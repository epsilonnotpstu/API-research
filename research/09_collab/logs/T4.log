   135	def mutate_strict(spec, path, method, op, edits):
   136	    for pointer, container, key in list(request_schemas(spec, path, method, op)):
   137	        for sp, schema in walk_schema(container[key], pointer):
   138	            t = schema.get('type')
   139	            if t in ('integer', 'number'):
   140	                before = schema.get('maximum')
   141	                schema['maximum'] = 0 if before is None else min(before, 0)
   142	                edits.append({'pointer': f'{sp}/maximum', 'before': before, 'after': schema['maximum']})
   143	            elif t == 'string' and 'enum' not in schema and 'format' not in schema:
   144	                before = schema.get('maxLength')
   145	                schema['maxLength'] = 1
   146	                edits.append({'pointer': f'{sp}/maxLength', 'before': before, 'after': 1})
   147	            if t == 'object' and schema.get('properties'):
   148	                before = schema.get('required')
   149	                schema['required'] = sorted(schema['properties'])
   150	                if before != schema['required']:
   151	                    edits.append({'pointer': f'{sp}/required', 'before': before, 'after': schema['required']})
   152	    set_param_required(path, method, op, True, edits)
