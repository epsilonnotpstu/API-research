   181	MUTATORS = {'REQUEST_LOOSE': mutate_loose, 'REQUEST_STRICT': mutate_strict,
   182	            'RESPONSE_ORACLE': mutate_response, 'METHOD_SEM': mutate_method}
   183	
   184	
   185	def mutate(spec, fault, severity, seed, exclude=()):
   186	    spec = copy.deepcopy(spec)
   187	    ops = [(p, m) for p, m, _ in operations(spec) if p not in exclude]
   188	    rng = random.Random(f'{seed}:{fault}')
   189	    k = max(1, round(len(ops) * severity / 100)) if ops else 0
   190	    chosen = sorted(rng.sample(ops, k))
   191	    manifest = []
   192	    for path, method in chosen:
   193	        op = spec['paths'][path][method]
   194	        original = copy.deepcopy(op)
   195	        edits = []
   196	        MUTATORS[fault](spec, path, method, op, edits)
   197	        if not edits:  # undo side effects ($ref inlining, copied path-level params) of a no-op
   198	            spec['paths'][path][method] = original
   199	        else:
   200	            l1, l2 = EXPECTED[fault]
   201	            manifest.append({'path': path, 'method': method, 'operationId': op.get('operationId'),
   202	                             'fault': fault, 'expected_L1': l1, 'expected_L2': l2, 'edits': edits})
   203	    return spec, manifest, len(ops)
   204	
