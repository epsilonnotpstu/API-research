    96	    frames = []
    97	    for f in sorted(glob.glob(str(p001 / 'faultClustersConfirmedBugs_*.csv'))):
    98	        d = pd.read_csv(f, low_memory=False)
    99	        d['api_file'] = Path(f).stem.split('_', 1)[1]
   100	        frames.append(d)
   101	    df = pd.concat(frames, ignore_index=True)
   102	    df['oracle'] = df['failReasonCategory'].map(CATEGORY_SHORT).fillna('OTHER')
   103	
   104	    # 1. violation-message types of OAS faults
   105	    oas = df[df.oracle == 'F_OAS'].copy()
