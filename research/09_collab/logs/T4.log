    16	  VALID_REJECTED          request conforms but got 400/422    (P001 F_400)
    17	
    18	Usage: python3 conformance.py SPEC EXCHANGES.jsonl > violations.jsonl
    19	"""
    20	import copy
    21	import datetime
    22	import json
    23	import re
    24	import sys
    25	
    26	import jsonschema
    27	
    28	import specmut
    29	
    30	FORMAT_CHECKER = copy.deepcopy(jsonschema.Draft4Validator.FORMAT_CHECKER)
    31	
    32	
    33	@FORMAT_CHECKER.checks('date', raises=ValueError)
    34	def _date(value):
    35	    return not isinstance(value, str) or bool(datetime.date.fromisoformat(value))
    36	
    37	
    38	@FORMAT_CHECKER.checks('date-time', raises=ValueError)
    39	def _date_time(value):
    40	    return not isinstance(value, str) or bool(datetime.datetime.fromisoformat(value.replace('Z', '+00:00')))
