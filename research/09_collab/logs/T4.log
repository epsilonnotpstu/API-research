    67	
    68	def kv(cell):
    69	    if not isinstance(cell, str):
    70	        return {}
    71	    out = {}
    72	    for part in filter(None, cell.split(';')):
    73	        k, _, v = part.partition('=')
    74	        out[unquote_plus(k)] = unquote_plus(v)
    75	    return out
