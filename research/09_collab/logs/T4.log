   104	def walk_schema(node, pointer):
   105	    """Yield (pointer, schema-dict) for a schema and its nested properties/items."""
   106	    if not isinstance(node, dict):
   107	        return
   108	    yield pointer, node
   109	    for name, sub in node.get('properties', {}).items():
   110	        yield from walk_schema(sub, f'{pointer}/properties/{name}')
   111	    if isinstance(node.get('items'), dict):
   112	        yield from walk_schema(node['items'], f'{pointer}/items')
