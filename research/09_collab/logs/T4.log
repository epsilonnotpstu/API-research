   124	def mutate_loose(spec, path, method, op, edits):
   125	    for pointer, container, key in list(request_schemas(spec, path, method, op)):
   126	        for sp, schema in walk_schema(container[key], pointer):
   127	            for k in LOOSE_KEYS:
   128	                if k in schema:
   129	                    edits.append({'pointer': f'{sp}/{k}', 'before': schema.pop(k), 'after': None})
   130	            if schema.get('required') and isinstance(schema['required'], list):
   131	                edits.append({'pointer': f'{sp}/required', 'before': schema.pop('required'), 'after': None})
   132	    set_param_required(path, method, op, False, edits)
   133	
