    78	def exchange(row, spec):
    79	    path = row['path']
    80	    for k, v in kv(row['pathParameters']).items():
    81	        path = path.replace('{' + k + '}', v)
    82	    body = row['responseBody'] if isinstance(row['responseBody'], str) else ''
    83	    return {'request': {'method': row['httpMethod'], 'path': spec.base + path,
    84	                        'query': {k: [v] for k, v in kv(row['queryParameters']).items()},
    85	                        'headers': {k.lower(): v for k, v in kv(row['headerParameters']).items()},
    86	                        'body': {'text': row['bodyParameter'] if isinstance(row['bodyParameter'], str) else ''}},
    87	            'response': {'status': int(row['statusCode']),
    88	                         'headers': {'content-type': row['outputContentType_y']} if isinstance(row['outputContentType_y'], str) else {},
    89	                         'body': {'text': body, 'truncated': False}}}
