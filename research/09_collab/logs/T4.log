    30	MESSAGE_TYPES = [  # (type, regex on one ' --- '-separated message); order matters
    31	    ('STATUS_UNDEFINED', r'Response status \d+ not defined'),
    32	    ('CONTENT_TYPE', r'Content-Type header'),
    33	    ('NO_BODY', r'no response body found'),
    34	    ('MISSING_REQUIRED', r'missing required properties'),
    35	    ('ADDITIONAL_PROPERTIES', r'not allowed by the schema'),
    36	    ('TYPE_NULL', r'instance type \(null\) does not match'),
    37	    ('TYPE_MISMATCH', r'instance type \(\w+\) does not match'),
    38	    ('PATTERN', r'ECMA 262 regex'),
    39	    ('ENUM', r'not found in enum'),
    40	    ('FORMAT', r'invalid against requested date format|not a valid (email|hostname|IPv)'),
    41	    ('NUMERIC_RANGE', r'numeric instance is (lower|greater|not strictly)'),
    42	    ('LENGTH', r'is too (short|long)|array is too'),
    43	    ('PARSE', r'Unable to parse JSON'),
    44	    ('COMPOSITION', r'failed to match (exactly one|at least one|all required) schema'),
    45	    ('INT_OVERFLOW', r'leads to overflow'),
    46	]
    47	CATEGORY_SHORT = {
    48	    'OAS disconformity': 'F_OAS',
    49	    'This faulty test case was expecting a 4XX status code(individual_parameter_constraint': 'F_2XXP',
    50	    'This faulty test case was expecting a 4XX status code(inter_parameter_dependency': 'F_2XXD',
    51	    "This test case's input was (possibly) correct": 'F_400',
    52	    'Status code 5XX with invalid request': 'F_5XXI',
