   206	def main():
   207	    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
   208	    ap.add_argument('spec')
   209	    ap.add_argument('--fault', choices=FAULTS, required=True)
   210	    ap.add_argument('--severity', type=int, default=30, help='percent of operations to mutate')
   211	    ap.add_argument('--seed', type=int, default=1)
   212	    ap.add_argument('--exclude', nargs='*', default=[], help='paths to leave untouched (e.g. auth/login)')
   213	    ap.add_argument('--out', required=True)
   214	    a = ap.parse_args()
   215	    base = load_spec(a.spec)
   216	    spec, manifest, n_ops = mutate(base, a.fault, a.severity, a.seed, set(a.exclude))
   217	    out = Path(a.out)
   218	    out.mkdir(parents=True, exist_ok=True)
   219	    stem = f'{Path(a.spec).stem}__{a.fault.lower()}__p{a.severity}__s{a.seed}'
   220	    (out / f'{stem}.json').write_text(json.dumps(spec, indent=2, default=str), encoding='utf-8')
   221	    meta = {'source_spec': a.spec, 'source_sha256': hashlib.sha256(Path(a.spec).read_bytes()).hexdigest(),
