    82	
    83	class Spec:
    84	    def __init__(self, spec, strict_additional=False):
    85	        self.raw = spec
    86	        self.strict = strict_additional
    87	        self.oas3 = specmut.is_oas3(spec)
    88	        base = spec.get('basePath', '') if not self.oas3 else ''
    89	        if self.oas3 and spec.get('servers'):
    90	            m = re.match(r'^(?:[a-z]+://[^/]+)?(/.*)?$', spec['servers'][0].get('url', ''))
    91	            base = (m.group(1) or '') if m else ''
    92	        self.base = base.rstrip('/')
    93	        self.routes = []  # (regex, template, path_item); literal segments first
    94	        for template in sorted(spec.get('paths', {}), key=lambda t: (t.count('{'), -len(t))):
    95	            rx = re.escape(self.base + template)
    96	            rx = re.sub(r'\\\{[^/]+?\\\}', '[^/]+', rx)
    97	            names = re.findall(r'\{([^/]+?)\}', template)
    98	            self.routes.append((re.compile('^' + rx + '/?$'), template, names))
    99	
   100	    def match(self, path):
   101	        for rx, template, names in self.routes:
   102	            m = rx.match(path)
   103	            if m:
   104	                values = re.findall(r'[^/]+', path[len(self.base):])
   105	                segs = template.strip('/').split('/')
   106	                params = {s[1:-1]: v for s, v in zip(segs, values) if s.startswith('{')}
   107	                return template, params
   108	        return None, {}
   109	
   110	    def operation(self, template, method):
   111	        item = self.raw['paths'][template]
   112	        op = item.get(method.lower())
   113	        if op is None:
   114	            return None, []
   115	        resolved = [specmut.resolve(self.raw, p) for p in item.get('parameters', []) + op.get('parameters', [])]
   116	        params = {(p.get('name'), p.get('in')): p for p in resolved}  # operation-level overrides path-level
   117	        return specmut.resolve(self.raw, op), list(params.values())
   118	
   119	    def response_entry(self, op, status):
   120	        responses = op.get('responses', {})
   121	        return responses.get(str(status)) or responses.get(f'{str(status)[0]}XX') or responses.get('default')
   122	
   123	    def response_schema(self, op, status):
   124	        resp = self.response_entry(op, status)
   125	        if resp is None:
   126	            return False, None
   127	        if self.oas3:
   128	            content = resp.get('content') or {}
   129	            media = content.get('application/json') or next(iter(content.values()), {})
   130	            return True, media.get('schema')
   131	        return True, resp.get('schema')
   132	
   133	    def allowed_media(self, op, status):
   134	        """Documented response media types, or None when the spec does not constrain them."""
   135	        resp = self.response_entry(op, status) or {}
   136	        if self.oas3:
   137	            return list(resp.get('content', {})) or None
   138	        produces = op.get('produces') or self.raw.get('produces')
   139	        return produces if produces and resp.get('schema') else None
   140	
