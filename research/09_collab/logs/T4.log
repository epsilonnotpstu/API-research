    43	def validator(schema, oas3, strict_additional=False):
    44	    return jsonschema.Draft4Validator(to_json_schema(schema, oas3, strict_additional), format_checker=FORMAT_CHECKER)
    45	
    46	
    47	PARAM_SCHEMA_KEYS = ('type', 'format', 'enum', 'minimum', 'maximum', 'exclusiveMinimum', 'exclusiveMaximum',
    48	                     'minLength', 'maxLength', 'pattern', 'items', 'minItems', 'maxItems', 'multipleOf')
    49	
    50	
    51	def to_json_schema(schema, oas3, strict_additional=False):
    52	    """Normalise an (already $ref-inlined) OpenAPI schema for jsonschema validation.
    53	
    54	    strict_additional=True treats every object schema that lists `properties` but says
    55	    nothing about `additionalProperties` as closed (a stricter reading than OpenAPI's default).
    56	    """
    57	    s = copy.deepcopy(schema)
    58	
    59	    def fix(node):
    60	        if isinstance(node, dict):
    61	            if oas3 and node.pop('nullable', False) and 'type' in node:
    62	                node['type'] = [node['type'], 'null'] if isinstance(node['type'], str) else node['type'] + ['null']
    63	            if node.get('x-nullable') is True and 'type' in node:  # Swagger 2.0 vendor extension
    64	                node['type'] = [node['type'], 'null']
    65	            for k in ('discriminator', 'xml', 'example', 'externalDocs', 'readOnly', 'writeOnly'):
    66	                node.pop(k, None)
    67	            if strict_additional and isinstance(node.get('properties'), dict) and 'additionalProperties' not in node:
    68	                node['additionalProperties'] = False
    69	            if isinstance(node.get('pattern'), str):
    70	                try:
    71	                    re.compile(node['pattern'])
    72	                except re.error:  # e.g. Java \p{L}; not checkable with Python re -> skip, keep a trace
    73	                    node['x-unchecked-pattern'] = node.pop('pattern')
    74	            for v in node.values():
    75	                fix(v)
    76	        elif isinstance(node, list):
    77	            for v in node:
    78	                fix(v)
    79	    fix(s)
    80	    return s
    81	
    82	
    83	class Spec:
    84	    def __init__(self, spec, strict_additional=False):
    85	        self.raw = spec
    86	        self.strict = strict_additional
    87	        self.oas3 = specmut.is_oas3(spec)
    88	        base = spec.get('basePath', '') if not self.oas3 else ''
    89	        if self.oas3 and spec.get('servers'):
    90	            m = re.match(r'^(?:[a-z]+://[^/]+)?(/.*)?$', spec['servers'][0].get('url', ''))
    91	            base = (m.group(1) or '') if m else ''
    92	        self.base = base.rstrip('/')
    93	        self.routes = []  # (regex, template, path_item); literal segments first
    94	        for template in sorted(spec.get('paths', {}), key=lambda t: (t.count('{'), -len(t))):
    95	            rx = re.escape(self.base + template)
    96	            rx = re.sub(r'\\\{[^/]+?\\\}', '[^/]+', rx)
    97	            names = re.findall(r'\{([^/]+?)\}', template)
    98	            self.routes.append((re.compile('^' + rx + '/?$'), template, names))
    99	
   100	    def match(self, path):
   101	        for rx, template, names in self.routes:
   102	            m = rx.match(path)
   103	            if m:
   104	                values = re.findall(r'[^/]+', path[len(self.base):])
   105	                segs = template.strip('/').split('/')
   106	                params = {s[1:-1]: v for s, v in zip(segs, values) if s.startswith('{')}
   107	                return template, params
   108	        return None, {}
   109	
   110	    def operation(self, template, method):
   111	        item = self.raw['paths'][template]
   112	        op = item.get(method.lower())
   113	        if op is None:
   114	            return None, []
   115	        resolved = [specmut.resolve(self.raw, p) for p in item.get('parameters', []) + op.get('parameters', [])]
   116	        params = {(p.get('name'), p.get('in')): p for p in resolved}  # operation-level overrides path-level
   117	        return specmut.resolve(self.raw, op), list(params.values())
   118	
   119	    def response_entry(self, op, status):
   120	        responses = op.get('responses', {})
   121	        return responses.get(str(status)) or responses.get(f'{str(status)[0]}XX') or responses.get('default')
   122	
   123	    def response_schema(self, op, status):
   124	        resp = self.response_entry(op, status)
   125	        if resp is None:
   126	            return False, None
   127	        if self.oas3:
   128	            content = resp.get('content') or {}
   129	            media = content.get('application/json') or next(iter(content.values()), {})
   130	            return True, media.get('schema')
   131	        return True, resp.get('schema')
   132	
   133	    def allowed_media(self, op, status):
   134	        """Documented response media types, or None when the spec does not constrain them."""
   135	        resp = self.response_entry(op, status) or {}
   136	        if self.oas3:
   137	            return list(resp.get('content', {})) or None
   138	        produces = op.get('produces') or self.raw.get('produces')
   139	        return produces if produces and resp.get('schema') else None
   140	
   141	
   142	def coerce(value, schema, values=None, delimiter=','):
   143	    """Path/query parameters arrive as strings; coerce to the declared type.
   144	
   145	    Arrays: repeated keys (OAS3 form/explode) or one delimited value (Swagger 2.0 csv,
   146	    OAS3 explode=false) are split and each item is coerced against `items`.
   147	    """
   148	    t = schema.get('type')
   149	    if t == 'array':
   150	        raw = values if values and len(values) > 1 else (value.split(delimiter) if isinstance(value, str) else [value])
   151	        return [coerce(x, schema.get('items', {})) for x in raw]
   152	    try:
   153	        if t == 'integer':
   154	            return int(value)
   155	        if t == 'number':
   156	            return float(value)
   157	        if t == 'boolean':
   158	            return {'true': True, 'false': False}[value.lower()]
   159	    except (ValueError, KeyError, AttributeError):
   160	        return value
   161	    return value
   162	
   163	
   164	def request_problems(spec, params, op, exchange, path_params):
   165	    """Return a list of (pointer, message) for spec violations in the request itself."""
   166	    problems = []
   167	    req = exchange['request']
   168	    for p in params:
   169	        loc, name = p.get('in'), p.get('name')
   170	        schema = p.get('schema') if 'schema' in p else {k: p[k] for k in PARAM_SCHEMA_KEYS if k in p}
   171	        if loc == 'body' or not schema:
   172	            continue
   173	        if loc == 'path':
   174	            present, raw = name in path_params, path_params.get(name)
   175	        elif loc == 'query':
   176	            vals = req.get('query', {}).get(name)
   177	            present, raw = bool(vals), (vals[0] if vals else None)
   178	            all_vals = vals or []
   179	        elif loc == 'header':
   180	            raw = req.get('headers', {}).get(name.lower())
   181	            present = raw is not None
   182	        else:
   183	            continue
   184	        if not present:
   185	            if p.get('required'):
   186	                problems.append((f'/parameters/{loc}/{name}/required', f'missing required {loc} parameter {name}'))
   187	            continue
   188	        js = to_json_schema(schema, spec.oas3)
   189	        delim = {'ssv': ' ', 'tsv': '\t', 'pipes': '|'}.get(p.get('collectionFormat'), ',')
   190	        if p.get('style') == 'spaceDelimited':
   191	            delim = ' '
   192	        elif p.get('style') == 'pipeDelimited':
   193	            delim = '|'
   194	        value = coerce(raw, js, all_vals if loc == 'query' else None, delim)
   195	        for err in validator(schema, spec.oas3).iter_errors(value):
   196	            problems.append((f'/parameters/{loc}/{name}/' + '/'.join(map(str, err.schema_path)), err.message))
   197	    body_schema = None
   198	    if spec.oas3 and 'requestBody' in op:
   199	        content = op['requestBody'].get('content', {})
   200	        body_schema = (content.get('application/json') or next(iter(content.values()), {})).get('schema')
   201	    else:
   202	        body_schema = next((p.get('schema') for p in params if p.get('in') == 'body'), None)
   203	    text = req.get('body', {}).get('text', '')
   204	    if body_schema and text:
   205	        try:
   206	            body = json.loads(text)
   207	        except ValueError:
   208	            body = None
   209	        if body is not None:
   210	            for err in validator(body_schema, spec.oas3).iter_errors(body):
   211	                problems.append(('/requestBody/' + '/'.join(map(str, err.schema_path)), err.message))
   212	    return problems
   213	
   214	
   215	def media_matches(ctype, allowed):
   216	    allowed = allowed.split(';')[0].strip().lower()
   217	    if allowed in ('*/*', ctype):
   218	        return True
   219	    a_type, _, a_sub = allowed.partition('/')
   220	    c_type, _, c_sub = ctype.partition('/')
   221	    return a_type == c_type and a_sub == '*'
   222	
   223	
   224	def check(spec, exchange):
   225	    req, resp = exchange['request'], exchange['response']
   226	    method, status = req['method'].upper(), int(resp['status'])
   227	    template, path_params = spec.match(req['path'])
   228	
   229	    def v(kind, pointer='', message=''):
   230	        return {'kind': kind, 'method': method, 'template': template or req['path'], 'status': status,
   231	                'pointer': pointer, 'message': message[:300],
   232	                'fingerprint': '|'.join([method, template or req['path'], str(status), kind, pointer])}
   233	
   234	    if template is None:
   235	        return [v('UNDOCUMENTED_OPERATION', message='path not in spec')]
   236	    op, params = spec.operation(template, method)
   237	    if op is None:
   238	        return [v('UNDOCUMENTED_OPERATION', message='method not in spec')]
   239	    out = []
   240	    if status >= 500:
   241	        out.append(v('SERVER_ERROR'))
   242	    documented, schema = spec.response_schema(op, status)
   243	    if not documented:
   244	        out.append(v('UNDOCUMENTED_STATUS'))
   245	    else:
   246	        allowed = spec.allowed_media(op, status)
   247	        ctype = (resp.get('headers', {}).get('content-type') or '').split(';')[0].strip().lower()
   248	        if allowed and ctype and not any(media_matches(ctype, a) for a in allowed):
   249	            out.append(v('RESPONSE_CONTENT_TYPE', '', f'{ctype} not in {allowed}'))
   250	    if documented and schema and resp.get('body', {}).get('text') and not resp['body'].get('truncated'):
   251	        try:
   252	            body = json.loads(resp['body']['text'])
   253	        except ValueError:
   254	            body = None
   255	            out.append(v('RESPONSE_PARSE', '', 'body is not valid JSON'))
   256	        if body is not None:
   257	            for err in validator(schema, spec.oas3, spec.strict).iter_errors(body):
   258	                out.append(v('RESPONSE_SCHEMA', '/' + '/'.join(map(str, err.schema_path)), err.message))
   259	    problems = request_problems(spec, params, op, exchange, path_params)
   260	    if problems and 200 <= status < 300:
   261	        out.extend(v('INVALID_ACCEPTED', ptr_, msg) for ptr_, msg in problems)
   262	    if not problems and status in (400, 422):
   263	        out.append(v('VALID_REJECTED'))
   264	    return out
   265	
   266	
   267	def main(spec_path, exchanges_path):
   268	    spec = Spec(specmut.load_spec(spec_path))
   269	    with open(exchanges_path, encoding='utf-8') as f:
   270	        for i, line in enumerate(f):
   271	            for violation in check(spec, json.loads(line)):
   272	                violation['exchange'] = i
   273	                print(json.dumps(violation))
   274	
   275	
   276	if __name__ == '__main__':
   277	    main(*sys.argv[1:3])

