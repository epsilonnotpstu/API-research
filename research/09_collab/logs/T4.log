    60	def message_types(fail_reason):
    61	    text = str(fail_reason).split(':', 1)[-1]
    62	    types = set()
    63	    for msg in filter(None, (m.strip() for m in text.split(' --- '))):
    64	        types.add(next((t for t, rx in MESSAGE_TYPES if re.search(rx, msg, re.I)), 'OTHER'))
    65	    return types
