    42	        if fp in mut_fp and fp not in base_fp:
    43	            status = 'NEW'
    44	            l1, l2 = (m['expected_L1'], m['expected_L2']) if m else ('UNEXPLAINED', '')
    45	        elif fp in base_fp and fp not in mut_fp:
    46	            status, l1, l2 = 'VANISHED', 'MASKED' if m else 'UNEXPLAINED', ''
