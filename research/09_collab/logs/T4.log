    32	def response(flow: http.HTTPFlow):
    33	    req, resp = flow.request, flow.response
    34	    record = {
    35	        'ts': time.time(),
    36	        'request': {'method': req.method, 'path': req.path.split('?', 1)[0],
    37	                    'query': {k: req.query.get_all(k) for k in req.query.keys()},
    38	                    'headers': _headers(req.headers), 'body': _body(req)},
    39	        'response': {'status': resp.status_code, 'headers': _headers(resp.headers), 'body': _body(resp)},
    40	    }
    41	    with open(LOG_FILE, 'a', encoding='utf-8') as f:
    42	        f.write(json.dumps(record, ensure_ascii=False) + '\n')
     1	"""Property checks for specmut over a folder of real specs (e.g. EMB openapi-swagger/).
     2	
     3	Usage: python3 test_specmut.py SPEC_DIR
     4	Checks, for every spec x fault class:
     5	  1. the mutated spec serialises to JSON;
     6	  2. locality: operations not listed in the manifest are byte-identical to the original;
     7	  3. manifest fidelity: every recorded edit's `after` value is present at its pointer
     8	     (or the key is absent when `after` is None);
     9	  4. determinism: the same seed yields the same manifest.
    10	"""
    11	import glob
    12	import json
    13	import sys
    14	from pathlib import Path
    15	
    16	import specmut
    17	
    18	
    19	def get(doc, pointer):
    20	    node = doc
    21	    for part in pointer.lstrip('/').split('/'):
    22	        part = part.replace('~1', '/').replace('~0', '~')
    23	        if isinstance(node, list):
    24	            node = node[int(part)]
    25	        elif isinstance(node, dict) and part in node:
    26	            node = node[part]
    27	        else:
    28	            raise KeyError(pointer)
    29	    return node
    30	
    31	
    32	def check(spec_path, fault, severity=30, seed=7):
    33	    base = specmut.load_spec(spec_path)
    34	    mutated, manifest, n_ops = specmut.mutate(base, fault, severity, seed)
    35	    json.dumps(mutated, default=str)
    36	    touched = {(m['path'], m['method']) for m in manifest}
    37	    if fault == 'METHOD_SEM':
    38	        touched |= {(m['path'], e['after']) for m in manifest for e in m['edits']}
    39	    for path, method, op in specmut.operations(base):
    40	        if (path, method) not in touched:
    41	            assert mutated['paths'][path].get(method) == op, f'locality broken at {method} {path}'
    42	    for m in manifest:
    43	        for e in m['edits']:
    44	            if fault == 'METHOD_SEM':
    45	                assert e['after'] in mutated['paths'][m['path']]
    46	                continue
    47	            try:
    48	                value = get(mutated, e['pointer'])
    49	                assert e['after'] is not None and value == e['after'], f'{e["pointer"]}: {value!r} != {e["after"]!r}'
    50	            except KeyError:
    51	                assert e['after'] is None, f'missing pointer {e["pointer"]}'
    52	    again = specmut.mutate(base, fault, severity, seed)[1]
    53	    assert again == manifest, 'non-deterministic'
    54	    return n_ops, len(manifest), sum(len(m['edits']) for m in manifest)
    55	
    56	
    57	def main(spec_dir):
    58	    failures, rows = [], []
    59	    for spec_path in sorted(glob.glob(f'{spec_dir}/*.json') + glob.glob(f'{spec_dir}/*.yaml')):
    60	        fmt = 'oas3' if specmut.is_oas3(specmut.load_spec(spec_path)) else 'sw2'
    61	        for fault in specmut.FAULTS:
    62	            try:
    63	                rows.append((Path(spec_path).stem, fmt, fault) + check(spec_path, fault))
    64	            except Exception as exc:  # report and continue
    65	                failures.append((Path(spec_path).stem, fault, repr(exc)[:200]))
    66	    for r in rows:
    67	        print(f'{r[0]:28s} {r[1]:4s} {r[2]:16s} ops={r[3]:4d} mutated={r[4]:3d} edits={r[5]:5d}')
    68	    print(f'\n{len(rows)} passed, {len(failures)} failed')
    69	    for f in failures:
    70	        print('FAIL', *f)
    71	    return 1 if failures else 0
    72	
    73	
    74	if __name__ == '__main__':
    75	    sys.exit(main(sys.argv[1]))
     1	"""End-to-end check of specmut -> conformance -> attribute in replay mode.
     2	
     3	For every spec in SPEC_DIR and every fault class we synthesise exchanges from the
     4	*original* spec (one schema-valid request/response per documented operation, with
     5	an extra undeclared response property, plus a deliberately out-of-range variant),
     6	check them against the original and the mutated spec, and attribute the diff.
     7	
     8	Because traffic is identical in both checks, every NEW or VANISHED fingerprint
     9	must sit on an operation listed in the manifest; anything else is a pipeline bug.
    10	
    11	Usage: python3 test_pipeline.py SPEC_DIR
    12	"""
    13	import glob
    14	import json
    15	import sys
    16	from pathlib import Path
    17	
    18	import attribute
    19	import conformance
    20	import specmut
    21	
    22	
    23	def instance(schema, depth=0):
    24	    """Minimal schema-valid instance (best effort) for an inlined schema."""
    25	    if not isinstance(schema, dict) or depth > 6:
    26	        return None
    27	    if 'enum' in schema and schema['enum']:
    28	        return schema['enum'][0]
    29	    for key in ('allOf', 'oneOf', 'anyOf'):
    30	        if schema.get(key):
    31	            return instance(schema[key][0], depth + 1)
    32	    t = schema.get('type')
    33	    if isinstance(t, list):
    34	        t = next((x for x in t if x != 'null'), None)
    35	    if t == 'object' or (t is None and 'properties' in schema):
    36	        obj = {k: instance(v, depth + 1) for k, v in schema.get('properties', {}).items()}
    37	        obj = {k: v for k, v in obj.items() if v is not None or k in schema.get('required', [])}
    38	        return obj
    39	    if t == 'array':
    40	        item = instance(schema.get('items', {}), depth + 1)
    41	        return [item] * max(1, schema.get('minItems', 1)) if item is not None else []
    42	    if t in ('integer', 'number'):
    43	        lo = schema.get('minimum', 1)
    44	        hi = schema.get('maximum', lo + 10)
    45	        val = lo if lo <= hi else hi
    46	        return int(val) if t == 'integer' else float(val)
    47	    if t == 'boolean':
    48	        return True
    49	    if t == 'string':
    50	        fmt = schema.get('format')
    51	        if fmt == 'date-time':
    52	            return '2026-01-01T00:00:00Z'
    53	        if fmt == 'date':
    54	            return '2026-01-01'
    55	        if fmt in ('uuid',):
    56	            return '123e4567-e89b-12d3-a456-426614174000'
    57	        if fmt == 'email':
    58	            return 'a@b.co'
    59	        n = max(1, schema.get('minLength', 1))
    60	        return 'a' * min(n, schema.get('maxLength', n))
    61	    return None
    62	
    63	
    64	def exchanges_for(spec_obj):
    65	    sp = conformance.Spec(spec_obj)
    66	    out = []
    67	    for template in spec_obj.get('paths', {}):
    68	        for method in list(spec_obj['paths'][template]):
    69	            if method not in specmut.HTTP_METHODS:
    70	                continue
    71	            op, params = sp.operation(template, method)
    72	            path, query = sp.base + template, {}
    73	            for p in params:
    74	                schema = p.get('schema') or {k: p[k] for k in conformance.PARAM_SCHEMA_KEYS if k in p}
    75	                val = instance(schema) if schema else 'a'
    76	                if p.get('in') == 'path':
    77	                    path = path.replace('{' + p['name'] + '}', str(val if val is not None else 'a'))
    78	                elif p.get('in') == 'query':
    79	                    query[p['name']] = [str(val).lower() if isinstance(val, bool) else str(val)]
    80	            code = next((c for c in op.get('responses', {}) if str(c).startswith('2')), None)
    81	            if code is None:
    82	                continue
    83	            _, schema = sp.response_schema(op, int(code))
    84	            body = instance(schema) if schema else None
    85	            if isinstance(body, dict):
    86	                body['zz_undeclared'] = 1  # tolerated unless additionalProperties is false
    87	            text = json.dumps(body) if body is not None else ''
    88	            ex = {'request': {'method': method.upper(), 'path': path, 'query': query, 'headers': {},
    89	                              'body': {'text': ''}},
    90	                  'response': {'status': int(code), 'headers': {}, 'body': {'text': text, 'truncated': False}}}
    91	            out.append(ex)
    92	            if query:  # out-of-range variant: every query param gets a long string
    93	                bad = json.loads(json.dumps(ex))
    94	                bad['request']['query'] = {k: ['x' * 300] for k in query}
    95	                out.append(bad)
    96	    return out
    97	
    98	
    99	def run(spec_path, fault, seed=3):
   100	    base = specmut.load_spec(spec_path)
   101	    mutated, manifest, _ = specmut.mutate(base, fault, 50, seed)
   102	    exchanges = exchanges_for(base)
   103	    b_spec, m_spec = conformance.Spec(base), conformance.Spec(mutated)
   104	    b_viol = [v for ex in exchanges for v in conformance.check(b_spec, ex)]
   105	    m_viol = [v for ex in exchanges for v in conformance.check(m_spec, ex)]
   106	    rows = attribute.attribute(b_viol, m_viol, {'mutations': manifest})
   107	    bad = [r for r in rows if r['status'] in ('NEW', 'VANISHED') and not r['op_mutated']]
   108	    new = sum(r['status'] == 'NEW' for r in rows)
   109	    gone = sum(r['status'] == 'VANISHED' for r in rows)
   110	    return len(exchanges), len(manifest), new, gone, bad
   111	
   112	
   113	def main(spec_dir):
   114	    total_bad, summary = 0, {}
   115	    for spec_path in sorted(glob.glob(f'{spec_dir}/*.json') + glob.glob(f'{spec_dir}/*.yaml')):
   116	        for fault in specmut.FAULTS:
   117	            try:
   118	                n_ex, n_mut, new, gone, bad = run(spec_path, fault)
   119	            except Exception as exc:
   120	                print('ERROR', Path(spec_path).stem, fault, repr(exc)[:200])
   121	                total_bad += 1
   122	                continue
   123	            s = summary.setdefault(fault, [0, 0, 0, 0])
   124	            s[0] += n_mut; s[1] += new; s[2] += gone; s[3] += len(bad)
   125	            for r in bad[:3]:
   126	                print('UNEXPLAINED', Path(spec_path).stem, fault, r['status'], r['fingerprint'][:150])
   127	            total_bad += len(bad)
   128	    print('\nfault             mutated_ops  NEW  VANISHED  unexplained')
   129	    for fault, (m, n, g, b) in summary.items():
   130	        print(f'{fault:17s} {m:11d} {n:4d} {g:9d} {b:12d}')
   131	    print('PASS' if total_bad == 0 else f'FAIL ({total_bad})')
   132	    return 1 if total_bad else 0
   133	
   134	
   135	if __name__ == '__main__':
   136	    sys.exit(main(sys.argv[1]))

