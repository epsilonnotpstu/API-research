   155	def mutate_response(spec, path, method, op, edits):
   156	    for code in [c for c in list(op.get('responses', {})) if str(c).startswith('5')]:
   157	        edits.append({'pointer': ptr('paths', path, method, 'responses', code),
   158	                      'before': op['responses'].pop(code), 'after': None})
   159	    for code, pointer, container, key in list(response_schemas(spec, path, method, op)):
   160	        if not str(code).startswith('2'):
