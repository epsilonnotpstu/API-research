    54	}
    55	OUR_KIND_FOR = {'F_OAS': {'RESPONSE_SCHEMA', 'UNDOCUMENTED_STATUS', 'RESPONSE_CONTENT_TYPE', 'RESPONSE_PARSE'}, 'F_2XXP': {'INVALID_ACCEPTED'},
    56	                'F_2XXD': {'INVALID_ACCEPTED'}, 'F_400': {'VALID_REJECTED'},
    57	                'F_5XXI': {'SERVER_ERROR'}, 'F_5XXV': {'SERVER_ERROR'}}
