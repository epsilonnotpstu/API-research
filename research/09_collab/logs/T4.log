    23	    raw = message.get_content(strict=False) or b''
    24	    text = raw[:MAX_BODY].decode('utf-8', 'replace')
    25	    return {'text': text, 'truncated': len(raw) > MAX_BODY, 'size': len(raw)}
    26	
    27	
    28	def _headers(headers):
    29	    return {k.lower(): ('<redacted>' if k.lower() in REDACT else v) for k, v in headers.items()}
