   172	def mutate_method(spec, path, method, op, edits):
   173	    item = spec['paths'][path]
   174	    target = METHOD_SWAP.get(method)
   175	    if not target or target in item:
   176	        return  # would collide with an existing operation; skipped (recorded as no edit)
   177	    item[target] = item.pop(method)
   178	    edits.append({'pointer': ptr('paths', path, method), 'before': method, 'after': target})
