   110	    type_counts = Counter(t for ts in oas['types'] for t in ts)
   111	
   112	    # 2. developer response by oracle category
   113	    bugs = pd.read_csv(p001 / 'bugs_reported.csv')
   114	    j = df.merge(bugs, on='testCaseId', how='left', suffixes=('', '_bug'))
   115	    def flag(col, val):
   116	        return j[col].astype(str).str.lower().eq(val)
   117	    j['dev_replied'], j['dev_confirmed'], j['dev_fixed'] = flag('replied', 'true'), flag('confirmed', 'true'), flag('fixed', 'true')
   118	    dev = j.groupby('oracle').agg(faults=('testCaseId', 'size'), reported=('reported', lambda s: s.astype(str).str.lower().eq('true').sum()),
   119	                                  replied=('dev_replied', 'sum'), confirmed=('dev_confirmed', 'sum'),
   120	                                  fixed=('dev_fixed', 'sum')).reset_index()
   121	    dev.to_csv(out / 'developer_response.csv', index=False)
   122	
   123	    # 3. replay agreement with tools/conformance.py
   124	    agree = []
   125	    cache = {}
   126	    for r in df.itertuples():
   127	        key = r.api_file.lower()
   128	        if key not in specs:
   129	            continue
   130	        row = {'api': r.api_file, 'testCaseId': r.testCaseId, 'p001_oracle': r.oracle,
   131	               'p001_types': ';'.join(sorted(message_types(r.failReason))) if r.oracle == 'F_OAS' else ''}
   132	        for mode, strict in (('default', False), ('strict', True)):
   133	            if (key, mode) not in cache:
   134	                cache[(key, mode)] = conformance.Spec(specmut.load_spec(str(specs[key])), strict_additional=strict)
   135	            spec = cache[(key, mode)]
   136	            try:
   137	                kinds = {v['kind'] for v in conformance.check(spec, exchange(r._asdict(), spec))}
   138	                err = ''
   139	            except Exception as exc:  # keep going; report
   140	                kinds, err = set(), repr(exc)[:120]
   141	            row[f'our_kinds_{mode}'] = ';'.join(sorted(kinds))
   142	            row[f'reproduced_{mode}'] = bool(kinds & OUR_KIND_FOR.get(r.oracle, set()))
   143	            row[f'error_{mode}'] = err
   144	        agree.append(row)
   145	    ag = pd.DataFrame(agree)
   146	    ag.to_csv(out / 'replay_agreement.csv', index=False)
   147	    by_oracle = ag.groupby('p001_oracle')[['reproduced_default', 'reproduced_strict']].agg(['sum', 'size']).reset_index()
   148	    by_oracle.columns = ['_'.join(c).strip('_') for c in by_oracle.columns]
   149	    oas_ag = ag[ag.p001_oracle == 'F_OAS']
   150	    addl = oas_ag[oas_ag.p001_types.str.contains('ADDITIONAL_PROPERTIES')]
   151	
   152	    summary = {
   153	        'faults_total': int(len(df)), 'faults_by_oracle': df['oracle'].value_counts().to_dict(),
   154	        'oas_faults_by_message_type': dict(type_counts.most_common()),
   155	        'oas_faults_multi_type': int((oas['types'].map(len) > 1).sum()),
   156	        'developer_response': dev.to_dict(orient='records'),
   157	        'replay_reproduced_by_oracle': by_oracle.to_dict(orient='records'),
   158	        'replay_errors': int((ag['error_default'] != '').sum() + (ag['error_strict'] != '').sum()),
   159	        'additional_properties_faults': {'n': int(len(addl)),
   160	                                         'reproduced_default': int(addl.reproduced_default.sum()),
   161	                                         'reproduced_strict': int(addl.reproduced_strict.sum())},
   162	    }
   163	    (out / 'summary.json').write_text(json.dumps(summary, indent=1, default=int))
   164	    print(json.dumps(summary, indent=1, default=int))
