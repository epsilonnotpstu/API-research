   115	def set_param_required(path, method, op, value, edits):
   116	    """Flip the parameter-level `required` flag (lives outside the schema in both formats)."""
   117	    for i, p in enumerate(op.get('parameters', [])):
   118	        if p.get('in') in ('query', 'header') and bool(p.get('required')) != value:
   119	            edits.append({'pointer': ptr('paths', path, method, 'parameters', i, 'required'),
   120	                          'before': p.get('required'), 'after': value})
   121	            p['required'] = value
