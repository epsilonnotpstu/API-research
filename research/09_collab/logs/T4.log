    48	def resolve(spec, node, depth=0):
    49	    """Return a deep copy of node with local $refs inlined (cycles cut at depth 8)."""
    50	    if depth > 8:
    51	        return {}
    52	    if isinstance(node, dict):
    53	        if '$ref' in node and isinstance(node['$ref'], str) and node['$ref'].startswith('#/'):
    54	            target = spec
    55	            for part in node['$ref'][2:].split('/'):
    56	                target = target.get(part.replace('~1', '/').replace('~0', '~'), {})
    57	            return resolve(spec, target, depth + 1)
    58	        return {k: resolve(spec, v, depth) for k, v in node.items()}
    59	    if isinstance(node, list):
    60	        return [resolve(spec, v, depth) for v in node]
    61	    return node
