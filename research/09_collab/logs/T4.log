    46	
    47	PARAM_SCHEMA_KEYS = ('type', 'format', 'enum', 'minimum', 'maximum', 'exclusiveMinimum', 'exclusiveMaximum',
    48	                     'minLength', 'maxLength', 'pattern', 'items', 'minItems', 'maxItems', 'multipleOf')
    49	
    50	
    51	def to_json_schema(schema, oas3, strict_additional=False):
    52	    """Normalise an (already $ref-inlined) OpenAPI schema for jsonschema validation.
    53	
    54	    strict_additional=True treats every object schema that lists `properties` but says
    55	    nothing about `additionalProperties` as closed (a stricter reading than OpenAPI's default).
    56	    """
    57	    s = copy.deepcopy(schema)
    58	
    59	    def fix(node):
    60	        if isinstance(node, dict):
    61	            if oas3 and node.pop('nullable', False) and 'type' in node:
    62	                node['type'] = [node['type'], 'null'] if isinstance(node['type'], str) else node['type'] + ['null']
    63	            if node.get('x-nullable') is True and 'type' in node:  # Swagger 2.0 vendor extension
    64	                node['type'] = [node['type'], 'null']
    65	            for k in ('discriminator', 'xml', 'example', 'externalDocs', 'readOnly', 'writeOnly'):
    66	                node.pop(k, None)
    67	            if strict_additional and isinstance(node.get('properties'), dict) and 'additionalProperties' not in node:
    68	                node['additionalProperties'] = False
    69	            if isinstance(node.get('pattern'), str):
    70	                try:
    71	                    re.compile(node['pattern'])
    72	                except re.error:  # e.g. Java \p{L}; not checkable with Python re -> skip, keep a trace
    73	                    node['x-unchecked-pattern'] = node.pop('pattern')
    74	            for v in node.values():
    75	                fix(v)
    76	        elif isinstance(node, list):
    77	            for v in node:
    78	                fix(v)
    79	    fix(s)
    80	    return s
