+            'source': emb / source, 'emb_spec': emb / 'openapi-swagger' / f'{sut}.json',
+            'blind_sheet': label_dir / f'{sheet}_baseline_s1_blind.csv',
+            'adjudication': label_dir / f'{sheet}_adjudication.csv',
+            'origin': f'http://sut-{sut}:8080', 'source_omit': [],
+        }
+    return result
