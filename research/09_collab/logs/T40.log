+
+    def test_method_collision_never_overwrites_existing_verb(self):
+        original = {'swagger': '2.0', 'paths': {'/a': {'get': {'responses': {}}, 'post': {'responses': {}}}}}
+        current, edits, _ = b.specmut.mutate(original, 'METHOD_SEM', 100, b.SEED, only={('/a', 'get')})
