+    config['fixtures'][0].write_text(json.dumps({'auth': [{'fixedHeaders': [
+        {'name': 'Authorization', 'value': 'Bearer synthetic-test-secret-9a7b'}]}]}))
+    finals = []
+    for sut in ('alpha', 'beta', 'gamma', 'delta'):
+        base = root / sut
+        run = base / 'run'
+        source = base / 'upstream'
+        run.mkdir(parents=True)
