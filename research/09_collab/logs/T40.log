+            records = [json.loads(line) for line in
+                       (self.hidden / 'replay' / f"{key['sut']}.attribution.jsonl").read_text().splitlines()]
+            row = next(r for r in records if r['fingerprint'] == key['fingerprint'])
+            if key['role'] == 'injected':
