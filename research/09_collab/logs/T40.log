+#!/usr/bin/env python3
+"""Offline behavioral tests; synthetic inputs, real repository mutation/checker APIs."""
+import collections
+import contextlib
+import copy
+import csv
+import importlib.util
+import io
+import json
+from pathlib import Path
+import sys
+import tempfile
