+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[1]
+EXPERIMENTS = HERE.parent
+TOOLS = EXPERIMENTS / 'tools'
+sys.path.insert(0, str(TOOLS))
+import attribute  # noqa: E402
+import conformance as checker  # noqa: E402
+import specmut  # noqa: E402
