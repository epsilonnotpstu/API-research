+                    found.add((key, json.dumps(value, sort_keys=True)))
+                found.update(extensions(value))
+        elif isinstance(node, list):
+            for value in node:
+                found.update(extensions(value))
+        return found
+    require(extensions(current) <= extensions(original), 'New vendor extension')
