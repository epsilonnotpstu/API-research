+            (root / 'K01/source').mkdir(parents=True)
+            original = {'openapi': '3.0.0', 'info': {'title': 'API', 'version': '1'}, 'paths': {}}
+            b.dump(root / 'K01/source/api-docs.json', original)
+            with self.assertRaisesRegex(ValueError, 'Original spec embedded'):
