+        (source / '.git').mkdir()
+        (source / '.git/config').write_text('not copied')
+        original = {'swagger': '2.0', 'info': {'title': sut, 'version': '1'}, 'paths': {}}
+        exchanges = []
+        for n in range(16):
+            path = f'/op{n}'
+            original['paths'][path] = {'get': {
