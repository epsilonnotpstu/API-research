"""Read one EMB fixed Authorization header at runtime, never include values in errors."""
from pathlib import Path
import sys

import yaml


def main():
    try:
        config = yaml.safe_load(Path(sys.argv[1]).read_text(encoding="utf-8"))
        roles = [role for role in config["auth"] if role["name"] == sys.argv[2]]
        if len(roles) != 1:
            raise ValueError
        headers = roles[0]["fixedHeaders"]
        # This harness supports the fixed-header fixtures used by these SUTs only.
        if len(headers) != 1 or headers[0]["name"].lower() != "authorization":
            raise ValueError
        name, value = headers[0]["name"], headers[0]["value"]
        if not isinstance(value, str) or not value or any(c in name + value for c in "\r\n"):
            raise ValueError
    except Exception:
        raise SystemExit("Cannot load a single fixed Authorization header for the selected role") from None
    print(name + ": " + value)


if __name__ == "__main__":
    main()
"""Redact the runtime benchmark credential from streaming and saved artifacts."""
import os
from pathlib import Path
import sys


def secrets():
    header = os.environ.get('PILOT_AUTH_REDACT', '')
    value = header.partition(':')[2].strip()
    token = value.split(' ', 1)[-1]
    return sorted({s for s in (header, value, token) if s}, key=len, reverse=True)


def clean(data, needles):
    for needle in needles:
        data = data.replace(needle.encode(), b'<redacted>')
    return data


def main():
    needles = secrets()
    if len(sys.argv) == 1:
        for line in sys.stdin.buffer:
            sys.stdout.buffer.write(clean(line, needles))
            sys.stdout.buffer.flush()
        return
    directory = Path(sys.argv[1])
    for path in directory.rglob('*'):
        # Public role identifiers in provenance/configuration are not credentials.
        # Metadata contains role/source/digests only; config contains no header value.
        if not path.is_file() or path.suffix == '.exec' or path.name in {'sut-config.env', 'run.json'}:
            continue
        data = path.read_bytes()
        redacted = clean(data, needles)
        if redacted != data:
            path.write_bytes(redacted)


if __name__ == '__main__':
    main()
#!/usr/bin/env python3
"""Final (adjudicated) L1 per fingerprint for the three pilot SUTs -> final_labels_baseline_s1.csv + summary.
final = supervisor_L1 if set; else the agreed L1 (A == B); else PENDING."""
import csv
from collections import Counter
SHEETS = {'scout-api': 'batch2_adjudication.csv', 'swagger-petstore': 'swagger-petstore_adjudication.csv',
          'market': 'market_adjudication.csv', 'cwa-verification': 'cwa-verification_adjudication.csv'}
out, summ = [], {}
for sut, f in SHEETS.items():
    rows = list(csv.DictReader(open(f, newline='')))
    for r in rows:
        if r['supervisor_note'].startswith('PENDING'):
            fin, src = 'PENDING', 'pending'
        elif r['supervisor_L1']:
            fin, src = r['supervisor_L1'], 'supervisor' if 'applied by Claude' not in r['supervisor_note'] else 'rule-applied'
        elif r['L1_agree'] == 'True':
            fin, src = r['A_L1'], 'agreed'
        else:
            fin, src = 'PENDING', 'pending'
        out.append({'sut': sut, 'item_id': r['item_id'], 'method': r['method'], 'template': r['template'],
                    'kind': r['kind'], 'status': r['status'], 'occurrences': r['occurrences'],
                    'final_L1': fin, 'source': src, 'A_L1': r['A_L1'], 'B_L1': r['B_L1'], 'note': r['supervisor_note']})
    summ[sut] = Counter(o['final_L1'] for o in out if o['sut'] == sut)
with open('final_labels_baseline_s1.csv', 'w', newline='') as fh:
    w = csv.DictWriter(fh, fieldnames=list(out[0])); w.writeheader(); w.writerows(out)
labels = ['SPEC', 'SPEC_PARTIAL', 'IMPL', 'BOTH', 'TEST', 'UNDECIDABLE', 'PENDING']
print('| SUT | n | ' + ' | '.join(labels) + ' |')
print('|---' * (len(labels) + 2) + '|')
for sut, c in summ.items():
    print(f'| {sut} | {sum(c.values())} | ' + ' | '.join(str(c.get(l, 0)) for l in labels) + ' |')
tot = sum(summ.values(), Counter())
print(f'| **total** | {sum(tot.values())} | ' + ' | '.join(str(tot.get(l, 0)) for l in labels) + ' |')
print('source:', dict(Counter(o['source'] for o in out)))

