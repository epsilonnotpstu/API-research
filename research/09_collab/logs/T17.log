#!/usr/bin/env bash
set -euo pipefail
HERE=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
EXP=$(cd -- "$HERE/../.." && pwd)
[[ $# == 2 || $# == 4 ]] || { echo 'Usage: analyse_run.sh MUTATED_RUN BASELINE_RUN [--mode both|fresh|replay]' >&2; exit 2; }
run_dir=$(realpath -- "$1"); baseline=$(realpath -- "$2"); mode=both
if [[ $# == 4 ]]; then [[ $3 == --mode ]] || { echo 'Expected --mode' >&2; exit 2; }; mode=$4; fi
case $mode in both|fresh|replay) ;; *) echo 'Invalid analysis mode' >&2; exit 2;; esac
sut=$(/usr/bin/python3 -I -B -c 'import json,sys; print(json.load(open(sys.argv[1]))["sut"])' "$run_dir/run.json")
source "$HERE/common.sh"
load_sut "$sut"
# Validate before producing analysis; incomplete runs need a separate, manual audit.
/usr/bin/python3 -I -B - "$run_dir" "$baseline" "$EXP/tools" "$HERE" <<'PY'
import hashlib, json, pathlib, sys
run, base, tools, harness = map(pathlib.Path, sys.argv[1:])
r, b = (json.loads((p / 'run.json').read_text()) for p in (run, base))
if not (r['complete'] and b['complete'] and r['mode'] == 'mutated' and b['mode'] == 'baseline'):
    raise SystemExit('Need complete mutated and baseline runs; inspect run.json and logs')
for key in ('sut', 'sut_jar_sha256', 'emb_commit', 'source_sha256', 'base_path', 'auth',
            'max_examples', 'budget_seconds', 'seed', 'schemathesis_image', 'logger_max_body',
            'request_timeout_ms', 'hypothesis_phases', 'schema_checks', 'harness_version',
            'sut_service', 'sut_image', 'internal_port', 'auth_source', 'auth_source_sha256',
            'health_path', 'harness_sha256', 'emb_config_sha256',
            'jacoco_agent_sha256', 'jacoco_cli_sha256'):
    if r[key] != b[key]:
        raise SystemExit(f'Incompatible runs: {key}')
for key in ('schema-image', f'sut-{r["sut"]}-image', 'mitmproxy-image'):
    if r['images'][key]['id'] != b['images'][key]['id']:
        raise SystemExit(f'Image changed between runs: {key}')
if r['tool_sha256'] != b['tool_sha256']:
    raise SystemExit('Tool snapshots differ between runs')
for name, digest in r['tool_sha256'].items():
    path = tools / name
    if not path.is_file() or hashlib.sha256(path.read_bytes()).hexdigest() != digest:
        raise SystemExit(f'Current tool differs from collection: {name}')
for name, digest in r['harness_sha256'].items():
    path = harness / name
    if not path.is_file() or hashlib.sha256(path.read_bytes()).hexdigest() != digest:
        raise SystemExit(f'Current harness differs from collection: {name}')
for directory, meta in ((run, r), (base, b)):
    specs = list(directory.glob('spec.test.*'))
    if len(specs) != 1:
        raise SystemExit('Expected exactly one spec.test snapshot')
    for name in ('exchanges.jsonl', specs[0].name, 'generator-input.json', 'sut-config.env'):
        digest = hashlib.sha256((directory / name).read_bytes()).hexdigest()
        if digest != meta['file_sha256'].get(name):
            raise SystemExit(f'Artifact changed: {directory / name}')
manifest = run / 'manifest.json'
if hashlib.sha256(manifest.read_bytes()).hexdigest() != r['file_sha256'].get('manifest.json'):
    raise SystemExit('Manifest changed since collection')
PY
# -I excludes ambient paths; explicitly add only the trusted local tools directory.
pytool() {
    /usr/bin/python3 -I -B -c 'import runpy,sys; sys.path.insert(0,sys.argv.pop(1)); script=sys.argv.pop(1); sys.argv[0]=script; runpy.run_path(script,run_name="__main__")' \
        "$EXP/tools" "$EXP/tools/$1" "${@:2}"
}
# T10 must deliver --mode. Never silently fall back to the unsafe pre-T10 CLI.
pytool attribute.py --help > /dev/null
base_specs=("$baseline"/spec.test.*); mut_specs=("$run_dir"/spec.test.*)
[[ ${#base_specs[@]} == 1 && -f ${base_specs[0]} && ${#mut_specs[@]} == 1 && -f ${mut_specs[0]} ]] || exit 1
analysis="$run_dir/analysis-$mode"
mkdir "$analysis" # Refuse to overwrite earlier analysis.
pytool conformance.py "${base_specs[0]}" "$baseline/exchanges.jsonl" >"$analysis/baseline.violations.jsonl"
if [[ $mode == both || $mode == fresh ]]; then
    pytool conformance.py "${mut_specs[0]}" "$run_dir/exchanges.jsonl" >"$analysis/fresh.violations.jsonl"
    pytool attribute.py "$analysis/baseline.violations.jsonl" "$analysis/fresh.violations.jsonl" \
        "$run_dir/manifest.json" --mode fresh >"$analysis/fresh.attributed.csv"
fi
if [[ $mode == both || $mode == replay ]]; then
    pytool conformance.py "${mut_specs[0]}" "$baseline/exchanges.jsonl" >"$analysis/replay.violations.jsonl"
    pytool attribute.py "$analysis/baseline.violations.jsonl" "$analysis/replay.violations.jsonl" \
        "$run_dir/manifest.json" --mode replay >"$analysis/replay.attributed.csv"
fi
sha256sum "$EXP/tools/conformance.py" "$EXP/tools/attribute.py" "$EXP/tools/specmut.py" >"$analysis/tool-sha256.txt"
printf '%s\n' "baseline=$baseline" "mutated=$run_dir" "mode=$mode" >"$analysis/inputs.txt"
echo "Analysis: $analysis"
"""Write atomic, standard-library-only provenance for a pilot (called by run_pilot.sh)."""
import datetime
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() else None


def main():
    (run, emb, sut, source, mode, fault, severity, seed, budget, examples, image,
     project, started, phase, schema_rc, coverage_rc, cleanup_rc, harness_rc,
     health, base_path) = sys.argv[1:]
    run, emb = Path(run), Path(emb)
    commit = subprocess.check_output(['git', '-C', str(emb), 'rev-parse', 'HEAD'], text=True).strip()
    dirty = subprocess.check_output(['git', '-C', str(emb), 'status', '--porcelain'], text=True)
    images = {}
    for path in sorted(run.glob('*-image.json')):
        try:
            inspected = json.loads(path.read_text())[0]
            images[path.stem] = {'id': inspected['Id'], 'repo_digests': inspected.get('RepoDigests', []),
                                'repo_tags': inspected.get('RepoTags', [])}
        except (ValueError, IndexError, KeyError) as error:
            images[path.stem] = {'inspection_error': str(error)}
    files = {p.name: sha(p) for p in sorted(run.iterdir())
             if p.is_file() and p.name != 'run.json' and not p.name.endswith('.tmp')}
    data = {
        'run_id': run.name, 'sut': sut, 'source_spec': source,
        'source_sha256': sha(next(run.glob('spec.original.*'), Path(source))),
        'mode': mode, 'fault': fault, 'severity': int(severity), 'seed': int(seed),
        'budget_seconds': int(budget), 'max_examples': int(examples),
        'schemathesis_image': image, 'compose_project': project,
        'started_at': started, 'updated_at': datetime.datetime.now(datetime.timezone.utc).isoformat(),
        'finished_at': None if harness_rc == 'pending' else datetime.datetime.now(datetime.timezone.utc).isoformat(),
        'phase': phase, 'schemathesis_exit': schema_rc, 'coverage_exit': coverage_rc,
        'cleanup_exit': cleanup_rc, 'harness_exit': harness_rc,
        'complete': harness_rc == '0', 'emb_commit': commit, 'emb_status_porcelain': dirty,
        'health_path': health, 'base_path': base_path, 'auth': os.environ.get('PILOT_AUTH_ROLE', 'none (pilot assumption)'),
        'request_timeout_ms': int(os.environ.get('PILOT_REQUEST_TIMEOUT_MS', '10000')),
        'hypothesis_phases': os.environ.get('PILOT_HYPOTHESIS_PHASES', 'explicit,generate'),
        'schema_checks': os.environ['SCHEMA_CHECKS'],
        'harness_version': 2,
        'sut_service': os.environ['SUT_SERVICE'],
        'sut_image': os.environ['SUT_IMAGE'],
        'internal_port': int(os.environ['INTERNAL_PORT']),
        'auth_source': os.environ['PILOT_AUTH_SOURCE'],
        'auth_source_sha256': (sha(emb / os.environ['PILOT_AUTH_SOURCE'])
                               if os.environ['PILOT_AUTH_SOURCE'] not in ('none', 'runtime-override') else None),
        'logger_max_body': int(os.environ['MITM_MAX_BODY']),
        'host_port': os.environ['HOST_PORT'], 'jacoco_port': os.environ['JACOCO_PORT'],
        'sut_jar_sha256': sha(emb / 'dist' / f'{sut}-sut.jar'),
        'jacoco_agent_sha256': sha(emb / 'dist' / 'jacocoagent.jar'),
        'jacoco_cli_sha256': sha(emb / 'dist' / 'jacococli.jar'),
        'images': images, 'file_sha256': files,
        'tool_sha256': {p.name: sha(p) for p in sorted((emb.parent.parent / 'tools').glob('*.py'))},
        'harness_sha256': {str(p.relative_to(Path(__file__).parent)): sha(p)
                           for p in sorted(Path(__file__).parent.rglob('*'))
                           if p.is_file() and not any(part.startswith('.') for part in p.relative_to(Path(__file__).parent).parts)},
        'emb_config_sha256': {name: sha(emb / name) for name in
                              (os.environ['COMPOSE_FILE'], os.environ['DOCKERFILE'])},
        'limitations': ['fresh traffic is observational', 'fixed seed does not guarantee identical traffic',
                         'generator schema back edges are cut; conformance uses the original or mutated oracle',
                         'equal mutation operation sets do not imply equal generator and oracle constraints',
                         'transport-error and truncation coverage require review',
                         'locally built SUT may have only image ID, no registry digest'],
    }
    tmp = run / 'run.json.tmp'
    tmp.write_text(json.dumps(data, indent=2) + '\n')
    tmp.replace(run / 'run.json')


if __name__ == '__main__':
    main()
"""Standard-library regression tests; no generator, Docker, or SUT execution."""
import copy
import importlib.util
import json
from pathlib import Path
import unittest

HERE = Path(__file__).resolve().parent
MODULE_SPEC = importlib.util.spec_from_file_location("derecurse_v2", HERE / "derecurse.py")
MODULE = importlib.util.module_from_spec(MODULE_SPEC)
MODULE_SPEC.loader.exec_module(MODULE)
derecurse = MODULE.derecurse


def schema_spec(group, oas3=False):
    header = {"openapi": "3.0.4", "components": {"schemas": group}} if oas3 else {
        "swagger": "2.0", "definitions": group}
    header["paths"] = {"/things": {"get": {"responses": {"200": {"description": "OK"}}}}}
    return header


class DerecurseTests(unittest.TestCase):
    def assert_stable(self, original, expected_cuts):
        snapshot = copy.deepcopy(original)
        output, cuts = derecurse(original)
        self.assertEqual(original, snapshot, "caller document was modified")
        self.assertEqual(len(cuts), expected_cuts)
        self.assertEqual(output["paths"], original["paths"])
        again, again_cuts = derecurse(output)
        self.assertEqual(again, output)
        self.assertEqual(again_cuts, [], "a supported cycle remains")
        self.assertEqual(derecurse(original), (output, cuts), "nondeterministic output")
        return output, cuts

    def test_swagger_self_cycle(self):
        source = schema_spec({"Node": {"type": "object", "properties": {
            "next": {"$ref": "#/definitions/Node"}}}})
        output, cuts = self.assert_stable(source, 1)
        self.assertEqual(cuts[0]["in"], "#/definitions/Node/properties/next")
        self.assertEqual(output["definitions"]["Node"]["properties"]["next"], {
            "type": "object", "x-derecursed-from": "#/definitions/Node"})

    def test_oas3_mutual_cycle(self):
        output, cuts = self.assert_stable(schema_spec({
            "A": {"properties": {"b": {"$ref": "#/components/schemas/B"}}},
            "B": {"properties": {"a": {"$ref": "#/components/schemas/A"}}},
        }, True), 1)
        self.assertEqual(cuts[0]["ref"], "#/components/schemas/A")
        self.assertEqual(output["components"]["schemas"]["A"]["properties"]["b"], {
            "$ref": "#/components/schemas/B"})

    def test_three_node_cycle_in_array_and_composition(self):
        self.assert_stable(schema_spec({
            "A": {"allOf": [{"$ref": "#/components/schemas/B"}]},
            "B": {"type": "array", "items": {"$ref": "#/components/schemas/C"}},
            "C": {"additionalProperties": {"$ref": "#/components/schemas/A"}},
        }, True), 1)

    def test_acyclic_shared_reference_is_unchanged(self):
        source = schema_spec({
            "A": {"allOf": [{"$ref": "#/definitions/Leaf"}, {"$ref": "#/definitions/Leaf"}]},
            "B": {"$ref": "#/definitions/Leaf"}, "Leaf": {"type": "string"},
        })
        output, _ = self.assert_stable(source, 0)
        self.assertEqual(output, source)

    def test_escaped_schema_names(self):
        _, cuts = self.assert_stable(schema_spec({"A/B~C": {"$ref": "#/components/schemas/A~1B~0C"}}, True), 1)
        self.assertEqual(cuts[0]["in"], "#/components/schemas/A~1B~0C")

    def test_both_schema_namespaces_are_processed(self):
        source = schema_spec({"Node": {"$ref": "#/definitions/Node"}}, True)
        source["definitions"] = {"Node": {"$ref": "#/definitions/Node"}}
        # The OAS schema points across namespaces; only the real back edge is cut.
        output, _ = self.assert_stable(source, 1)
        self.assertEqual(output["components"]["schemas"]["Node"], {"$ref": "#/definitions/Node"})

    def test_equal_basenames_do_not_alias(self):
        source = schema_spec({"Node": {"properties": {
            "parameter": {"$ref": "#/components/parameters/Node"}}}}, True)
        source["components"]["parameters"] = {"Node": {"name": "q", "in": "query"}}
        self.assertEqual(self.assert_stable(source, 0)[0], source)

    def test_independent_cycles_in_both_namespaces(self):
        source = schema_spec({"Node": {"$ref": "#/components/schemas/Node"}}, True)
        source["definitions"] = {"Node": {"$ref": "#/definitions/Node"}}
        self.assert_stable(source, 2)

    def test_external_and_dangling_refs_are_untouched(self):
        source = schema_spec({"Node": {"allOf": [
            {"$ref": "other.json#/definitions/Node"}, {"$ref": "#/definitions/Absent"}]}})
        self.assertEqual(self.assert_stable(source, 0)[0], source)

    def test_schema_ref_siblings_are_walked(self):
        source = schema_spec({"A": {"$ref": "#/components/schemas/B", "properties": {
            "next": {"$ref": "#/components/schemas/A"}}}, "B": {"type": "object"}}, True)
        _, cuts = self.assert_stable(source, 1)
        self.assertEqual(cuts[0]["in"], "#/components/schemas/A/properties/next")

    def test_independent_cycles(self):
        self.assert_stable(schema_spec({
            "A": {"$ref": "#/definitions/A"}, "B": {"$ref": "#/definitions/B"}}), 2)

    def test_spec_without_schema_components(self):
        source = {"openapi": "3.0.4", "paths": {}}
        self.assertEqual(self.assert_stable(source, 0)[0], source)

    def test_actual_sut_documents_static_transform(self):
        emb = HERE.parents[1] / "_external" / "emb"
        for sut in ("scout-api", "swagger-petstore", "market"):
            with self.subTest(sut=sut):
                source = json.loads((emb / "openapi-swagger" / f"{sut}.json").read_text())
                output, cuts = derecurse(source)
                self.assert_stable(source, len(cuts))
                self.assertEqual(output["paths"], source["paths"])
                if sut == "scout-api":
                    self.assertGreater(len(cuts), 0, "scout regression fixture lost its cycles")


if __name__ == "__main__":
    unittest.main(verbosity=2)

