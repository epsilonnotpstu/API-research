    71	    if (enabled) {
    72	      return new ApacheHttpClient(
    73	        HttpClientBuilder
    74	          .create()
    75	          .setSSLContext(getSslContext())
    76	          .setSSLHostnameVerifier(getSslHostnameVerifier())
    77	          .build()
    78	      );
    79	    }
    80	    return new ApacheHttpClient(HttpClientBuilder.create()
    81	      .setSSLHostnameVerifier(getSslHostnameVerifier())
    82	      .build());
    83	  }
