    85	  private SSLContext getSslContext() {
    86	    try {
    87	      SSLContextBuilder builder = SSLContextBuilder
    88	        .create();
    89	      if (oneWay) {
    90	        builder.loadTrustMaterial(ResourceUtils.getFile(trustStorePath),
    91	          trustStorePassword);
    92	      }
    93	      if (twoWay) {
    94	        builder.loadKeyMaterial(ResourceUtils.getFile(keyStorePath),
    95	          keyStorePassword,
    96	          keyStorePassword);
    97	      }
    98	      return builder.build();
    99	    } catch (IOException | GeneralSecurityException e) {
   100	      throw new VerificationServerException(HttpStatus.INTERNAL_SERVER_ERROR, "The SSL context could not be loaded.");
   101	    }
   102	  }
