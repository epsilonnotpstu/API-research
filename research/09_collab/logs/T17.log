   108	   */
   109	  public boolean validateToken(final String token, final PublicKey publicKey, List<AuthorizationRole> mandatoryRoles) {
   110	    log.debug("process validateToken() by - token: {} PK: {}", token, publicKey);
   111	    if (null != publicKey) {
