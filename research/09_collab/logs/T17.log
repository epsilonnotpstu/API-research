    61	@Validated
    62	@Profile("internal")
    63	public class InternalTanController {
    64	
    65	  /**
    66	   * The route to the tan verification endpoint.
    67	   */
    68	  public static final String TAN_VERIFY_ROUTE = "/tan/verify";
    69	  /**
    70	   * The route to the teleTAN generation endpoint.
    71	   */
    72	  public static final String TELE_TAN_ROUTE = "/tan/teletan";
    73	
    74	  public static final String TELE_TAN_TYPE_HEADER = "X-CWA-TELETAN-TYPE";
    75	
    76	  @NonNull
    77	  private final TanService tanService;
    78	
    79	  @NonNull
    80	  private final JwtService jwtService;
    81	
    82	  /**
    83	   * This provided REST method verifies the transaction number (TAN).
    84	   *
    85	   * @param tan - the transaction number, which needs to be verified {@link Tan}
    86	   * @return HTTP 200, if the verification was successful. Otherwise HTTP 404.
    87	   */
    88	  @Operation(
    89	    summary = "Verify provided Tan",
    90	    description = "The provided Tan is verified to be formerly issued by the verification server"
    91	  )
    92	  @ApiResponses(value = {
    93	    @ApiResponse(
    94	      responseCode = "200",
    95	      description = "Tan is valid an formerly issued by the verification server",
    96	      headers = {
    97	        @Header(name = TELE_TAN_TYPE_HEADER, description = "Type of the TeleTan (TEST or EVENT)")
    98	      }),
    99	    @ApiResponse(responseCode = "404", description = "Tan could not be verified")})
   100	  @PostMapping(value = TAN_VERIFY_ROUTE,
   101	    consumes = MediaType.APPLICATION_JSON_VALUE
   102	  )
   103	  public ResponseEntity<?> verifyTan(@Valid @RequestBody Tan tan) {
   104	    return tanService.getEntityByTan(tan.getTan())
   105	      .filter(t -> t.canBeRedeemed(LocalDateTime.now()))
   106	      .map(t -> {
   107	        tanService.deleteTan(t);
   108	        log.info("The Tan is valid.");
   109	        return t;
   110	      })
   111	      .map(t -> {
   112	        ResponseEntity.BodyBuilder responseBuilder = ResponseEntity.ok();
   113	
   114	        if (t.getTeleTanType() != null) {
   115	          responseBuilder.header(TELE_TAN_TYPE_HEADER, t.getTeleTanType().toString());
   116	        }
   117	
   118	        return responseBuilder.build();
   119	      })
   120	      .orElseGet(() -> {
   121	        log.info("The Tan is invalid.");
   122	        throw new VerificationServerException(HttpStatus.NOT_FOUND, "No Tan found or Tan is invalid");
   123	      });
   124	  }
   125	
   126	  /**
   127	   * This method generates a valid teleTAN.
   128	   *
   129	   * @param authorization auth
   130	   * @return a created teletan
   131	   */
   132	  @Operation(
   133	    summary = "Request generation of a teleTAN",
   134	    description = "A teleTAN is a human readable TAN with 7 characters which is supposed to be issued via call line"
   135	  )
   136	  @ApiResponses(value = {
   137	    @ApiResponse(responseCode = "201", description = "TeleTan created")})
   138	  @PostMapping(value = TELE_TAN_ROUTE,
   139	    produces = MediaType.APPLICATION_JSON_VALUE
   140	  )
   141	  public ResponseEntity<TeleTan> createTeleTan(
   142	    @RequestHeader(JwtService.HEADER_NAME_AUTHORIZATION) @Valid AuthorizationToken authorization,
   143	    @RequestHeader(value = TELE_TAN_TYPE_HEADER, required = false) @Valid TeleTanType teleTanType) {
   144	
   145	    List<AuthorizationRole> requiredRoles = new ArrayList<>();
   146	
   147	    if (teleTanType == null) {
   148	      teleTanType = TeleTanType.TEST;
   149	      requiredRoles.add(AuthorizationRole.AUTH_C19_HOTLINE);
   150	    } else if (teleTanType == TeleTanType.EVENT) {
   151	      requiredRoles.add(AuthorizationRole.AUTH_C19_HOTLINE_EVENT);
   152	    }
   153	
   154	    if (jwtService.isAuthorized(authorization.getToken(), requiredRoles)) {
   155	      if (tanService.isTeleTanRateLimitNotExceeded()) {
   156	        String teleTan = tanService.generateVerificationTeleTan(teleTanType);
   157	        log.info("The teleTAN is generated.");
   158	        return ResponseEntity.status(HttpStatus.CREATED).body(new TeleTan(teleTan));
   159	      } else {
   160	        throw new VerificationServerException(HttpStatus.TOO_MANY_REQUESTS, "Rate Limit exceed. Try again later.");
   161	      }
   162	    }
   163	    throw new VerificationServerException(HttpStatus.UNAUTHORIZED, "JWT is invalid.");
   164	  }
   165	
   166	}
