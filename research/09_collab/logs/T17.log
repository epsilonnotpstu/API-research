    89	  public boolean isAuthorized(String authorizationToken, List<AuthorizationRole> mandatoryRoles) {
    90	    // check if the JWT is enabled
    91	    if (!verificationApplicationConfig.getJwt().getEnabled()) {
    92	      return true;
    93	    }
    94	    if (null != authorizationToken && authorizationToken.startsWith(TOKEN_PREFIX)) {
    95	      String jwtToken = authorizationToken.substring(TOKEN_PREFIX.length());
    96	      return validateToken(jwtToken, getPublicKey(), mandatoryRoles);
