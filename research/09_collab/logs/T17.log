    42	/**
    43	 * This class represents the rest controller for requests regarding test states.
    44	 */
    45	@Slf4j
    46	@RequiredArgsConstructor
    47	@RestController
    48	@RequestMapping("/version/v1")
    49	@Validated
    50	@Profile("external")
    51	public class ExternalTestStateController {
    52	
    53	  /**
    54	   * The route to the test status of the COVID-19 test endpoint.
    55	   */
    56	  public static final String TESTRESULT_ROUTE = "/testresult";
    57	
    58	  public static final Integer RESPONSE_PADDING_LENGTH = 45;
    59	
    60	  private final ScheduledExecutorService scheduledExecutor = Executors.newScheduledThreadPool(4);
    61	
    62	  private final FakeRequestService fakeRequestService;
    63	
    64	  private final AppSessionService appSessionService;
    65	
    66	  private final TestResultServerService testResultServerService;
    67	
    68	  private final FakeDelayService fakeDelayService;
    69	
    70	  private final VerificationApplicationConfig config;
    71	
    72	  /**
    73	   * Returns the test status of the COVID-19 test with cwa-fake header.
    74	   *
    75	   * @param registrationToken generated by a hashed guid {@link RegistrationToken}
    76	   * @param fake              flag for fake request
    77	   * @return result of the test, which can be POSITIVE, NEGATIVE, INVALID, PENDING, FAILED,
    78	   *     quick-test-POSITIVE, quick-test-NEGATIVE, quick-test-INVALID, quick-test-PENDING or quick-test-FAILED
    79	   *     will be POSITIVE for TeleTan
    80	   */
    81	  @Operation(
    82	    summary = "COVID-19 test result for given RegistrationToken",
    83	    description = "Gets the result of COVID-19 Test. "
    84	      + "If the RegistrationToken belongs to a TeleTan the result is always positive"
    85	  )
    86	  @ApiResponses(value = {
    87	    @ApiResponse(responseCode = "200", description = "Testresult retrieved"),
    88	    @ApiResponse(responseCode = "403", description = "TestResult of dob hash does not equal to TestResult of hash")
    89	  })
    90	  @PostMapping(value = TESTRESULT_ROUTE,
    91	    consumes = MediaType.APPLICATION_JSON_VALUE,
    92	    produces = MediaType.APPLICATION_JSON_VALUE
    93	  )
    94	  public DeferredResult<ResponseEntity<TestResult>> getTestState(
    95	    @Valid @RequestBody RegistrationToken registrationToken,
    96	    @RequestHeader(value = "cwa-fake", required = false) String fake) {
    97	    if ((fake != null) && (fake.equals("1"))) {
    98	      return fakeRequestService.getTestState(registrationToken);
    99	    }
   100	    StopWatch stopWatch = new StopWatch();
   101	    stopWatch.start();
   102	    Optional<VerificationAppSession> appSession =
   103	      appSessionService.getAppSessionByToken(registrationToken.getRegistrationToken());
   104	    if (appSession.isPresent()) {
   105	      AppSessionSourceOfTrust sourceOfTrust = appSession.get().getSourceOfTrust();
   106	      DeferredResult<ResponseEntity<TestResult>> deferredResult = new DeferredResult<>();
   107	
   108	      switch (sourceOfTrust) {
   109	        case HASHED_GUID:
   110	          HashedGuid hash = new HashedGuid(appSession.get().getHashedGuid());
   111	          TestResult testResult = testResultServerService.result(hash);
   112	          testResult.setResponsePadding(RandomStringUtils.randomAlphanumeric(RESPONSE_PADDING_LENGTH));
   113	
   114	          // Check DOB Hash if present
   115	          if (!config.isDisableDobHashCheckForExternalTestResult() && appSession.get().getHashedGuidDob() != null) {
   116	            HashedGuid hashDob = new HashedGuid(appSession.get().getHashedGuidDob());
   117	            TestResult testResultDob = testResultServerService.result(hashDob);
   118	
   119	            // TRS will always respond with a TestResult so we have to check if both results are equal
   120	            if (testResultDob.getTestResult() != testResult.getTestResult()) {
   121	              // given DOB Hash is invalid
   122	              throw new VerificationServerException(HttpStatus.FORBIDDEN,
   123	                "TestResult of dob hash does not equal to TestResult of hash");
   124	            }
   125	          }
   126	
   127	          log.debug("Result {}", testResult);
   128	          log.info("The result for registration token based on hashed Guid will be returned.");
   129	          stopWatch.stop();
   130	          fakeDelayService.updateFakeTestRequestDelay(stopWatch.getTotalTimeMillis());
   131	          deferredResult.setResult(ResponseEntity.ok(generateReturnTestResult(testResult.getTestResult(),
   132	            testResult.getSc(), testResult.getLabId())));
   133	          return deferredResult;
   134	        case TELETAN:
   135	          log.info("The result for registration token based on teleTAN will be returned.");
   136	          stopWatch.stop();
   137	          fakeDelayService.updateFakeTestRequestDelay(stopWatch.getTotalTimeMillis());
   138	          scheduledExecutor.schedule(() -> deferredResult.setResult(ResponseEntity.ok(
   139	            generateReturnTestResult(LabTestResult.POSITIVE.getTestResult(),
   140	              appSession.get().getCreatedAt().toEpochSecond(ZoneOffset.UTC), null))),
   141	            fakeDelayService.realDelayTest(), MILLISECONDS);
   142	          return deferredResult;
   143	        default:
   144	          stopWatch.stop();
   145	          throw new VerificationServerException(HttpStatus.BAD_REQUEST,
   146	            "Unknown source of trust inside the appsession for the registration token");
   147	      }
   148	    }
   149	    log.info("The registration token doesn't exist.");
   150	    throw new VerificationServerException(HttpStatus.BAD_REQUEST,
   151	      "Returning the test result for the registration token failed");
   152	  }
   153	
   154	  private TestResult generateReturnTestResult(Integer testResult, Long sc, String labId) {
   155	    return new TestResult(testResult,sc, labId, RandomStringUtils.randomAlphanumeric(RESPONSE_PADDING_LENGTH));
   156	  }
   157	}
