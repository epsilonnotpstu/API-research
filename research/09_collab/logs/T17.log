    cp "$source_jar" "$stage/$SUT_ID-sut.jar"
    mv "$stage/$SUT_ID-sut.jar" "$EMB/dist/$SUT_ID-sut.jar"
fi
echo "Ready: $EMB/dist (runtime agent + CLI pinned to 0.8.12)."

