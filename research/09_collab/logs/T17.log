    34	@EnableWebSecurity
    35	@Configuration
    36	public class SecurityConfig extends WebSecurityConfigurerAdapter {
    37	
    38	  @Bean
    39	  protected HttpFirewall strictFirewall() {
    40	    StrictHttpFirewall firewall = new StrictHttpFirewall();
    41	    firewall.setAllowedHttpMethods(Arrays.asList(
    42	      HttpMethod.GET.name(),
    43	      HttpMethod.POST.name(),
    44	      HttpMethod.HEAD.name()
    45	    ));
    46	    return firewall;
    47	  }
    48	
    49	  @Override
    50	  protected void configure(HttpSecurity http) throws Exception {
    51	    http
    52	      .authorizeRequests()
    53	      .mvcMatchers("/api/**").permitAll().and().requiresChannel().mvcMatchers("/api/**").requiresSecure().and()
    54	      .authorizeRequests()
    55	      .mvcMatchers("/version/**").permitAll()
    56	      .mvcMatchers("/actuator/**").permitAll()
    57	      .anyRequest().denyAll()
    58	      .and().csrf().disable();
    59	  }
    60	
    61	}
