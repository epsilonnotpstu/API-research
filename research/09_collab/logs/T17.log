   163	   * Get the certificate from IAM client.
   164	   * As long as Keycloak can rotate it’s keys we decided to reload 
   165	   * the key on every validateToken call especially the method call 
   166	   * is fortunately limited in time and number too.
   167	   *
   168	   * @return the calculated Public key from the certificate
   169	   */
   170	  public PublicKey getPublicKey() {
   171	    Certs certs = iamClient.certs();
   172	    log.debug("process getPublicKey() - cert info from IAM certs: {}", certs);
   173	    for (Key key : certs.getKeys()) {
   174	      if (key.isCertValid()) {
   175	        String certb64 = key.getX5c().get(0);
   176	        String wrappedCert = BEGIN_CERT + System.lineSeparator() + certb64 + System.lineSeparator() + END_CERT;
   177	        try {
   178	          byte[] certBytes = wrappedCert.getBytes(java.nio.charset.StandardCharsets.UTF_8);
   179	          CertificateFactory certFactory = CertificateFactory.getInstance("X.509");
   180	          InputStream in = new ByteArrayInputStream(certBytes);
   181	          X509Certificate certificate = (X509Certificate) certFactory.generateCertificate(in);
   182	          return certificate.getPublicKey();
   183	        } catch (CertificateException ex) {
   184	          log.warn("Error generate certificate: {}.", ex.getMessage());
   185	        }
   186	      } else {
   187	        log.warn("Wrong use or alg key given! use: {} alg: {}", key.getUse(), key.getAlg());
   188	        log.warn("Keys use: {} and alg: {} are expected!", Key.SIG, Key.RS256);
   189	      }
   190	    }
   191	    return null;
   192	  }
