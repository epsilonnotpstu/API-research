   189	schema_cmd=(run "/work/$(basename "$test_spec")" --base-url "http://mitmproxy:8080$BASE_PATH" \
   190	    --checks "$SCHEMA_CHECKS" --hypothesis-seed "$seed" --hypothesis-max-examples "$MAX_EXAMPLES" \
   191	    --junit-xml /work/schemathesis.junit.xml --cassette-path /work/schemathesis-cassette.yaml \
   192	    --request-timeout "$REQUEST_TIMEOUT_MS" --hypothesis-phases "$PILOT_HYPOTHESIS_PHASES" --sanitize-output true)
   193	# DATA_GEN (positive|negative|all): unset keeps the argv of earlier batches (Schemathesis default = positive).
   194	# REQUEST_LOOSE can only show an effect if traffic violates the loosened constraint, i.e. with negative data.
   195	if [[ -n ${DATA_GEN:-} ]]; then
   196	    [[ $DATA_GEN =~ ^(positive|negative|all)$ ]] || { echo 'Invalid DATA_GEN' >&2; exit 2; }
   197	    schema_cmd+=(--data-generation-method "$DATA_GEN")
   198	fi
   199	# mount the run directory, so the input and every output remain in this run.
   200	# Generator input only: cut recursive $ref back-edges (hypothesis-jsonschema stalls on them).
   201	# Conformance analysis keeps using spec.test.* (the untouched original or mutated spec).
   202	if [[ $mode == mutated ]]; then
   203	    # specmut inlines $refs into mutated operations, which would unroll recursive schemas again.
   204	    # So: de-recurse the ORIGINAL first, then apply the same mutation (same fault/severity/seed
   205	    # => same operations selected) to obtain the generator input.
   206	    /usr/bin/python3 -I -B "$HERE/derecurse.py" "$original_spec" "$run_dir/spec.derecursed.json" >"$run_dir/derecurse-cuts.json"
   207	    /usr/bin/python3 -I -B "$TOOLS_DIR/specmut.py" "$run_dir/spec.derecursed.json" --fault "$fault" --severity "$severity" \
   208	        --seed "$seed" "${only_args[@]}" --out "$run_dir/mutation_gen" >"$run_dir/specmut_gen.log" 2>&1
   209	    gen=("$run_dir"/mutation_gen/*.manifest.json)
   210	    [[ ${#gen[@]} == 1 ]] || { echo 'Expected one generator mutation manifest' >&2; exit 1; }
   211	    /usr/bin/python3 -I -B -c 'import json,sys; a,b=(json.load(open(p)) for p in sys.argv[1:3]); k=lambda m: sorted((x["path"],x["method"]) for x in m["mutations"]); sys.exit(0 if k(a)==k(b) else "Generator mutation selected different operations")' "$run_dir/manifest.json" "${gen[0]}"
   212	    cp "${gen[0]%.manifest.json}.json" "$run_dir/generator-input.json"
   213	else

