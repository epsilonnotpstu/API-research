    23	
    24	import java.io.IOException;
    25	import javax.servlet.FilterChain;
    26	import javax.servlet.ServletException;
    27	import javax.servlet.http.HttpServletRequest;
    28	import javax.servlet.http.HttpServletResponse;
    29	import liquibase.util.StringUtils;
    30	import lombok.NonNull;
    31	import lombok.RequiredArgsConstructor;
    32	import lombok.extern.slf4j.Slf4j;
    33	import org.apache.http.HttpHeaders;
    34	import org.springframework.http.HttpStatus;
    35	import org.springframework.stereotype.Component;
    36	import org.springframework.web.filter.OncePerRequestFilter;
    37	
    38	/**
    39	 * A filter to avoid requests with a large content and chunked requests.
    40	 */
    41	@Component
    42	@Slf4j
    43	@RequiredArgsConstructor
    44	public class RequestSizeLimitFilter extends OncePerRequestFilter {
    45	
    46	  @NonNull
    47	  private final VerificationApplicationConfig verificationApplicationConfig;
    48	
    49	  @Override
    50	  protected void doFilterInternal(HttpServletRequest request,
    51	                                  HttpServletResponse response, FilterChain filterChain)
    52	    throws ServletException, IOException {
    53	    long maxPostSize = verificationApplicationConfig.getRequest().getSizelimit();
    54	    if (request.getContentLengthLong() > maxPostSize || isChunkedRequest(request)) {
    55	      log.warn("The request size is too large or the request was sent via chunks.");
    56	      response.setStatus(HttpStatus.NOT_ACCEPTABLE.value());
    57	      return;
    58	    }
    59	    filterChain.doFilter(request, response);
    60	  }
    61	
    62	  private boolean isChunkedRequest(HttpServletRequest request) {
    63	    String header = request.getHeader(HttpHeaders.TRANSFER_ENCODING);
    64	
    65	    return !StringUtils.isEmpty(header) && header.equalsIgnoreCase("chunked");
    66	  }
    67	
    68	}
