    76	  private final TanService tanService;
    77	
    78	  @NonNull
    79	  private final FakeRequestService fakeRequestService;
    80	
    81	  /**
    82	   * This method generates a transaction number by a Registration Token, if the state of the COVID-19 lab-test is
    83	   * positive.
    84	   *
    85	   * @param registrationToken generated by a hashed guid or a teleTAN. {@link RegistrationToken}
    86	   * @param fake              flag for fake request
    87	   * @return A generated transaction number {@link Tan}.
    88	   */
    89	  @Operation(
    90	    summary = "Generates a Tan",
    91	    description = "Generates a TAN on input of Registration Token. With the TAN one can submit his Diagnosis keys"
    92	  )
    93	  @ApiResponses(value = {
    94	    @ApiResponse(responseCode = "201", description = "Registration Token is valid"),
    95	    @ApiResponse(responseCode = "400", description = "Registration Token does not exist")})
    96	  @PostMapping(value = TAN_ROUTE,
    97	    consumes = MediaType.APPLICATION_JSON_VALUE,
    98	    produces = MediaType.APPLICATION_JSON_VALUE
    99	  )
   100	  public DeferredResult<ResponseEntity<Tan>> generateTan(@Valid @RequestBody RegistrationToken registrationToken,
   101	                                                         @RequestHeader(value = "cwa-fake", required = false)
   102	                                                           String fake) {
   103	    if ((fake != null) && (fake.equals("1"))) {
   104	      return fakeRequestService.generateTan(registrationToken);
   105	    }
   106	    StopWatch stopWatch = new StopWatch();
   107	    stopWatch.start();
   108	    Optional<VerificationAppSession> actual
   109	      = appSessionService.getAppSessionByToken(registrationToken.getRegistrationToken());
   110	    if (actual.isPresent()) {
   111	      VerificationAppSession appSession = actual.get();
   112	      int tancountermax = verificationApplicationConfig.getAppsession().getTancountermax();
   113	      if (appSession.getTanCounter() < tancountermax) {
   114	        AppSessionSourceOfTrust appSessionSourceOfTrust = appSession.getSourceOfTrust();
   115	        TanSourceOfTrust tanSourceOfTrust = TanSourceOfTrust.CONNECTED_LAB;
   116	        switch (appSessionSourceOfTrust) {
   117	          case HASHED_GUID:
   118	            TestResult covidTestResult = testResultServerService.result(new HashedGuid(appSession.getHashedGuid()));
   119	            if (covidTestResult.getTestResult() != LabTestResult.POSITIVE.getTestResult()
   120	              && covidTestResult.getTestResult() != LabTestResult.QUICK_POSITIVE.getTestResult()
   121	            ) {
   122	              stopWatch.stop();
   123	              throw new VerificationServerException(HttpStatus.BAD_REQUEST,
   124	                "Tan cannot be created, caused by the non positive result of the labserver");
   125	            }
   126	            break;
   127	          case TELETAN:
   128	            tanSourceOfTrust = TanSourceOfTrust.TELETAN;
   129	            break;
   130	          default:
   131	            stopWatch.stop();
   132	            throw new VerificationServerException(HttpStatus.BAD_REQUEST,
   133	              "Unknown source of trust inside the appsession for the registration token");
   134	        }
   135	        appSession.incrementTanCounter();
   136	        appSession.setUpdatedAt(LocalDateTime.now());
   137	
   138	        appSessionService.saveAppSession(appSession);
   139	        String generatedTan = tanService.generateVerificationTan(tanSourceOfTrust, appSession.getTeleTanType());
   140	
   141	        Tan returnTan = generateReturnTan(generatedTan, fake);
   142	        stopWatch.stop();
   143	        fakeDelayService.updateFakeTanRequestDelay(stopWatch.getTotalTimeMillis());
   144	        DeferredResult<ResponseEntity<Tan>> deferredResult = new DeferredResult<>();
   145	        scheduledExecutor.schedule(() -> deferredResult.setResult(
   146	            ResponseEntity.status(HttpStatus.CREATED).body(returnTan)),
   147	          fakeDelayService.realDelayTan(), MILLISECONDS);
   148	        log.info("Returning the successfully generated tan.");
   149	        return deferredResult;
   150	      }
   151	      throw new VerificationServerException(HttpStatus.BAD_REQUEST,
   152	        "The maximum of generating tans for this registration token is reached");
   153	    }
   154	    throw new VerificationServerException(HttpStatus.BAD_REQUEST,
   155	      "VerificationAppSession not found for the registration token");
   156	  }
   157	
   158	  private Tan generateReturnTan(String tan, String fake) {
   159	    if (fake == null) {
   160	      return new Tan(tan);
   161	    }
   162	    return new Tan(tan, RandomStringUtils.randomAlphanumeric(RESPONSE_PADDING_LENGTH));
   163	  }
   164	
   165	}
