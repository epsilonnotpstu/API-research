   143	    Map<String, List<String>> realm = getRealmFromToken(token, publicKey);
   144	    return realm.getOrDefault(ROLES, new ArrayList<>());
   145	  }
   146	
   147	  @SuppressWarnings("unchecked")
   148	  private Map<String, List<String>> getRealmFromToken(final String token, final PublicKey publicKey) {
   149	    final Claims claims = getAllClaimsFromToken(token, publicKey);
   150	    return claims.get(REALM_ACCESS, Map.class);
   151	  }
   152	
   153	  public <T> T getClaimFromToken(final String token, Function<Claims, T> claimsResolver, final PublicKey publicKey) {
   154	    final Claims claims = getAllClaimsFromToken(token, publicKey);
   155	    return claimsResolver.apply(claims);
   156	  }
