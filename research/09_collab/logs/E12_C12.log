1049: // listScanTasks returns the tasks of the reports
1050: func (bc *basicController) listScanTasks(ctx context.Context, reportUUIDs []string) ([]*task.Task, error) {
1051: 	if len(reportUUIDs) == 0 {
1052: 		return nil, nil
1053: 	}
1054: 
1055: 	tasks := make([]*task.Task, len(reportUUIDs))
1056: 	errs := make([]error, len(reportUUIDs))
1057: 
1058: 	var wg sync.WaitGroup
1059: 	for i, reportUUID := range reportUUIDs {
1060: 		wg.Add(1)
1061: 
1062: 		go func(ix int, reportUUID string) {
1063: 			defer wg.Done()
1064: 
1065: 			task, err := bc.getScanTask(bc.cloneCtx(ctx), reportUUID)
1066: 			if err == nil {
1067: 				tasks[ix] = task
1068: 			} else if !errors.IsNotFoundErr(err) {
1069: 				errs[ix] = err
1070: 			} else {
1071: 				log.G(ctx).Warningf("task for the scan report %s not found", reportUUID)
1072: 			}
1073: 		}(i, reportUUID)
1074: 	}
1075: 	wg.Wait()
1076: 
1077: 	for _, err := range errs {
1078: 		if err != nil {
1079: 			return nil, err
1080: 		}
1081: 	}
1082: 
1083: 	var results []*task.Task
1084: 	for _, task := range tasks {
1085: 		if task != nil {
1086: 			results = append(results, task)
1087: 		}
1088: 	}
1089: 
1090: 	return results, nil
1091: }
1092: 
1093: func (bc *basicController) getScanTask(ctx context.Context, reportUUID string) (*task.Task, error) {
