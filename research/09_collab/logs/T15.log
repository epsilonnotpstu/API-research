   188	    private String saveBodyPartAsFile(BodyPart bodyPart) throws IOException {
   189	        String relativeLocalPath = getLocalFileName(bodyPart.getMediaType().toString());
   190	        InputStream stream = bodyPart.getEntityAs(InputStream.class);
   191	        Files.copy(stream, new File(mediaFilesFolder, relativeLocalPath).toPath());
   192	        stream.close();
   193	        return relativeLocalPath;
