@@ -0,0 +1,50 @@
+"""Join HTTP error IDs to saved stack traces without executing the SUT."""
+import collections
+import json
+from pathlib import Path
+import re
+
+OUT = Path(__file__).resolve().parent
+ROOT = OUT.parents[2]
+RUN = ROOT / '08_experiments/E1_pilot/runs/scout-api/20261113T202103Z_baseline_NONE_p0_s1_1642810'
+# Count physical LF-delimited lines, matching rg/nl; generated Unicode/control
+# characters in logged request data must not create artificial line numbers.
+logs = (RUN / 'compose.log').read_bytes().decode('utf-8').split('\n')
+starts = {}
+for n, line in enumerate(logs, 1):
+    match = re.search(r'Error handling a request: ([0-9a-f]+)', line)
+    if match:
+        starts[match[1]] = n
+records = []
+for item in json.loads((OUT / 'exchange_map.json').read_text()):
+    errors = []
+    grouped = collections.defaultdict(list)
+    for sample in item['response_signatures']:
+        match = re.search(r'logged \(ID ([0-9a-f]+)\)', sample['response_error'].get('message', ''))
+        if not match:
+            continue
+        start = starts[match[1]]
+        stack = []
+        for n in range(start, min(start + 130, len(logs))):
+            line = logs[n]
+            if 'sut-scout-api-1' not in line:
+                continue
+            if ' | ! ' not in line:
+                break
+            stack.append((n + 1, line.split(' | ! ', 1)[1]))
+        exceptions = [(n, line) for n, line in stack if not line.startswith('at ') and not line.startswith('...')]
+        frames = [(n, line) for n, line in stack if 'at se.devscout.' in line]
+        key = ' / '.join([e[1] for e in exceptions[:2]] + [f[1] for f in frames[:2]])
+        grouped[key].append(sample['line'])
+        errors.append({'exchange_line': sample['line'], 'log_line': start,
+                       'exceptions': exceptions, 'project_frames': frames})
+    if errors:
+        records.append({'item_id': item['item_id'], 'errors': errors,
+                        'groups': [{'signature': sig, 'count': len(lines), 'exchange_lines': lines}
+                                   for sig, lines in grouped.items()]})
+(OUT / 'log_map.json').write_text(json.dumps(records, indent=2, ensure_ascii=True) + '\n')
+for item in records:
+    print(item['item_id'], 'error IDs', len(item['errors']), 'types', len(item['groups']))
+    for g in item['groups']:
+        e = next(e for e in item['errors'] if e['exchange_line'] == g['exchange_lines'][0])
+        print(' ',g['count'],'EX',e['exchange_line'],'LOG',e['log_line'],ascii(g['signature'])[:450])
diff --git a/research/09_collab/logs/T15_scratch/map_evidence.py b/research/09_collab/logs/T15_scratch/map_evidence.py
new file mode 100644
index 0000000000000000000000000000000000000000..ca9498e632fa9379e87b2eab3a59890531e2f057
--- /dev/null
+++ b/research/09_collab/logs/T15_scratch/map_evidence.py
@@ -0,0 +1,68 @@
+"""Replay only the project's checker; never load labeller A's artifacts."""
+import collections
+import csv
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).resolve().parents[3]
+OUT = Path(__file__).resolve().parent
+RUN = ROOT / '08_experiments/E1_pilot/runs/scout-api/20261113T202103Z_baseline_NONE_p0_s1_1642810'
+sys.path.insert(0, str(ROOT / '08_experiments/tools'))
+import conformance
+
+items = list(csv.DictReader((ROOT / '08_experiments/E2_labelling/batch2_baseline_s1_blind.csv').open()))
+by_fp = {r['fingerprint']: r['item_id'] for r in items}
+spec = conformance.Spec(json.loads((RUN / 'spec.original.json').read_text()))
+matches = {r['item_id']: [] for r in items}
+signatures = collections.defaultdict(collections.Counter)
+examples = {}
+unknown = collections.Counter()
+exchange_count = 0
+for line, raw in enumerate((RUN / 'exchanges.jsonl').open(), 1):
+    exchange_count = line
+    x = json.loads(raw)
+    violations = conformance.check(spec, x)
+    req, resp = x['request'], x['response']
+    template, pp = spec.match(req['path'], req['method'], req.get('origin'))
+    op, params = spec.operation(template, req['method']) if template else (None, [])
+    rp = conformance.request_problems(spec, params, op, x, pp) if op else []
+    try:
+        rb = json.loads(resp['body']['text'])
+    except (ValueError, KeyError):
+        rb = {}
+    # Successful bodies can contain identity information; do not record them.
+    error = {k: rb[k] for k in ('code', 'message', 'errors') if k in rb} if isinstance(rb, dict) and int(resp['status']) >= 400 else {}
+    signature = json.dumps(error, ensure_ascii=True, sort_keys=True)
+    for v in violations:
+        item = by_fp.get(v['fingerprint'])
+        if not item:
+            unknown[v['fingerprint']] += 1
+            continue
+        matches[item].append(line)
+        signatures[item][signature] += 1
+        key = (item, signature)
+        if key not in examples:
+            examples[key] = {'line': line, 'request_path': req['path'], 'query': req.get('query'),
+                             'request_body_sha256': hashlib.sha256(req.get('body', {}).get('text', '').encode()).hexdigest(),
+                             'request_body_size': req.get('body', {}).get('size'),
+                             'request_problems': list(rp), 'request_uncheckable': getattr(rp, 'uncheckable', []),
+                             'response_error': error, 'timestamp': x.get('ts')}
+
+data = []
+for r in items:
+    item = r['item_id']
+    assert len(matches[item]) == int(r['occurrences']), (item, len(matches[item]), r['occurrences'])
+    data.append({'item_id': item, 'fingerprint': r['fingerprint'], 'exchange_lines': matches[item],
+                 'response_signatures': [{'count': count, **examples[(item, sig)]}
+                                         for sig, count in signatures[item].most_common()]})
+(OUT / 'exchange_map.json').write_text(json.dumps(data, indent=2, ensure_ascii=True) + '\n')
+summary = {'exchanges': exchange_count, 'items': len(items), 'matched_occurrences': sum(map(len, matches.values())),
+           'unmatched_fingerprints': dict(unknown), 'all_occurrence_counts_match': True}
+(OUT / 'replay_summary.json').write_text(json.dumps(summary, indent=2) + '\n')
+print(json.dumps(summary))
+for r, mapped in zip(items, data):
+    print(r['item_id'], r['kind'], r['method'], r['template'], r['status'], 'lines', mapped['exchange_lines'][:3])
+    for sig in mapped['response_signatures'][:8]:
+        print('  ', sig['count'], 'line', sig['line'], json.dumps(sig['response_error'], ensure_ascii=True)[:350])
diff --git a/research/09_collab/logs/T15_scratch/validate_outputs.py b/research/09_collab/logs/T15_scratch/validate_outputs.py
new file mode 100644
index 0000000000000000000000000000000000000000..8561ace683ffe60258bcedcc7638ba105cdeb9c1
--- /dev/null
+++ b/research/09_collab/logs/T15_scratch/validate_outputs.py
@@ -0,0 +1,113 @@
+"""Check output coverage, evidence locators, and case-level root memberships."""
+import collections
+import csv
+import hashlib
+import json
+from pathlib import Path
+import re
+
+OUT = Path(__file__).resolve().parent
+ROOT = OUT.parents[2]
+RUN = ROOT / '08_experiments/E1_pilot/runs/scout-api/20261113T202103Z_baseline_NONE_p0_s1_1642810'
+label_path = ROOT / '08_experiments/E2_labelling/batch2_baseline_s1_labels_codex.csv'
+root_path = ROOT / '08_experiments/E2_labelling/batch2_root_causes_codex.csv'
+with label_path.open(newline='') as f:
+    reader = csv.DictReader(f)
+    assert reader.fieldnames == ['item_id','L1','L2','proposed_L2','confidence','evidence_types','evidence_locators','root_cause_id','both_candidate','rationale']
+    labels = list(reader)
+with root_path.open(newline='') as f:
+    reader = csv.DictReader(f)
+    assert reader.fieldnames == ['root_cause_id','description','fix_site','items']
+    roots = list(reader)
+blind_path = ROOT / '08_experiments/E2_labelling/batch2_baseline_s1_blind.csv'
+items = list(csv.DictReader(blind_path.open(newline='')))
+assert [r['item_id'] for r in labels] == [r['item_id'] for r in items] == [f'B{i:03}' for i in range(1,100)]
+assert [r['root_cause_id'] for r in roots] == [f'RC{i:02}' for i in range(1,19)]
+root_ids = {r['root_cause_id'] for r in roots}
+case_map = collections.defaultdict(list)
+for case in json.loads((OUT / 'case_root_causes.json').read_text()):
+    case_map[case['item_id']].append(case)
+exmap = {r['item_id']:r for r in json.loads((OUT / 'exchange_map.json').read_text())}
+file_lines = {}
+loc_count = 0
+allowed_l2 = {'IMPL':{'I-CRASH'},'SPEC':{'S-STRUCT','S-STATUS','S-REQ-LOOSE'},'UNDECIDABLE':{''},'TEST':{''}}
+for row,item in zip(labels,items):
+    iid = row['item_id']
+    assert row['L2'] in allowed_l2[row['L1']]
+    assert row['confidence'] in {'1','2','3'}
+    assert row['both_candidate'] in {'true','false'}
+    assert row['rationale'].startswith('⚠️ ')
+    assert len(row['rationale'].split()) <= 30
+    assert bool(row['proposed_L2']) == (iid == 'B001')
+    membership = set(row['root_cause_id'].split(';'))
+    assert membership <= root_ids
+    for rc in membership:
+        root = next(r for r in roots if r['root_cause_id']==rc)
+        assert iid in root['items'].split(';')
+    assert len(exmap[iid]['exchange_lines']) == int(item['occurrences'])
+    if item['status']=='500':
+        assert len(case_map[iid]) == int(item['occurrences']), iid
+        assert len({r['exchange_line'] for r in case_map[iid]}) == int(item['occurrences'])
+        assert {r['root_cause_id'] for r in case_map[iid]} == membership
+        assert {r['exchange_line'] for r in case_map[iid]} == set(exmap[iid]['exchange_lines'])
+    for locator in row['evidence_locators'].split(';'):
+        match = re.fullmatch(r'(.+):(\d+)(?: \(JSON Pointer (.*)\))?', locator)
+        assert match, locator
+        name, line = match[1], int(match[2])
+        assert 'labels_code' not in name and 'prelim' not in name
+        path = ROOT / name
+        assert path.is_file(), locator
+        if name not in file_lines:
+            file_lines[name] = path.read_bytes().split(b'\n')
+        assert 1 <= line <= len(file_lines[name]), locator
+        assert file_lines[name][line-1].strip(), locator
+        if match[3] is not None:
+            node = json.loads(path.read_text())
+            for part in match[3].lstrip('/').split('/'):
+                part = part.replace('~1','/').replace('~0','~')
+                node = node[int(part)] if isinstance(node,list) else node[part]
+        loc_count += 1
+for root in roots:
+    members = [r['item_id'] for r in labels if root['root_cause_id'] in r['root_cause_id'].split(';')]
+    assert root['items'].split(';') == members
+    if root['root_cause_id']=='RC18':
+        assert root['description'].startswith('[H]') and root['fix_site']==''
+    else:
+        assert root['description'].startswith('⚠️')
+        assert root['fix_site'] in {'spec','code','test','env'}
+
+# Independently verify logged error IDs against physical LF line numbers.
+log_lines = (RUN / 'compose.log').read_bytes().decode('utf-8').split('\n')
+xs = [json.loads(raw) for raw in (RUN / 'exchanges.jsonl').open()]
+for mapped in json.loads((OUT / 'log_map.json').read_text()):
+    for error in mapped['errors']:
+        message = json.loads(xs[error['exchange_line']-1]['response']['body']['text'])['message']
+        error_id = re.search(r'logged \(ID ([0-9a-f]+)\)',message)[1]
+        assert f'Error handling a request: {error_id}' in log_lines[error['log_line']-1]
+
+# Directly check the overflow and probe witnesses without the replay map logic.
+overflow_count = 0
+for item in items:
+    if item['status']=='404':
+        for n in exmap[item['item_id']]['exchange_lines']:
+            value = int(xs[n-1]['request']['path'].rsplit('/',1)[-1])
+            assert not -(2**63) <= value < 2**63
+            overflow_count += 1
+first = xs[0]
+assert first['request']['headers']['x-schemathesis-probe']=='NULL_BYTE_IN_HEADER'
+assert first['request']['headers']['x-schemathesis-probe-null']=='\x00'
+assert first['response']['status']==400
+
+files = [blind_path,label_path,root_path,RUN/'exchanges.jsonl',RUN/'compose.log',RUN/'spec.original.json',RUN/'generator-input.json',RUN/'derecurse-cuts.json']
+files += [ROOT/name for name in sorted(file_lines) if (ROOT/name) not in files]
+manifest = {str(path.relative_to(ROOT)):hashlib.sha256(path.read_bytes()).hexdigest() for path in files}
+(OUT/'sha256_manifest.json').write_text(json.dumps(manifest,indent=2)+'\n')
+summary = {'status':'PASS','items':len(labels),'order_and_schema':'PASS','rationale_max_words':max(len(r['rationale'].split()) for r in labels),
+           'evidence_locators_checked':loc_count,'evidence_files_checked':len(file_lines),
+           'L1':dict(collections.Counter(r['L1'] for r in labels)), 'root_rows':len(roots),
+           'provisional_root_with_unresolved_fix_site':'RC18','overflow_404_exchanges':overflow_count,
+           'case_memberships_checked':sum(map(len,case_map.values())),
+           'both_candidates':sum(r['both_candidate']=='true' for r in labels),
+           'physical_log_line_numbering':'PASS','error_id_joins':'PASS','sha256_manifest':'sha256_manifest.json'}
+(OUT/'validation.json').write_text(json.dumps(summary,indent=2)+'\n')
+print(json.dumps(summary,indent=2))
diff --git a/research/09_collab/logs/T15_scratch/write_labels.py b/research/09_collab/logs/T15_scratch/write_labels.py
new file mode 100644
index 0000000000000000000000000000000000000000..2a76b0744fcf05ef437c3b170d3e3828b403c976
--- /dev/null
+++ b/research/09_collab/logs/T15_scratch/write_labels.py
@@ -0,0 +1,329 @@
+"""Materialize independently reviewed decisions from the blind evidence index."""
+import collections
+import csv
+import json
+from pathlib import Path
+
+OUT = Path(__file__).resolve().parent
+ROOT = OUT.parents[2]
+RUN_REL = '08_experiments/E1_pilot/runs/scout-api/20261113T202103Z_baseline_NONE_p0_s1_1642810'
+SRC = '08_experiments/_external/emb/jdk_8_maven/cs/rest/original/scout-api/'
+RES = SRC + 'api/src/main/java/se/devscout/scoutapi/resource/'
+MODEL = SRC + 'data-access/src/main/java/se/devscout/scoutapi/model/'
+DAO = SRC + 'data-access/src/main/java/se/devscout/scoutapi/dao/'
+CHECKER = '08_experiments/tools/conformance.py'
+SPEC = RUN_REL + '/spec.original.json'
+EXCHANGES = RUN_REL + '/exchanges.jsonl'
+LOG = RUN_REL + '/compose.log'
+items = list(csv.DictReader((ROOT / '08_experiments/E2_labelling/batch2_baseline_s1_blind.csv').open()))
+maps = {r['item_id']: r for r in json.loads((OUT / 'exchange_map.json').read_text())}
+logs = {r['item_id']: r for r in json.loads((OUT / 'log_map.json').read_text())}
+access = json.loads((OUT / 'request_log_map.json').read_text())
+locations = json.loads((OUT / 'spec_locations.json').read_text())
+xs = [json.loads(raw) for raw in (ROOT / EXCHANGES).open()]
+raw_spec = json.loads((ROOT / SPEC).read_text())
+
+# Root-cause mechanisms are shared across operations, not independent bug counts.
+# A fingerprint can contain several mechanisms; semicolons preserve membership.
+causes = {
+ 'RC01': ('A Schemathesis null-byte setup probe is included as an undocumented API operation.', 'test'),
+ 'RC02': ('Missing Activity lookup is dereferenced by activity mutation/deletion or rating-key construction.', 'code'),
+ 'RC03': ('Missing MediaFile lookup reaches unchecked update, delete, or download code.', 'code'),
+ 'RC04': ('Missing SystemMessage lookup reaches unchecked update or ORM deletion.', 'code'),
+ 'RC05': ('Missing Tag lookup reaches unchecked tag/category update or ORM deletion.', 'code'),
+ 'RC06': ('Missing User lookup reaches unchecked update or ORM deletion.', 'code'),
+ 'RC07': ('Absent JSON request bodies reach unchecked resource, model, or persistence calls.', 'code'),
+ 'RC08': ('Required persistent fields are not validated before dereference or NOT NULL database enforcement.', 'code'),
+ 'RC09': ('Client-supplied generated IDs reach persist as updates to nonexistent rows, causing stale-state failures.', 'code'),
+ 'RC10': ('Favourites POST dereferences an absent id list instead of validating the request.', 'code'),
+ 'RC11': ('The explicitly unsupported my_favourites filter throws WebApplicationException without a non-500 status.', 'code'),
+ 'RC12': ('Empty activity-search tokens reach charAt(0) without an emptiness guard.', 'code'),
+ 'RC13': ('Mutation operations document only 200 and omit the consistently observed JSON-binding 400 response.', 'spec'),
+ 'RC14': ('Mutation operations omit the 404 response observed when path IDs cannot bind to Java long.', 'spec'),
+ 'RC15': ('User creation omits the 403 authorization rejection explicitly implemented and required by developer test source.', 'spec'),
+ 'RC16': ('Required path parameter id is declared on profile/favourites routes that contain no id placeholder.', 'spec'),
+ 'RC17': ('Activity search declares unrestricted strings where the explicit parser requires numeric lists.', 'spec'),
+ 'RC18': ('[H] Open request schemas and JSON binding disagree; unknown-property/date/range intent and repair site remain unresolved.', ''),
+}
+
+root_sources = {
+ 'RC02': [DAO + 'ActivityDao.java:156', DAO + 'ActivityDao.java:167', DAO + 'ActivityDao.java:219', MODEL + 'ActivityRating.java:90'],
+ 'RC03': [RES + 'MediaFileResource.java:295', RES + 'MediaFileResource.java:96', RES + 'MediaFileResource.java:260', DAO + 'MediaFileDao.java:22'],
+ 'RC04': [RES + 'SystemMessageResource.java:102', DAO + 'SystemMessageDao.java:21', DAO + 'SystemMessageDao.java:41'],
+ 'RC05': [RES + 'TagResource.java:85', DAO + 'TagDao.java:21', DAO + 'TagDao.java:72'],
+ 'RC06': [RES + 'UserResource.java:100', DAO + 'UserDao.java:25', DAO + 'UserDao.java:48'],
+ 'RC09': [MODEL + 'SystemMessage.java:37', MODEL + 'User.java:36'],
+ 'RC10': [RES + 'v1/FavouritesResourceV1.java:66', RES + 'v1/FavouritesResourceV1.java:84'],
+ 'RC11': [RES + 'ActivityResourceV2.java:76', RES + 'v1/ActivityResourceV1.java:74'],
+ 'RC12': [DAO + 'ActivityDao.java:65', DAO + 'ActivityDao.java:68'],
+}
+
+def ptr(path):
+    return path.replace('~', '~0').replace('/', '~1')
+
+def sl(pointer):
+    return f'{SPEC}:{locations[pointer]} (JSON Pointer {pointer})'
+
+def no_body(x):
+    return x['request']['body']['text'].strip() in ('', 'null')
+
+def classify_error(error):
+    x = xs[error['exchange_line'] - 1]
+    text = '\n'.join(v for _, v in error['exceptions'] + error['project_frames'])
+    if 'NULL not allowed' in text:
+        return 'RC08'
+    if 'StaleStateException' in text or 'OptimisticLockException' in text:
+        return 'RC09'
+    if 'ActivityDao.update' in text or 'ActivityDao.delete' in text or 'ActivityRating$Key.<init>' in text:
+        return 'RC02'
+    if 'Activity.addAndPublish' in text:
+        assert no_body(x)
+        return 'RC07'
+    if 'ActivityResource.postRating' in text:
+        assert no_body(x)
+        return 'RC07'
+    if 'MediaFileResource.update' in text:
+        return 'RC07' if no_body(x) else 'RC03'
+    if 'MediaFileResource.downloadFile' in text or 'MediaFileDao.delete' in text:
+        return 'RC03'
+    if 'MediaFileResource.create' in text:
+        return 'RC07' if no_body(x) else 'RC08'
+    if 'SystemMessageResource.update' in text:
+        return 'RC07' if no_body(x) else 'RC04'
+    if 'SystemMessageDao.delete' in text:
+        return 'RC04'
+    if 'TagResource.update' in text:
+        return 'RC07' if no_body(x) else 'RC05'
+    if 'TagDao.delete' in text:
+        return 'RC05'
+    if 'UserResource.assertAuthorizationLevel' in text:
+        assert no_body(x)
+        return 'RC07'
+    if 'UserResource.update' in text:
+        return 'RC06'
+    if 'UserDao.delete' in text:
+        return 'RC06'
+    if 'SystemMessageDao.create' in text or 'TagDao.create' in text:
+        assert no_body(x)
+        return 'RC07'
+    if 'FavouritesResourceV1.put' in text:
+        return 'RC10'
+    if 'StringIndexOutOfBoundsException' in text and 'ActivityDao.' in text:
+        return 'RC12'
+    raise AssertionError((error['exchange_line'], text))
+
+def model_for(item):
+    path = item['template']
+    if 'rating' in path:
+        return 'ActivityRatingAttrs'
+    if 'activities' in path:
+        return 'ActivityProperties'
+    if 'media_files' in path:
+        return 'MediaFile'
+    if 'system_messages' in path:
+        return 'SystemMessage'
+    if 'tags' in path or 'categories' in path:
+        return 'Tag'
+    if 'users' in path:
+        return 'User'
+    if 'favourites' in path:
+        return 'PutFavouritesEntity'
+    raise AssertionError(item)
+
+def resource_site(item):
+    path, method = item['template'], item['method']
+    if path.startswith('/v2/activities'):
+        line = {'PUT':174, 'PATCH':185, 'POST':152 if 'rating' in path else 112,
+                'GET':138 if 'rating' in path else 35, 'DELETE':163 if 'rating' in path else 103}[method]
+        return RES + f'ActivityResourceV2.java:{line}'
+    if path.startswith('/v1/activities'):
+        line = {'PUT':173, 'PATCH':184, 'POST':151 if 'rating' in path else 111,
+                'GET':137 if 'rating' in path else 39, 'DELETE':162 if 'rating' in path else 102}[method]
+        return RES + f'v1/ActivityResourceV1.java:{line}'
+    if 'media_files' in path:
+        return RES + 'MediaFileResource.java:' + str({'PUT':291,'POST':104,'GET':251,'DELETE':83}[method])
+    if 'system_messages' in path:
+        return RES + 'SystemMessageResource.java:' + str({'PUT':98,'POST':76,'DELETE':68}[method])
+    if 'tags' in path or 'categories' in path:
+        return RES + 'TagResource.java:' + str({'PUT':81,'POST':59,'DELETE':51}[method])
+    if 'users' in path:
+        return RES + 'UserResource.java:' + str({'PUT':94,'POST':59,'GET':84,'DELETE':51}[method])
+    if 'favourites' in path:
+        return RES + 'v1/FavouritesResourceV1.java:' + str(46 if method == 'GET' else 55)
+    raise AssertionError(item)
+
+def required_field_evidence(item):
+    model = model_for(item)
+    annotation_lines = {'ActivityRatingAttrs':15, 'MediaFile':51, 'SystemMessage':40, 'Tag':37, 'User':43}
+    result = []
+    if model in annotation_lines:
+        result += [MODEL + f'{model}.java:{annotation_lines[model]}', sl('/definitions/' + model)]
+    if model == 'Tag':
+        result += [MODEL + 'Tag.java:41', MODEL + 'MediaFile.java:51', sl('/definitions/MediaFile')]
+    if model == 'SystemMessage':
+        result.append(MODEL + 'SystemMessage.java:44')
+    return result
+
+rationales = {
+ 'RC02': 'Missing activity lookup reaches an unchecked dereference. Logged NullPointerException establishes an implementation crash; status-only diagnostics share the same cause.',
+ 'RC03': 'Missing media lookup reaches unchecked update, download, or deletion code. The logged exception establishes an implementation failure.',
+ 'RC04': 'Missing system-message lookup reaches unchecked update or ORM deletion. The saved stack trace establishes an implementation failure.',
+ 'RC05': 'Missing tag lookup reaches unchecked update or deletion. The saved stack trace establishes an implementation failure.',
+ 'RC06': 'Missing user lookup reaches unchecked update or deletion. The saved stack trace establishes an implementation failure.',
+ 'RC07': 'An absent request body reaches unchecked object or persistence code and produces a logged exception. The 500 is an implementation failure.',
+ 'RC08': 'Required persistent fields reach unchecked dereference or database enforcement. Missing schema requirements are independently supported; implementation still mishandles the input with 500.',
+ 'RC10': 'An omitted favourites id list is dereferenced at forEach. The implementation crashes; the same operation also contains an impossible required path parameter.',
+}
+
+rows = []
+cases = []
+for item in items:
+    iid, kind, status = item['item_id'], item['kind'], item['status']
+    mapped = maps[iid]
+    first = mapped['exchange_lines'][0]
+    locs = [f'{EXCHANGES}:{first}']
+    if str(first) in access:
+        locs.append(f'{LOG}:{access[str(first)]["access_log_line"]}')
+    op_ptr = '/paths/' + ptr(item['template']) + '/' + item['method'].lower()
+    if iid != 'B001':
+        locs += [sl(op_ptr), sl(op_ptr + '/responses'), resource_site(item)]
+    evidence = ['E-OBS', 'E-LOG']
+    roots = set()
+    both = False
+    proposed = ''
+    l2 = ''
+    if status == '500':
+        l1, l2, confidence = 'IMPL', 'I-CRASH', 3
+        evidence.append('E-CODE-INTENT')
+        examples = {}
+        for error in logs.get(iid, {}).get('errors', []):
+            root = classify_error(error)
+            roots.add(root)
+            examples.setdefault(root, error)
+            cases.append({'item_id': iid, 'exchange_line': error['exchange_line'],
+                          'root_cause_id': root, 'log_line': error['log_line']})
+        for sample in mapped['response_signatures']:
+            if sample['response_error'].get('message') == 'API currently does not support filtering on your own favourites.':
+                roots.add('RC11')
+                examples['RC11'] = {'exchange_line': sample['line'], 'log_line': access[str(sample['line'])]['access_log_line'], 'project_frames': []}
+                cases += [{'item_id': iid, 'exchange_line': n, 'root_cause_id': 'RC11',
+                           'log_line': access[str(n)]['access_log_line']}
+                          for n in mapped['exchange_lines']
