   200	    private String saveDataUriAsFile(URI uri) throws IOException {
   201	        String s = uri.getSchemeSpecificPart();
   202	        String data = s.substring(s.indexOf(',') + 1);
   203	        String metaData = s.substring(0, s.indexOf(','));
   204	//                String charset = StringUtils.defaultString(StringUtils.substringBetween(metaData, ";charset=", ","), "US-ASCII");
   205	        String mimeType = StringUtils.defaultString(StringUtils.substringBefore(metaData, ";"), "text/plain");
   206	        boolean isBase64Encoded = metaData.contains(";base64");
   207	        String relativeLocalPath = getLocalFileName(mimeType);
   208	        File localFile = new File(mediaFilesFolder, relativeLocalPath);
   209	        if (isBase64Encoded) {
   210	            saveBase64EncodedFile(data, localFile);
   211	        } else {
   212	            saveTextFile(data, localFile);
   213	        }
   214	        return relativeLocalPath;
   215	    }
   216	
   217	    private String getLocalFileName(String mimeType) {
   218	        String extension = imageMimeTypes.containsKey(mimeType) ? imageMimeTypes.get(mimeType) : "unknown-type";
   219	
   220	        return String.format("%s.%s.%s", new SimpleDateFormat("yyyyMMddHHmmss").format(new Date()), UUID.randomUUID().toString(), extension);
   221	    }
   222	
   223	    private void saveTextFile(String data, File localFile) throws IOException {
   224	        Files.write(localFile.toPath(), Collections.singletonList(data));
   225	    }
   226	
   227	    private void saveBase64EncodedFile(String data, File localFile) throws IOException {
   228	        byte[] bytes = Base64.getDecoder().decode(data);
   229	        java.nio.file.Path path = Files.write(localFile.toPath(), bytes);
   230	        LOGGER.info("Saved uploaded file as " + path.toFile().getAbsolutePath());
   231	    }
