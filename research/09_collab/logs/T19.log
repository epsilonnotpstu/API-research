+        chunks = re.split(r"(\{[^{}]+\})", p)
+        pattern = "^" + re.escape(meta["base_path"].rstrip("/")) + "".join("[^/]+" if c.startswith("{") else re.escape(c) for c in chunks) + "/?$"
