+    [[ $mode == baseline && $fault == NONE && $severity == 0 ]] || { echo 'E5 keeps the spec unchanged' >&2; exit 2; }
+    [[ -n ${SUT_IMAGE_OVERRIDE:-} && -n ${SUT_JAR_OVERRIDE:-} && -s ${CODE_MANIFEST:-} && -s $PILOT_SUT_JAR_PATH ]] || { echo 'E5 image/jar/manifest missing' >&2; exit 2; }
