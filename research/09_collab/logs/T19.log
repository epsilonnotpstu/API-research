+    spec = json.loads((EMB / "openapi-swagger" / f"{sut}.json").read_text())
+    patterns = [(p, m, re.compile("^" + re.escape(meta["base_path"].rstrip("/") + p).replace(r"\{", "{").replace(r"\}", "}") + "/?$")) for p in [] for m in []]
