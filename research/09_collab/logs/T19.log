+add("market", "market-reject-valid", "REJECT_VALID", MR + "ProductsRestController.java",
+    "public ProductDTO getProduct(@PathVariable long productId) {",
+    'public ProductDTO getProduct(@PathVariable long productId) {\n\t\tif (productId > 0L) { throw new org.springframework.web.server.ResponseStatusException(org.springframework.http.HttpStatus.BAD_REQUEST, "E5 rejects positive product IDs"); }',
+    [("/products/{productId}", "get")], "I-REJECT-VALID", ["VALID_REJECTED", "SERVER_ERROR"],
