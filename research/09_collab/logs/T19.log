   405	TREAT="$PWD/08_experiments/E1_pilot/runs/$sut/${stamp}_e5_${site}_mutant_s1"
   406	ANALYSIS="$MUT/analysis-s1"
   407	mkdir "$ANALYSIS"
   408	pytool() {
   409	  /usr/bin/python3 -I -B - "$PWD/08_experiments/tools/$1" "${@:2}" <<'TOOL_PY'
   410	import pathlib, runpy, sys
   411	script = pathlib.Path(sys.argv.pop(1)).resolve()
   412	sys.path.insert(0, str(script.parent))
   413	sys.argv[0] = str(script)
   414	runpy.run_path(str(script), run_name='__main__')
   415	TOOL_PY
   416	}
   417	for oracle in default sut; do
   418	  rejects=400,422
   419	  [[ $sut != market || $oracle != sut ]] || rejects=400,406,422
   420	  for role in control mutant; do
