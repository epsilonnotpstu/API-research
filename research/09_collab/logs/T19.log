+                break
+    exposure["operations"].extend(rows[k] for k in sorted(rows))
+(OUT / "exposure.json").write_text(json.dumps(exposure, indent=2) + "\n")
+print("Reviewed sites:", len(sites), "Exposure rows:", len(exposure["operations"]))
