   426	  done
   427	  pytool attribute.py "$ANALYSIS/control-$oracle.violations.jsonl" \
   428	    "$ANALYSIS/mutant-$oracle.violations.jsonl" "$MUT/manifest.json" --mode fresh \
   429	    > "$ANALYSIS/attribution-$oracle.csv"
