+                          f"first 2xx line `{row['first_2xx_exchange']}`, first nonempty JSON 2xx line `{row['first_nonempty_2xx_exchange']}` "
+                          f"(`exposure.json`, `{row['evidence_id']}`; `{run['run_dir']}/exchanges.jsonl:{row['first_exchange']}`).\n"]
+            else:
