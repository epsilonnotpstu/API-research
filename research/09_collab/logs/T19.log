def agreement(left, right, mode='strict'):
    """Raw agreement and Cohen's kappa; undefined degenerate kappa is None."""
    if len(left) != len(right) or not left:
        raise ValueError('Need equal, nonempty paired label sequences')
    left, right = [score_label(x, mode) for x in left], [score_label(x, mode) for x in right]
    n, a, b = len(left), Counter(left), Counter(right)
    matched = sum(x == y for x, y in zip(left, right))
    observed = matched / n
    expected = sum(a[k] * b[k] for k in a.keys() | b.keys()) / n ** 2
    return {'n': n, 'matched': matched, 'raw_agreement': observed,
            'kappa': (observed - expected) / (1 - expected) if expected != 1 else None}


def classify(row, ctx, sheet_ref='input:sheet', message_rows=None):
    """§9.1: aggregate message labels without discarding supported findings."""
    entries = classify_messages(row, ctx, sheet_ref) if message_rows is None else message_rows
    label = aggregate_labels(m['L1'] for m in entries)
    supported = [m for m in entries if m['L1'] != 'UNDECIDABLE']
    unresolved = [{'path': m['path'], 'message': m['message'], 'msg_idx': m['msg_idx']}
                  for m in entries if m['L1'] == 'UNDECIDABLE']
    mixed_gap = label == 'UNDECIDABLE' and bool(supported)
    return {
        'label_L1': label,
        'label_L2': '|'.join(sorted({m['L2'] for m in supported if m['L2']})),
        'confidence': min(m['confidence'] for m in supported) if supported and label != 'UNDECIDABLE' else 1,
        'evidence_codes': ';'.join(sorted({c for m in entries for c in m['evidence_codes'].split(';') if c})),
        'rules': ';'.join(sorted({m['rule'] for m in entries} | ({'AGGREGATION_RULE_GAP'} if mixed_gap else set()))),
        'evidence_refs': json.dumps(sorted({source(ctx.raw(row)), sheet_ref + ':fault_id=' + row['fault_id']} |
                                           {r for m in entries for r in json.loads(m['refs'])}), ensure_ascii=False),
        'evidence_details': json.dumps(entries, ensure_ascii=False),
        'unresolved': json.dumps(unresolved, ensure_ascii=False),
        'spec_limitation': ctx.spec_errors.get(row['api'], ''),
        'doc_gap': any(m['doc_gap'] for m in entries),
        'aggregation_gap': mixed_gap,
        'n_labelled_messages': len(entries),
        'note': ('Unspecified mixed L1 combination; conservative UNDECIDABLE.' if mixed_gap else
                 'Partial attribution; confidence applies to supported messages.' if label.endswith('_PARTIAL') else
                 'Message-level heuristic attribution aggregated under section 9.1.'),
        'codebook_ref': CODEBOOK + ':sections=2,3,4,8,9',
    }


def run(sheet, p001_dir, output, messages_output=None):
    rows = read_csv(sheet)
    if not rows:
        raise ValueError('Empty sheet')
    ctx = Context.from_directory(p001_dir)
    if messages_output is None:
        messages_output = Path(output).with_name('triage_messages.csv')
    if Path(output).resolve() == Path(messages_output).resolve():
        raise ValueError('Fault and message output paths must differ')
    results, message_rows = [], []
    for row in rows:
        entries = classify_messages(row, ctx, str(sheet))
        message_rows.extend(entries)
        results.append({**row, **classify(row, ctx, str(sheet), entries)})
    with Path(output).open('w', encoding='utf-8', newline='') as handle:
        writer = csv.DictWriter(handle, fieldnames=list(results[0]))
        writer.writeheader()
        writer.writerows(results)
    with Path(messages_output).open('w', encoding='utf-8', newline='') as handle:
        writer = csv.DictWriter(handle, fieldnames=MESSAGE_FIELDS)
        writer.writeheader()
        writer.writerows(message_rows)
    counts = Counter((r['label_L1'], r['confidence']) for r in results)
    print(json.dumps({f'{label}/confidence={conf}': n for (label, conf), n in sorted(counts.items())}))
    return results


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('sheet')
    parser.add_argument('p001_dir')
    parser.add_argument('output')
    parser.add_argument('--messages', dest='messages_output', help='Message CSV path (default: triage_messages.csv beside output)')
    args = parser.parse_args()
    run(args.sheet, args.p001_dir, args.output, args.messages_output)


if __name__ == '__main__':
    main()
#!/usr/bin/env bash
# Trusted, non-secret configuration shared by the v2 scripts.
load_sut() {
    case ${1:-} in scout-api|swagger-petstore|market|cwa-verification) ;; *) echo 'Unsupported SUT' >&2; return 2;; esac
    # Only checked-in configurations from the allowlist are sourced.
    source "$HERE/suts/$1.env"
    export EMB_DIR="$EXP/_external/emb" TOOLS_DIR="$EXP/tools"
    export SUT_ID SUT_SERVICE INTERNAL_PORT SUT_IMAGE COMPOSE_FILE DOCKERFILE
    export JAR_SOURCE SPEC_SOURCE AUTH_SOURCE
    export HEALTH_PATH=${HEALTH_PATH:-$HEALTH_PATH_DEFAULT}
    export BASE_PATH=${BASE_PATH:-$BASE_PATH_DEFAULT}
    export PILOT_AUTH_ROLE=${AUTH_ROLE:-$AUTH_ROLE_DEFAULT}
    # These interpolate into the original EMB Compose port declarations.
    export HOST_PORT=127.0.0.1:18080 JACOCO_PORT=127.0.0.1:16300
}

acquire_run_lock() {
    exec 9>"$HERE/.run.lock"
    flock -n 9 || { echo 'Another v2 pilot/preparation is running' >&2; return 1; }
    # Share the existing v1 lock without writing or truncating any v1 file.
    if [[ -f $HERE/../harness/.run.lock ]]; then
        exec 8<"$HERE/../harness/.run.lock"
        flock -n 8 || { echo 'The v1 pilot is running; retry after it finishes' >&2; return 1; }
    fi
}
#!/usr/bin/env bash
set -euo pipefail
HERE=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
EXP=$(cd -- "$HERE/../.." && pwd)
[[ $# == 7 ]] || { echo 'Usage: run_pilot.sh SUT SPEC baseline|mutated FAULT SEVERITY SEED BUDGET_SECONDS' >&2; exit 2; }
sut=$1; spec=$(realpath -- "$2"); mode=$3; fault=$4; severity=$5; seed=$6; budget=$7
source "$HERE/common.sh"
load_sut "$sut"
[[ -s $spec && $spec == *.json ]] || { echo 'Spec must be an existing JSON document' >&2; exit 2; }
[[ $mode == baseline || $mode == mutated ]] || { echo 'Invalid mode' >&2; exit 2; }
[[ $severity =~ ^(0|[1-9][0-9]*)$ && $seed =~ ^(0|[1-9][0-9]*)$ && $budget =~ ^[1-9][0-9]*$ ]] || { echo 'Invalid numeric parameter' >&2; exit 2; }
((severity <= 100)) || { echo 'Severity must be 0..100' >&2; exit 2; }
if [[ $mode == baseline ]]; then
    [[ $fault == NONE && $severity == 0 ]] || { echo 'Baseline requires NONE 0' >&2; exit 2; }
else
    case $fault in REQUEST_LOOSE|REQUEST_STRICT|RESPONSE_ORACLE|METHOD_SEM) ;; *) echo 'Invalid fault class' >&2; exit 2;; esac
    ((severity > 0)) || { echo 'Mutated run requires positive severity' >&2; exit 2; }
fi
for tool in docker curl java timeout flock git sha256sum grep /usr/bin/python3; do command -v "$tool" >/dev/null || { echo "Missing tool: $tool" >&2; exit 1; }; done
docker compose version >/dev/null
export PILOT_UID=$(id -u) PILOT_GID=$(id -g)
# Original EMB port interpolation accepts an IP prefix; bind published ports to loopback.
export MITM_MAX_BODY=${MITM_MAX_BODY:-65536}
SCHEMA_IMAGE=schemathesis/schemathesis:3.39.16
MAX_EXAMPLES=${MAX_EXAMPLES:-100}
# Our oracle is tools/conformance.py. Schemathesis abandons an operation at its first failed check,
# so batch 2 uses a check that does not fail on 5xx to keep generating (SCHEMA_CHECKS).
export SCHEMA_CHECKS=${SCHEMA_CHECKS:-all}
[[ $SCHEMA_CHECKS =~ ^[a-z_,]+$ ]] || { echo "Invalid SCHEMA_CHECKS" >&2; exit 2; }
REQUEST_TIMEOUT_MS=${REQUEST_TIMEOUT_MS:-10000}
export PILOT_REQUEST_TIMEOUT_MS="$REQUEST_TIMEOUT_MS" PILOT_HYPOTHESIS_PHASES=explicit,generate
[[ $REQUEST_TIMEOUT_MS =~ ^[1-9][0-9]*$ ]] || { echo 'Invalid REQUEST_TIMEOUT_MS' >&2; exit 2; }
# Fixed fixture values stay in memory and are redacted from saved artifacts.
# Do not use shell xtrace, docker-debug output, or print this variable.
if [[ ${AUTH_HEADER+x} ]]; then
    export PILOT_AUTH_ROLE=${AUTH_ROLE:-custom}
    export PILOT_AUTH_SOURCE=runtime-override
elif [[ $PILOT_AUTH_ROLE == none ]]; then
    AUTH_HEADER=
    export PILOT_AUTH_SOURCE=none
else
    [[ -n $AUTH_SOURCE ]] || { echo 'No auth fixture configured' >&2; exit 2; }
    AUTH_HEADER=$(/usr/bin/python3 -I -B "$HERE/auth_header.py" "$EMB_DIR/$AUTH_SOURCE" "$PILOT_AUTH_ROLE")
    export PILOT_AUTH_SOURCE="$AUTH_SOURCE"
fi
if [[ -n $AUTH_HEADER ]]; then
    [[ $AUTH_HEADER == *:* && $AUTH_HEADER != *$'\n'* && $AUTH_HEADER != *$'\r'* ]] || { echo 'Invalid AUTH_HEADER' >&2; exit 2; }
else
    [[ $PILOT_AUTH_ROLE == none ]] || { echo 'Empty header for authenticated role' >&2; exit 2; }
fi
# Only the redactor receives this host-side environment value; Docker receives -H.
export PILOT_AUTH_REDACT="$AUTH_HEADER"
[[ $MAX_EXAMPLES =~ ^[1-9][0-9]*$ && $HEALTH_PATH == /* && $BASE_PATH == /* ]] || { echo 'Invalid MAX_EXAMPLES, HEALTH_PATH or BASE_PATH' >&2; exit 2; }
for jar in "$sut-sut.jar" jacocoagent.jar jacococli.jar; do
    [[ -s $EMB_DIR/dist/$jar ]] || { echo "Missing $jar; run prepare_dist.sh first" >&2; exit 1; }
done
# Serialize runs to avoid port, build, and resource contention. Never replace an existing run.
acquire_run_lock
run_id=${PILOT_RUN_ID:-"$(date -u +%Y%m%dT%H%M%SZ)_${mode}_${fault}_p${severity}_s${seed}_$$"}
[[ $run_id =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,180}$ ]] || { echo 'Invalid run ID' >&2; exit 2; }
run_dir="$EXP/E1_pilot/runs/$sut/$run_id"
mkdir -p "$EXP/E1_pilot/runs/$sut"
mkdir "$run_dir"
export PILOT_LOG_DIR="$run_dir"
project="r1-$sut-$(date -u +%s)-$$"
generator="$project-generator"
compose=(docker compose --project-name "$project" --project-directory "$EMB_DIR" \
    -f "$EMB_DIR/$COMPOSE_FILE" -f "$HERE/compose.override.$sut.yaml")
started=$(date -u +%FT%TZ)
phase=preparation
schema_rc=not_started
