--- /dev/null
+++ b/research/08_experiments/E5_codemut/codemut.py
@@ -0,0 +1,261 @@
+"""Apply one reviewed Java edit to a fresh source-tree copy; never run/build code.
+
+The JSON catalogue is data, not a Java parser or an executable extension point.
+Each entry pins one file digest, line and unique exact before/after anchor.
+"""
+import argparse
+import difflib
+import hashlib
+import json
+import os
+from pathlib import Path, PurePosixPath
+import stat
+import sys
+
+HERE = Path(__file__).resolve().parent
+EXP = HERE.parent
+EMB = EXP / "_external" / "emb"
+ROOTS = {
+    "scout-api": "jdk_8_maven/cs/rest/original/scout-api",
+    "swagger-petstore": "jdk_8_maven/cs/rest/original/swagger-petstore",
+    "market": "jdk_11_maven/cs/rest-gui/market",
+    "cwa-verification": "jdk_11_maven/cs/rest/cwa-verification-server",
+}
+OPERATORS = {
+    "DROP_VALIDATION": {"I-ACCEPT-INVALID", "I-CRASH"},
+    "WRONG_STATUS": {"I-RESP-CONTRACT"},
+    "DROP_NULL_CHECK": {"I-CRASH"},
+    "RESP_FIELD": {"I-RESP-CONTRACT"},
+    "REJECT_VALID": {"I-REJECT-VALID"},
+}
+SIGNALS = {"SERVER_ERROR", "INVALID_ACCEPTED", "VALID_REJECTED", "RESPONSE_SCHEMA", "UNDOCUMENTED_STATUS"}
+EXCLUDED = {".git", ".hg", ".svn", ".idea", ".venv", "venv", "__pycache__", "target", "node_modules"}
+
+
+class MutationError(ValueError):
+    """An input/snapshot safety check failed; no ready manifest is produced."""
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def canonical_hash(value):
+    return sha(json.dumps(value, sort_keys=True, separators=(",", ":")).encode())
+
+
+def relative_java(value):
+    if not isinstance(value, str) or not value or "\\" in value:
+        raise MutationError("Site file must be a relative POSIX Java path")
+    path = PurePosixPath(value)
+    if path.is_absolute() or any(p in ("", ".", "..") for p in value.split("/")):
+        raise MutationError("Site file cannot escape the source tree")
+    if path.suffix != ".java" or any(p in EXCLUDED for p in path.parts):
+        raise MutationError("Site must target a non-excluded .java source file")
+    return path.as_posix()
+
+
+def validate_sites(sites):
+    if not isinstance(sites, list) or not sites:
+        raise MutationError("Catalogue must contain a nonempty sites list")
+    ids = set()
+    for site in sites:
+        if not isinstance(site, dict):
+            raise MutationError("Each catalogue site must be an object")
+        try:
+            sid, sut, operator = site["site_id"], site["sut"], site["operator"]
+            if not isinstance(sid, str) or not sid or sid in ids:
+                raise MutationError("Site IDs must be nonempty and unique")
+            ids.add(sid)
+            if sut not in ROOTS or operator not in OPERATORS:
+                raise MutationError("Unknown SUT or operator")
+            relative_java(site["file"])
+            if type(site["line"]) is not int or site["line"] < 1:
+                raise MutationError("Site line must be a positive integer")
+            before, after = site["before"], site["after"]
+            if not isinstance(before, str) or not isinstance(after, str) or not before or before == after:
+                raise MutationError("Site needs a nonempty before and a different after snippet")
+            digest = site["source_sha256"]
+            if not isinstance(digest, str) or len(digest) != 64 or any(c not in "0123456789abcdef" for c in digest):
+                raise MutationError("Site must pin the original file SHA-256")
+            if site["expected_L1"] != "IMPL" or site["expected_L2"] not in OPERATORS[operator]:
+                raise MutationError("Expected labels do not match the operator")
+            signals = site["expected_conformance_signal"]
+            if not isinstance(signals, list) or any(s not in SIGNALS for s in signals):
+                raise MutationError("Unknown conformance signal")
+            operations = site["operations"]
+            if not isinstance(operations, list) or not operations:
+                raise MutationError("A reviewed affected-operation list is required")
+            seen = set()
+            for op in operations:
+                path, method = op["path"], op["method"]
+                if not isinstance(path, str) or not path.startswith("/") or method not in {
+                    "get", "post", "put", "delete", "patch", "head", "options", "trace"}:
+                    raise MutationError("Invalid affected operation")
+                if (path, method) in seen:
+                    raise MutationError("Duplicate affected operation")
+                seen.add((path, method))
+        except (KeyError, TypeError) as error:
+            raise MutationError("Malformed catalogue entry") from error
+    return sites
+
+
+def select_site(sites, sut, operator, seed, site_id=None):
+    validate_sites(sites)
+    if type(seed) is not int or seed < 0:
+        raise MutationError("Seed must be a non-negative integer")
+    pool = sorted((s for s in sites if s["sut"] == sut and s["operator"] == operator),
+                  key=lambda s: s["site_id"])
+    if not pool:
+        raise MutationError("No reviewed site for this SUT/operator")
+    if site_id is not None:
+        selected = [s for s in pool if s["site_id"] == site_id]
+        if len(selected) != 1:
+            raise MutationError("Explicit site does not belong to this SUT/operator")
+        return selected[0]
+    # Stable across Python random implementation changes and catalogue ordering.
+    index = int(sha(f"{sut}:{operator}:{seed}".encode()), 16) % len(pool)
+    return pool[index]
+
+
+def inventory(root):
+    """Return copied-file digests/modes; reject links and non-regular retained files."""
+    files = {}
+    for directory, dirs, names in os.walk(root, followlinks=False):
+        dirs[:] = sorted(d for d in dirs if d not in EXCLUDED)
+        for name in dirs + names:
+            path = Path(directory) / name
+            if name in EXCLUDED:
+                continue
+            info = path.lstat()
+            if stat.S_ISLNK(info.st_mode):
+                raise MutationError("Symlinks in the copied source set are not supported")
+            if stat.S_ISDIR(info.st_mode):
+                continue
+            if not stat.S_ISREG(info.st_mode):
+                raise MutationError("Non-regular source files are not supported")
+            relative = path.relative_to(root).as_posix()
+            files[relative] = {"sha256": sha(path.read_bytes()), "mode": stat.S_IMODE(info.st_mode) & 0o777}
+    return dict(sorted(files.items()))
+
+
+def edit_bytes(original, site):
+    if sha(original) != site["source_sha256"]:
+        raise MutationError("Source file digest differs from the reviewed site")
+    before, after = site["before"].encode(), site["after"].encode()
+    if original.count(before) != 1:
+        raise MutationError("Before snippet must occur exactly once")
+    start = original.index(before)
+    if original[:start].count(b"\n") + 1 != site["line"]:
+        raise MutationError("Source line differs from the reviewed site")
+    return original[:start] + after + original[start + len(before):]
+
+
+def patch_text(original, mutated, relative):
+    result = []
+    for line in difflib.unified_diff(original.decode("utf-8").splitlines(keepends=True),
+                                     mutated.decode("utf-8").splitlines(keepends=True),
+                                     fromfile="a/" + relative, tofile="b/" + relative):
+        result.append(line)
+        if not line.endswith("\n"):
+            result.append("\n\\ No newline at end of file\n")
+    return "".join(result)
+
+
+def mutate(source, out, sut, operator, sites, seed=1, site_id=None):
+    source, out = Path(source).resolve(), Path(out).absolute()
+    if out.is_symlink() or out.exists():
+        raise MutationError("Output must not exist (including symlinks)")
+    out = out.resolve()
+    if not source.is_dir() or source == out or source in out.parents or out in source.parents:
+        raise MutationError("Source and output trees must be separate and non-overlapping")
+    if out == EMB.resolve() or EMB.resolve() in out.parents or out in EMB.resolve().parents:
+        raise MutationError("Output may not write to or contain the protected EMB tree")
+    site = select_site(sites, sut, operator, seed, site_id)
+    files = inventory(source)
+    relative = relative_java(site["file"])
+    if relative not in files:
+        raise MutationError("Site file is absent from the copy inventory")
+    original = (source / relative).read_bytes()
+    changed = edit_bytes(original, site)
+    patch = patch_text(original, changed, relative)
+    # All semantic preflight failures precede output creation. Partial copy failure
+    # leaves an output without a ready manifest; it is never silently reused.
+    out.mkdir(parents=True, exist_ok=False)
+    tree = out / "source"
+    tree.mkdir()
+    for name, expected in files.items():
+        src, dst = source / name, tree / name
+        fd = os.open(src, os.O_RDONLY | os.O_NOFOLLOW)
+        with os.fdopen(fd, "rb") as stream:
+            data = stream.read()
+        if sha(data) != expected["sha256"]:
+            raise MutationError("Source changed while copying; discard this incomplete output")
+        dst.parent.mkdir(parents=True, exist_ok=True)
+        with dst.open("xb") as stream:
+            stream.write(changed if name == relative else data)
+        dst.chmod(expected["mode"])
+    if inventory(source) != files:
+        raise MutationError("Source changed during mutation; discard this incomplete output")
+    result_files = inventory(tree)
+    changed_files = [p for p in files if result_files.get(p) != files[p]]
+    if changed_files != [relative] or set(result_files) != set(files):
+        raise MutationError("Copy differs outside the single reviewed source file")
+    edits = [{"file": relative, "line": site["line"], "before": site["before"], "after": site["after"]}]
+    manifest = {
+        "format": "codemut-v1", "injection_side": "IMPL", "sut": sut, "operator": operator,
+        "site_id": site["site_id"], "seed": seed, "file": relative, "line": site["line"],
+        "before": site["before"], "after": site["after"], "operations": site["operations"],
+        "expected_L1": site["expected_L1"], "expected_L2": site["expected_L2"],
+        "expected_conformance_signal": site["expected_conformance_signal"],
+        "source_spec": None, "source_root": str(source), "source_sha256": sha(original),
+        "mutated_file_sha256": sha(changed), "source_tree_sha256": canonical_hash(files),
+        "mutated_tree_sha256": canonical_hash(result_files), "source_files": files,
+        "excluded_names": sorted(EXCLUDED), "catalogue_site_sha256": canonical_hash(site),
+        "catalogue_sha256": canonical_hash(sites),
+        "candidate_site_ids": sorted(s["site_id"] for s in sites if s["sut"] == sut and s["operator"] == operator),
+        "explicit_site": site_id is not None,
+        "expected_L2_by_signal": ({"INVALID_ACCEPTED": "I-ACCEPT-INVALID", "SERVER_ERROR": "I-CRASH"}
+                                  if operator == "DROP_VALIDATION" else {s: site["expected_L2"] for s in site["expected_conformance_signal"]}),
+        "patch_sha256": sha(patch.encode()), "operations_mutated": len(site["operations"]),
+        "mutations": [dict(op, fault=operator, operator=operator, edits=edits,
+                           expected_L1=site["expected_L1"], expected_L2=site["expected_L2"])
+                      for op in site["operations"]],
+        "selection_algorithm": "sha256(sut:operator:decimal_seed) modulo sorted candidate count",
+        "conditions": site.get("conditions", "See reviewed catalogue"),
+        "validation": {"source_copy": "one changed file; source rechecked", "java_compile": "not_run",
+                       "sut_execution": "not_run", "fault_observed": False, "attribution": "NEEDS_MANUAL"},
+        "limitations": ["operation mapping is source-reviewed, not measured reachability",
+                        "expected labels are injection intent, not observed causal attribution",
+                        "fresh attribution only; replay of unchanged exchanges/spec cannot test a code mutant"],
+    }
+    with (out / "patch.diff").open("x", encoding="utf-8") as stream:
+        stream.write(patch)
+    with (out / "manifest.json").open("x", encoding="utf-8") as stream:
+        json.dump(manifest, stream, indent=2, sort_keys=True)
+        stream.write("\n")
+    return manifest
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--sut", choices=sorted(ROOTS), required=True)
+    parser.add_argument("--operator", choices=sorted(OPERATORS), required=True)
+    parser.add_argument("--source", type=Path, help="SUT root; defaults to its EMB source checkout")
+    parser.add_argument("--catalog", type=Path, default=HERE / "sites.json")
+    parser.add_argument("--seed", type=int, default=1)
+    parser.add_argument("--site", help="Reviewed site_id, constrained to the selected SUT/operator")
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args(argv)
+    try:
+        catalogue = json.loads(args.catalog.read_text(encoding="utf-8"))
+        manifest = mutate(args.source or EMB / ROOTS[args.sut], args.out, args.sut, args.operator,
+                          catalogue["sites"], args.seed, args.site)
+    except (MutationError, OSError, UnicodeError, json.JSONDecodeError, KeyError) as error:
+        parser.exit(2, f"codemut: {error}\n")
+    print(json.dumps({"site_id": manifest["site_id"], "operator": manifest["operator"],
+                      "out": str(args.out.resolve()), "execution": "not_run"}, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/research/08_experiments/E5_codemut/test_codemut.py b/research/08_experiments/E5_codemut/test_codemut.py
new file mode 100644
index 0000000000000000000000000000000000000000..8beaaebcc1c7208f2538b6e8120785083b8aed3a
--- /dev/null
+++ b/research/08_experiments/E5_codemut/test_codemut.py
@@ -0,0 +1,211 @@
+"""Synthetic Java fixtures only; no real SUT copies, compilers, or builds."""
+import copy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+HERE = Path(__file__).resolve().parent
+SPEC = importlib.util.spec_from_file_location("codemut_under_test", HERE / "codemut.py")
+MODULE = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(MODULE)
+
+
+class CodeMutationTests(unittest.TestCase):
+    def setUp(self):
+        # All test writes remain within the task's allowed E5 directory.
+        self.temp = tempfile.TemporaryDirectory(prefix=".test-", dir=HERE)
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.source = self.root / "original"
+        (self.source / "src").mkdir(parents=True)
+        self.text = ("class Handler {\n"
+                     "  Object create(@Valid Object body) { return body; }\n"
+                     "  int status() { return 201; }\n"
+                     "  int length(String x) { if (x == null) return 0; return x.length(); }\n"
+                     "  public String getName() { return name; }\n"
+                     "  int read(int id) { return id; }\n"
+                     "}\n")
+        (self.source / "src/Handler.java").write_text(self.text)
+        (self.source / "pom.xml").write_text("<project/>\n")
+        self.sites = [
+            self.site("validate", "DROP_VALIDATION", "@Valid Object body", "Object body", "I-ACCEPT-INVALID", ["INVALID_ACCEPTED"]),
+            self.site("status", "WRONG_STATUS", "return 201;", "return 418;", "I-RESP-CONTRACT", ["UNDOCUMENTED_STATUS"]),
+            self.site("null", "DROP_NULL_CHECK", "if (x == null) return 0; ", "", "I-CRASH", ["SERVER_ERROR"]),
+            self.site("field", "RESP_FIELD", "public String getName()", "public String getRenamedName()", "I-RESP-CONTRACT", ["RESPONSE_SCHEMA"]),
+            self.site("reject", "REJECT_VALID", "return id;", "if (id > 1) throw new BadRequest(); return id;", "I-REJECT-VALID", ["VALID_REJECTED"]),
+        ]
+
+    def site(self, sid, operator, before, after, l2, signals):
+        return {"site_id": sid, "sut": "scout-api", "operator": operator, "file": "src/Handler.java",
+                "line": self.text[:self.text.index(before)].count("\n") + 1,
+                "before": before, "after": after, "source_sha256": hashlib.sha256(self.text.encode()).hexdigest(),
+                "expected_L1": "IMPL", "expected_L2": l2, "expected_conformance_signal": signals,
+                "operations": [{"path": "/things", "method": "post"}]}
+
+    def apply(self, site, name="out", sites=None, seed=1):
+        return MODULE.mutate(self.source, self.root / name, "scout-api", site["operator"],
+                             sites or self.sites, seed, site["site_id"])
+
+    def test_each_operator_changes_only_copy_and_emits_complete_manifest(self):
+        for index, site in enumerate(self.sites):
+            with self.subTest(operator=site["operator"]):
+                out = self.root / f"out{index}"
+                manifest = self.apply(site, out.name)
+                self.assertEqual((self.source / "src/Handler.java").read_text(), self.text)
+                self.assertEqual((out / "source/src/Handler.java").read_text(), self.text.replace(site["before"], site["after"], 1))
+                self.assertEqual((out / "source/pom.xml").read_bytes(), (self.source / "pom.xml").read_bytes())
+                self.assertEqual(json.loads((out / "manifest.json").read_text()), manifest)
+                self.assertEqual(manifest["source_sha256"], hashlib.sha256(self.text.encode()).hexdigest())
+                self.assertEqual(manifest["expected_L1"], "IMPL")
+                self.assertFalse(manifest["validation"]["fault_observed"])
+                self.assertEqual(manifest["validation"]["java_compile"], "not_run")
+                self.assertEqual(manifest["mutations"][0]["fault"], site["operator"])
+                self.assertTrue((out / "patch.diff").read_text().startswith("--- a/src/Handler.java\n+++ b/src/Handler.java\n"))
+                self.assertEqual(manifest["patch_sha256"], hashlib.sha256((out / "patch.diff").read_bytes()).hexdigest())
+                self.assertNotEqual(manifest["source_tree_sha256"], manifest["mutated_tree_sha256"])
+
+    def test_seeded_selection_is_order_independent_and_explicit_site_wins(self):
+        first = self.sites[1]
+        second = self.site("status-other", "WRONG_STATUS", "return id;", "return 418;", "I-RESP-CONTRACT", ["UNDOCUMENTED_STATUS"])
+        pool = [first, second]
+        chosen = MODULE.select_site(pool, "scout-api", "WRONG_STATUS", 17)
+        self.assertEqual(chosen, MODULE.select_site(pool[::-1], "scout-api", "WRONG_STATUS", 17))
+        self.assertEqual(MODULE.select_site(pool, "scout-api", "WRONG_STATUS", 17, second["site_id"]), second)
+        self.assertEqual({MODULE.select_site(pool, "scout-api", "WRONG_STATUS", seed)["site_id"] for seed in range(20)}, {first["site_id"], second["site_id"]})
+
+    def test_repeated_invocations_have_identical_patch_and_manifest(self):
+        first = self.apply(self.sites[1], "one")
+        second = self.apply(self.sites[1], "two")
+        self.assertEqual(first, second)
+        self.assertEqual((self.root / "one/patch.diff").read_bytes(), (self.root / "two/patch.diff").read_bytes())
+
+    def test_existing_output_is_never_overwritten(self):
+        self.apply(self.sites[1])
+        existing = (self.root / "out/manifest.json").read_bytes()
+        with self.assertRaises(MODULE.MutationError): self.apply(self.sites[1])
+        self.assertEqual((self.root / "out/manifest.json").read_bytes(), existing)
+
+    def test_output_may_not_overlap_source_in_either_direction(self):
+        for out in (self.source, self.source / "inside", self.root):
+            with self.subTest(out=out), self.assertRaises(MODULE.MutationError):
+                MODULE.mutate(self.source, out, "scout-api", "WRONG_STATUS", self.sites)
+
+    def test_output_cannot_be_in_any_protected_emb_subtree(self):
+        original = MODULE.EMB
+        MODULE.EMB = self.root / "protected-emb"
+        self.addCleanup(setattr, MODULE, "EMB", original)
+        with self.assertRaises(MODULE.MutationError):
+            MODULE.mutate(self.source, MODULE.EMB / "other-sut/out", "scout-api", "WRONG_STATUS", self.sites)
+        self.assertFalse(MODULE.EMB.exists())
+
+    def test_symlink_output_and_escaping_source_links_are_rejected(self):
+        (self.root / "out").symlink_to(self.root / "missing", target_is_directory=True)
+        with self.assertRaises(MODULE.MutationError): self.apply(self.sites[1])
+        (self.root / "out").unlink()
+        (self.source / "src/escape.java").symlink_to(self.root / "outside.java")
+        with self.assertRaises(MODULE.MutationError): self.apply(self.sites[1])
+        self.assertFalse((self.root / "out").exists())
+
+    def test_symlink_directories_are_rejected(self):
+        (self.source / "linked").symlink_to(self.root, target_is_directory=True)
+        with self.assertRaises(MODULE.MutationError): self.apply(self.sites[1])
+
+    def test_build_outputs_and_vcs_are_excluded(self):
+        for directory in ("target", ".git", "node_modules", "__pycache__"):
+            (self.source / directory).mkdir()
+            (self.source / directory / "cached").write_text("not source")
+        manifest = self.apply(self.sites[1])
+        self.assertEqual(set(manifest["source_files"]), {"src/Handler.java", "pom.xml"})
+        self.assertFalse((self.root / "out/source/target").exists())
+
+    def test_preserves_executable_mode_and_resource_bytes(self):
+        (self.source / "mvnw").write_bytes(b"#!/bin/sh\nexit 0\n")
+        (self.source / "mvnw").chmod(0o755)
+        (self.source / "data.bin").write_bytes(bytes(range(256)))
+        self.apply(self.sites[1])
+        self.assertEqual((self.root / "out/source/mvnw").stat().st_mode & 0o777, 0o755)
+        self.assertEqual((self.root / "out/source/data.bin").read_bytes(), bytes(range(256)))
+
+    def test_file_digest_drift_fails_before_output_creation(self):
+        (self.source / "src/Handler.java").write_text(self.text + "// changed\n")
+        with self.assertRaisesRegex(MODULE.MutationError, "digest"): self.apply(self.sites[1])
+        self.assertFalse((self.root / "out").exists())
+
+    def test_pinned_line_mismatch_is_rejected(self):
+        sites = copy.deepcopy(self.sites); sites[1]["line"] += 1
+        with self.assertRaisesRegex(MODULE.MutationError, "line"): self.apply(sites[1], sites=sites)
+
+    def test_ambiguous_anchor_is_rejected_even_when_hash_matches(self):
+        text = self.text.replace("return id;", "return 201;")
+        (self.source / "src/Handler.java").write_text(text)
+        sites = copy.deepcopy(self.sites); sites[1]["source_sha256"] = hashlib.sha256(text.encode()).hexdigest()
+        with self.assertRaisesRegex(MODULE.MutationError, "exactly once"): self.apply(sites[1], sites=sites)
+
+    def test_missing_anchor_is_rejected(self):
+        sites = copy.deepcopy(self.sites); sites[1]["before"] = "does not exist"
+        with self.assertRaisesRegex(MODULE.MutationError, "exactly once"): self.apply(sites[1], sites=sites)
+
+    def test_path_traversal_absolute_windows_and_excluded_paths_rejected(self):
+        for path in ("../evil.java", "/tmp/evil.java", "src/../evil.java", "src\\evil.java", "target/A.java", "src//A.java"):
+            sites = copy.deepcopy(self.sites); sites[1]["file"] = path
+            with self.subTest(path=path), self.assertRaises(MODULE.MutationError): self.apply(sites[1], sites=sites)
+        self.assertFalse((self.root / "out").exists())
+
+    def test_explicit_site_must_match_operator_and_sut(self):
+        with self.assertRaises(MODULE.MutationError):
+            MODULE.mutate(self.source, self.root / "out", "scout-api", "WRONG_STATUS", self.sites, site_id="validate")
+        with self.assertRaises(MODULE.MutationError):
+            MODULE.select_site(self.sites, "market", "WRONG_STATUS", 1)
+
+    def test_duplicate_site_ids_invalid_labels_and_unknown_signals_fail_closed(self):
+        cases = []
+        duplicate = copy.deepcopy(self.sites); duplicate.append(copy.deepcopy(duplicate[0])); cases.append(duplicate)
+        for key, value in (("expected_L1", "SPEC"), ("expected_L2", "I-CRASH"), ("expected_conformance_signal", ["INVENTED"]), ("line", 0), ("before", ""), ("operations", [])):
+            sites = copy.deepcopy(self.sites); sites[1][key] = value; cases.append(sites)
+        for sites in cases:
+            with self.subTest(sites=sites[1]["expected_L2"]), self.assertRaises(MODULE.MutationError): MODULE.validate_sites(sites)
+
+    def test_negative_seed_and_noop_edit_are_rejected(self):
+        with self.assertRaises(MODULE.MutationError): MODULE.select_site(self.sites, "scout-api", "WRONG_STATUS", -1)
+        sites = copy.deepcopy(self.sites); sites[1]["after"] = sites[1]["before"]
+        with self.assertRaises(MODULE.MutationError): self.apply(sites[1], sites=sites)
+
+    def test_no_final_newline_and_crlf_are_preserved_in_copy(self):
+        for index, text in enumerate((self.text.rstrip("\n"), self.text.replace("\n", "\r\n"))):
+            (self.source / "src/Handler.java").write_bytes(text.encode())
+            sites = copy.deepcopy(self.sites); sites[1]["source_sha256"] = hashlib.sha256(text.encode()).hexdigest()
+            manifest = self.apply(sites[1], f"format{index}", sites)
+            result = (self.root / f"format{index}/source/src/Handler.java").read_bytes()
+            self.assertEqual(result, text.replace("return 201;", "return 418;", 1).encode())
+            self.assertEqual(manifest["line"], 3)
+
+    def test_diff_marks_changed_line_without_final_newline(self):
+        diff = MODULE.patch_text(b"class A {}", b"class B {}", "A.java")
+        self.assertIn("-class A {}\n\\ No newline at end of file\n", diff)
+        self.assertIn("+class B {}\n\\ No newline at end of file\n", diff)
+
+    def test_shared_response_field_records_every_affected_operation(self):
+        sites = copy.deepcopy(self.sites)
+        sites[3]["operations"].append({"path": "/other", "method": "get"})
+        manifest = self.apply(sites[3], sites=sites)
+        self.assertEqual(manifest["operations_mutated"], 2)
+        self.assertEqual({(m["path"], m["method"]) for m in manifest["mutations"]}, {("/things", "post"), ("/other", "get")})
+
+    def test_cli_uses_json_catalogue_and_creates_output_without_execution(self):
+        catalogue = self.root / "sites.json"
+        catalogue.write_text(json.dumps({"sites": self.sites}))
+        result = subprocess.run(["/usr/bin/python3", "-I", "-B", str(HERE / "codemut.py"),
+                                 "--sut", "scout-api", "--operator", "WRONG_STATUS", "--site", "status",
+                                 "--source", str(self.source), "--catalog", str(catalogue), "--out", str(self.root / "cli")],
+                                text=True, capture_output=True)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(json.loads(result.stdout)["execution"], "not_run")
+        self.assertTrue((self.root / "cli/patch.diff").exists())
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
diff --git a/research/09_collab/logs/T19_scratch/make_catalogue.py b/research/09_collab/logs/T19_scratch/make_catalogue.py
new file mode 100644
index 0000000000000000000000000000000000000000..4b0686f100e61e83746f51f9640a280d7ca100c0
--- /dev/null
+++ b/research/09_collab/logs/T19_scratch/make_catalogue.py
@@ -0,0 +1,203 @@
+"""Read source/spec/run data and write the reviewed E5 site registry and exposure evidence."""
+from pathlib import Path
+import hashlib
+import json
+import re
+
+BASE = Path.cwd()
+OUT = BASE / "08_experiments/E5_codemut"
+EMB = BASE / "08_experiments/_external/emb"
+ROOTS = {
+    "scout-api": "jdk_8_maven/cs/rest/original/scout-api",
+    "swagger-petstore": "jdk_8_maven/cs/rest/original/swagger-petstore",
+    "market": "jdk_11_maven/cs/rest-gui/market",
+    "cwa-verification": "jdk_11_maven/cs/rest/cwa-verification-server",
+}
+SC = "api/src/main/java/se/devscout/scoutapi/resource/"
+SD = "data-access/src/main/java/se/devscout/scoutapi/"
+PC = "src/main/java/io/swagger/petstore/"
+MR = "market-rest/src/main/java/market/rest/"
+MC = "market-core/src/main/java/market/"
+CW = "src/main/java/app/coronawarn/verification/"
+sites = []
+
+
+def add(sut, sid, op, file, before, after, operations, l2, signals, condition, witness, pilot=False):
+    data = (EMB / ROOTS[sut] / file).read_bytes()
+    text = data.decode()
+    assert text.count(before) == 1, (sid, text.count(before))
+    line = text[:text.index(before)].count("\n") + 1
+    sites.append({"site_id": sid, "sut": sut, "operator": op, "file": file, "line": line,
+                  "before": before, "after": after, "operations": [{"path": p, "method": m} for p, m in operations],
+                  "expected_L1": "IMPL", "expected_L2": l2, "expected_conformance_signal": signals,
+                  "source_sha256": hashlib.sha256(data).hexdigest(), "conditions": condition,
+                  "witness_plan": witness, "pilot": pilot,
+                  "evidence": f"08_experiments/_external/emb/{ROOTS[sut]}/{file}:{line}"})
+
+
+add("scout-api", "scout-drop-validation", "DROP_VALIDATION", SC + "ActivityResource.java",
+    'throw new WebApplicationException("Could not understand the request. Perhaps you sent text instead of integers?", Response.Status.BAD_REQUEST);',
+    'return java.util.Collections.emptyList();', [("/v2/activities", "get")], "I-ACCEPT-INVALID", [],
+    "Latent under current spec: comma-separated numeric filters are declared strings. Removing the explicit parser guard changes code intent, but INVALID_ACCEPTED needs an encoded spec constraint. Exclude from detection denominator until a non-spec-changing oracle/witness is justified.",
+    "Send ages=not-an-integer to demonstrate the removed guard; report semantic-only survival if original spec accepts it.")
+before = '''public RolesView roles() {
+        return new RolesView(
+                Stream.of(Permission.values()).collect(Collectors.toMap(Enum::name, Permission::getLevel)),
+                Stream.of(Role.values()).collect(Collectors.toMap(Enum::name, Role::getLevel))
+        );
+    }'''
+after = before.replace("public RolesView", "public Response").replace("return new RolesView(", "return Response.status(418).entity(new RolesView(").replace("        );", "        )).build();")
+add("scout-api", "scout-wrong-status", "WRONG_STATUS", SC + "SystemResource.java", before, after,
+    [("/v1/system/roles", "get")], "I-RESP-CONTRACT", ["UNDOCUMENTED_STATUS"],
+    "This operation declares only 200; 418 has no default fallback. Confirm body unchanged and original 200 witness.",
+    "GET /api/v1/system/roles with the same headers against clean baseline and mutant.", True)
+add("scout-api", "scout-drop-null", "DROP_NULL_CHECK", SD + "dao/TagDao.java",
+    "if (name != null) {", "if (true) {", [("/v2/tags", "get")], "I-CRASH", ["SERVER_ERROR"],
+    "Absent optional name reaches name.toUpperCase(); original skips the filter. Verify original request succeeds; group/name mutations can share an existing SERVER_ERROR fingerprint.",
+    "GET /api/v2/tags without name; preserve optional attrs behavior and inspect the new stack.", True)
+add("scout-api", "scout-response-field", "RESP_FIELD", SC + "SystemResource.java",
+    "public Map<String, Integer> getPermissionLevels() {",
+    "@com.fasterxml.jackson.annotation.JsonProperty(access = com.fasterxml.jackson.annotation.JsonProperty.Access.WRITE_ONLY)\n        public Map<String, Integer> getPermissionLevels() {",
+    [("/v1/system/roles", "get")], "I-RESP-CONTRACT", [],
+    "Dropping permission_levels is invisible to the current default schema because neither RolesView field is required. Strict additional-property policy does not detect an absent optional field. Keep as an oracle-blind negative control, not a claimed killed mutant.",
+    "Compare raw JSON key presence, separately from conformance. Do not strengthen the test spec.")
+add("scout-api", "scout-reject-valid", "REJECT_VALID", SC + "TagResource.java",
+    "return okResponse(dao.find(group, name, minActivitiesCount), attrs);",
+    'if (group == null) { throw new javax.ws.rs.BadRequestException("E5 requires optional group"); }\n        return okResponse(dao.find(group, name, minActivitiesCount), attrs);',
+    [("/v2/tags", "get")], "I-REJECT-VALID", ["VALID_REJECTED"],
+    "group is optional. Use an original 2xx witness without group; default/SUT rejection oracle includes 400.",
+    "GET /api/v2/tags without group against fresh identical seed state.", True)
+
+add("swagger-petstore", "petstore-drop-validation", "DROP_VALIDATION", PC + "controller/OrderController.java",
+    "if (order == null) {", "if (false) {", [("/store/order", "post")], "I-CRASH", ["SERVER_ERROR"],
+    "Removing the explicit empty-order guard lets null reach OrderData.addOrder. Framework request validation may reject first: verify handler reachability before treating survival as an attribution miss.",
+    "Empty order request; compare the original 400 with a mutant stack, and report framework-preempted if the handler is never invoked.")
+add("swagger-petstore", "petstore-wrong-status", "WRONG_STATUS", PC + "controller/OrderController.java",
+    "public ResponseContext getInventory(final RequestContext request) {\n        return new ResponseContext()",
+    "public ResponseContext getInventory(final RequestContext request) {\n        return new ResponseContext().status(418)",
+    [("/store/inventory", "get")], "I-RESP-CONTRACT", [],
