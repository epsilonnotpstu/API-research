+    strict_args=()
+    [[ -n ${STRICT_KEYWORDS:-} ]] || return 0
+    [[ $1 == REQUEST_STRICT ]] || { echo 'STRICT_KEYWORDS requires REQUEST_STRICT' >&2; return 2; }
