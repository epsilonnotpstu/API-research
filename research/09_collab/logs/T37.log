cp "$test_spec" "$run_dir/spec.test.${test_spec##*.}"
# Keep both the effective compose configuration and immutable image IDs/digests.
"${compose[@]}" config >"$run_dir/compose.resolved.yaml"
if [[ $PILOT_FUZZER == evomaster ]]; then
