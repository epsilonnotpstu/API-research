class RedactionTests(unittest.TestCase):
    def test_streaming_and_saved_recursive_outputs(self):
        header = 'Authorization: Bearer synthetic-t27-credential'
        with patch.dict(os.environ, {'PILOT_AUTH_REDACT': header}, clear=True):
            needles = REDACTOR.secrets()
            raw = (header + '\nBearer synthetic-t27-credential\nsynthetic-t27-credential\n').encode()
            self.assertEqual(REDACTOR.clean(raw, needles), b'<redacted>\n<redacted>\n<redacted>\n')
            stream = subprocess.run(['/usr/bin/python3', '-I', '-B', str(HERE / 'redact_auth.py')],
                                    input=raw, capture_output=True, env=dict(os.environ), check=True)
            self.assertEqual(stream.stdout, b'<redacted>\n<redacted>\n<redacted>\n')
            with tempfile.TemporaryDirectory(prefix='t27-redact-') as directory:
                root = Path(directory)
                (root / 'evomaster' / 'tests').mkdir(parents=True)
                for name in ('evomaster.log', 'evomaster/tests/Test.java', 'evomaster/statistics.csv'):
                    (root / name).write_bytes(raw)
                with patch.object(sys, 'argv', ['redact_auth.py', directory]):
                    REDACTOR.main()
                self.assertTrue(all(b'synthetic-t27-credential' not in p.read_bytes()
                                    for p in root.rglob('*') if p.is_file()))

    def test_empty_auth_is_noop(self):
        with patch.dict(os.environ, {'PILOT_AUTH_REDACT': ''}, clear=True):
            self.assertEqual(REDACTOR.clean(b'public', REDACTOR.secrets()), b'public')


class MetadataTests(unittest.TestCase):
    def metadata(self, fuzzer, code, schema_oracles=None, generator_input=None):
        with tempfile.TemporaryDirectory(prefix='t27-metadata-') as directory:
            root = Path(directory)
            run, emb = root / 'run', root / '_external/emb'
            run.mkdir()
            emb.mkdir(parents=True)
            (run / 'generator-input.json').write_text('synthetic derecursed input\n')
            (run / 'spec.test.json').write_text('synthetic oracle input\n')
            (run / 'evomaster').mkdir()
            (run / 'evomaster' / 'statistics.csv').write_text('synthetic\n')
            (run / 'evomaster-argv.txt').write_text('--header0\n<redacted>\n')
            (run / 'schema-image.json').write_text(json.dumps([{'Id': 'sha256:synthetic', 'RepoDigests': ['synthetic@sha256:123']}]))
            values = {'PILOT_FUZZER': fuzzer, 'PILOT_AUTH_ROLE': 'none', 'SCHEMA_CHECKS': 'all',
                      'SUT_SERVICE': 'sut-synthetic', 'SUT_IMAGE': 'synthetic', 'INTERNAL_PORT': '8080',
                      'COMPOSE_FILE': 'synthetic.yaml', 'DOCKERFILE': 'synthetic.dockerfile',
                      'PILOT_AUTH_SOURCE': 'none', 'MITM_MAX_BODY': '65536', 'HOST_PORT': '127.0.0.1:18080',
                      'JACOCO_PORT': '127.0.0.1:16300', 'PILOT_EVOMASTER_IMAGE': 'synthetic@sha256:123',
                      'PILOT_EVOMASTER_VERSION': '6.2.0'}
            if generator_input is not None:
                values['PILOT_EVOMASTER_INPUT'] = generator_input
            if schema_oracles is not None:
                values['PILOT_EVOMASTER_SCHEMA_ORACLES'] = schema_oracles
            argv = ['run_metadata.py', str(run), str(emb), 'synthetic', str(root / 'source.json'),
                    'baseline', 'NONE', '0', '7', '300', '100', 'synthetic@sha256:123',
                    'project', 'start', 'complete', code, '0', '0', '0' if code in ('0', '1') else code,
                    '/health', '/']
            with patch.dict(os.environ, values, clear=True), patch.object(sys, 'argv', argv), \
                    patch.object(METADATA.subprocess, 'check_output', side_effect=['synthetic-commit\n', '']):
                METADATA.main()
            return json.loads((run / 'run.json').read_text())

    def test_evomaster_identity_redacted_argv_and_nested_hashes(self):
        data = self.metadata('evomaster', '1')
        self.assertEqual(data['fuzzer'], 'evomaster')
        self.assertEqual(data['evomaster_version'], '6.2.0')
        self.assertEqual(data['evomaster_image'], 'synthetic@sha256:123')
        self.assertEqual(data['evomaster_exit'], '1')
        self.assertEqual(data['schemathesis_exit'], 'not_started')
        self.assertEqual(data['evomaster_argv'], ['--header0', '<redacted>'])
        self.assertEqual(data['evomaster_watchdog_seconds'], 420)
        self.assertTrue(data['complete'])
        self.assertIn('evomaster/statistics.csv', data['file_sha256'])
        self.assertIn('schema-image', data['images'])

    def test_default_metadata_has_unchanged_generator_fields(self):
        data = self.metadata('schemathesis', '1')
        self.assertEqual(data['schemathesis_exit'], '1')
        self.assertTrue(data['complete'])
        self.assertNotIn('evomaster_exit', data)
        self.assertNotIn('evomaster_schema_oracles', data)
        self.assertNotIn('evomaster/statistics.csv', data['file_sha256'])

    def test_schema_oracles_metadata_is_boolean_and_evomaster_only(self):
        for setting, expected in ((None, True), ('true', True), ('false', False)):
            with self.subTest(setting=setting):
                data = self.metadata('evomaster', '0', schema_oracles=setting)
                self.assertIs(data['evomaster_schema_oracles'], expected)
        self.assertNotIn('evomaster_schema_oracles',
                         self.metadata('schemathesis', '0', schema_oracles='false'))

    def test_input_metadata_hashes_actual_schema_and_preserves_limitations(self):
        for setting in (None, 'spec', 'derecursed'):
            with self.subTest(setting=setting):
                data = self.metadata('evomaster', '0', generator_input=setting)
                self.assertEqual(data['evomaster_input'], setting or 'spec')
                derecursed = setting == 'derecursed'
                content = 'synthetic derecursed input\n' if derecursed else 'synthetic oracle input\n'
                self.assertEqual(data['generator_input_sha256'], hashlib.sha256(content.encode()).hexdigest())
                for prefix in ('generator schema back edges', 'equal mutation operation sets'):
                    self.assertEqual(any(line.startswith(prefix) for line in data['limitations']), derecursed)
                self.assertEqual(any('EvoMaster uses spec.test unchanged' in line
                                     for line in data['limitations']), not derecursed)
        data = self.metadata('schemathesis', '0')
        self.assertNotIn('evomaster_input', data)
        self.assertEqual(data['generator_input_sha256'],
                         hashlib.sha256(b'synthetic derecursed input\n').hexdigest())

    def test_timeout_metadata_is_incomplete(self):
        data = self.metadata('evomaster', '124')
        self.assertEqual(data['evomaster_exit'], '124')
        self.assertFalse(data['complete'])


