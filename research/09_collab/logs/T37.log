    cp "${gen[0]%.manifest.json}.json" "$run_dir/generator-input.json"
else
    /usr/bin/python3 -I -B "$HERE/derecurse.py" "$test_spec" "$run_dir/generator-input.json" >"$run_dir/derecurse-cuts.json"
fi
schema_cmd[1]="/work/generator-input.json"
}
