+    for keyword in "${keywords[@]}"; do
+        [[ $seen != *",$keyword,"* ]] || { echo 'Invalid STRICT_KEYWORDS' >&2; return 2; }
+        seen+="$keyword,"
+    done
+    strict_args=(--strict-keywords "$STRICT_KEYWORDS")
