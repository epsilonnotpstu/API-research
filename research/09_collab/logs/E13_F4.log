494: func (q *RelationQuery) ToURLQuery() url.Values {
495: 	v := make(url.Values, 4)
496: 
497: 	if q.Namespace != "" {
498: 		v.Add("namespace", q.Namespace)
499: 	}
500: 	if q.Relation != "" {
501: 		v.Add("relation", q.Relation)
502: 	}
503: 	if q.Object != "" {
504: 		v.Add("object", q.Object)
505: 	}
506: 	if q.SubjectID != nil {
507: 		v.Add(subjectIDKey, *q.SubjectID)
508: 	} else if q.SubjectSet != nil {
509: 		v.Add(subjectSetNamespaceKey, q.SubjectSet.Namespace)
510: 		v.Add(subjectSetObjectKey, q.SubjectSet.Object)
511: 		v.Add(subjectSetRelationKey, q.SubjectSet.Relation)
512: 	}
513: 
514: 	return v
515: }
