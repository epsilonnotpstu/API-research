672:     public Response submitParameterContextUpdate(
673:             @PathParam("contextId") final String contextId,
674:             @Parameter(description = "The updated version of the parameter context.", required = true) final ParameterContextEntity requestEntity) {
675: 
676:         if (requestEntity == null) {
677:             throw new IllegalArgumentException("Parameter Context must be specified.");
678:         }
679: 
680:         // Verify the request
681:         final RevisionDTO revisionDto = requestEntity.getRevision();
682:         if (revisionDto == null) {
683:             throw new IllegalArgumentException("Parameter Context Revision must be specified");
684:         }
685: 
686:         final ParameterContextDTO contextDto = requestEntity.getComponent();
687:         if (contextDto == null) {
688:             throw new IllegalArgumentException("Parameter Context must be specified");
689:         }
690: 
691:         if (contextDto.getId() == null) {
692:             throw new IllegalArgumentException("Parameter Context's ID must be specified");
693:         }
694:         if (!contextDto.getId().equals(contextId)) {
695:             throw new IllegalArgumentException("ID of Parameter Context in message body does not match Parameter Context ID supplied in URI");
696:         }
697: 
698:         validateParameterNames(contextDto);
699:         validateAssetReferences(contextDto);
700: 
701:         // We will perform the updating of the Parameter Context in a background thread because it can be a long-running process.
702:         // In order to do this, we will need some objects that are only available as Thread-Local variables to the current
703:         // thread, so we will gather the values for these objects up front.
704:         final boolean replicateRequest = isReplicateRequest();
705:         final ComponentLifecycle componentLifecycle = replicateRequest ? clusterComponentLifecycle : localComponentLifecycle;
706:         final NiFiUser user = NiFiUserUtils.getNiFiUser();
707: 
708:         // Workflow for this process:
709:         // 1. Determine which components will be affected and are enabled/running
710:         // 2. Verify READ and WRITE permissions for user, for every component that is affected
711:         // 3. Verify READ and WRITE permissions for user, for Parameter Context
712:         // 4. Stop all Processors that are affected.
713:         // 5. Wait for all of the Processors to finish stopping.
714:         // 6. Disable all Controller Services that are affected.
715:         // 7. Wait for all Controller Services to finish disabling.
716:         // 8. Update Parameter Context
717:         // 9. Re-Enable all affected Controller Services
718:         // 10. Re-Start all Processors
719: 
720:         final Set<AffectedComponentEntity> affectedComponents = serviceFacade.getComponentsAffectedByParameterContextUpdate(Collections.singletonList(contextDto));
721:         logger.debug("Received Update Request for Parameter Context: {}; the following {} components will be affected: {}", requestEntity, affectedComponents.size(), affectedComponents);
722: 
723:         final InitiateChangeParameterContextRequestWrapper requestWrapper = new InitiateChangeParameterContextRequestWrapper(requestEntity, componentLifecycle, getAbsolutePath(),
724:                 affectedComponents, replicateRequest, user);
725: 
726:         final Revision requestRevision = getRevision(requestEntity.getRevision(), contextDto.getId());
727:         return withWriteLock(
728:                 serviceFacade,
729:                 requestWrapper,
730:                 requestRevision,
731:                 lookup -> {
732:                     // Verify READ and WRITE permissions for user, for the Parameter Context itself
733:                     authorizeReadWriteParameterContext(contextId);
734: 
735:                     // Verify READ and WRITE permissions for user, for every component that is affected
736:                     affectedComponents.forEach(component -> parameterUpdateManager.authorizeAffectedComponent(component, lookup, user, true, true));
737: 
738:                     final ParameterContext parameterContext = lookup.getParameterContext(contextId);
739:                     validateControllerServiceReferences(requestEntity, lookup, parameterContext, user);
740:                 },
741:                 () -> {
742:                     // Verify Request
743:                     serviceFacade.verifyUpdateParameterContext(contextDto, false);
744:                 },
745:                 this::submitUpdateRequest
746:         );
747:     }
