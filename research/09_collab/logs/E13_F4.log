805:     private void validateAssetReferences(final ParameterContextDTO parameterContextDto) {
806:         if (parameterContextDto.getParameters() != null) {
807:             for (final ParameterEntity entity : parameterContextDto.getParameters()) {
808:                 if (Boolean.TRUE.equals(entity.getParameter().getInherited())) {
809:                     continue;
810:                 }
811: 
812:                 final List<AssetReferenceDTO> referencedAssets = entity.getParameter().getReferencedAssets();
813:                 if (referencedAssets == null) {
814:                     continue;
815:                 }
816: 
817:                 for (final AssetReferenceDTO referencedAsset : referencedAssets) {
818:                     if (StringUtils.isBlank(referencedAsset.getId())) {
819:                         throw new IllegalArgumentException("Asset reference id cannot be blank");
820:                     }
821:                     final Asset asset = assetManager.getAsset(referencedAsset.getId())
822:                             .orElseThrow(() -> new IllegalArgumentException("Request contains a reference to an Asset (%s) that does not exist".formatted(referencedAsset)));
823:                     if (!asset.getOwnerIdentifier().equals(parameterContextDto.getId())) {
824:                         throw new IllegalArgumentException("Request contains a reference to an Asset (%s) that does not exist in Parameter Context (%s)"
825:                                 .formatted(referencedAsset, parameterContextDto.getId()));
826:                     }
827:                 }
828: 
829:                 if (!referencedAssets.isEmpty() && entity.getParameter().getValue() != null) {
830:                     throw new IllegalArgumentException(
831:                         "Request contains a Parameter (%s) with both a value and a reference to an Asset. A Parameter may have either a value or a reference to an Asset, but not both."
832:                             .formatted(entity.getParameter().getName()));

