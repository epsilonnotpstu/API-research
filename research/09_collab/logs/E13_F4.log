204:     @Override
205:     public Project createProject(final Project project, Collection<Tag> tags, boolean commitIndex) {
206:         return callInTransaction(() -> {
207:             if (project.getParent() != null && project.getParent().getInactiveSince() != null) {
208:                 throw new IllegalArgumentException("An inactive Parent cannot be selected as parent");
209:             }
210: 
211:             if (project.getCollectionLogic() == ProjectCollectionLogic.AGGREGATE_DIRECT_CHILDREN_WITH_TAG) {
212:                 if (project.getCollectionTag() == null) {
213:                     throw new IllegalArgumentException(
214:                             "A collection tag must be specified for AGGREGATE_DIRECT_CHILDREN_WITH_TAG logic.");
215:                 }
216: 
217:                 final Set<Tag> resolvedCollectionTags = resolveTags(List.of(project.getCollectionTag()));
218:                 project.setCollectionTag(resolvedCollectionTags.iterator().next());
219:             } else {
220:                 project.setCollectionTag(null);
221:             }
222: 
223:             // Remove isLatest flag from current latest project version, if the new project will be the latest
224:             final Project oldLatestProject = project.isLatest() ? getLatestProjectVersion(project.getName()) : null;
225:             if (oldLatestProject != null) {
226:                 oldLatestProject.setIsLatest(false);
227: 
228:                 // Ensure the change is flushed to the database before the new project
229:                 // record is created. Necessary to prevent unique constraint violation.
230:                 pm.flush();
231:             }
232: 
233:             // NB: Prevent JDO from implicitly creating any tags already assigned to the project object.
234:             project.setTags(null);
