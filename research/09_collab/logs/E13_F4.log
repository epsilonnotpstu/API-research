105:     @POST
106:     @Consumes(MediaType.MULTIPART_FORM_DATA)
107:     @Produces(MediaType.APPLICATION_JSON)
108:     @ApiOperation(
109:             value = "Upload a supported bil of material format document",
110:             notes = "Expects CycloneDX or SPDX (text or RDF) along and a valid project UUID. If a UUID is not specified, than the projectName and projectVersion must be specified. Optionally, if autoCreate is specified and 'true' and the project does not exist, the project will be created. In this scenario, the principal making the request will additionally need the PORTFOLIO_MANAGEMENT or PROJECT_CREATION_UPLOAD permission."
111:     )
112:     @ApiResponses(value = {
113:             @ApiResponse(code = 401, message = "Unauthorized"),
114:             @ApiResponse(code = 404, message = "The project could not be found")
115:     })
116:     @PermissionRequired(Permissions.Constants.SCAN_UPLOAD)
117:     public Response uploadScan(@FormDataParam("project") String projectUuid,
118:                                @DefaultValue("false") @FormDataParam("autoCreate") boolean autoCreate,
119:                                @FormDataParam("projectName") String projectName,
120:                                @FormDataParam("projectVersion") String projectVersion,
121:                                final FormDataMultiPart multiPart) {
122: 
123:         final List<FormDataBodyPart> artifactParts = multiPart.getFields("bom");
124:         if (projectUuid != null) { // behavior in v3.0.0
125:             try (QueryManager qm = new QueryManager()) {
126:                 final Project project = qm.getObjectByUuid(Project.class, projectUuid);
127:                 return process(project, artifactParts);
138:                 }
139:                 return process(project, artifactParts);
140:             }
141:         }
142:     }
143: 
144:     /**
145:      * Common logic that processes a BoM given a project and encoded payload.
146:      */
147:     private Response process(Project project, String encodedBomData) {
148:         if (project != null) {
149:             final byte[] decoded = Base64.getDecoder().decode(encodedBomData);
150:             Event.dispatch(new BomUploadEvent(project.getUuid(), decoded));
151:             return Response.ok().build();
152:         } else {
153:             return Response.status(Response.Status.NOT_FOUND).entity("The project could not be found.").build();
154:         }
155:     }
156: 
157:     /**
158:      * Common logic that processes a BoM given a project and list of multi-party form objects containing decoded payloads.
159:      */
160:     private Response process(Project project, List<FormDataBodyPart> artifactParts) {
161:         for (FormDataBodyPart artifactPart: artifactParts) {
162:             BodyPartEntity bodyPartEntity = (BodyPartEntity) artifactPart.getEntity();
163:             if (project != null) {
164:                 try {
165:                     final byte[] content = IOUtils.toByteArray(bodyPartEntity.getInputStream());
166:                     // todo: make option to combine all the bom data so components are reconciled in a single pass.
167:                     // todo: https://github.com/DependencyTrack/dependency-track/issues/130
168:                     Event.dispatch(new ScanUploadEvent(project.getUuid(), content));
169:                 } catch (IOException e) {
170:                     return Response.status(Response.Status.BAD_REQUEST).build();
171:                 }
172:             } else {
173:                 return Response.status(Response.Status.NOT_FOUND).entity("The project could not be found.").build();
174:             }
175:         }
176:         return Response.ok().build();
177:     }
