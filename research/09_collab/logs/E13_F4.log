174: func (h *RestreamHandler) Update(c echo.Context) error {
175: 	id := util.PathParam(c, "id")
176: 
177: 	process := api.ProcessConfig{
178: 		ID:        id,
179: 		Type:      "ffmpeg",
180: 		Autostart: true,
181: 	}
182: 
183: 	if err := util.ShouldBindJSON(c, &process); err != nil {
184: 		return api.Err(http.StatusBadRequest, "Invalid JSON", "%s", err)
185: 	}
186: 
187: 	config := process.Marshal()
188: 
189: 	if err := h.restream.UpdateProcess(id, config); err != nil {
190: 		return api.Err(http.StatusBadRequest, "Process can't be updated", "%s", err)
191: 	}
192: 
193: 	p, _ := h.getProcess(config.ID, "config")
194: 
195: 	return c.JSON(http.StatusOK, p.Config)
196: }
