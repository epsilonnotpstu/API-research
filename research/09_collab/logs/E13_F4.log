424: func (q *RelationQuery) FromProto(query TupleData) (*RelationQuery, error) {
425: 	q.Namespace = query.GetNamespace()
426: 	q.Object = query.GetObject()
427: 	q.Relation = query.GetRelation()
428: 	// reset subject
429: 	q.SubjectID = nil
430: 	q.SubjectSet = nil
431: 
453: 	subjectSetObjectKey    = "subject_set.object"
