145:     public static ChatRequestBody from(final Map<String, Object> raw, final int maxMessageLength) throws IOException {
146:         final String message = trimmedOrNull(raw.get("message"));
147:         final String sessionId = trimmedOrNull(raw.get("session_id"));
148:         if (message != null && message.length() > maxMessageLength) {
149:             throw new MessageTooLongException("message exceeds max length: " + message.length() + " > " + maxMessageLength);
150:         }
151:         final Map<String, List<String>> warnings = new HashMap<>();
152:         final ChatApiHelper chatApiHelper = ComponentUtil.getChatApiHelper();
153:         final Map<String, String[]> fields = chatApiHelper.parseFieldFilters(raw, warnings);
154:         final String[] extraQueries = chatApiHelper.parseExtraQueries(raw, warnings);
155:         return new ChatRequestBody(message, sessionId, fields, extraQueries, warnings);
156:     }
