155:     /**
156:      * Renames a tag: the tag of the new name is created with the paths, permissions, virtual host and sort order of
157:      * the old one, the old one is deleted, and the rename of the value on the documents is queued. When the caller
158:      * has a tag of the new name already, nothing changes. The old tag is deleted only if it did not change since it
159:      * was read; otherwise the new tag is removed again and the rename is retried on a fresh read, so that a URL
160:      * added to the old tag meanwhile is carried over.
161:      */
162:     private TagType renameTag(final TagType read, final String name, final Boolean shared, final String userId) throws TagRequestException {
163:         final TagTypeHelper helper = getTagTypeHelper();
164:         TagType current = read;
165:         for (int attempt = 1;; attempt++) {
166:             if (attempt > 1) {
167:                 current = getOwnTagType(read.getId(), userId);
168:             }
169:             final TagType renamed = new TagType();
170:             renamed.setName(name);
171:             renamed.setOwner(current.getOwner());
177:             renamed.setSortOrder(current.getSortOrder());
178:             renamed.setCreatedBy(current.getCreatedBy());
179:             renamed.setCreatedTime(current.getCreatedTime());
180:             renamed.setUpdatedBy(userId);
181:             renamed.setUpdatedTime(ComponentUtil.getSystemHelper().getCurrentTimeAsLong());
182:             final boolean replaced;
183:             try {
184:                 replaced = getTagTypeService().replace(current, renamed);
185:             } catch (final TagTypeConflictException e) {
186:                 throw new TagRequestException(V2ErrorCode.CONFLICT, "a tag with the name already exists");
187:             }
188:             if (!replaced) {
189:                 if (attempt >= MAX_UPDATE_ATTEMPTS) {
190:                     logger.warn("Failed to rename the tag after {} attempts: id={}", attempt, read.getId());
191:                     throw new TagRequestException(V2ErrorCode.CONFLICT, "the tag was changed concurrently; try again");
192:                 }
193:                 if (logger.isDebugEnabled()) {
194:                     logger.debug("The tag was changed concurrently; retrying the rename: id={}, attempt={}", read.getId(), attempt);
195:                 }
196:                 continue;
197:             }
198:             enqueue(TagChange.rename(current.getTagValue(), renamed.getTagValue()));
199:             return renamed;
200:         }
201:     }
