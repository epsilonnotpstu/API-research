591: 	flagID := util.SafeUint(params.FlagID)
592: 	subject := getSubjectFromRequest(params.HTTPRequest)
593: 	cons := &entity.Constraint{}
594: 	cons.SegmentID = uint(params.SegmentID)
595: 	if params.Body != nil {
596: 		cons.Property = util.SafeString(params.Body.Property)
597: 		cons.Operator = util.SafeString(params.Body.Operator)
598: 		cons.Value = util.SafeString(params.Body.Value)
599: 	}
600: 	if err := cons.Validate(); err != nil {
601: 		return constraint.NewCreateConstraintDefault(400).WithPayload(ErrorMessage("%s", err))
602: 	}
603: 
604: 	err := commitFlagMutation(flagID, subject, notification.OperationCreate, notification.ComponentConstraint, func(tx *gorm.DB) (uint, mutationNotify, error) {
605: 		if err := tx.Create(cons).Error; err != nil {
606: 			return 0, mutationNotify{}, err
607: 		}
608: 		return flagID, mutationNotify{ComponentID: cons.ID, ComponentKey: ""}, nil
609: 	})
610: 	if err != nil {
611: 		return constraint.NewCreateConstraintDefault(500).WithPayload(ErrorMessage("%s", err))
612: 	}
613: 
614: 	resp := constraint.NewCreateConstraintOK()
615: 	resp.SetPayload(e2r.MapConstraint(cons))
616: 	return resp
617: }
