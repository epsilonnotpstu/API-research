128: func isBlank(value reflect.Value) bool {
129: 	switch value.Kind() {
130: 	case reflect.String:
131: 		return value.Len() == 0
132: 	case reflect.Bool:
133: 		return !value.Bool()
134: 	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
135: 		return value.Int() == 0
136: 	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Uintptr:
137: 		return value.Uint() == 0
138: 	case reflect.Float32, reflect.Float64:
139: 		return value.Float() == 0
140: 	case reflect.Interface, reflect.Ptr:
141: 		return value.IsNil()
142: 	}
143: 
144: 	return reflect.DeepEqual(value.Interface(), reflect.Zero(value.Type()).Interface())
145: }
