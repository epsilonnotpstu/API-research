110: func (h *Handler) List(factory func(context.Context, *http.Request, httprouter.Params) (*ListRequest, error)) httprouter.Handle {
111: 	return func(w http.ResponseWriter, r *http.Request, ps httprouter.Params) {
112: 		ctx := r.Context()
113: 		l, err := factory(ctx, r, ps)
114: 		if err != nil {
115: 			h.h.WriteError(w, r, err)
116: 			return
117: 		}
118: 		limit, offset := pagination.Parse(r, 100, 0, 500)
119: 
120: 		if err := h.s.List(ctx, l.Collection, l.Value, limit, offset); err != nil {
121: 			h.h.WriteError(w, r, err)
122: 			return
123: 		}
124: 
125: 		m := r.URL.Query()
126: 		h.h.Write(w, r, l.Filter(m).Value)
127: 	}
128: }
