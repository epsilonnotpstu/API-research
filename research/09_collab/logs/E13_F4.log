189: 	query, err := (&RelationQuery{}).FromURLQuery(q)
190: 	if err != nil {
191: 		h.d.Writer().WriteError(w, r, herodot.ErrBadRequest.WithError(err.Error()))
192: 		return
193: 	}
194: 
195: 	l := h.d.Logger()
196: 	for k := range q {
197: 		l = l.WithField(k, q.Get(k))
198: 	}
199: 	l.Debug("deleting relation tuples")
200: 
201: 	if err := h.d.RelationTupleManager().DeleteAllRelationTuples(r.Context(), query); err != nil {
202: 		l.WithError(err).Errorf("got an error while deleting relation tuples")
203: 		h.d.Writer().WriteError(w, r, herodot.ErrInternalServerError.WithError(err.Error()))
204: 		return
205: 	}
206: 
207: 	w.WriteHeader(http.StatusNoContent)
208: }
