110: // MustAuthWithoutAccountAvailable auth user info, any login user can access though user is not active.
111: func (am *AuthUserMiddleware) MustAuthWithoutAccountAvailable() gin.HandlerFunc {
112: 	return func(ctx *gin.Context) {
113: 		token := ExtractToken(ctx)
114: 		if len(token) == 0 {
115: 			handler.HandleResponse(ctx, errors.Unauthorized(reason.UnauthorizedError), nil)
116: 			ctx.Abort()
117: 			return
118: 		}
119: 		userInfo, err := am.authService.GetUserCacheInfo(ctx, token)
120: 		if err != nil || userInfo == nil {
121: 			handler.HandleResponse(ctx, errors.Unauthorized(reason.UnauthorizedError), nil)
122: 			ctx.Abort()
123: 			return
124: 		}
125: 		if userInfo.UserStatus == entity.UserStatusDeleted {
126: 			handler.HandleResponse(ctx, errors.Unauthorized(reason.UnauthorizedError), nil)
127: 			ctx.Abort()
128: 			return
129: 		}
130: 		ctx.Set(ctxUUIDKey, userInfo)
131: 		ctx.Next()
132: 	}
133: }
134: 
135: // MustAuthAndAccountAvailable auth user info and check user status, only allow active user access.
136: func (am *AuthUserMiddleware) MustAuthAndAccountAvailable() gin.HandlerFunc {
137: 	return func(ctx *gin.Context) {
138: 		token := ExtractToken(ctx)
139: 		if len(token) == 0 {
140: 			handler.HandleResponse(ctx, errors.Unauthorized(reason.UnauthorizedError), nil)
141: 			ctx.Abort()
142: 			return
143: 		}
144: 		userInfo, err := am.authService.GetUserCacheInfo(ctx, token)
145: 		if err != nil || userInfo == nil {
146: 			handler.HandleResponse(ctx, errors.Unauthorized(reason.UnauthorizedError), nil)
147: 			ctx.Abort()
148: 			return
149: 		}
150: 		if userInfo.EmailStatus != entity.EmailStatusAvailable {
151: 			handler.HandleResponse(ctx, errors.Forbidden(reason.EmailNeedToBeVerified),
152: 				&schema.ForbiddenResp{Type: schema.ForbiddenReasonTypeInactive})
153: 			ctx.Abort()
154: 			return
155: 		}
156: 		if userInfo.UserStatus == entity.UserStatusSuspended {
157: 			handler.HandleResponse(ctx, errors.Forbidden(reason.UserSuspended),
158: 				&schema.ForbiddenResp{Type: schema.ForbiddenReasonTypeUserSuspended})

