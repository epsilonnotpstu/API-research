49:     @GET
50:     public Collection<Position> getJson(
51:             @QueryParam("deviceId") long deviceId, @QueryParam("id") List<Long> positionIds,
52:             @QueryParam("from") String from, @QueryParam("to") String to)
53:             throws SQLException {
54:         if (!positionIds.isEmpty()) {
55:             ArrayList<Position> positions = new ArrayList<>();
56:             for (Long positionId : positionIds) {
57:                 Position position = Context.getDataManager().getObject(Position.class, positionId);
58:                 Context.getPermissionsManager().checkDevice(getUserId(), position.getDeviceId());
59:                 positions.add(position);
60:             }
61:             return positions;
62:         } else if (deviceId == 0) {
63:             return Context.getDeviceManager().getInitialState(getUserId());
64:         } else {
65:             Context.getPermissionsManager().checkDevice(getUserId(), deviceId);
66:             return Context.getDataManager().getPositions(
67:                     deviceId, DateUtil.parseDate(from), DateUtil.parseDate(to));
68:         }
69:     }
70: 
71:     @GET
72:     @Produces(TEXT_CSV)
73:     public Response getCsv(
74:             @QueryParam("deviceId") long deviceId, @QueryParam("from") String from, @QueryParam("to") String to)
75:             throws SQLException {
76:         Context.getPermissionsManager().checkDevice(getUserId(), deviceId);
77:         CsvBuilder csv = new CsvBuilder();
78:         csv.addHeaderLine(new Position());
79:         csv.addArray(Context.getDataManager().getPositions(
80:                 deviceId, DateUtil.parseDate(from), DateUtil.parseDate(to)));
81:         return Response.ok(csv.build()).header(HttpHeaders.CONTENT_DISPOSITION, CONTENT_DISPOSITION_VALUE_CSV).build();
82:     }
83: 
84:     @GET
85:     @Produces(GPX)
86:     public Response getGpx(
87:             @QueryParam("deviceId") long deviceId, @QueryParam("from") String from, @QueryParam("to") String to)
88:             throws SQLException {
89:         Context.getPermissionsManager().checkDevice(getUserId(), deviceId);
90:         GpxBuilder gpx = new GpxBuilder(Context.getIdentityManager().getById(deviceId).getName());
91:         gpx.addPositions(Context.getDataManager().getPositions(
92:                 deviceId, DateUtil.parseDate(from), DateUtil.parseDate(to)));
93:         return Response.ok(gpx.build()).header(HttpHeaders.CONTENT_DISPOSITION, CONTENT_DISPOSITION_VALUE_GPX).build();
94:     }
