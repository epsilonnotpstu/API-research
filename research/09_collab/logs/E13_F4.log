56: public class ScanUploadProcessingTask implements Subscriber {
57: 
58:     private static final Logger LOGGER = Logger.getLogger(ScanUploadProcessingTask.class);
59: 
65:      * {@inheritDoc}
66:      */
67:     public void inform(Event e) {
68:         if (e instanceof ScanUploadEvent) {
69:             final ScanUploadEvent event = (ScanUploadEvent) e;
70: 
71:             final File file = event.getFile();
72:             final byte[] scanData = CompressUtil.optionallyDecompress(event.getScan());
73:             try {
74:                 final Analysis analysis = (file != null)
75:                         ? new DependencyCheckParser().parse(file)
76:                         : new DependencyCheckParser().parse(scanData);
77:                 qm = new QueryManager();
78:                 final Project project = qm.getObjectByUuid(Project.class, event.getProjectUuid());
79:                 final Date date = new Date();
80:                 scan = qm.createScan(project, analysis.getProjectInfo().getReportDate(), date);
81: 
82:                 for (Dependency dependency : analysis.getDependencies()) {
83:                     processDependency(dependency);
84:                 }
85: 
86:                 qm.reconcileDependencies(project, components);
87:                 qm.updateLastScanImport(project, date);
88: 
89:                 Event.dispatch(new VulnerabilityAnalysisEvent(components).project(project));
90:             } catch (Exception ex) {
91:                 LOGGER.error("Error while processing scan result", ex);
92:             } finally {
98:         }
99:     }
100: 
101:     private void processDependency(Dependency dependency) {
102:         // Attempt to resolve component
103:         final ComponentResolver componentResolver = new ComponentResolver(qm);
104:         Component component = componentResolver.resolve(dependency);
105: 
106:         // Attempt to resolve license
107:         final LicenseResolver licenseResolver = new LicenseResolver(qm);
108:         final License resolvedLicense = licenseResolver.resolve(dependency);
109: 
110:         if (component == null) {
111:             // Component could not be resolved (was null), so create a new component
112:             component = new Component();
113:             resolveMetadata(component, dependency, resolvedLicense);
114:             component = qm.createComponent(component, false);
115:             Event.dispatch(new RepositoryMetaEvent(component));
116:         } else {
117:             resolveMetadata(component, dependency, resolvedLicense);
118:             component = qm.updateComponent(component, false);
119:         }
120: 
121:         if (dependency.getVulnerabilities() != null && dependency.getVulnerabilities().getVulnerabilities() != null) {
122:             for (org.dependencytrack.parser.dependencycheck.model.Vulnerability dcvuln: dependency.getVulnerabilities().getVulnerabilities()) {
123: 
124:                 /*
125:                  * Resolve the source of the vulnerability. The source as defined in ODC needs to be
126:                  * the same as the source identified in ODT. Defaults to NVD since older versions of
127:                  * ODC did not support the 'source' attribute and only used the NVD.
128:                  */
129:                 Vulnerability.Source source = Vulnerability.Source.NVD;
130:                 if (dcvuln.getSource() != null) {
131:                     source = Vulnerability.Source.valueOf(dcvuln.getSource().toUpperCase());
134:                 /*
135:                  * Check to see if the vulnerability already exists. If so, bind it to the component.
136:                  */
137:                 final org.dependencytrack.model.Vulnerability dtvuln = qm.getVulnerabilityByVulnId(source, dcvuln.getName());
138:                 if (dtvuln != null) {
139:                     qm.addVulnerability(dtvuln, component);
140:                 }
141:             }
142:         }
143: 
144:         components.add(component);
145:         qm.bind(scan, component);
146: 
147:         if (dependency.getEvidenceCollected() != null) {
148:             for (Evidence evidence : dependency.getEvidenceCollected()) {
149:                 qm.createEvidence(component, evidence.getType(), evidence.getConfidenceScore(evidence.getConfidenceType()), evidence
150:                         .getSource(), evidence.getName(), evidence.getValue());
151:             }
152:         }
153: 
154:         if (dependency.getRelatedDependencies() != null) {
155:             for (Dependency relatedDependency: dependency.getRelatedDependencies()) {
156:                 processDependency(relatedDependency);
157:             }
158:         }
159:     }
