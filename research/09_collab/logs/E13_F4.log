54: public final class ChatRequestBody {
55: 
56:     private final String message;
57:     private final String sessionId;
58:     private final Map<String, String[]> fields;
59:     private final String[] extraQueries;
60: 
61:     /**
62:      * MJ-29: Tracks values that were supplied by the caller but rejected by the
63:      * allowlist. Indexed by field name (e.g. "fields.label", "extra_queries") with a
64:      * list of the rejected string values. Empty when nothing was dropped.
65:      *
66:      * <p>Diagnostics-only: not emitted on the wire today. Surfacing rejected
67:      * values to clients is a planned follow-up.</p>
68:      */
69:     private final Map<String, List<String>> warnings;
70: 
71:     private ChatRequestBody(final String message, final String sessionId, final Map<String, String[]> fields, final String[] extraQueries,
72:             final Map<String, List<String>> warnings) {
73:         this.message = message;
74:         this.sessionId = sessionId;
75:         this.fields = fields;
76:         this.extraQueries = extraQueries;
77:         this.warnings = warnings;
78:     }
