250:     @Override
251:     public Project updateProject(Project transientProject, boolean commitIndex) {
252:         return callInTransaction(() -> {
253:             final Project project = getObjectByUuid(Project.class, transientProject.getUuid());
254:             project.setAuthors(transientProject.getAuthors());
255:             project.setPublisher(transientProject.getPublisher());
256:             project.setManufacturer(transientProject.getManufacturer());
257:             project.setSupplier(transientProject.getSupplier());
258:             project.setGroup(transientProject.getGroup());
259:             project.setName(transientProject.getName());
260:             project.setDescription(transientProject.getDescription());
261:             project.setVersion(transientProject.getVersion());
262:             project.setClassifier(transientProject.getClassifier());
263:             project.setCpe(transientProject.getCpe());
264:             project.setPurl(transientProject.getPurl());
265:             project.setSwidTagId(transientProject.getSwidTagId());
266:             project.setExternalReferences(transientProject.getExternalReferences());
267: 
268:             if (project.isActive() && !transientProject.isActive() && hasActiveChild(project)) {
269:                 throw new IllegalArgumentException("Project cannot be set to inactive if active children are present.");
270:             }
271:             project.setActive(transientProject.isActive());
272: 
273:             // Remove isLatest flag from current latest project version, if this project will be the latest now
274:             if (transientProject.isLatest() && !project.isLatest()) {
275:                 final Project oldLatestProject = getLatestProjectVersion(project.getName());
276:                 if (oldLatestProject != null) {
277:                     oldLatestProject.setIsLatest(false);
278: 
279:                     // Ensure the change is flushed to the database before the project
280:                     // record is updated. Necessary to prevent unique constraint violation.
281:                     pm.flush();
282:                 }
283:             }
284:             project.setIsLatest(transientProject.isLatest());
285: 
286:             if (transientProject.getParent() != null
287:                     && transientProject.getParent().getUuid() != null) {
288:                 if (project.getUuid().equals(transientProject.getParent().getUuid())) {
289:                     throw new IllegalArgumentException("A project cannot select itself as a parent");
290:                 }
291:                 Project parent = getObjectByUuid(
292:                         Project.class, transientProject.getParent().getUuid());
293:                 if (parent.getInactiveSince() != null) {
294:                     throw new IllegalArgumentException("An inactive project cannot be selected as a parent");
295:                 } else if (isChildOf(parent, transientProject.getUuid())) {
296:                     throw new IllegalArgumentException(
297:                             "The new parent project cannot be a child of the current project.");
298:                 } else {
299:                     project.setParent(parent);
300:                 }
301:                 project.setParent(parent);
302:             } else {
303:                 project.setParent(null);
304:             }
305: 
306:             // Prevent illegal states of collection projects (must not contain components or services).
307:             final ProjectCollectionLogic newCollectionLogic = transientProject.getCollectionLogic();
308:             if (newCollectionLogic != null
309:                     && !newCollectionLogic.equals(project.getCollectionLogic())
310:                     && (hasComponents(project) || hasServiceComponents(project))) {
311:                 throw new IllegalArgumentException(
312:                         "A project with components or services cannot be converted to a collection project.");
313:             }
314: 
315:             // NB: Resolve the collection tag BEFORE setting collectionLogic on the persistent project,
316:             // as resolveTags triggers a query that flushes dirty state, which would violate the
317:             // PROJECT_COLLECTION_TAG_REQUIRED_check constraint if collectionLogic is already set
318:             // but collectionTag is still null.
319:             Tag resolvedCollectionTag = null;
320:             if (newCollectionLogic == ProjectCollectionLogic.AGGREGATE_DIRECT_CHILDREN_WITH_TAG) {
321:                 if (transientProject.getCollectionTag() == null) {
322:                     throw new IllegalArgumentException(
323:                             "A collection tag must be specified for AGGREGATE_DIRECT_CHILDREN_WITH_TAG logic.");
324:                 }
325: 
326:                 final Set<Tag> resolvedCollectionTags = resolveTags(List.of(transientProject.getCollectionTag()));
327:                 resolvedCollectionTag = resolvedCollectionTags.iterator().next();
328:             }
329: 
330:             project.setCollectionLogic(newCollectionLogic);
331:             project.setCollectionTag(resolvedCollectionTag);
332:             if (newCollectionLogic != null) {
333:                 project.setClassifier(null);
334:             }
335: 
336:             final Set<Tag> resolvedTags = resolveTags(transientProject.getTags());
337:             bind(project, resolvedTags);
338:             return persist(project);
339:         });
