16: // SearchLabels finds and returns labels as JSON.
17: //
18: //	@Summary	finds and returns labels as JSON
19: //	@Id			SearchLabels
20: //	@Tags		Labels
21: //	@Produce	json
22: //	@Success	200				{object}	search.Label
23: //	@Failure	401,429,403,400	{object}	i18n.Response
24: //	@Param		count			query		int		true	"maximum number of results"	minimum(1)	maximum(100000)
25: //	@Param		offset			query		int		false	"search result offset"		minimum(0)	maximum(100000)
26: //	@Param		all				query		bool	false	"show all"
27: //	@Param		q				query		string	false	"search query"
28: //	@Router		/api/v1/labels [get]
29: func SearchLabels(router *gin.RouterGroup) {
30: 	router.GET("/labels", func(c *gin.Context) {
31: 		s := Auth(c, acl.ResourceLabels, acl.ActionSearch)
32: 
33: 		if s.Abort(c) {
34: 			return
35: 		}
36: 
37: 		var frm form.SearchLabels
38: 
39: 		err := c.MustBindWith(&frm, binding.Form)
40: 
41: 		if err != nil {
42: 			AbortBadRequest(c, err)
43: 			return
44: 		}
45: 
46: 		if acl.Rules.Deny(acl.ResourceLabels, s.GetUserRole(), acl.AccessPrivate) {
47: 			frm.NSFW = false
48: 			frm.Public = true
49: 		}
50: 
51: 		// Update precalculated photo counts if needed.
52: 		if err = entity.UpdateLabelCountsIfNeeded(); err != nil {
53: 			log.Warnf("labels: could not update photo counts (%s)", err)
54: 		}
55: 
56: 		// Search matching labels.
57: 		result, err := search.Labels(frm)
58: 
59: 		if err != nil {
60: 			c.AbortWithStatusJSON(400, gin.H{"error": txt.UpperFirst(err.Error())})
61: 			return
62: 		}
63: 
64: 		// TODO c.Header("X-Count", strconv.Itoa(count))
65: 		AddLimitHeader(c, frm.Count)
66: 		AddOffsetHeader(c, frm.Offset)
67: 		AddTokenHeaders(c, s)
68: 
69: 		c.JSON(http.StatusOK, result)
70: 	})
71: }

