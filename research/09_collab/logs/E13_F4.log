198: // Command issues a command to a process
199: // @Summary Issue a command to a process
200: // @Description Issue a command to a process: start, stop, reload, restart
201: // @ID restream-3-command
202: // @Accept json
203: // @Produce json
204: // @Param id path string true "Process ID"
205: // @Param command body api.Command true "Process command"
206: // @Success 200 {string} string
207: // @Failure 400 {object} api.Error
208: // @Failure 404 {object} api.Error
209: // @Security ApiKeyAuth
210: // @Router /api/v3/process/{id}/command [put]
211: func (h *RestreamHandler) Command(c echo.Context) error {
212: 	id := util.PathParam(c, "id")
213: 
214: 	var command api.Command
215: 
216: 	if err := util.ShouldBindJSON(c, &command); err != nil {
217: 		return api.Err(http.StatusBadRequest, "Invalid JSON", "%s", err)
218: 	}
219: 
220: 	var err error
221: 	if command.Command == "start" {
222: 		err = h.restream.StartProcess(id)
223: 	} else if command.Command == "stop" {
224: 		err = h.restream.StopProcess(id)
225: 	} else if command.Command == "restart" {
226: 		err = h.restream.RestartProcess(id)
227: 	} else if command.Command == "reload" {
228: 		err = h.restream.ReloadProcess(id)
229: 	} else {
230: 		return api.Err(http.StatusBadRequest, "Unknown command provided", "Known commands are: start, stop, reload, restart")
231: 	}
