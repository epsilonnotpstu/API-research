130: type UpsertRequest struct {
131: 	Collection string
132: 	Key        string
133: 	Value      interface{}
134: }
135: 
136: func (h *Handler) Upsert(factory func(context.Context, *http.Request, httprouter.Params) (*UpsertRequest, error)) httprouter.Handle {
137: 	return func(w http.ResponseWriter, r *http.Request, ps httprouter.Params) {
138: 		ctx := r.Context()
139: 		u, err := factory(ctx, r, ps)
140: 		if err != nil {
141: 			h.h.WriteError(w, r, err)
142: 			return
143: 		}
144: 
145: 		if err := h.s.Upsert(ctx, u.Collection, u.Key, u.Value); err != nil {
146: 			h.h.WriteError(w, r, err)
147: 			return
148: 		}
149: 
150: 		h.h.Write(w, r, u.Value)
151: 	}
