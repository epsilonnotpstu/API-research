749:     private void validateControllerServiceReferences(final ParameterContextEntity requestEntity, final AuthorizableLookup lookup, final ParameterContext parameterContext, final NiFiUser user) {
750:         final Set<ParameterEntity> parametersEntities = requestEntity.getComponent().getParameters();
751:         for (ParameterEntity parameterEntity : parametersEntities) {
752:             final String parameterName = parameterEntity.getParameter().getName();
753:             final List<ParameterReferencedControllerServiceData> referencedControllerServiceDataSet =
754:                 parameterContext.getParameterReferenceManager().getReferencedControllerServiceData(parameterContext, parameterName);
755: 
756:             final Set<? extends Class<? extends ControllerService>> referencedControllerServiceTypes = referencedControllerServiceDataSet.stream()
757:                 .map(ParameterReferencedControllerServiceData::getReferencedControllerServiceType)
758:                 .collect(Collectors.toSet());
759: 
760:             if (referencedControllerServiceTypes.size() > 1) {
761:                 throw new IllegalStateException("Parameter is used by multiple different types of controller service references");
762:             } else if (!referencedControllerServiceTypes.isEmpty()) {
763:                 final Optional<org.apache.nifi.parameter.Parameter> parameterOptional = parameterContext.getParameter(parameterName);
764:                 if (parameterOptional.isPresent()) {
765:                     final String currentParameterValue = parameterOptional.get().getValue();
766:                     if (currentParameterValue != null) {
767:                         try {
768:                             final ComponentAuthorizable currentControllerService = lookup.getControllerService(currentParameterValue);
769:                             if (currentControllerService != null) {
770:                                 final Authorizable currentControllerServiceAuthorizable = currentControllerService.getAuthorizable();
771:                                 currentControllerServiceAuthorizable.authorize(authorizer, RequestAction.READ, user);
772:                                 currentControllerServiceAuthorizable.authorize(authorizer, RequestAction.WRITE, user);
773:                             }
774:                         } catch (ResourceNotFoundException e) {
775:                             // the currently referenced controller service no longer exists, we can just
776:                             // skip the authorization check, and move on to setting the new parameter value
777:                             logger.debug("Current Controller Service with ID {} not found, skipping authorization check", currentParameterValue);
778:                         }
779:                     }
780:                 }
781: 
782:                 final String newParameterValue = parameterEntity.getParameter().getValue();
783:                 if (newParameterValue != null) {
784:                     final ComponentAuthorizable newControllerService = lookup.getControllerService(newParameterValue);
785:                     if (newControllerService != null) {
786:                         final Authorizable newControllerServiceAuthorizable = newControllerService.getAuthorizable();
787:                         if (newControllerServiceAuthorizable != null) {
788:                             newControllerServiceAuthorizable.authorize(authorizer, RequestAction.READ, user);
789:                             newControllerServiceAuthorizable.authorize(authorizer, RequestAction.WRITE, user);
790: 
791:                             final Class<?> firstClass = referencedControllerServiceTypes.iterator().next();
792:                             final ComponentNode componentNode = (ComponentNode) newControllerServiceAuthorizable;
793:                             final Class<?> componentClass = componentNode.getComponent().getClass();
794: 
795:                             if (!firstClass.isAssignableFrom(componentClass)) {
796:                                 throw new IllegalArgumentException("New Parameter value attempts to reference an incompatible controller service");
797:                             }
798:                         }
799:                     }
800:                 }
801:             }
802:         }
803:     }
