833: func (r *restream) UpdateProcess(id string, config *app.Config) error {
834: 	r.lock.Lock()
835: 	defer r.lock.Unlock()
836: 
837: 	t, err := r.createTask(config)
838: 	if err != nil {
839: 		return err
840: 	}
841: 
842: 	task, ok := r.tasks[id]
843: 	if !ok {
844: 		return fmt.Errorf("unknown process ID (%s)", id)
845: 	}
846: 
847: 	t.process.Order = task.process.Order
848: 
849: 	if id != t.id {
850: 		_, ok := r.tasks[t.id]
851: 		if ok {
852: 			return fmt.Errorf("the process ID '%s' already exists", t.id)
853: 		}
854: 	}
855: 
856: 	if err := r.stopProcess(id); err != nil {
857: 		return err
858: 	}
859: 
860: 	if err := r.deleteProcess(id); err != nil {
861: 		return err
862: 	}
863: 
864: 	r.tasks[t.id] = t
865: 
866: 	// set filesystem cleanup rules
867: 	r.setCleanup(t.id, t.config)
868: 
869: 	if t.process.Order == "start" {
870: 		r.startProcess(t.id)
871: 	}
872: 
873: 	r.save()
874: 
875: 	return nil
876: }
