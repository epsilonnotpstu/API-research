457: func (q *RelationQuery) FromURLQuery(query url.Values) (*RelationQuery, error) {
458: 	if q == nil {
459: 		q = &RelationQuery{}
460: 	}
461: 
462: 	if query.Has("subject") {
463: 		return nil, errors.WithStack(ErrDroppedSubjectKey)
464: 	}
465: 
466: 	// reset subject
467: 	q.SubjectID = nil
468: 	q.SubjectSet = nil
469: 
470: 	switch {
471: 	case !query.Has(subjectIDKey) && !query.Has(subjectSetNamespaceKey) && !query.Has(subjectSetObjectKey) && !query.Has(subjectSetRelationKey):
472: 		// was not queried for the subject
473: 	case query.Has(subjectIDKey) && query.Has(subjectSetNamespaceKey) && query.Has(subjectSetObjectKey) && query.Has(subjectSetRelationKey):
474: 		return nil, errors.WithStack(ErrDuplicateSubject)
475: 	case query.Has(subjectIDKey):
476: 		q.SubjectID = pointerx.String(query.Get(subjectIDKey))
477: 	case query.Has(subjectSetNamespaceKey) && query.Has(subjectSetObjectKey) && query.Has(subjectSetRelationKey):
478: 		q.SubjectSet = &SubjectSet{
479: 			Namespace: query.Get(subjectSetNamespaceKey),
480: 			Object:    query.Get(subjectSetObjectKey),
481: 			Relation:  query.Get(subjectSetRelationKey),
482: 		}
483: 	default:
484: 		return nil, errors.WithStack(ErrIncompleteSubject)
485: 	}
486: 
487: 	q.Object = query.Get("object")
488: 	q.Relation = query.Get("relation")
489: 	q.Namespace = query.Get("namespace")
490: 
491: 	return q, nil
492: }
