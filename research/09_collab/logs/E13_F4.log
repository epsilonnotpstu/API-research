53:     public void inform(Event e) {
54:         if (e instanceof BomUploadEvent) {
55:             final BomUploadEvent event = (BomUploadEvent) e;
56:             final byte[] bomBytes = CompressUtil.optionallyDecompress(event.getBom());
57:             QueryManager qm = new QueryManager();
58:             try {
59:                 final Project project = qm.getObjectByUuid(Project.class, event.getProjectUuid());
60:                 final List<Component> components;
61:                 final List<Component> flattenedComponents = new ArrayList<>();
62: 
63:                 // Holds a list of all Components that are existing dependencies of the specified project
64:                 final List<Component> existingProjectDependencies = new ArrayList<>();
67:                 final String bomString = new String(bomBytes, StandardCharsets.UTF_8);
68:                 if (bomString.startsWith("<?xml") && bomString.contains("<bom") && bomString.contains("http://cyclonedx.org/schema/bom")) {
69:                     final CycloneDxParser parser = new CycloneDxParser(qm);
70:                     components = parser.convert(parser.parse(bomBytes));
71:                 } else {
72:                     final SpdxDocumentParser parser = new SpdxDocumentParser(qm);
73:                     components = parser.parse(bomBytes);
74:                 }
75:                 final Date date = new Date();
76:                 final Bom bom = qm.createBom(project, date);
77:                 for (Component component: components) {
78:                     processComponent(qm, bom, project, component, flattenedComponents);
79:                 }
80: 
81:                 qm.reconcileDependencies(project, existingProjectDependencies, flattenedComponents);
82:                 qm.updateLastBomImport(project, date);
137:      * Recursively bind component and all children to a project.
138:      */
139:     private void bind(QueryManager qm, Project project, Component component) {
140:         qm.createDependencyIfNotExist(project, component, null, null);
141:         if (component.getChildren() != null) {
142:             for (Component c: component.getChildren()) {
143:                 bind(qm, project, c);
144:             }
145:         }
146:     }
