  p=Path(path)
  assert p.is_file(),loc
  count=len(p.read_text(errors=\"replace\").splitlines())
  assert re.fullmatch(r\"\\d+(?:-\\d+)?(?:,\\d+(?:-\\d+)?)*\",lines),loc
  for n in re.findall(r\"\\d+\",lines): assert 1<=int(n)<=count,loc
