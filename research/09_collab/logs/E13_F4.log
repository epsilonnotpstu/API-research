130: 
131:     /**
132:      * Parses a raw JSON body map into a validated {@link ChatRequestBody}.
133:      *
134:      * <p>The {@code message} and {@code session_id} values are trimmed; blank
135:      * inputs become {@code null}. Label filters and {@code extra_queries} are
136:      * passed through the {@link ChatApiHelper} allowlist; rejected values are
137:      * tracked in {@link #getWarnings()} but otherwise dropped.</p>
138:      *
139:      * @param raw the parsed JSON request body
140:      * @param maxMessageLength upper bound on the {@code message} length, in characters
141:      * @return a validated, immutable view of the request body
142:      * @throws MessageTooLongException if {@code message} exceeds {@code maxMessageLength}
143:      * @throws IOException if validation reports an unrecoverable error
144:      */
145:     public static ChatRequestBody from(final Map<String, Object> raw, final int maxMessageLength) throws IOException {
146:         final String message = trimmedOrNull(raw.get("message"));
147:         final String sessionId = trimmedOrNull(raw.get("session_id"));
148:         if (message != null && message.length() > maxMessageLength) {
149:             throw new MessageTooLongException("message exceeds max length: " + message.length() + " > " + maxMessageLength);
150:         }
151:         final Map<String, List<String>> warnings = new HashMap<>();
152:         final ChatApiHelper chatApiHelper = ComponentUtil.getChatApiHelper();
153:         final Map<String, String[]> fields = chatApiHelper.parseFieldFilters(raw, warnings);
154:         final String[] extraQueries = chatApiHelper.parseExtraQueries(raw, warnings);
155:         return new ChatRequestBody(message, sessionId, fields, extraQueries, warnings);
156:     }
157: 
158:     private static String trimmedOrNull(final Object v) {
159:         if (v == null) {
160:             return null;
161:         }
162:         final String s = v.toString().trim();
163:         return s.isEmpty() ? null : s;
164:     }
165: 
166:     /** Thrown when the request {@code message} exceeds {@code rag.chat.message.max.length}. */
167:     public static class MessageTooLongException extends IOException {
168:         private static final long serialVersionUID = 1L;
169: 
170:         /**
171:          * Creates a new exception describing the length violation.
172:          *
173:          * @param m the developer-facing detail message
174:          */
175:         public MessageTooLongException(final String m) {
176:             super(m);
177:         }
178:     }
179: }

