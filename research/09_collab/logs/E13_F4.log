85: func ListByQuery(l *ListRequest, m map[string][]string) {
86: 	switch val := l.Value.(type) {
87: 	case *Roles:
88: 		var res Roles
89: 		for _, role := range *val {
90: 			filteredRole := role.withMembers(m["member"]).withIDs(m["id"])
91: 			if filteredRole != nil {
92: 				res = append(res, *filteredRole)
93: 			}
94: 		}
95: 		l.Value = &res
96: 	case *Policies:
97: 		var res Policies
98: 		for _, policy := range *val {
99: 			filteredPolicy := policy.withSubjects(m["subject"]).withResources(m["resource"]).withActions(m["action"]).withIDs(m["id"])
100: 			if filteredPolicy != nil {
101: 				res = append(res, *filteredPolicy)
102: 			}
103: 		}
104: 		l.Value = &res
105: 	default:
106: 		panic("storage:unable to cast list request to a known type!")
107: 	}
108: }
