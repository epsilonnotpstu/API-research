14: func Labels(frm form.SearchLabels) (results []Label, err error) {
15: 	if err = frm.ParseQueryString(); err != nil {
16: 		return results, err
17: 	}
18: 
19: 	s := UnscopedDb()
20: 	// s.LogMode(true)
21: 
22: 	// Base query.
