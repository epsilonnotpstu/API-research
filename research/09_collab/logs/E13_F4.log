390:     public Response createAsset(
391:             @PathParam("contextId") final String contextId,
392:             @HeaderParam(FILENAME_HEADER) final String assetName,
393:             @Parameter(description = "The contents of the asset.", required = true) final InputStream assetContents) throws IOException {
394: 
395:         // Validate input
396:         if (StringUtils.isBlank(assetName)) {
397:             throw new IllegalArgumentException(FILENAME_HEADER + " header is required");
398:         }
399:         if (assetContents == null) {
400:             throw new IllegalArgumentException("Asset contents must be specified.");
401:         }
402: 
403:         final String sanitizedAssetName = FileUtils.getSanitizedFilename(assetName);
404:         if (!assetName.equals(sanitizedAssetName)) {
405:             throw new IllegalArgumentException(FILENAME_HEADER + " header contains an invalid file name");
406:         }
407: 
408:         // If clustered and not all nodes are connected, do not allow creating an asset.
409:         // Generally, we allow the flow to be modified when nodes are disconnected, but we do not allow creating an asset because
410:         // the cluster has no mechanism for synchronizing those assets after the upload.
411:         final ClusterCoordinator clusterCoordinator = getClusterCoordinator();
412:         if (clusterCoordinator != null) {
413:             final Set<NodeIdentifier> disconnectedNodes = clusterCoordinator.getNodeIdentifiers(NodeConnectionState.CONNECTING, NodeConnectionState.DISCONNECTED, NodeConnectionState.DISCONNECTING);
414:             if (!disconnectedNodes.isEmpty()) {
415:                 throw new IllegalStateException("Cannot create an Asset because the following %s nodes are not currently connected: %s".formatted(disconnectedNodes.size(), disconnectedNodes));
416:             }
417:         }
418: 
419:         // Get the context or throw ResourceNotFoundException
420:         final NiFiUser user = NiFiUserUtils.getNiFiUser();
421:         final ParameterContextEntity contextEntity = serviceFacade.getParameterContext(contextId, false, user);
422:         final Set<AffectedComponentEntity> affectedComponents = serviceFacade.getComponentsAffectedByParameterContextUpdate(Collections.singletonList(contextEntity.getComponent()));
423:         final Optional<Asset> previousAsset = assetManager.getAssets(contextId).stream().filter(asset -> asset.getName().equals(sanitizedAssetName)).findAny();
424: 
425:         // Authorize the request
426:         serviceFacade.authorizeAccess(lookup -> {
427:             // Verify READ and WRITE permissions for user, for the Parameter Context itself
428:             authorizeReadWriteParameterContext(contextId);
429: 
430:             // Verify READ and WRITE permissions for user, for every component that is affected
431:             // This is necessary because this end-point may be called to replace the content of an asset that is referenced in a parameter that is already in use
432:             if (previousAsset.isPresent()) {
433:                 affectedComponents.forEach(component -> parameterUpdateManager.authorizeAffectedComponent(component, lookup, user, true, true));
434:             }
435:         });
436: 
437:         // If we need to replicate the request, we do so using the Upload Request Replicator, rather than the typical replicate() method.
438:         // This is because Upload Request Replication works differently in that it needs to be able to replicate the InputStream multiple times,
439:         // so it must create a file on disk to do so and then use the file's content to replicate the request. It also bypasses the two-phase
440:         // commit process that is used for other requests because doing so would result in uploading the file twice to each node or providing a
441:         // different request for each of the two phases.
442: 
443:         final long startTime = System.currentTimeMillis();
444:         final InputStream maxLengthInputStream = new MaxLengthInputStream(assetContents, MAX_ASSET_SIZE_BYTES);
445: 
446:         final AssetEntity assetEntity;
447:         if (isReplicateRequest()) {
448:             final UploadRequest<AssetEntity> uploadRequest = new UploadRequest.Builder<AssetEntity>()
449:                     .user(NiFiUserUtils.getNiFiUser())
450:                     .filename(sanitizedAssetName)
451:                     .identifier(UUID.randomUUID().toString())
452:                     .contents(maxLengthInputStream)
453:                     .forwardRequestHeaders(getHeaders())
454:                     .header(FILENAME_HEADER, sanitizedAssetName)
455:                     .header(CONTENT_TYPE_HEADER, UPLOAD_CONTENT_TYPE)
456:                     .exampleRequestUri(getAbsolutePath())
