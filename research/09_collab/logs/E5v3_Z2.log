22: package app.coronawarn.verification.validator;
23: 
24: import app.coronawarn.verification.model.RegistrationTokenKeyType;
25: import app.coronawarn.verification.model.RegistrationTokenRequest;
26: import app.coronawarn.verification.service.HashingService;
27: import app.coronawarn.verification.service.TanService;
28: import javax.validation.ConstraintValidator;
29: import javax.validation.ConstraintValidatorContext;
30: import lombok.NonNull;
31: import lombok.RequiredArgsConstructor;
32: import lombok.extern.slf4j.Slf4j;
33: import org.springframework.stereotype.Component;
34: 
35: /**
36:  * The registration token request validator.
37:  */
38: @Slf4j
39: @RequiredArgsConstructor
40: @Component
41: public class RegistrationTokenRequestValidator
42:   implements ConstraintValidator<RegistrationTokenKeyConstraint, RegistrationTokenRequest> {
43:   /**
44:    * The {@link HashingService}.
45:    */
46:   @NonNull
47:   private final HashingService hashingService;
48: 
49:   /**
50:    * The {@link TanService}.
51:    */
52:   @NonNull
53:   private final TanService tanService;
54: 
55:   @Override
56:   public boolean isValid(RegistrationTokenRequest request, ConstraintValidatorContext arg1) {
57: 
58:     String key = request.getKey();
59:     RegistrationTokenKeyType keyType = request.getKeyType();
60:     if (key == null || keyType == null) {
61:       return false;
62:     }
63:     switch (keyType) {
64:       case GUID:
65:         return hashingService.isHashValid(key);
66:       case TELETAN: 
67:         return tanService.verifyTeleTan(key);
68:       default: 
69:         return false;
70:     }
71:   }
72: }
