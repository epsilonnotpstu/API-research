29: 		this.distilleryService = distilleryService;
30: 	}
31: 
32: 	@Transactional(readOnly = true)
33: 	@Override
34: 	public List<Product> findAll() {
35: 		return productDAO.findAll().stream()
36: 			.sorted(Comparator.comparing(Product::getName))
37: 			.collect(Collectors.toList());
38: 	}
39: 
40: 	@Transactional(readOnly = true)
41: 	@Override
42: 	public Page<Product> findAll(PageRequest request) {
43: 		return productDAO.findAll(request);
44: 	}
45: 
46: 	@Transactional(readOnly = true)
47: 	@Override
48: 	public Page<Product> findByDistillery(Distillery distillery, PageRequest request) {
49: 		return productDAO.findByDistilleryOrderByName(distillery, request);
50: 	}
51: 
52: 	@Transactional(readOnly = true)
53: 	@Override
54: 	public Page<Product> findByRegion(Region region, PageRequest request) {
55: 		return productDAO.findByRegionOrderByName(region, request);
56: 	}
57: 
58: 	@Transactional(readOnly = true)
59: 	@Override
60: 	public Page<Product> findByAvailability(String available, PageRequest request) {
61: 		Page<Product> pagedList;
62: 		if ("all".equals(available)) {
63: 			pagedList = productDAO.findAll(request);
64: 		} else {
65: 			boolean availability = Boolean.parseBoolean(available);
66: 			pagedList = productDAO.findByAvailableOrderByName(availability, request);
67: 		}
68: 		return pagedList;
69: 	}
