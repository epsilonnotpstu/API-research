44: /**
45:  * This class represents the TanService service.
46:  */
47: @Slf4j
48: @Component
49: public class TanService {
50: 
51:  
52:   private final VerificationApplicationConfig verificationApplicationConfig;
53: 
54:   /**
55:    * The {@link VerificationTanRepository}.
56:    */
57:   private final VerificationTanRepository tanRepository;
58:   /**
59:    * The {@link HashingService}.
60:    */
61:   private final HashingService hashingService;
62: 
63:   private final Pattern teleTanPattern;
64:   private final int teleTanLength;
65: 
66:   /**
67:    * Constructor for the TanService that also builds the pattern for tele tan verification.
68:    *
69:    * @param verificationApplicationConfig the {@link VerificationApplicationConfig} with needed tan configurations
70:    * @param tanRepository the {@link VerificationTanRepository} where tans are queried and inserted
71:    * @param hashingService the {@link HashingService} implementation
72:    */
73:   public TanService(
74:     @NonNull VerificationApplicationConfig verificationApplicationConfig,
75:     @NonNull VerificationTanRepository tanRepository,
76:     @NonNull HashingService hashingService
77:   ) {
78:     this.verificationApplicationConfig = verificationApplicationConfig;
79:     this.tanRepository = tanRepository;
80:     this.hashingService = hashingService;
81:     this.teleTanLength = verificationApplicationConfig.getTan().getTele().getValid().getLength();
82:     this.teleTanPattern = Pattern.compile("^["
83:       + verificationApplicationConfig.getTan().getTele().getValid().getChars()
84:       + "]{"
85:       + (verificationApplicationConfig.getTan().getTele().getValid().getLength() + 1)
86:       + "}$");
87:   }
88: 
89:   /**
90:    * Saves a {@link VerificationTan} into the database.
91:    *
92:    * @param tan {@link VerificationTan}
93:    * @return {@link VerificationTan}
94:    */
95:   public VerificationTan saveTan(VerificationTan tan) {
96:     return tanRepository.save(tan);
97:   }
98: 
99:   /**
100:    * Deletes a {@link VerificationTan} from the database.
101:    *
102:    * @param tan the tan which will be deleted
103:    */
104:   public void deleteTan(VerificationTan tan) {
105:     tanRepository.delete(tan);
106:   }
107: 
108:   /**
109:    * Check teleTAN syntax constraints.
110:    *
111:    * @param teleTan the teleTAN
112:    * @return teleTAN verification flag
113:    */
114:   private boolean syntaxTeleTanVerification(String teleTan) {
115:     Matcher matcher = teleTanPattern.matcher(teleTan);
116:     return matcher.find();
117:   }
118: 
119:   /**
120:    * Verifies the tele transaction number (teleTAN).
121:    *
122:    * @param teleTan the teleTAN to verify
123:    * @return is teleTAN verified
124:    */
125:   public boolean verifyTeleTan(String teleTan) {
126:     boolean verified = false;
127:     if (syntaxTeleTanVerification(teleTan)) {
128:       Optional<VerificationTan> teleTanEntity = getEntityByTan(teleTan);
129:       if (teleTanEntity.isPresent() && teleTanEntity.get().canBeRedeemed(LocalDateTime.now())) {
130:         verified = true;
131:       } else {
132:         log.warn("The teleTAN is unknown, expired or already redeemed.");
133:       }
134:     } else {
135:       log.warn("The teleTAN is not valid to the syntax constraints.");
136:     }
137:     return verified;
138:   }
139: 
140:   /**
141:    * Generates a new, valid TAN String.
142:    * A TAN is considered as valid if it is not yet stored in the database.
143:    *
144:    * @param tanCreator a supplier which creates a new TAN
145:    * @return a Valid TAN String
146:    */
147:   protected String generateValidTan(Supplier<String> tanCreator) {
148:     boolean validTan = false;
149:     String newTan = "";
150:     while (!validTan) {
151:       newTan = tanCreator.get();
152:       validTan = checkTanNotExist(newTan);
153:     }
154:     return newTan;
155:   }
156: 
157:   /**
158:    * This method generates a {@link VerificationTan} - entity and saves it.
159:    *
160:    * @param tan     the TAN
161:    * @param tanType the TAN type
162:    * @param teleTanType type of the teleTan
163:    * @return the persisted TAN
164:    */
165:   private VerificationTan persistTan(
166:     String tan, TanType tanType, TanSourceOfTrust sourceOfTrust, TeleTanType teleTanType) {
167:     VerificationTan newTan = generateVerificationTan(tan, tanType, sourceOfTrust, teleTanType);
168:     return tanRepository.save(newTan);
169:   }
170: 
171:   /**
172:    * Creates a new TeleTan String.
173:    *
174:    * @return a new teleTAN
175:    */
176:   protected String createTeleTan() {
177:     final int length = verificationApplicationConfig.getTan().getTele().getValid().getLength();
178:     final String chars = verificationApplicationConfig.getTan().getTele().getValid().getChars();
179:     String teletan = IntStream.range(0, length)
180:       .mapToObj(i -> chars.charAt(Holder.NUMBER_GENERATOR.nextInt(chars.length())))
181:       .collect(Collector.of(
182:         StringBuilder::new,
183:         StringBuilder::append,
184:         StringBuilder::append,
185:         StringBuilder::toString));
186:     return teletan + hashingService.getCheckDigit(teletan);
187: 
188:   }
189: 
190:   /**
191:    * Returns the if a teleTAN matches the Pattern requirements.
192:    *
193:    * @param teleTan the teleTAN to check
194:    * @return The validity of the teleTAN
195:    */
196:   public boolean isTeleTanValid(String teleTan) {
197:     return syntaxTeleTanVerification(teleTan);
198:   }
199: 
200:   /**
201:    * Created a new TAN String.
202:    *
203:    * @return a new TAN
204:    */
205:   protected String createTanFromUuid() {
206:     // A UUID is a 128 bit value
207:     return UUID.randomUUID().toString();
208:   }
209: 
210:   /**
211:    * Check for existing TAN in the {@link VerificationTanRepository}.
212:    *
213:    * @param tan the TAN
214:    * @return flag for existing TAN
215:    */
216:   public boolean checkTanNotExist(String tan) {
217:     String tanHash = hashingService.hash(tan);
218:     return !tanRepository.existsByTanHash(tanHash);
219:   }
220: 
221:   /**
222:    * Returns a generated valid teleTAN and persists it.
223:    *
224:    * @return a valid teleTAN
225:    */
226:   public String generateVerificationTeleTan(@NotNull TeleTanType teleTanType) {
227:     String teleTan = generateValidTan(this::createTeleTan);
228:     persistTan(teleTan, TanType.TELETAN, TanSourceOfTrust.TELETAN, teleTanType);
229:     return teleTan;
230:   }
231: 
232:   /**
233:    * This Method generates a valid TAN and persists it. Returns the generated TAN.
234:    *
235:    * @param sourceOfTrust sets the source of Trust for the Tan
236:    * @param teleTanType type of the teleTan
237:    * @return a valid tan with given source of Trust
238:    */
239:   public String generateVerificationTan(TanSourceOfTrust sourceOfTrust, TeleTanType teleTanType) {
240:     String tan = generateValidTan(this::createTanFromUuid);
241:     persistTan(tan, TanType.TAN, sourceOfTrust, teleTanType);
242:     return tan;
243:   }
244: 
245:   /**
246:    * This method generates a valid TAN Object but doesn't persist it.
247:    * @param tan alphanumeric tan
248:    * @param tanType type of the tan
249:    * @param sourceOfTrust source of trust of the tan
250:    * @return Tan object
251:    */
252:   public VerificationTan generateVerificationTan(
253:     String tan, TanType tanType, TanSourceOfTrust sourceOfTrust, TeleTanType teleTanType) {
254: 
255:     LocalDateTime from = LocalDateTime.now();
256:     LocalDateTime until;
257:     int tanValidInDays = verificationApplicationConfig.getTan().getValid().getDays();
258:     int teleTanValidInHours = verificationApplicationConfig.getTan().getTele().getValid().getHours();
259:     int eventTeleTanValidInDays = verificationApplicationConfig.getTan().getTele().getValid().getEventDays();
260: 
261:     if (tanType == TanType.TELETAN) {
262:       if (teleTanType == TeleTanType.TEST) {
263:         until = from.plusHours(teleTanValidInHours);
264:       } else {
265:         until = from.plusDays(eventTeleTanValidInDays);
266:       }
267:     } else {
268:       until = from.plusDays(tanValidInDays);
269:     }
270: 
271:     VerificationTan verificationTan = new VerificationTan();
272:     verificationTan.setTanHash(hashingService.hash(tan));
273:     verificationTan.setValidFrom(from);
274:     verificationTan.setValidUntil(until);
275:     verificationTan.setSourceOfTrust(sourceOfTrust);
276:     verificationTan.setRedeemed(false);
277:     verificationTan.setCreatedAt(LocalDateTime.now());
278:     verificationTan.setUpdatedAt(LocalDateTime.now());
279:     verificationTan.setType(tanType);
280:     verificationTan.setTeleTanType(teleTanType);
281:     return verificationTan;
282:   }
283: 
284:   /**
285:    * Get existing VerificationTan by TAN from {@link VerificationTanRepository}.
286:    *
287:    * @param tan the TAN
288:    * @return Optional VerificationTan
289:    */
290:   public Optional<VerificationTan> getEntityByTan(String tan) {
291:     log.info("Start getEntityByTan.");
292:     return tanRepository.findByTanHash(hashingService.hash(tan));
293:   }
