64:    * This method generates a registrationToken by a hashed guid or a teleTAN.
65:    *
66:    * @param request {@link RegistrationTokenRequest}
67:    * @param fake    flag for fake request
68:    * @return RegistrationToken - the created registration token {@link RegistrationToken}
69:    */
70:   @Operation(
71:     summary = "Get registration Token",
72:     description = "Get a registration token by providing a SHA-256 hasehd GUID or a teleTAN")
73:   @ApiResponses(value = {
74:     @ApiResponse(responseCode = "201", description = "registration token generated."),
75:     @ApiResponse(responseCode = "400", description = "GUID/TeleTAN already exists.")})
76:   @PostMapping(value = REGISTRATION_TOKEN_ROUTE,
77:     consumes = MediaType.APPLICATION_JSON_VALUE,
78:     produces = MediaType.APPLICATION_JSON_VALUE)
79:   public DeferredResult<ResponseEntity<RegistrationToken>> generateRegistrationToken(
80:     @RequestBody RegistrationTokenRequest request,
81:     @RequestHeader(value = "cwa-fake", required = false) String fake) {
82:     if ((fake != null) && (fake.equals("1"))) {
83:       return fakeRequestController.generateRegistrationToken(request);
84:     }
85:     StopWatch stopWatch = new StopWatch();
86:     stopWatch.start();
87:     String key = request.getKey();
88:     RegistrationTokenKeyType keyType = request.getKeyType();
89:     DeferredResult<ResponseEntity<RegistrationToken>> deferredResult = new DeferredResult<>();
90: 
91:     switch (keyType) {
92:       case GUID:
93:         ResponseEntity<RegistrationToken> responseEntity =
94:           appSessionService.generateRegistrationTokenByGuid(key, request.getKeyDob(), fake);
95:         stopWatch.stop();
96:         fakeDelayService.updateFakeTokenRequestDelay(stopWatch.getTotalTimeMillis());
97:         deferredResult.setResult(responseEntity);
98:         log.info("Returning the successfully generated RegistrationToken.");
99:         return deferredResult;
100:       case TELETAN:
101:         Optional<VerificationTan> optional = tanService.getEntityByTan(key);
102: 
103:         ResponseEntity<RegistrationToken> response = appSessionService.generateRegistrationTokenByTeleTan(
104:           key,
105:           fake,
106:           optional.map(VerificationTan::getTeleTanType).orElse(null));
107: 
108:         if (optional.isPresent()) {
109:           VerificationTan teleTan = optional.get();
110:           teleTan.setRedeemed(true);
111:           tanService.saveTan(teleTan);
112:           stopWatch.stop();
113:           fakeDelayService.updateFakeTokenRequestDelay(stopWatch.getTotalTimeMillis());
114:           scheduledExecutor.schedule(() -> deferredResult.setResult(response), fakeDelayService.realDelayToken(),
115:             MILLISECONDS);
116:           log.info("Returning the successfully generated RegistrationToken.");
117:           return deferredResult;
118:         }
119:         stopWatch.stop();
120:         throw new VerificationServerException(HttpStatus.BAD_REQUEST, "The teleTAN verification failed");
121:       default:
122:         stopWatch.stop();
123:         throw new VerificationServerException(HttpStatus.BAD_REQUEST,
124:           "Unknown registration key type for registration token");
125:     }
126:   }
127: }
