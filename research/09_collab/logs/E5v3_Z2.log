30:     public List<Tag> find(String group, String name, Long minActivitiesCount) {
31:         StringBuilder q = new StringBuilder();
32:         List<String> qWhereConditions = new ArrayList<>();
33:         Map<String, Object> qWhereParameters = new HashMap<>();
34:         q.append("SELECT t FROM Tag t");
35: 
36:         if (true) {
37:             qWhereConditions.add("UPPER(t.name) LIKE :name");
38:             qWhereParameters.put("name", "%" + name.toUpperCase() + "%");
39:         }
40:         if (group != null) {
41:             qWhereConditions.add("UPPER(t.group) LIKE :group");
42:             qWhereParameters.put("group", "%" + group.toUpperCase() + "%");
43:         }
44:         if (minActivitiesCount != null) {
45:             qWhereConditions.add("t.derived.activitiesCount >= :minActivitiesCount");
46:             qWhereParameters.put("minActivitiesCount", minActivitiesCount);
47:         }
48:         if (!qWhereConditions.isEmpty()) {
49:             q.append(" WHERE (" + Joiner.on(") AND (").join(qWhereConditions) + ")");
50:         }
51: 
52:         q.append(" ORDER BY t.name");
53: 
54:         Query query = currentSession().createQuery(q.toString());
55:         qWhereParameters.forEach((key, val) -> {
56:             query.setParameter(key, val);
57:         });
58: 
59:         List<Tag> tags = Lists.newArrayList(new HashSet<>(query.list()));
60:         return tags;
61:     }
