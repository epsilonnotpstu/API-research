71:     public List<Pet> findPetByStatus(final String status) {
72:         final String[] statues = status.split(",");
73:         final List<Pet> result = new ArrayList<>();
74:         for (final Pet pet : pets) {
75:             for (final String s : statues) {
76:                 if (s.equals(pet.getStatus())) {
77:                     result.add(pet);
78:                 }
79:             }
80:         }
81:         return result;
82:     }
83: 
84:     public List<Pet> findPetByTags(final List<String> tags) {
85:         final List<Pet> result = new ArrayList<>();
86:         for (final Pet pet : pets) {
87:             if (null != pet.getTags()) {
88:                 for (final Tag tag : pet.getTags()) {
89:                     for (final String tagListString : tags) {
90:                         if (tagListString.equals(tag.getName())) {
91:                             result.add(pet);
92:                         }
93:                     }
94:                 }
95:             }
96:         }
97:         return result;
98:     }
99: 
100:     public void addPet(final Pet pet) {
101:         if (pets.size() > 0) {
102:             for (int i = pets.size() - 1; i >= 0; i--) {
103:                 if (pets.get(i).getId() == pet.getId()) {
104:                     pets.remove(i);
105:                 }
106:             }
107:         }
108:         pets.add(pet);
109:     }
110: 
111:     public void deletePetById(final Long petId) {
112:         pets.removeIf(pet -> pet.getId() == petId);
113:     }
