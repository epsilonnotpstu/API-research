34:  */
35: @Schema(
36:   description = "The registration token request model."
37: )
38: @Data
39: @NoArgsConstructor
40: @AllArgsConstructor
41: @RegistrationTokenKeyConstraint
42: public class RegistrationTokenRequest {
43: 
