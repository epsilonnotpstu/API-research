+    return bool(parts & {'test', 'tests', '__tests__', 'spec', 'specs'}) or bool(
+        re.search(r'Test.*\.java$|IT\.java$|(?:^test_|_test\.|\.test\.|\.spec\.)', path.name))
+
+
+def path_reference(text, path):
