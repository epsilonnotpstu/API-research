+
+def strip_comments(text):
+    pattern = r'"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\'|//[^\n]*|/\*[\s\S]*?\*/'
+    return re.sub(pattern, lambda m: re.sub(r'[^\n]', ' ', m.group())
+                  if m.group().startswith(('//', '/*')) else m.group(), text)
