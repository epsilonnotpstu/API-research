/usr/bin/zsh -lc "wc -l 09_collab/logs/T26_scratch/commands.txt 09_collab/logs/T26_scratch/run_review_tests.py; nl -ba 08_experiments/_external/emb/jdk_11_maven/cs/rest/cwa-verification-server/src/main/java/app/coronawarn/verification/controller/ExternalTanController.java | sed -n '90,99p'; /usr/bin/python3 -I -B - <<'PY'
