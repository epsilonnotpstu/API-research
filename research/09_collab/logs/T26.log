+    def deref(value, seen=()):
+        if not isinstance(value, dict) or '$ref' not in value:
+            return value
+        ref = value['$ref']
+        if not ref.startswith('#/') or ref in seen:
+            return {}
+        node = spec
+        for part in ref[2:].split('/'):
+            node = node.get(part.replace('~1', '/').replace('~0', '~'), {})
+        return deref(node, (*seen, ref))
