+                if full.is_symlink():
+                    stats['skipped_symlink'] += 1
+                    continue
+                suffix = full.suffix.lower()
+                doc = suffix in DOC or name.lower().startswith('readme') or bool(
+                    set(relative.parts[:-1]) & {'docs', 'templates'})
