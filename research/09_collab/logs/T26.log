+        return 'absent'
+    if re.search(r'doesNotExist\s*\(|hasNoJsonPath\s*\(|(?:not in|not\.toHaveProperty)', text):
+        return 'absent'
+    if re.search(r'READ_ONLY|JsonProperty|\.exists\s*\(|hasJsonPath\s*\(|toHaveProperty', text):
+        return 'present'
+    return None
