+def mask_java(text):
+    """Keep offsets/newlines while masking comments and strings."""
+    pattern = r'//[^\n]*|/\*[\s\S]*?\*/|"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\''
+    return re.sub(pattern, lambda m: re.sub(r'[^\n]', ' ', m.group()), text)
