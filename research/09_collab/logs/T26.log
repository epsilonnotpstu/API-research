+        prefix = f['text'][:r['start']]
+        doc = re.search(r'/\*\*[\s\S]*?\*/\s*$', prefix)
+        if doc:
+            doc_ranges.append((f, doc.start(), doc.end(), True))
+        for name, a, b, _ in r['annotations']:
