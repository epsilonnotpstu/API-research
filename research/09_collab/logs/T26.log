+        first = self.search(status=418)
+        self.assertEqual(first, self.search(status=418))
+        self.assertTrue(all(len(h['snippet']) <= 160 for h in first['hits']))
+        categories = [ie.CATEGORIES.index(h['category']) for h in first['hits']]
