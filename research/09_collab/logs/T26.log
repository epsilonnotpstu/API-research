+def annotations(text, mask):
+    out = []
+    pos = 0
+    rx = re.compile(r'@(?:[\w]+\.)*(\w+)\b')
+    while (m := rx.search(mask, pos)):
+        end = m.end()
+        after = re.match(r'\s*\(', mask[end:])
+        if after:
+            end = matching(mask, end + after.end() - 1)
+        out.append((m[1], m.start(), end, text[m.start():end]))
+        pos = end
+    return out
