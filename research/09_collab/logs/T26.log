+
+    def test_git_pickaxe_is_local_readonly_and_handler_scoped(self):
+        self.handler()
+        commands = []
+        def git(cmd, **kwargs):
+            commands.append(cmd)
+            output = 'true\n' if 'rev-parse' in cmd else 'abc123 update response\n'
+            return subprocess.CompletedProcess(cmd, 0, output, '')
