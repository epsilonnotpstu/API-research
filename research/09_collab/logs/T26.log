+# Run from research/. No external source code or SUT is executed.
+/usr/bin/python3 -I -B 08_experiments/tools/test_intent_evidence.py
+# Existing review suite uses hardcoded T10 temp dirs; this wrapper redirects them.
+/usr/bin/python3 -I -B 09_collab/logs/T26_scratch/run_review_tests.py
