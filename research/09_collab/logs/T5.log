## যা যাচাই হয়েছে এবং সীমাবদ্ধতা

Concrete path `/pets/mine` templated counterpart-এর আগে match করে; ordinary Swagger2 `basePath` কাজ করে; exact response→`2XX`→`default` precedence কাজ করে; ordinary OAS3.0 nullable value validator-এ গ্রহণযোগ্য; conformance-এ operation parameter path-level parameter override করে; same-input/same-seed mutation result মেলে; METHOD_SEM-এর নতুন method attribution alias আছে। Ordinary allOf/oneOf validation-ও control-এ কাজ করে। Evidence: `09_collab/logs/T4_scratch/reproduce.py`, শেষ positive-control block। Ambiguous templates-এর tooling choice-কে confirmed precedence bug হিসেবে ধরা হয়নি; normative background: [OAS3.0 Path Matching](https://spec.openapis.org/oas/v3.0.3.html#path-templating-matching)।

P001 sample-এ কেবল fault representative আছে; true-negative population নেই (`08_experiments/E1_pilot/P001_empirical_findings.md:6`, `:123`)। ⚠️ তাই broad re-detection rate থেকে specificity, false-positive rate বা অন্য SUT-এ instrument reliability নির্ণয় করা যায় না। Strict mode নিজেই default-এর বাইরে policy প্রয়োগ করে (`08_experiments/tools/conformance.py:54`); strict-এ hit বাড়া independent correctness evidence নয়।


def media_matches(ctype, allowed):
    allowed = allowed.split(';')[0].strip().lower()
    if allowed in ('*/*', ctype):
        return True
    a_type, _, a_sub = allowed.partition('/')
    c_type, _, c_sub = ctype.partition('/')
    return a_type == c_type and a_sub == '*'


def check(spec, exchange):
    req, resp = exchange['request'], exchange['response']
    method, status = req['method'].upper(), int(resp['status'])
    template, path_params = spec.match(req['path'])

    def v(kind, pointer='', message=''):
        return {'kind': kind, 'method': method, 'template': template or req['path'], 'status': status,
                'pointer': pointer, 'message': message[:300],
                'fingerprint': '|'.join([method, template or req['path'], str(status), kind, pointer])}

    if template is None:
        return [v('UNDOCUMENTED_OPERATION', message='path not in spec')]
    op, params = spec.operation(template, method)
    if op is None:
        return [v('UNDOCUMENTED_OPERATION', message='method not in spec')]
    out = []
    if status >= 500:
        out.append(v('SERVER_ERROR'))
    documented, schema = spec.response_schema(op, status)
    if not documented:
        out.append(v('UNDOCUMENTED_STATUS'))
    else:
        allowed = spec.allowed_media(op, status)
        ctype = (resp.get('headers', {}).get('content-type') or '').split(';')[0].strip().lower()
        if allowed and ctype and not any(media_matches(ctype, a) for a in allowed):
            out.append(v('RESPONSE_CONTENT_TYPE', '', f'{ctype} not in {allowed}'))
    if documented and schema and resp.get('body', {}).get('text') and not resp['body'].get('truncated'):
        try:
            body = json.loads(resp['body']['text'])
        except ValueError:
            body = None
            out.append(v('RESPONSE_PARSE', '', 'body is not valid JSON'))
        if body is not None:
            for err in validator(schema, spec.oas3, spec.strict).iter_errors(body):
                out.append(v('RESPONSE_SCHEMA', '/' + '/'.join(map(str, err.schema_path)), err.message))
    problems = request_problems(spec, params, op, exchange, path_params)
    if problems and 200 <= status < 300:
        out.extend(v('INVALID_ACCEPTED', ptr_, msg) for ptr_, msg in problems)
    if not problems and status in (400, 422):
        out.append(v('VALID_REJECTED'))
    return out


def main(spec_path, exchanges_path):
    spec = Spec(specmut.load_spec(spec_path))
    with open(exchanges_path, encoding='utf-8') as f:
        for i, line in enumerate(f):
            for violation in check(spec, json.loads(line)):
                violation['exchange'] = i
                print(json.dumps(violation))


if __name__ == '__main__':
    main(*sys.argv[1:3])
"""attribute — diff violation sets of a baseline and a mutated-spec run, then label with the manifest.

Both runs must exercise the same SUT build; only the spec differs. Then:
  NEW        fingerprint only in the mutated run
               on a mutated operation  -> label = manifest expected label (injected SPEC defect)
               on an untouched op      -> label = UNEXPLAINED (nondeterminism or cross-op effect)
  VANISHED   fingerprint only in the baseline run -> MASKED: the mutation hid a real
             mismatch (e.g. REQUEST_LOOSE hiding INVALID_ACCEPTED) — reported, not labelled
  PERSISTENT in both runs -> pre-existing mismatch, needs manual labelling (codebook §3)

Usage: python3 attribute.py BASELINE_violations.jsonl MUTATED_violations.jsonl MANIFEST.json > attributed.csv
Note: tools that use the spec to generate requests (all black-box fuzzers) send
different traffic under a mutated spec; NEW/VANISHED therefore mixes oracle
changes and traffic changes. Replaying the baseline requests against the
mutated spec isolates oracle-side effects (use conformance.py on the baseline
exchanges with the mutated spec).
"""
import csv
import json
import sys


def load(path):
    with open(path, encoding='utf-8') as f:
        return [json.loads(line) for line in f if line.strip()]


def attribute(baseline, mutated, manifest):
    base_fp = {v['fingerprint']: v for v in baseline}
    mut_fp = {v['fingerprint']: v for v in mutated}
    mutated_ops = {}
    for m in manifest['mutations']:
        mutated_ops[(m['method'].upper(), m['path'])] = m
        if m['fault'] == 'METHOD_SEM':  # the operation now lives under the swapped method
            for e in m['edits']:
                mutated_ops[(str(e['after']).upper(), m['path'])] = m
    rows = []
    for fp in sorted(set(base_fp) | set(mut_fp)):
        v = mut_fp.get(fp) or base_fp[fp]
        key = (v['method'], v['template'])
        m = mutated_ops.get(key)
        if fp in mut_fp and fp not in base_fp:
            status = 'NEW'
            l1, l2 = (m['expected_L1'], m['expected_L2']) if m else ('UNEXPLAINED', '')
        elif fp in base_fp and fp not in mut_fp:
            status, l1, l2 = 'VANISHED', 'MASKED' if m else 'UNEXPLAINED', ''
        else:
            status, l1, l2 = 'PERSISTENT', 'NEEDS_MANUAL', ''
        rows.append({'fingerprint': fp, 'status': status, 'kind': v['kind'], 'method': v['method'],
                     'template': v['template'], 'http_status': v['status'], 'pointer': v['pointer'],
                     'op_mutated': bool(m), 'fault': m['fault'] if m else '', 'label_L1': l1, 'label_L2': l2})
    return rows


def main(baseline_path, mutated_path, manifest_path):
    rows = attribute(load(baseline_path), load(mutated_path), json.load(open(manifest_path)))
    w = csv.DictWriter(sys.stdout, fieldnames=list(rows[0]) if rows else ['fingerprint'])
    w.writeheader()
    w.writerows(rows)


if __name__ == '__main__':
    main(*sys.argv[1:4])
        MUTATORS[fault](spec, path, method, op, edits)
        if not edits:  # undo side effects ($ref inlining, copied path-level params) of a no-op
            spec['paths'][path][method] = original
        else:
            l1, l2 = EXPECTED[fault]
            manifest.append({'path': path, 'method': method, 'operationId': op.get('operationId'),
                             'fault': fault, 'expected_L1': l1, 'expected_L2': l2, 'edits': edits})
    return spec, manifest, len(ops)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('spec')
    ap.add_argument('--fault', choices=FAULTS, required=True)
    ap.add_argument('--severity', type=int, default=30, help='percent of operations to mutate')
    ap.add_argument('--seed', type=int, default=1)
    ap.add_argument('--exclude', nargs='*', default=[], help='paths to leave untouched (e.g. auth/login)')
    ap.add_argument('--out', required=True)
    a = ap.parse_args()
    base = load_spec(a.spec)
    spec, manifest, n_ops = mutate(base, a.fault, a.severity, a.seed, set(a.exclude))
    out = Path(a.out)
    out.mkdir(parents=True, exist_ok=True)
    stem = f'{Path(a.spec).stem}__{a.fault.lower()}__p{a.severity}__s{a.seed}'
    (out / f'{stem}.json').write_text(json.dumps(spec, indent=2, default=str), encoding='utf-8')
    meta = {'source_spec': a.spec, 'source_sha256': hashlib.sha256(Path(a.spec).read_bytes()).hexdigest(),
            'format': 'openapi3' if is_oas3(base) else 'swagger2', 'fault': a.fault, 'severity': a.severity,
            'seed': a.seed, 'operations_total': n_ops, 'operations_mutated': len(manifest), 'mutations': manifest}
    (out / f'{stem}.manifest.json').write_text(json.dumps(meta, indent=2, default=str), encoding='utf-8')
    print(f'{stem}: {len(manifest)}/{n_ops} operations mutated, '
          f'{sum(len(m["edits"]) for m in manifest)} edits')


if __name__ == '__main__':
    main()
