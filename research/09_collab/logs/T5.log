  mitmproxy:
    user: "${PILOT_UID:?Set PILOT_UID}:${PILOT_GID:?Set PILOT_GID}"
    environment:
      HOME: /tmp
      MITM_LOG_DIR: /custom-logs
      MITM_FULLLOG_FILE: exchanges.jsonl
