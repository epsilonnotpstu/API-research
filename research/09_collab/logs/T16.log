+            case_labels.append({**case,'L1':a,'L2':b,'proposed_L2':c,'confidence':d,'root_cause_id':rc})
+    path=ROOT/f'08_experiments/E2_labelling/{sut}_baseline_s1_labels_codex.csv'
+    with path.open('w',newline='') as f:
