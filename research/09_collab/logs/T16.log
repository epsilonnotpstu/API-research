+                elif '/customer/cart'==item['template']:
+                    locs += [REST+'rest/CartRestController.java:75',DTO+'CartItemDTO.java:12',DTO+'CartItemDTO.java:14',DTO+'CartItemDTO.java:18']
+                elif '/customer/contacts'==item['template']:
