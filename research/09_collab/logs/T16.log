+                locs += [f'{log_path}:{f["line"]}' for f in log_map[str(n)].get('frames',[])[:2]]
+        both=False;evidence=['E-OBS','E-LOG']
+        if sut=='swagger-petstore':
+            if 'RC06' in roots:
+                locs.append(GUARDS[iid]);evidence.append('E-CODE-INTENT')
