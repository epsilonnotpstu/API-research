+                           evidence_types=';'.join(dict.fromkeys(evidence)),evidence_locators=';'.join(dict.fromkeys(locs)),
+                           root_cause_id=';'.join(roots),both_candidate=str(both).lower(),rationale=rationale))
+        for case in by_item[iid]:
