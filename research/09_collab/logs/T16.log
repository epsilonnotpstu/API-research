index 0000000000000000000000000000000000000000..b3e9da22e6729f418c9debd0c8b3fbaf65a9bca7
--- /dev/null
+++ b/research/09_collab/logs/T16_scratch/index_logs.py
@@ -0,0 +1,98 @@
+"""Index physical log lines; do not write request URLs, credentials, or messages."""
+import collections
+import json
+import re
+from urllib.parse import parse_qs,urlsplit
+from pathlib import Path
+import sys
+
+sys.path.insert(0,str(Path(__file__).resolve().parent))
+from replay import OUT,ROOT,RUNS
+
+def request_key(method,path,query,status):
+    return (method,path,tuple(sorted((k,tuple(v)) for k,v in query.items())),int(status))
+
+def main():
+    for sut,rel in RUNS.items():
+        run=ROOT/rel;xs=[json.loads(s) for s in (run/'exchanges.jsonl').open()]
+        lines=(run/'compose.log').read_bytes().decode().split('\n')
+        queues=collections.defaultdict(collections.deque);count=0
+        for n,line in enumerate(lines,1):
+            m=re.search(r'"(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS) (\S+) HTTP/[12](?:\.[01])?" (\d{3}) ',line)
+            if m and line.startswith('sut-'):
+                url=urlsplit(m[2]);queues[request_key(m[1],url.path,parse_qs(url.query,keep_blank_values=True),m[3])].append(n);count+=1
+        mapping={}
+        for n,x in enumerate(xs,1):
+            r=x['request'];key=request_key(r['method'],r['path'],r.get('query',{}),x['response']['status'])
+            if queues[key]:mapping[str(n)]={'access_line':queues[key].popleft()}
+        if sut=='market':
+            error_queues=collections.defaultdict(collections.deque)
+            warn_queues=collections.defaultdict(collections.deque)
+            for n,line in enumerate(lines,1):
+                if line.startswith('sut-market-1') and 'WARN' in line and 'RestExceptionHandler' in line:
+                    path=re.search(r'uri=([^,\s\'"}]+)',line)
+                    if path:warn_queues[path[1]].append(n)
+                if not line.startswith('sut-market-1') or 'ERROR' not in line:continue
+                block=[]
+                for j in range(n-1,min(n+12,len(lines))):
+                    if lines[j].startswith('sut-market-1'):block.append(lines[j])
+                combined='\n'.join(block)
+                path=re.search(r'uri=([^,\s\'"}]+)',combined)
+                if not path:continue
+                if '_links' in combined:category='HAL_links_binding'
+                elif 'quantity' in combined:category='quantity_int32_overflow'
+                elif 'NumberFormatException' in combined:category='path_int64_overflow'
+                else:raise AssertionError(('unclassified market log',n))
+                frames=[]
+                for j in range(n,min(n+35,len(lines))):
+                    m=re.search(r'\bat ([\w.$]+)\(([^()]*)\)',lines[j])
+                    if m:frames.append({'line':j+1,'symbol':m[1],'source':m[2]})
+                error_queues[(path[1],category)].append({'error_line':n,'frames':frames[:6]})
+            for n,x in enumerate(xs,1):
+                if x['response']['status'] in (401,404,406) and warn_queues[x['request']['path']]:
+                    mapping.setdefault(str(n),{})['validation_or_notfound_line']=warn_queues[x['request']['path']].popleft()
+                if x['response']['status']!=500:continue
+                msg=json.loads(x['response']['body']['text'])['message']
+                category='HAL_links_binding' if '_links' in msg else ('quantity_int32_overflow' if 'quantity' in msg else 'path_int64_overflow')
+                key=(x['request']['path'],category)
+                assert error_queues[key],(n,category)
+                mapping.setdefault(str(n),{}).update(error_queues[key].popleft())
+            assert sum(map(len,error_queues.values()))==0
+        else:
+            # Mitmproxy's URI display is truncated. Its own ordered request/response
+            # stream can still locate a representative complete URI per operation.
+            pending=None; pairs=[]; prefix_pairs=[]
+            for n,line in enumerate(lines,1):
+                if not line.startswith('mitmproxy-1'):continue
+                m=re.search(r'\| [^ ]+:\d+: (GET|POST|PUT|PATCH|DELETE|OPTIONS|HEAD) (http://\S+)',line)
+                if m:
+                    url=urlsplit(m[2]);pending=(m[1],url.path,parse_qs(url.query,keep_blank_values=True),n,'\u2026' in m[2])
+                m=re.search(r'\|\s+<< (\d{3})\b',line)
+                if m and pending:
+                    method,path,query,start,truncated=pending
+                    prefix_pairs.append((method,path,int(m[1]),start,n,truncated))
+                    if not truncated:pairs.append((request_key(method,path,query,m[1]),start,n))
+                    pending=None
+            proxy=collections.defaultdict(collections.deque)
+            for key,a,b in pairs:proxy[key].append((a,b))
+            for n,x in enumerate(xs,1):
+                r=x['request'];key=request_key(r['method'],r['path'],r.get('query',{}),x['response']['status'])
+                if proxy[key]:
+                    a,b=proxy[key].popleft();mapping.setdefault(str(n),{}).update({'proxy_request_line':a,'proxy_response_line':b})
+            for n,x in enumerate(xs,1):
+                if str(n) in mapping:continue
+                r=x['request'];candidates=[]
+                for method,path,status,a,b,truncated in prefix_pairs:
+                    if method!=r['method'] or status!=x['response']['status']:continue
+                    prefix=path.split('\u2026',1)[0]
+                    if r['path']==path or (truncated and r['path'].startswith(prefix)):
+                        candidates.append((len(prefix),a,b))
+                if candidates:
+                    _,a,b=max(candidates,key=lambda v:v[0])
+                    mapping[str(n)]={'prefix_corroboration_request_line':a,'prefix_corroboration_response_line':b,
+                                     'scope':'operation/status and displayed URI prefix; not an exact exchange join'}
+        (OUT/f'{sut}_log_locations.json').write_text(json.dumps(mapping,indent=2)+'\n')
+        print(json.dumps({'sut':sut,'access_lines':count,'mapped_exchanges':len(mapping),
+                          'error_joins':sum('error_line' in r for r in mapping.values())}))
+
+if __name__=='__main__':main()
diff --git a/research/09_collab/logs/T16_scratch/inspect_evidence.py b/research/09_collab/logs/T16_scratch/inspect_evidence.py
new file mode 100644
index 0000000000000000000000000000000000000000..89cc2240eb486d7e5c1932e1b94b6fc49a34961f
--- /dev/null
+++ b/research/09_collab/logs/T16_scratch/inspect_evidence.py
@@ -0,0 +1,81 @@
+"""Summarize saved failures without revealing request or credential values."""
+import collections
+import csv
+import json
+from pathlib import Path
+import re
+import sys
+
+sys.path.insert(0,str(Path(__file__).resolve().parent))
+from replay import OUT, ROOT, RUNS
+
+def char_flags(value):
+    return {'length':len(value),'control':bool(re.search(r'[\x00-\x1f\x7f]',value)),
+            'non_ascii':not value.isascii(), 'percent_control':bool(re.search(r'%(?:0[0-9a-f]|1[0-9a-f]|7f)',value,re.I))}
+
+def main():
+    for sut,run_rel in RUNS.items():
+        run=ROOT/run_rel; xs=[json.loads(s) for s in (run/'exchanges.jsonl').open()]
+        lines=(run/'compose.log').read_bytes().decode('utf-8').split('\n')
+        items=list(csv.DictReader((ROOT/f'08_experiments/E2_labelling/{sut}_baseline_s1_blind.csv').open()))
+        maps={i['item_id']:i for i in json.loads((OUT/f'{sut}_exchange_map.json').read_text())}
+        if sut=='swagger-petstore':
+            # Only exception class names and source frames, never messages/values.
+            exceptions=[]
+            for n,line in enumerate(lines,1):
+                m=re.search(r'(?:(?:Caused by:|Causing:)\s*)?((?:[A-Za-z_$][\w$]*\.)+[\w$]*(?:Exception|Error))\b',line)
+                if m and ' at ' not in line:
+                    frames=[]
+                    for j in range(n,min(n+100,len(lines))):
+                        f=re.search(r'at ((?:io\.swagger\.|org\.glassfish\.|com\.fasterxml\.)[\w.$]+)\(([^()]*)\)',lines[j])
+                        if f:frames.append({'line':j+1,'symbol':f[1],'source':f[2]})
+                        if j>n and re.search(r'\| (?:WARN|ERROR|INFO)\s',lines[j]):break
+                    exceptions.append({'line':n,'class':m[1],'frames':frames[:8]})
+            (OUT/f'{sut}_log_exceptions.json').write_text(json.dumps(exceptions,indent=2)+'\n')
+            grouped=collections.defaultdict(list)
+            for error in exceptions:
+                key=(error['class'],tuple((f['symbol'],f['source']) for f in error['frames'][:2]))
+                grouped[key].append(error['line'])
+            print('PET LOG GROUPS')
+            for key,ns in grouped.items():print(len(ns),ns[:3],key)
+        else:
+            exceptions=[]
+            for n,line in enumerate(lines,1):
+                match=re.search(r'((?:org\.|java\.|com\.|market\.)[\w.$]*(?:Exception|Error))\b',line)
+                if match and ' at ' not in line:
+                    frames=[]
+                    for j in range(n,min(n+100,len(lines))):
+                        f=re.search(r'at (market\.[\w.$]+)\(([^()]*)\)',lines[j])
+                        if f:frames.append({'line':j+1,'symbol':f[1],'source':f[2]})
+                        if j>n and re.match(r'^sut-.*\| \d{4}-\d\d-\d\dT',lines[j]):break
+                    exceptions.append({'line':n,'class':match[1],'frames':frames})
+            (OUT/f'{sut}_log_exceptions.json').write_text(json.dumps(exceptions,indent=2)+'\n')
+            grouped=collections.defaultdict(list)
+            for error in exceptions:grouped[(error['class'],tuple((f['symbol'],f['source']) for f in error['frames'][:2]))].append(error['line'])
+            print('MARKET LOG GROUPS')
+            for key,ns in grouped.items():print(len(ns),ns[:3],key)
+        print('VALID_REJECTED/500 REQUEST SHAPES',sut)
+        records=[]
+        for item in items:
+            if item['kind'] not in ('VALID_REJECTED','SERVER_ERROR','RESPONSE_SCHEMA','RESPONSE_PARSE') and not(item['status']=='406'):continue
+            groups=collections.defaultdict(list)
+            for n in maps[item['item_id']]['exchange_lines']:
+                x=xs[n-1]; req=x['request'];resp=x['response'];text=resp['body']['text']
+                try:value=json.loads(text)
+                except ValueError:value=None
+                message=value.get('message','') if isinstance(value,dict) else text
+                # Record diagnostic categories, not error contents or credentials.
+                name=next((k for k in ['No Name provided','No User provided','No Order provided','No status provided','No tags provided','No file uploaded','No User provided'] if k in message),None)
+                reason=re.search(r'(?:reason:|<title>)([^<\n]+)',message)
+                if reason:
+                    reason=reason[1]
+                    name=next((k for k in ['Bad URI','Bad Message','Bad Request','Illegal character','Bad query','Bad path','Bad header'] if k.lower() in reason.lower()),'HTTP parser rejection')
+                exceptions=re.findall(r'(?:[A-Za-z_$][\w$]*\.)+[\w$]*(?:Exception|Error)',message)
+                if exceptions:name=';'.join(sorted(set(exceptions)))
+                if not name:name='JSON generic error' if isinstance(value,dict) else 'non-JSON response'
+                groups[name].append(n)
+            print(item['item_id'],[(k,len(v),v[:4]) for k,v in groups.items()])
+            records.append({'item_id':item['item_id'],'groups':[{'category':k,'count':len(v),'exchange_lines':v} for k,v in groups.items()]})
+        (OUT/f'{sut}_response_groups.json').write_text(json.dumps(records,indent=2)+'\n')
+
+if __name__=='__main__':main()
diff --git a/research/09_collab/logs/T16_scratch/replay.py b/research/09_collab/logs/T16_scratch/replay.py
new file mode 100644
index 0000000000000000000000000000000000000000..47448326dd995e2ce28e76641ef797def28abe46
--- /dev/null
+++ b/research/09_collab/logs/T16_scratch/replay.py
@@ -0,0 +1,128 @@
+"""Replay the project oracle for T16; retain locators without credential values."""
+import bisect
+import collections
+import csv
+import hashlib
+import json
+from pathlib import Path
+import re
+import sys
+
+OUT = Path(__file__).resolve().parent
+ROOT = OUT.parents[2]
+sys.path.insert(0, str(ROOT / '08_experiments/tools'))
+import conformance
+
+RUNS = {
+ 'swagger-petstore': '08_experiments/E1_pilot/runs/swagger-petstore/20261114T021748Z_batch_1701236_baseline_NONE_p0_s1',
+ 'market': '08_experiments/E1_pilot/runs/market/20261114T023303Z_batch_1724645_baseline_NONE_p0_s1',
+}
+
+def fingerprint(raw):
+    value = raw
+    for _ in range(3):
+        if isinstance(value, list):
+            return json.dumps(value,ensure_ascii=False,separators=(',',':'))
+        value = json.loads(value)
+    raise ValueError('fingerprint did not decode to an array')
+
+def structure(value, depth=0):
+    if depth > 3:
+        return type(value).__name__
+    if isinstance(value,dict):
+        return {k:structure(v,depth+1) for k,v in value.items() if len(k)<50 and k.isascii()}
+    if isinstance(value,list):
+        return [structure(v,depth+1) for v in value[:3]]
+    return type(value).__name__
+
+def public_error(text):
+    # Record only fixed API error text and validator metadata, never user values.
+    fixed = ['No status provided','No tags provided','No Name provided','No name provided',
+             'No Pet provided','No petId provided','No User provided','No Username provided',
+             'No username provided','No Order provided','No file uploaded','Pet not found','User not found']
+    for phrase in fixed:
+        if phrase in text:
+            return phrase
+    try:
+        value=json.loads(text)
+    except ValueError:
+        return 'non-JSON error body'
+    if isinstance(value,dict):
+        return {'keys':list(value), 'field_error_names':sorted(set(re.findall(r'"field"\s*:\s*"([A-Za-z_][A-Za-z0-9_.]*)"',text)))}
+    return type(value).__name__
+
+def spec_index(source):
+    newline=[-1]+[m.start() for m in re.finditer('\n',source)]
+    decoder=json.JSONDecoder(); loc={}
+    def scan(pos,pointer):
+        while source[pos].isspace():pos+=1
+        loc[pointer]=bisect.bisect_left(newline,pos)
+        if source[pos] not in '{[':return decoder.raw_decode(source,pos)[1]
+        obj=source[pos]=='{';pos+=1;n=0
+        while True:
+            while source[pos].isspace() or source[pos]==',':pos+=1
+            if source[pos] in '}]':return pos+1
+            if obj:
+                key,pos=decoder.raw_decode(source,pos)
+                while source[pos].isspace() or source[pos]==':':pos+=1
+                key=key.replace('~','~0').replace('/','~1')
+            else:key=str(n)
+            pos=scan(pos,pointer+'/'+key);n+=1
+    scan(0,'');return loc
+
+def main():
+    for sut,run_rel in RUNS.items():
+        run=ROOT/run_rel
+        spec_data=json.loads((run/'spec.original.json').read_text())
+        oracle=conformance.Spec(spec_data)
+        items=list(csv.DictReader((ROOT/f'08_experiments/E2_labelling/{sut}_baseline_s1_blind.csv').open()))
+        by_fp={fingerprint(i['fingerprint']):i['item_id'] for i in items}
+        matches={i['item_id']:[] for i in items}; unknown=collections.Counter(); meta={}
+        all_violations=[]
+        for n,raw in enumerate((run/'exchanges.jsonl').open(),1):
+            x=json.loads(raw);req,resp=x['request'],x['response']
+            template,pp=oracle.match(req['path'],req['method'],req.get('origin'))
+            op,params=oracle.operation(template,req['method']) if template else (None,[])
+            problems=conformance.request_problems(oracle,params,op,x,pp) if op else []
+            rb=req.get('body',{});text=rb.get('text','')
+            try:body=json.loads(text) if text else None
+            except ValueError:body=None
+            response_text=resp.get('body',{}).get('text','')
+            meta[str(n)]={'method':req['method'],'template':template,'status':resp['status'],
+                         'timestamp':x.get('ts'),
+                         'query_names':list(req.get('query',{})),
+                         'content_type':req.get('headers',{}).get('content-type',''),
+                         'response_content_type':resp.get('headers',{}).get('content-type',''),
+                         'body_size':rb.get('size'), 'body_truncated':rb.get('truncated'),
+                         'body_decode_error':rb.get('decode_error'),'body_shape':structure(body),
+                         'response_sha256':hashlib.sha256(response_text.encode()).hexdigest(),
+                         'response_size':resp.get('body',{}).get('size'),
+                         'response_error':public_error(response_text) if int(resp['status'])>=400 else None,
+                         'request_problems':[{'pointer':p,'keyword':i.get('keyword')} for p,m,i in problems],
+                         'request_uncheckable':getattr(problems,'uncheckable',[])}
+            for v in conformance.check(oracle,x):
+                iid=by_fp.get(v['fingerprint'])
+                if iid:matches[iid].append(n)
+                else:unknown[v['fingerprint']]+=1
+                all_violations.append({'item_id':iid,'exchange_line':n,'kind':v['kind'],'pointer':v['pointer']})
+        mapped=[]
+        for item in items:
+            iid=item['item_id'];assert len(matches[iid])==int(item['occurrences']),(sut,iid,len(matches[iid]),item['occurrences'])
+            mapped.append({'item_id':iid,'exchange_lines':matches[iid]})
+        assert not unknown,(sut,unknown)
+        for name,value in [('exchange_map',mapped),('exchange_meta',meta),('diagnostics',all_violations),
+                           ('spec_locations',spec_index((run/'spec.original.json').read_text()))]:
+            (OUT/f'{sut}_{name}.json').write_text(json.dumps(value,indent=2,ensure_ascii=True)+'\n')
+        summary={'sut':sut,'run':run_rel,'exchanges':n,'items':len(items),'diagnostic_occurrences':len(all_violations),
+                 'exact_occurrence_counts':True,'unmatched_fingerprints':dict(unknown),
+                 'fingerprint_outer_JSON_string_normalized':True,
+                 'oracle_version':spec_data.get('openapi',spec_data.get('swagger')),'base':oracle.base}
+        (OUT/f'{sut}_replay_summary.json').write_text(json.dumps(summary,indent=2)+'\n')
+        print(json.dumps(summary))
+        for item,mapped_item in zip(items,mapped):
+            sample=meta[str(mapped_item['exchange_lines'][0])]
+            print(item['item_id'],item['kind'],item['status'],'n',len(mapped_item['exchange_lines']),
+                  'ex',mapped_item['exchange_lines'][:3], 'type',sample['content_type'],
+                  'error',sample['response_error'])
+
+if __name__=='__main__':main()
diff --git a/research/09_collab/logs/T16_scratch/validate.py b/research/09_collab/logs/T16_scratch/validate.py
new file mode 100644
index 0000000000000000000000000000000000000000..86d64a5a9b3a640a8478df7bb3c6032b9e0c5502
--- /dev/null
+++ b/research/09_collab/logs/T16_scratch/validate.py
@@ -0,0 +1,136 @@
+"""Validate T16 coverage, evidence, aggregation, and observable subcase witnesses."""
+import collections
+import csv
+import hashlib
+import importlib.metadata
+import json
+from pathlib import Path
+import re
+import sys
+from urllib.parse import unquote
+
+sys.path.insert(0,str(Path(__file__).resolve().parent))
+from replay import OUT,ROOT,RUNS
+sys.path.insert(0,str(ROOT/'08_experiments/tools'))
+import conformance
+
+FIELDS=['item_id','L1','L2','proposed_L2','confidence','evidence_types','evidence_locators','root_cause_id','both_candidate','rationale']
+files={};result=[]
+capabilities={'int32_format_checker_registered':'int32' in conformance.FORMAT_CHECKER.checkers,
+              'int64_format_checker_registered':'int64' in conformance.FORMAT_CHECKER.checkers,
+              'jsonschema_version':importlib.metadata.version('jsonschema')}
+assert not capabilities['int32_format_checker_registered'] and not capabilities['int64_format_checker_registered']
+for sut,rel in RUNS.items():
+    prefix,count=('P',43) if sut=='swagger-petstore' else ('M',13)
+    label_path=ROOT/f'08_experiments/E2_labelling/{sut}_baseline_s1_labels_codex.csv'
+    root_path=ROOT/f'08_experiments/E2_labelling/{sut}_root_causes_codex.csv'
+    blind_path=ROOT/f'08_experiments/E2_labelling/{sut}_baseline_s1_blind.csv'
+    with label_path.open(newline='') as f:
+        reader=csv.DictReader(f);assert reader.fieldnames==FIELDS;labels=list(reader)
+    with root_path.open(newline='') as f:
+        reader=csv.DictReader(f);assert reader.fieldnames==['root_cause_id','description','fix_site','items'];roots=list(reader)
+    items=list(csv.DictReader(blind_path.open(newline='')))
+    assert [r['item_id'] for r in labels]==[r['item_id'] for r in items]==[f'{prefix}{i:03}' for i in range(1,count+1)]
+    rootids={r['root_cause_id'] for r in roots}
+    maps={r['item_id']:r for r in json.loads((OUT/f'{sut}_exchange_map.json').read_text())}
+    cases=json.loads((OUT/f'{sut}_case_labels.json').read_text());by_item=collections.defaultdict(list)
+    for case in cases:by_item[case['item_id']].append(case)
+    xs=[json.loads(raw) for raw in (ROOT/rel/'exchanges.jsonl').open()]
+    log_lines=(ROOT/rel/'compose.log').read_bytes().decode().split('\n')
+    log_map=json.loads((OUT/f'{sut}_log_locations.json').read_text())
+    locators=0
+    for row,item in zip(labels,items):
+        iid=row['item_id'];expected=set(maps[iid]['exchange_lines'])
+        assert len(expected)==len(by_item[iid])==int(item['occurrences'])
+        assert {c['exchange_line'] for c in by_item[iid]}==expected
+        assert set(row['root_cause_id'].split(';'))=={c['root_cause_id'] for c in by_item[iid]}<=rootids
+        l1s={c['L1'] for c in by_item[iid]}
+        assert row['L1']==('UNDECIDABLE' if l1s=={'SPEC','TEST'} else next(iter(l1s)))
+        assert row['both_candidate'] in ('true','false')
+        assert row['confidence'] in ('1','2','3')
+        assert row['rationale'].startswith('⚠️') and len(row['rationale'].split())<=30
+        if row['L1']=='TEST':assert row['L2']=='' and row['proposed_L2'].startswith('T-')
+        if row['L1']=='UNDECIDABLE':assert row['L2']==row['proposed_L2']=='' and row['confidence']=='1'
+        if item['kind']=='REQUEST_UNCHECKABLE':
+            assert row['L1']=='TEST' and row['proposed_L2']=='T-ORACLE-COVERAGE'
+            for n in expected:
+                x=xs[n-1];oracle=conformance.Spec(json.loads((ROOT/rel/'spec.original.json').read_text()))
+                t,pp=oracle.match(x['request']['path'],x['request']['method'],x['request'].get('origin'))
+                op,params=oracle.operation(t,x['request']['method'])
+                rp=conformance.request_problems(oracle,params,op,x,pp)
+                assert rp.uncheckable
+                if item['status']=='500':
+                    assert any(c['exchange_line']==n and c['L1']=='IMPL' and c['L2']=='I-CRASH' for c in cases)
+        for locator in row['evidence_locators'].split(';'):
+            m=re.fullmatch(r'(.+):(\d+)(?: \(JSON Pointer (.*)\))?',locator);assert m,locator
+            name,line=m[1],int(m[2]);assert 'labels_A' not in name and '/runs/scout-api/' not in name
+            path=ROOT/name;assert path.is_file(),locator
+            if name not in files:files[name]=path.read_bytes()
+            lines=files[name].split(b'\n');assert 1<=line<=len(lines) and lines[line-1].strip(),locator
+            if m[3] is not None:
+                node=json.loads(files[name]);pointer=m[3]
+                for part in pointer.lstrip('/').split('/'):
+                    part=part.replace('~1','/').replace('~0','~')
+                    node=node[int(part)] if isinstance(node,list) else node[part]
+            locators+=1
+    for root in roots:
+        assert root['fix_site'] in ('spec','code','test','env')
+        assert root['description'].startswith(('⚠️','[H]'))
+        assert root['items'].split(';')==[r['item_id'] for r in labels if root['root_cause_id'] in r['root_cause_id'].split(';')]
+    # Direct subcase checks independent of label-writing code.
+    for case in cases:
+        n=case['exchange_line'];x=xs[n-1];category=case['category']
+        if category=='oracle_ignored_int64_range':
+            segment=x['request']['path'].split('/')[-2 if x['request']['path'].endswith('/uploadImage') else -1]
+            assert not -(2**63)<=int(segment)<2**63
+        elif category in ('oracle_ignored_int32_range','quantity_int32_overflow'):
+            body=json.loads(x['request']['body']['text']);value=body['userStatus' if sut=='swagger-petstore' else 'quantity']
+            assert not -(2**31)<=value<2**31
+        elif category=='path_int64_overflow':
+            assert not -(2**63)<=int(x['request']['path'].rsplit('/',1)[-1])<2**63
+        elif category=='transport_rejection':
+            if case['item_id']=='P022':assert any(ord(c)<32 or ord(c)==127 for c in x['request']['headers']['api_key'])
+            else:assert '\\' in unquote(x['request']['path']) and 'Invalid URI' in x['response']['body']['text']
+        elif category=='HAL_links_binding':
+            message=json.loads(x['response']['body']['text'])['message']
+            assert 'Expected relation name' in message and '_links' in message
+            assert isinstance(json.loads(x['request']['body']['text'])['_links'],list)
+        elif category=='explicit_validation_406':
+            response=json.loads(x['response']['body']['text']);assert response['fieldErrors'] and x['response']['status']==406
+            assert 'WARN' in log_lines[log_map[str(n)]['validation_or_notfound_line']-1]
+        elif category=='inferred_null_pet_id':
+            assert 'id' not in json.loads(x['request']['body']['text'])
+        elif category=='unquoted_JSON_string':
+            assert 'application/json' in x['response']['headers'].get('content-type','')
+            try:json.loads(x['response']['body']['text'])
+            except ValueError:pass
+            else:raise AssertionError('login body unexpectedly parses')
+    first=xs[0];assert first['request']['headers']['x-schemathesis-probe']=='NULL_BYTE_IN_HEADER'
+    assert first['request']['headers']['x-schemathesis-probe-null']=='\x00'
+    if sut=='swagger-petstore':
+        poisoned=xs[951];assert poisoned['response']['status']==200 and json.loads(poisoned['request']['body']['text'])=={}
+        assert json.loads(poisoned['response']['body']['text']).get('username') is None
+    else:
+        for n,x in enumerate(xs,1):
+            if x['response']['status']==500:
+                assert 'ERROR' in log_lines[log_map[str(n)]['error_line']-1]
+    for path in [blind_path,label_path,root_path,ROOT/rel/'exchanges.jsonl',ROOT/rel/'spec.original.json',ROOT/rel/'compose.log',ROOT/rel/'generator-input.json']:
+        files[str(path.relative_to(ROOT))]=path.read_bytes()
+    result.append({'sut':sut,'status':'PASS','items':count,'L1':dict(collections.Counter(r['L1'] for r in labels)),
+                   'evidence_locators_checked':locators,'diagnostic_cases':len(cases),
+                   'root_rows':len(roots),'both_candidates':sum(r['both_candidate']=='true' for r in labels),
+                   'max_rationale_words':max(len(r['rationale'].split()) for r in labels),
+                   'error_log_joins_by_URI_category_order':sum('error_line' in x for x in log_map.values()),
+                   'proxy_exact_URI_matches':sum('proxy_request_line' in x for x in log_map.values()),
+                   'proxy_prefix_corroborations':sum('prefix_corroboration_request_line' in x for x in log_map.values()),
+                   'application_ERROR_lines':sum('ERROR' in x and x.startswith('sut-') for x in log_lines)})
+manifest={name:hashlib.sha256(value).hexdigest() for name,value in files.items()}
+for name in ['08_experiments/tools/conformance.py','08_experiments/tools/specmut.py','08_experiments/R1_triage_codebook.md','09_collab/tasks/T16.md']:
+    manifest[name]=hashlib.sha256((ROOT/name).read_bytes()).hexdigest()
+(OUT/'sha256_manifest.json').write_text(json.dumps(manifest,indent=2)+'\n')
+(OUT/'oracle_capabilities.json').write_text(json.dumps(capabilities,indent=2)+'\n')
+summary={'status':'PASS','SUTs':result,'evidence_files_checked':len(files),'oracle_capabilities':capabilities,
+         'blinding':{'labels_A_opened':False,'interpretation_reports_opened':False,'board_not_used_as_label_evidence':True},
+         'external_execution':False}
+(OUT/'validation.json').write_text(json.dumps(summary,indent=2)+'\n')
+print(json.dumps(summary,indent=2))
diff --git a/research/09_collab/logs/T16_scratch/write_labels.py b/research/09_collab/logs/T16_scratch/write_labels.py
new file mode 100644
index 0000000000000000000000000000000000000000..d4df94554fe6ada89ea8cc46b0b7b14a1715ca18
--- /dev/null
+++ b/research/09_collab/logs/T16_scratch/write_labels.py
@@ -0,0 +1,238 @@
+"""Write independently reviewed T16 labels and preserve case-level decisions."""
+import collections
+import csv
+import json
+from pathlib import Path
+import sys
+
+sys.path.insert(0,str(Path(__file__).resolve().parent))
+from replay import OUT,ROOT,RUNS
+
+CHECKER='08_experiments/tools/conformance.py'
+PET='08_experiments/_external/emb/jdk_8_maven/cs/rest/original/swagger-petstore/src/main/java/io/swagger/petstore/'
+MARKET='08_experiments/_external/emb/jdk_11_maven/cs/rest-gui/market/'
+REST=MARKET+'market-rest/src/main/java/market/'
