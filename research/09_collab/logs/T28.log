[[ $REQUEST_TIMEOUT_MS =~ ^[1-9][0-9]*$ ]] || { echo 'Invalid REQUEST_TIMEOUT_MS' >&2; exit 2; }
# Fixed fixture values stay in memory and are redacted from saved artifacts.
