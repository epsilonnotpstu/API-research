"""Write atomic, standard-library-only provenance for a pilot (called by run_pilot.sh)."""
import datetime
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() else None


def main():
    (run, emb, sut, source, mode, fault, severity, seed, budget, examples, image,
     project, started, phase, schema_rc, coverage_rc, cleanup_rc, harness_rc,
     health, base_path) = sys.argv[1:]
    run, emb = Path(run), Path(emb)
    commit = subprocess.check_output(['git', '-C', str(emb), 'rev-parse', 'HEAD'], text=True).strip()
    dirty = subprocess.check_output(['git', '-C', str(emb), 'status', '--porcelain'], text=True)
    images = {}
    for path in sorted(run.glob('*-image.json')):
        try:
            inspected = json.loads(path.read_text())[0]
            images[path.stem] = {'id': inspected['Id'], 'repo_digests': inspected.get('RepoDigests', []),
                                'repo_tags': inspected.get('RepoTags', [])}
        except (ValueError, IndexError, KeyError) as error:
            images[path.stem] = {'inspection_error': str(error)}
    files = {p.name: sha(p) for p in sorted(run.iterdir())
             if p.is_file() and p.name != 'run.json' and not p.name.endswith('.tmp')}
    fuzzer = os.environ.get('PILOT_FUZZER', 'schemathesis')
    data = {
        'fuzzer': fuzzer,
        'run_id': run.name, 'sut': sut, 'source_spec': source,
        'source_sha256': sha(next(run.glob('spec.original.*'), Path(source))),
        'mode': mode, 'fault': fault, 'severity': int(severity), 'seed': int(seed),
        'budget_seconds': int(budget), 'max_examples': int(examples),
        'schemathesis_image': image, 'compose_project': project,
        'started_at': started, 'updated_at': datetime.datetime.now(datetime.timezone.utc).isoformat(),
        'finished_at': None if harness_rc == 'pending' else datetime.datetime.now(datetime.timezone.utc).isoformat(),
        'phase': phase, 'schemathesis_exit': schema_rc, 'coverage_exit': coverage_rc,
        'cleanup_exit': cleanup_rc, 'harness_exit': harness_rc,
        'complete': harness_rc == '0', 'emb_commit': commit, 'emb_status_porcelain': dirty,
        'health_path': health, 'base_path': base_path, 'auth': os.environ.get('PILOT_AUTH_ROLE', 'none (pilot assumption)'),
        'request_timeout_ms': int(os.environ.get('PILOT_REQUEST_TIMEOUT_MS', '10000')),
        'hypothesis_phases': os.environ.get('PILOT_HYPOTHESIS_PHASES', 'explicit,generate'),
        'schema_checks': os.environ['SCHEMA_CHECKS'],
        'harness_version': 2,
        'sut_service': os.environ['SUT_SERVICE'],
        'sut_image': os.environ['SUT_IMAGE'],
        'internal_port': int(os.environ['INTERNAL_PORT']),
        'auth_source': os.environ['PILOT_AUTH_SOURCE'],
        'auth_source_sha256': (sha(emb / os.environ['PILOT_AUTH_SOURCE'])
                               if os.environ['PILOT_AUTH_SOURCE'] not in ('none', 'runtime-override') else None),
        'logger_max_body': int(os.environ['MITM_MAX_BODY']),
        'host_port': os.environ['HOST_PORT'], 'jacoco_port': os.environ['JACOCO_PORT'],
        'sut_jar_sha256': sha(Path(os.environ.get('PILOT_SUT_JAR_PATH', str(emb / 'dist' / f'{sut}-sut.jar')))),
        'code_mutation': ({'role': os.environ['PILOT_CODE_ROLE'],
                           'source_tree_sha256': os.environ['PILOT_CODE_SOURCE_SHA256'],
                           'manifest_sha256': sha(run / 'code.manifest.json')}
                          if os.environ.get('PILOT_CODE_ROLE') else None),
        'jacoco_agent_sha256': sha(emb / 'dist' / 'jacocoagent.jar'),
        'jacoco_cli_sha256': sha(emb / 'dist' / 'jacococli.jar'),
        'images': images, 'file_sha256': files,
        'tool_sha256': {p.name: sha(p) for p in sorted((emb.parent.parent / 'tools').glob('*.py'))},
        'harness_sha256': {str(p.relative_to(Path(__file__).parent)): sha(p)
                           for p in sorted(Path(__file__).parent.rglob('*'))
                           if p.is_file() and not any(part.startswith('.') for part in p.relative_to(Path(__file__).parent).parts)},
        'emb_config_sha256': {name: sha(emb / name) for name in
                              (os.environ['COMPOSE_FILE'], os.environ['DOCKERFILE'])},
        'limitations': ['fresh traffic is observational', 'fixed seed does not guarantee identical traffic',
                         'generator schema back edges are cut; conformance uses the original or mutated oracle',
                         'equal mutation operation sets do not imply equal generator and oracle constraints',
                         'transport-error and truncation coverage require review',
                         'locally built SUT may have only image ID, no registry digest'],
    }
    if fuzzer == 'evomaster':
        # Legacy image key identifies the selected generator for unchanged analysis.
        # Do not claim that Schemathesis ran in an EvoMaster collection.
        data['schemathesis_exit'] = 'not_started'
        data.update({
            'evomaster_image': os.environ['PILOT_EVOMASTER_IMAGE'],
            'evomaster_version': os.environ['PILOT_EVOMASTER_VERSION'],
            'evomaster_exit': schema_rc,
            'evomaster_argv_file': 'evomaster-argv.txt',
            'evomaster_argv': ((run / 'evomaster-argv.txt').read_text().splitlines()
                               if (run / 'evomaster-argv.txt').is_file() else []),
            'evomaster_watchdog_seconds': int(budget) + 120,
        })
        data['file_sha256'].update({str(p.relative_to(run)): sha(p)
                                   for p in sorted((run / 'evomaster').rglob('*')) if p.is_file()})
        data['limitations'] = [line for line in data['limitations']
                               if not line.startswith(('generator schema back edges',
                                                       'equal mutation operation sets'))]
        data['limitations'].append('EvoMaster uses spec.test unchanged; schema path checked against base_path')
    tmp = run / 'run.json.tmp' 
    tmp.write_text(json.dumps(data, indent=2) + '\n')
    tmp.replace(run / 'run.json')


if __name__ == '__main__':
    main()
"""T14/T17/T27 static validation and the permitted stdlib derecurse tests.

No harness scripts, third-party project code, Docker, Java, network, or SUT
commands are executed. Run from any directory with /usr/bin/python3 -I -B.
"""
import ast
import datetime
import hashlib
import importlib.util
import json
from pathlib import Path
import re
import subprocess
import sys
import xml.etree.ElementTree as ET
from urllib.parse import urlsplit

import yaml

HERE = Path(__file__).resolve().parent
EXP = HERE.parents[1]
EMB = EXP / "_external" / "emb"
SUTS = ("scout-api", "swagger-petstore", "market", "cwa-verification")


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main():
    print("T14/T17/T27 validation:", datetime.datetime.now(datetime.timezone.utc).isoformat(), flush=True)
    for path in sorted(HERE.glob("*.sh")):
        subprocess.run(["bash", "-n", str(path)], check=True)
        source = path.read_text()
        if path.name != "common.sh":
            assert "set -euo pipefail" in source, path.name
            assert path.stat().st_mode & 0o111, path.name
        for code in re.findall(r"<<'PY'\n(.*?)^PY$", source, re.M | re.S):
            ast.parse(code, filename=path.name + ":heredoc")
        for code in re.findall(r" -c '([^']*)'", source):
            ast.parse(code, filename=path.name + ":inline")
        assert not re.search(r"docker\s+(?:system|container|image|volume)\s+prune", source)
        assert not re.search(r"(?:pip\s+install|curl[^\n]+\|\s*(?:bash|sh))", source)
        print("PASS SHELL/INLINE_AST", path.name, flush=True)
    for path in sorted(HERE.glob("*.py")):
        ast.parse(path.read_text(), filename=path.name)
        print("PASS PYTHON_AST", path.name, flush=True)

    fixture_values = set()
    fixture_tokens = set()
    public_roles = set()
    for sut in SUTS:
        path = HERE / "suts" / f"{sut}.env"
        config = dict(line.split("=", 1) for line in path.read_text().splitlines()
                      if line and not line.startswith("#"))
        assert config["SUT_ID"] == sut
        assert config["SUT_IMAGE"] == f"r1-{sut}-sut:pilot"
        assert config["SUT_SERVICE"] == f"sut-{sut}"
        assert config["INTERNAL_PORT"] == "8080"
        for key in ("HEALTH_PATH_DEFAULT", "BASE_PATH_DEFAULT"):
            assert config[key].startswith("/")
        for key in ("JAR_SOURCE", "COMPOSE_FILE", "DOCKERFILE", "SPEC_SOURCE"):
            assert (EMB / config[key]).is_file(), (sut, key)
        assert (EMB / config["JAR_SOURCE"]).stat().st_size > 0
        original = yaml.safe_load((EMB / config["COMPOSE_FILE"]).read_text())
        override = yaml.safe_load((HERE / f"compose.override.{sut}.yaml").read_text())
        service = override["services"][config["SUT_SERVICE"]]
        proxy = override["services"]["mitmproxy"]
        assert service["image"] == config["SUT_IMAGE"]
        assert service["build"]["dockerfile"] == config["DOCKERFILE"]
        assert service["build"]["context"] == "${EMB_DIR:?Set EMB_DIR}"
        assert proxy["entrypoint"] == ["mitmdump"]
        assert f"reverse:http://{config['SUT_SERVICE']}:8080" in proxy["command"]
        assert proxy["environment"]["MITM_FULLLOG_FILE"] == "exchanges.jsonl"
        # This validates the port interpolation inputs, not Docker's merge engine.
        assert original["services"]["mitmproxy"]["ports"] == ["${HOST_PORT:-8080}:8080"]
        assert original["services"][config["SUT_SERVICE"]]["ports"] == ["${JACOCO_PORT:-6300}:6300"]
        assert all("ports" not in entry for entry in override["services"].values())
        spec = json.loads((EMB / config["SPEC_SOURCE"]).read_text())
        count = sum(method in {"get", "put", "post", "delete", "patch", "head", "options", "trace"}
                    for item in spec["paths"].values() for method in item)
        if config["AUTH_ROLE_DEFAULT"] != "none":
            auth = yaml.safe_load((EMB / config["AUTH_SOURCE"]).read_text())
            selected = [role for role in auth["auth"] if role["name"] == config["AUTH_ROLE_DEFAULT"]]
            assert len(selected) == 1 and len(selected[0]["fixedHeaders"]) == 1
            assert selected[0]["fixedHeaders"][0]["name"].lower() == "authorization"
            for role in auth["auth"]:
                public_roles.add(role["name"])
                for header in role.get("fixedHeaders", []):
                    value = header["value"]
                    fixture_values.add(value)
                    fixture_tokens.add(value.split(" ", 1)[-1])
        else:
            assert config["AUTH_SOURCE"] == ""
            assert not (EMB / "auth" / f"{sut}-auth.yaml").exists()
        print(f"PASS CONFIG:{sut} jar/paths/YAML/proxy/auth-shape; declared_operations={count}; "
              f"spec_version={spec.get('swagger', spec.get('openapi'))}", flush=True)
        if sut == "cwa-verification":
            cwa = EMB / "jdk_11_maven/cs/rest/cwa-verification-server"
            ns = {"m": "http://maven.apache.org/POM/4.0.0"}
            pom = ET.parse(cwa / "pom.xml").getroot()
            plugin = next(p for p in pom.findall("m:build/m:plugins/m:plugin", ns)
                          if p.findtext("m:artifactId", namespaces=ns) == "spring-boot-maven-plugin")
            execution = next(e for e in plugin.findall("m:executions/m:execution", ns)
                             if "repackage" in [g.text for g in e.findall("m:goals/m:goal", ns)])
            final_name = execution.findtext("m:configuration/m:finalName", namespaces=ns)
            classifier = execution.findtext("m:configuration/m:classifier", namespaces=ns)
            assert final_name == "cwa-verification" and classifier == "sut"
            assert (EMB / config["JAR_SOURCE"]) == cwa / "target" / f"{final_name}-{classifier}.jar"
            assert config["AUTH_ROLE_DEFAULT"] == "none"
            assert not list((EMB / "auth").glob("cwa-verification*.yaml"))
            assert config["BASE_PATH_DEFAULT"] == "/" and count == 5
            assert all(urlsplit(server["url"]).path in ("", "/") for server in spec["servers"])
            assert config["HEALTH_PATH_DEFAULT"] == "/version/v1/tan/verify"
