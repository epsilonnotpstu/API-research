+        raise ValueError('Invalid message L1: ' + repr(labels))
+    if len(labels) == 1:
+        return next(iter(labels))
+    if {'SPEC', 'IMPL'} <= labels:
+        return 'BOTH'
+    if labels == {'SPEC', 'UNDECIDABLE'}:
+        return 'SPEC_PARTIAL'
+    if labels == {'IMPL', 'UNDECIDABLE'}:
+        return 'IMPL_PARTIAL'
+    return 'UNDECIDABLE'
