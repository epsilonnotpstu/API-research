   680	def message_finding(row, ctx, raw, path, msg, sheet_ref):
   681	    """§9: independent attribution; no R3 inference from closed-source code.
   682	
   683	    confirmed/fixed flags cannot establish a fix direction and are not rules.
   684	    Response-level ENV/5xx evidence applies to each message in that response.
   685	    """
   686	    ref, status = source(raw), int(raw['statusCode'])
   687	    hit = environment(raw)
   688	    if hit is not None:
   689	        return hit
   690	    if 500 <= status < 600:
   691	        return finding('I-CRASH', 3, 'R1_5XX', ['E-CONV'], [ref], 'Observed server error.', 'IMPL')
   692	    hit = strict_property(ctx, row, raw, path, msg, sheet_ref)
   693	    if hit is None and 'Unable to parse JSON' in msg:
   694	        hit = malformed_json(ctx, row['api'], raw)
   695	    if hit is None:
   696	        hit = broken_pattern(msg, ref)
   697	    if hit is None and 'Instance type (null)' in msg:
   698	        hit = consistency(ctx, row['api'], raw, path, 'null')
   699	        if hit is None:
   700	            hit = documented_null(ctx, row['api'], raw, path)
   701	    if hit is None:
   702	        hit = alternative_format(msg, ref)
   703	    if hit is None:
   704	        hit = repeated_outlier(ctx, row['api'], raw, path, msg)
   705	    if hit is None and 'failed to match' in msg:
   706	        hit = composition(ctx, row['api'], raw, path)
   707	        if hit is None:
   708	            diagnostics = composition_diagnostics(ctx, row['api'], raw, path)
   709	            return finding('', 1, 'R5_INSUFFICIENT', ['E-AUX'],
   710	                           [ref, ctx.spec_refs.get(row['api'], 'input:spec=' + row['api']) + ':response-path=' + path],
   711	                           'Composition diagnostics (no intent attribution): ' + json.dumps(diagnostics, ensure_ascii=False), 'UNDECIDABLE')
   712	    if hit is None and 'Response status' in msg:
   713	        if status in (401, 403) or (400 <= status < 500 and truth(raw.get('faulty'))):
   714	            hit = finding('S-STATUS', 2, 'STATUS_REJECT_INVALID_OR_AUTH', ['E-CONV', 'E-AUX'], [ref],
   715	                          'Undocumented rejection/auth status; supplied invalidity flag if applicable.')
   716	        else:
   717	            hit = undocumented_4xx(ctx, row['api'], raw)
   718	    if hit is None and 'Content-Type header' in msg:
   719	        hit = finding('S-MEDIA', 1, 'MEDIA_TYPE_UNDOCUMENTED', ['E-AUX'], [ref],
   720	                      'Retains baseline media-type SPEC lean; intent remains weak.')
   721	    return hit or finding('', 1, 'R5_INSUFFICIENT', [], [ref],
   722	                          'No supported intent evidence; mismatch alone is insufficient.', 'UNDECIDABLE')
   723	
