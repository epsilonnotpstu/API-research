+        ms = json.loads(out['evidence_details'])
+        self.assertEqual((ms[0]['L1'], ms[0]['L2']), ('TEST', 'T-ORACLE-STRICT'))
+        self.assertEqual(out['label_L1'], 'UNDECIDABLE')
