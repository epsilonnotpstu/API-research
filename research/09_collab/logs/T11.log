   614	    if schema is not None:
   615	        hit.refs += (ctx.spec_refs.get(row['api'], 'input:spec=' + row['api']) + ':response-path=' + path,)
   616	        for prop in re.findall(r'"([^"]+)"', message):
   617	            evidence = ctx.documentation.get((row['api'], path, prop), {})
   618	            url, date = evidence.get('url', ''), evidence.get('retrieved_on', '')
   619	            try:
   620	                dt.date.fromisoformat(date)
   621	            except (ValueError, TypeError):
   622	                continue
   623	            if prop not in schema.get('properties', {}) and re.match(r'https?://', url):
   624	                hit.doc_gap = True
   625	                hit.codes = tuple(sorted(set(hit.codes) | {'E-DOC'}))
   626	                hit.refs += (url + ' retrieved_on=' + date,)
   627	                hit.note += ' Public documentation includes absent schema field: ' + prop + '.'
   628	    return hit
