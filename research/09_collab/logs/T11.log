        self.assertEqual(hit.rule, 'PROPERTY_STABLE')
        c = raw({'items': [{'extra': 3}, {}]}, 'c')
        self.assertIsNone(T.consistency(T.Context({'api': [a, c]}), 'api', a, '/items/[item]/extra', 'property'))

