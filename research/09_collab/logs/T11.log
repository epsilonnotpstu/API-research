+                 (['SPEC', 'IMPL'], 'BOTH'), (['SPEC', 'IMPL', 'UNDECIDABLE'], 'BOTH'),
+                 (['TEST', 'SPEC'], 'UNDECIDABLE'), (['TEST', 'UNDECIDABLE'], 'UNDECIDABLE'),
+                 (['ENV', 'SPEC'], 'UNDECIDABLE'), (['ENV', 'UNDECIDABLE'], 'UNDECIDABLE')]
