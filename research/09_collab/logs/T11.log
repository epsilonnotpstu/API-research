+    if label in ('SPEC_PARTIAL', 'IMPL_PARTIAL'):
+        return 'UNDECIDABLE' if mode == 'strict' else label.removesuffix('_PARTIAL')
+    if label not in ('SPEC', 'IMPL', 'ENV', 'TEST', 'BOTH', 'UNDECIDABLE'):
