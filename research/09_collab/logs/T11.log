+    def test_doc_gap_requires_missing_field_url_and_retrieval_date(self):
+        a = raw({'extra': 1}, reason='Object instance has properties which are not allowed by the schema: ["extra"]')
+        spec = spec_with({'type': 'object', 'properties': {}})
