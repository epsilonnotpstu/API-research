+        return finding('I-RESP-CONTRACT', 2, 'MALFORMED_JSON', ['E-AUX', 'E-CONV'],
+                       [source(raw), ctx.spec_refs.get(api, 'input:spec=' + api) + ':response-status=' + str(raw['statusCode'])],
