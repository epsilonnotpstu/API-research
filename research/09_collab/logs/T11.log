   631	def environment(raw):
   632	    """§9.3: R4 precedes R1; body evidence is limited to error envelopes."""
   633	    if int(raw['statusCode']) in (429, 502, 503, 504):
   634	        return finding('', 2, 'R4_ENV', ['E-CONV'], [source(raw)],
   635	                       'Rate limit/gateway/service unavailable; repeatability unestablished.', 'ENV')
   636	    body = json_body(raw)
   637	    if isinstance(body, dict):
   638	        text = ' '.join(str(body.get(k, '')) for k in ('error', 'message', 'title', 'detail'))
   639	    elif body is MISSING:
   640	        text = raw.get('responseBody', '')
   641	    else:
   642	        text = ''
   643	    if re.search(r'\bbad gateway\b|\bgateway time[ -]?out\b|\b(?:request|connection|upstream|server) (?:timed out|time[ -]?out)\b', text, re.I):
   644	        return finding('', 2, 'R4_ENV_BODY', ['E-CONV'], [source(raw)],
   645	                       'Gateway/timeout diagnostic in error body; repeatability unestablished.', 'ENV')
   646	
   647	
   648	def malformed_json(ctx, api, raw):
   649	    """§9.3: syntactically invalid body + documented JSON response contract.
   650	
   651	    Swagger schema without produces also needs the captured expected JSON
   652	    outputContentType_x. An actual JSON Content-Type alone is not a contract.
   653	    """
   654	    if json_body(raw) is not MISSING:
   655	        return None
   656	    spec = ctx.spec(api)
   657	    if spec is None:
   658	        return None
   659	    try:
   660	        _, op = operation_for(spec, raw)
   661	        response = response_for(spec, raw)
   662	        if response is None:
   663	            return None
   664	        if 'swagger' in spec:
   665	            media = op.get('produces', spec.get('produces'))
   666	            if media is None:
   667	                media = [raw.get('outputContentType_x', '')] if 'schema' in response else []
   668	        else:
   669	            media = response.get('content', {})
   670	        is_json = lambda value: value.split(';')[0].strip().lower() == 'application/json' or value.split(';')[0].strip().lower().endswith('+json')
   671	        if not any(is_json(m) for m in media):
   672	            return None
   673	        return finding('I-RESP-CONTRACT', 2, 'MALFORMED_JSON', ['E-AUX', 'E-CONV'],
   674	                       [source(raw), ctx.spec_refs.get(api, 'input:spec=' + api) + ':response-status=' + str(raw['statusCode'])],
   675	                       'Captured body is syntactically invalid under documented JSON response contract.', 'IMPL')
   676	    except (ImportError, KeyError, ValueError, TypeError):
   677	        return None
