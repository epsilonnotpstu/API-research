+        hit = message_finding(row, ctx, raw, path, msg, sheet_ref)
+        refs = set(hit.refs) | {source(raw) + ':msg_idx=' + str(index),
+                               sheet_ref + ':fault_id=' + row['fault_id']}
+        result.append(dict(zip(MESSAGE_FIELDS, [
