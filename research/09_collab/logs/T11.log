+        out = T.classify(sheet(a), ctx)
+        self.assertEqual(out['label_L1'], 'SPEC_PARTIAL')
+        self.assertEqual([m['L1'] for m in json.loads(out['evidence_details'])], ['SPEC', 'UNDECIDABLE'])
+
