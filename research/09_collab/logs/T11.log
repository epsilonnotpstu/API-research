+        spec['paths']['/x']['get']['responses']['200']['schema']['properties']['extra'] = {}
+        ctx = T.Context({'api': [a]}, {'api': spec}, documentation={key: evidence})
+        self.assertFalse(T.classify_messages(sheet(a), ctx)[0]['doc_gap'])
