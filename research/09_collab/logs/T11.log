   743	def aggregate_labels(labels):
   744	    """§9.1; unspecified TEST/ENV mixtures conservatively remain undecidable.
   745	
   746	    BOTH requires independently supported SPEC and IMPL messages. No decisive
   747	    pattern/structure exception; unresolved messages always remain visible.
   748	    """
   749	    labels = set(labels)
   750	    if not labels <= {'SPEC', 'IMPL', 'ENV', 'TEST', 'UNDECIDABLE'}:
   751	        raise ValueError('Invalid message L1: ' + repr(labels))
   752	    if len(labels) == 1:
   753	        return next(iter(labels))
   754	    if {'SPEC', 'IMPL'} <= labels:
   755	        return 'BOTH'
   756	    if labels == {'SPEC', 'UNDECIDABLE'}:
   757	        return 'SPEC_PARTIAL'
   758	    if labels == {'IMPL', 'UNDECIDABLE'}:
   759	        return 'IMPL_PARTIAL'
   760	    return 'UNDECIDABLE'
   761	
   762	
   763	def score_label(label, mode='strict'):
   764	    """§9.1: normalize partial labels for strict or lenient evaluation."""
   765	    if mode not in ('strict', 'lenient'):
   766	        raise ValueError('Scoring mode must be strict or lenient')
   767	    if label in ('SPEC_PARTIAL', 'IMPL_PARTIAL'):
   768	        return 'UNDECIDABLE' if mode == 'strict' else label.removesuffix('_PARTIAL')
   769	    if label not in ('SPEC', 'IMPL', 'ENV', 'TEST', 'BOTH', 'UNDECIDABLE'):
   770	        raise ValueError('Invalid cluster L1: ' + label)
   771	    return label
   772	
   773	
   774	def agreement(left, right, mode='strict'):
   775	    """Raw agreement and Cohen's kappa; undefined degenerate kappa is None."""
   776	    if len(left) != len(right) or not left:
   777	        raise ValueError('Need equal, nonempty paired label sequences')
   778	    left, right = [score_label(x, mode) for x in left], [score_label(x, mode) for x in right]
   779	    n, a, b = len(left), Counter(left), Counter(right)
   780	    matched = sum(x == y for x, y in zip(left, right))
   781	    observed = matched / n
   782	    expected = sum(a[k] * b[k] for k in a.keys() | b.keys()) / n ** 2
   783	    return {'n': n, 'matched': matched, 'raw_agreement': observed,
   784	            'kappa': (observed - expected) / (1 - expected) if expected != 1 else None}
   785	
   786	
   787	def classify(row, ctx, sheet_ref='input:sheet', message_rows=None):
   788	    """§9.1: aggregate message labels without discarding supported findings."""
   789	    entries = classify_messages(row, ctx, sheet_ref) if message_rows is None else message_rows
   790	    label = aggregate_labels(m['L1'] for m in entries)
   791	    supported = [m for m in entries if m['L1'] != 'UNDECIDABLE']
   792	    unresolved = [{'path': m['path'], 'message': m['message'], 'msg_idx': m['msg_idx']}
   793	                  for m in entries if m['L1'] == 'UNDECIDABLE']
   794	    mixed_gap = label == 'UNDECIDABLE' and bool(supported)
   795	    return {
   796	        'label_L1': label,
   797	        'label_L2': '|'.join(sorted({m['L2'] for m in supported if m['L2']})),
   798	        'confidence': min(m['confidence'] for m in supported) if supported and label != 'UNDECIDABLE' else 1,
   799	        'evidence_codes': ';'.join(sorted({c for m in entries for c in m['evidence_codes'].split(';') if c})),
   800	        'rules': ';'.join(sorted({m['rule'] for m in entries} | ({'AGGREGATION_RULE_GAP'} if mixed_gap else set()))),
   801	        'evidence_refs': json.dumps(sorted({source(ctx.raw(row)), sheet_ref + ':fault_id=' + row['fault_id']} |
   802	                                           {r for m in entries for r in json.loads(m['refs'])}), ensure_ascii=False),
   803	        'evidence_details': json.dumps(entries, ensure_ascii=False),
   804	        'unresolved': json.dumps(unresolved, ensure_ascii=False),
   805	        'spec_limitation': ctx.spec_errors.get(row['api'], ''),
   806	        'doc_gap': any(m['doc_gap'] for m in entries),
   807	        'aggregation_gap': mixed_gap,
   808	        'n_labelled_messages': len(entries),
   809	        'note': ('Unspecified mixed L1 combination; conservative UNDECIDABLE.' if mixed_gap else
   810	                 'Partial attribution; confidence applies to supported messages.' if label.endswith('_PARTIAL') else
   811	                 'Message-level heuristic attribution aggregated under section 9.1.'),
   812	        'codebook_ref': CODEBOOK + ':sections=2,3,4,8,9',
   813	    }
   814	
