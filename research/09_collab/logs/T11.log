   729	def classify_messages(row, ctx, sheet_ref='input:sheet'):
   730	    raw = ctx.raw(row)
   731	    result = []
   732	    for index, (path, msg) in enumerate(messages(raw['failReason']), 1):
   733	        hit = message_finding(row, ctx, raw, path, msg, sheet_ref)
   734	        refs = set(hit.refs) | {source(raw) + ':msg_idx=' + str(index),
   735	                               sheet_ref + ':fault_id=' + row['fault_id']}
   736	        result.append(dict(zip(MESSAGE_FIELDS, [
   737	            row['fault_id'], index, (f"[Path '{path}'] " if path else '') + msg,
   738	            hit.label, hit.locus, hit.confidence, hit.rule, ';'.join(hit.codes),
   739	            json.dumps(sorted(refs), ensure_ascii=False), hit.doc_gap, path, hit.note])))
   740	    return result
