   816	def run(sheet, p001_dir, output, messages_output=None):
   817	    rows = read_csv(sheet)
   818	    if not rows:
   819	        raise ValueError('Empty sheet')
   820	    ctx = Context.from_directory(p001_dir)
   821	    if messages_output is None:
   822	        messages_output = Path(output).with_name('triage_messages.csv')
   823	    if Path(output).resolve() == Path(messages_output).resolve():
   824	        raise ValueError('Fault and message output paths must differ')
   825	    results, message_rows = [], []
   826	    for row in rows:
   827	        entries = classify_messages(row, ctx, str(sheet))
   828	        message_rows.extend(entries)
   829	        results.append({**row, **classify(row, ctx, str(sheet), entries)})
   830	    with Path(output).open('w', encoding='utf-8', newline='') as handle:
   831	        writer = csv.DictWriter(handle, fieldnames=list(results[0]))
   832	        writer.writeheader()
   833	        writer.writerows(results)
   834	    with Path(messages_output).open('w', encoding='utf-8', newline='') as handle:
   835	        writer = csv.DictWriter(handle, fieldnames=MESSAGE_FIELDS)
   836	        writer.writeheader()
   837	        writer.writerows(message_rows)
   838	    counts = Counter((r['label_L1'], r['confidence']) for r in results)
   839	    print(json.dumps({f'{label}/confidence={conf}': n for (label, conf), n in sorted(counts.items())}))
   840	    return results
