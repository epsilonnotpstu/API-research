 reader=csv.DictReader(f);assert reader.fieldnames==expected;rows=list(reader)
items=list(csv.DictReader(open('items.csv')))
assert len(rows)==36
assert [r['item_id'] for r in rows]==[r['item_id'] for r in items]
locators=0
for r in rows:
 assert r['divergence_kind'] in {'DELIBERATE','ACCIDENTAL','UNCLEAR'}
 assert r['contract_specificity'] in {'SPECIFIC','GENERIC','UNCLEAR'}
 assert r['confidence'] in {'1','2','3'}
 assert len(r['rationale'].split())<=40
 for field,side,sep in [('impl_locators','impl',':'),('contract_locators','contract','#')]:
  for loc in r[field].split(';'):
   file,line=loc.rsplit(sep,1)
   assert file.startswith(r['item_id']+'/'+side+'/')
   p=pathlib.Path(file);assert p.is_file()
   assert 1<=int(line)<=len(p.read_text().splitlines()),loc
   locators+=1
report=pathlib.Path('codes_report_C11.md').read_text()
assert re.search('[\\u0980-\\u09ff]',report)
