100: 	flagKey := util.SafeString(evalContext.FlagKey)
101: 	f := cache.GetByFlagKeyOrID(flagID)
102: 	if f == nil {
103: 		f = cache.GetByFlagKeyOrID(flagKey)
104: 	}
105: 
106: 	if f == nil {
107: 		return BlankResult(nil, evalContext, fmt.Sprintf("flagID %v not found", flagID))
