105: // @router /get-user-payments [get]
106: func (c *ApiController) GetUserPayments() {
107: 	owner := c.Ctx.Input.Query("owner")
108: 	user := c.Ctx.Input.Query("user")
109: 
110: 	if !c.IsAdmin() {
111: 		sessionUser := c.GetSessionUsername()
112: 		sessionUserOwner, sessionUserName, err := util.GetOwnerAndNameFromIdWithError(sessionUser)
113: 		if err != nil {
114: 			c.ResponseError(err.Error())
115: 			return
116: 		}
117: 		if sessionUserOwner != owner || sessionUserName != user {
118: 			c.ResponseError("Forbidden")
119: 			return
120: 		}
121: 	}
122: 
123: 	payments, err := object.GetUserPayments(owner, user)
124: 	if err != nil {
125: 		c.ResponseError(err.Error())
126: 		return
127: 	}
128: 
129: 	c.ResponseOk(payments)
130: }
