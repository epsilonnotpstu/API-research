52: 
53:     @GET
54:     @Path("/project/{uuid}")
55:     @Produces(MediaType.APPLICATION_JSON)
56:     @ApiOperation(
57:             value = "Returns a list of all findings for a specific project",
58:             response = Finding.class,
59:             responseContainer = "List",
60:             responseHeaders = @ResponseHeader(name = TOTAL_COUNT_HEADER, response = Long.class, description = "The total number of findings")
61:     )
62:     @ApiResponses(value = {
63:             @ApiResponse(code = 401, message = "Unauthorized"),
64:             @ApiResponse(code = 404, message = "The project could not be found")
65:     })
66:     @PermissionRequired(Permissions.Constants.VULNERABILITY_ANALYSIS)
67:     public Response getFindingsByProject(@PathParam("uuid") String uuid) {
68:         try (QueryManager qm = new QueryManager(getAlpineRequest())) {
69:             final Project project = qm.getObjectByUuid(Project.class, uuid);
70:             if (project != null) {
71:                 final long totalCount = qm.getVulnerabilityCount(project, true);
72:                 final List<Finding> findings = qm.getFindings(project);
73:                 return Response.ok(findings).header(TOTAL_COUNT_HEADER, totalCount).build();
74:             } else {
75:                 return Response.status(Response.Status.NOT_FOUND).entity("The project could not be found.").build();
76:             }
77:         }
78:     }
