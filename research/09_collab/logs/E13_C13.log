8513:             if (parameter.getReferencedAssets() != null) {
8514:                 for (final Asset asset : parameter.getReferencedAssets()) {
8515:                     if (asset.getIdentifier().equals(assetId)) {
8516:                         referencingParameterNames.add(parameter.getDescriptor().getName());
