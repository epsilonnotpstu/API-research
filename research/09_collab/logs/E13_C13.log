55: func (h *handler) DeleteRelationTuples(ctx context.Context, req *acl.DeleteRelationTuplesRequest) (*acl.DeleteRelationTuplesResponse, error) {
56: 	if req.Query == nil {
57: 		return nil, errors.WithStack(herodot.ErrBadRequest.WithReason("invalid request"))
58: 	}
59: 
60: 	q, err := (&RelationQuery{}).FromProto(req.Query)
61: 	if err != nil {
62: 		return nil, errors.WithStack(herodot.ErrBadRequest.WithError(err.Error()))
63: 	}
64: 
65: 	if err := h.d.RelationTupleManager().DeleteAllRelationTuples(ctx, q); err != nil {
66: 		return nil, errors.WithStack(herodot.ErrInternalServerError.WithError(err.Error()))
67: 	}
68: 
69: 	return &acl.DeleteRelationTuplesResponse{}, nil
70: }
