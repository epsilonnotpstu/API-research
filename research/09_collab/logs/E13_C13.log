89:     })
90:     @PermissionRequired(Permissions.Constants.VULNERABILITY_ANALYSIS)
91:     public Response exportFindingsByProject(@PathParam("uuid") String uuid) {
92:         try (QueryManager qm = new QueryManager(getAlpineRequest())) {
93:             final Project project = qm.getObjectByUuid(Project.class, uuid);
94:             if (project != null) {
95:                 final List<Finding> findings = qm.getFindings(project);
96:                 final FindingPackagingFormat fpf = new FindingPackagingFormat(UUID.fromString(uuid), findings);
97:                 final Response.ResponseBuilder rb = Response.ok(fpf.getDocument().toString(), "application/json");
98:                 rb.header("Content-Disposition", "inline; filename=findings-" + uuid + ".fpf");
