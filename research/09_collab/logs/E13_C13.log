236:     private Map<String, Object> deleteTag(final String tagId, final String userId) throws TagRequestException {
237:         for (int attempt = 1;; attempt++) {
238:             final TagType tagType = getOwnTagType(tagId, userId);
239:             try {
240:                 getTagTypeService().delete(tagType);
241:             } catch (final TagTypeConflictException e) {
242:                 if (attempt >= MAX_UPDATE_ATTEMPTS) {
243:                     logger.warn("Failed to delete the tag after {} attempts: id={}", attempt, tagId, e);
244:                     throw new TagRequestException(V2ErrorCode.CONFLICT, "the tag was changed concurrently; try again");
245:                 }
246:                 continue;
247:             }
248:             enqueue(TagChange.delete(tagType.getTagValue()));
249:             break;

