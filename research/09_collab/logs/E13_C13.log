589: func (gw *Gateway) handleGetAllKeys(filter string) (interface{}, int) {
590: 	sessions := gw.GlobalSessionManager.Sessions(filter)
591: 	if filter != "" {
592: 		filterB64 := base64.StdEncoding.WithPadding(base64.NoPadding).EncodeToString([]byte(fmt.Sprintf(`{"org":"%s"`, filter)))
593: 		// Remove last 2 digits to look exact match
594: 		filterB64 = filterB64[0 : len(filterB64)-2]
595: 		orgIDB64Sessions := gw.GlobalSessionManager.Sessions(filterB64)
596: 		sessions = append(sessions, orgIDB64Sessions...)
597: 	}
598: 
599: 	fixedSessions := make([]string, 0)
600: 	for _, s := range sessions {
601: 		if !strings.HasPrefix(s, QuotaKeyPrefix) && !strings.HasPrefix(s, RateLimitKeyPrefix) {
602: 			fixedSessions = append(fixedSessions, s)
603: 		}
604: 	}
605: 
606: 	sessionsObj := apiAllKeys{fixedSessions}
607: 
608: 	log.WithFields(logrus.Fields{
609: 		"prefix": "api",
610: 		"status": "ok",
611: 	}).Info("Retrieved key list.")
612: 
613: 	return sessionsObj, http.StatusOK
614: }

