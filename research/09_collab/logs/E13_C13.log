13: // Labels searches labels based on their name.
14: func Labels(frm form.SearchLabels) (results []Label, err error) {
15: 	if err = frm.ParseQueryString(); err != nil {
16: 		return results, err
17: 	}
18: 
19: 	s := UnscopedDb()
20: 	// s.LogMode(true)
21: 
22: 	// Base query.
23: 	s = s.Table("labels").
24: 		Select(`labels.*`).
25: 		Where("labels.deleted_at IS NULL").
26: 		Where("labels.photo_count > 0").
27: 		Group("labels.id")
28: 
29: 	// Filter private labels.
30: 	if frm.Public {
31: 		s = s.Where("labels.label_nsfw = 0")
32: 	} else if frm.NSFW {
33: 		s = s.Where("labels.label_nsfw = 1")
34: 	}
35: 
36: 	// Limit result count.
37: 	if frm.Count > 0 && frm.Count <= MaxResults {
38: 		s = s.Limit(frm.Count).Offset(frm.Offset)
39: 	} else {
40: 		s = s.Limit(MaxResults).Offset(frm.Offset)
41: 	}
42: 
43: 	// Set sort order.
44: 	switch frm.Order {
45: 	case sortby.Slug:
46: 		s = s.Order("custom_slug ASC, labels.photo_count DESC")
47: 	case sortby.Count:
