11: // Enricher namespaces. The namespace is both the enricher's identity on a flag
12: // and the selector for its implementation in the handler registry. Namespaces
13: // are hardcoded in code: adding an integration is a code change.
14: const (
15: 	// EnricherNamespaceTs contributes @ts, @ts_hour, @ts_weekday, @ts_month.
16: 	// Global: supplied by the server, never stored on a flag.
17: 	EnricherNamespaceTs = "ts"
18: 	// EnricherNamespaceHTTP contributes @http_<header>. Global.
19: 	EnricherNamespaceHTTP = "http"
20: 	// EnricherNamespaceJev contributes @jev_<question> from a System One call.
21: 	// Flag-scoped.
22: 	EnricherNamespaceJev = "jev"
23: )
