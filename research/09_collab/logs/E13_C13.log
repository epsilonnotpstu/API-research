573: func (c *crud) DeleteSegment(params segment.DeleteSegmentParams) middleware.Responder {
574: 	flagID := util.SafeUint(params.FlagID)
575: 	segmentID := util.SafeUint(params.SegmentID)
576: 	subject := getSubjectFromRequest(params.HTTPRequest)
577: 
578: 	err := commitFlagMutation(flagID, subject, notification.OperationDelete, notification.ComponentSegment, func(tx *gorm.DB) (uint, mutationNotify, error) {
579: 		if err := tx.Delete(&entity.Segment{}, segmentID).Error; err != nil {
580: 			return 0, mutationNotify{}, err
581: 		}
582: 		return flagID, mutationNotify{ComponentID: segmentID, ComponentKey: ""}, nil
583: 	})
584: 	if err != nil {
585: 		return segment.NewDeleteSegmentDefault(500).WithPayload(ErrorMessage("%s", err))
586: 	}
587: 	return segment.NewDeleteSegmentOK()
588: }

