+    def test_refuse_to_overwrite_each_output(self):
+        files = {'items.csv': b.csv_bytes(b.ITEM_COLUMNS, [dict.fromkeys(b.ITEM_COLUMNS, 'K01')])}
+        log = {'package_hashes': {'items.csv': b.sha(files['items.csv'])}}
+        for target in range(3):
