+def scalar(value):
+    value = value.strip()
+    if value[:1] in {'"', "'"}:
+        try:
+            return ast.literal_eval(value)
+        except (ValueError, SyntaxError):
+            raise BuildError('Unsupported quoted authentication fixture scalar') from None
+    return value.split(' #', 1)[0].strip()
