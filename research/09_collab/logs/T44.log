+                                 '-c', 'core.fsmonitor=false', '-c', 'core.hooksPath=/dev/null',
+                                 '--git-dir=' + str(self.path), *args], input=stdin,
+                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
+        if ancestor and result.returncode == 1:
