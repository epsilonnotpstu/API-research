+        self.root = Path(self.temp.name)
+        self.store = SyntheticGit(self.root / 'fixture.git')
+        self.git = b.Git(self.store.path)
+        self.reference = self.root / 'reference'; self.reference.mkdir()
+        for method in ['M1', 'M2']:
