+    def tree(self, revision):
+        require(bool(re.fullmatch(r'[0-9a-f]{40,64}', revision)), 'Invalid revision')
+        if revision not in self.trees:
+            entries = {}
+            for record in self.run('ls-tree', '-r', '-l', '-z', revision).split(b'\0'):
+                if not record:
+                    continue
