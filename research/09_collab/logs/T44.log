+def discover_repos():
+    repos = {p.stem: p for p in sorted(UPSTREAM.glob('*.git'))}
+    for p in sorted(EARLIER.iterdir()):
+        if (p / '.git').is_dir():
+            require(p.name not in repos, 'Duplicate upstream repository')
+            repos[p.name] = p / '.git'
+        elif p.suffix == '.git':
+            require(p.stem not in repos, 'Duplicate upstream repository')
+            repos[p.stem] = p
+    return repos
