+
+def csv_bytes(columns, rows):
+    stream = io.StringIO(newline='')
+    writer = csv.DictWriter(stream, columns, lineterminator='\n', extrasaction='ignore')
+    writer.writeheader()
+    writer.writerows(rows)
+    return stream.getvalue().encode()
