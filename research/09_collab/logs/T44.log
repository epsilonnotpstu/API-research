+               'target', 'build', 'dist', 'out', 'coverage', '.next', 'vendor'}
+BUILD_SUFFIXES = {'.class', '.jar', '.war', '.ear', '.pyc', '.o', '.so', '.dll',
+                  '.exe', '.zip', '.tar', '.gz', '.tgz', '.jks', '.p12', '.pfx'}
+DESCRIPTORS = {'pom.xml', 'build.gradle', 'build.gradle.kts', 'settings.gradle',
