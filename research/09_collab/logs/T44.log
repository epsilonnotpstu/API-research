+    def ancestor(self, earlier, later):
+        pair = earlier, later
+        if pair not in self.ancestry:
+            self.ancestry[pair] = self.run('merge-base', '--is-ancestor', earlier, later, ancestor=True)
+        return self.ancestry[pair]
