+    def test_publish_hashes_and_repeat_refused(self):
+        parent, child, _ = self.pair()
+        files, key, log = self.prepare([self.row('A', parent, child)])
+        destinations = self.root / 'out', self.root / 'key.csv', self.root / 'log.json'
