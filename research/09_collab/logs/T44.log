+    def changed(self, parent, child):
+        raw = self.run('diff-tree', '--no-commit-id', '--no-ext-diff', '--no-textconv',
+                       '--no-renames', '-r', '--name-only', '-z', parent, child)
+        return sorted(x.decode() for x in raw.split(b'\0') if x)
