+#!/usr/bin/python3
+"""Offline regression tests. Synthetic Git stores are written with stdlib only."""
+import csv
+import hashlib
+import io
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+import zlib
