+                      self.other: b'package p;\nclass Other { int value = 1; }\n',
+                      'src/test/java/p/HandlerTest.java': b'package p;\nclass HandlerTest {}\n',
+                      'README.md': b'API documentation\n', 'docs/guide.md': b'Review guidance\n'}
