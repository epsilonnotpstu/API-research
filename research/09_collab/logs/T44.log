+SENSITIVE = r'(?:[\w.-]*(?:password|passwd|secret|api[_-]?key|access[_-]?key|auth[_-]?token|access[_-]?token|refresh[_-]?token|private[_-]?key)[\w.-]*|authorization|proxy-authorization)'
