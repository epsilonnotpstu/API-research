21: package com.redhat.swatch.contract.resource;
22: 
23: import com.redhat.swatch.contract.exception.ContractsException;
24: import com.redhat.swatch.contract.openapi.model.Error;
25: import jakarta.ws.rs.core.Response;
26: import jakarta.ws.rs.core.Response.Status;
27: import jakarta.ws.rs.ext.ExceptionMapper;
28: import jakarta.ws.rs.ext.Provider;
29: 
30: /** ExceptionMapper that maps application exceptions into . */
31: @Provider
32: public class ContractsExceptionMapper implements ExceptionMapper<ContractsException> {
33:   @Override
34:   public Response toResponse(ContractsException exception) {
35:     // Using a switch expression below forces us to decide on an HTTP status every time we add a new
36:     // ErrorCode.
37:     var status =
38:         switch (exception.getCode()) {
39:           case CONTRACT_EXISTS -> Status.CONFLICT;
40:           case BAD_UPDATE -> Status.BAD_REQUEST;
41:           case CONTRACT_DOES_NOT_EXIST -> Status.NOT_FOUND;
42:           default -> Status.INTERNAL_SERVER_ERROR;
43:         };
44:     return Response.status(status)
45:         .entity(
46:             new Error()
47:                 .code(exception.getCode().getCode())
48:                 .status(String.valueOf(status.getStatusCode()))
49:                 .title(exception.getMessage())
50:                 .detail(exception.getDetail()))
51:         .build();
52:   }
53: }

