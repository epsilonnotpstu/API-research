+      required:
+      - operationId
+      - targetUrl
+      properties:
+        id:
+          description: Unique identifier of the Webhook registration
+          type: string
+        createdOn:
+          format: date-time
+          description: Creation date of this Webhook registration
+          type: string
+        expiresAt:
+          format: date-time
+          description: Expiration date of this Webhook registration
+          type: string
+        operationId:
+          description: Identifier of the subscribed Operation, formatted as {serviceId}-{operationName}
+          type: string
+        operationMethod:
+          description: HTTP method of the subscribed Operation
+          type: string
+        targetUrl:
+          description: Target URL where Microcks will invoke the Webhook
+          type: string
