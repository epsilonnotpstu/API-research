+  /webhooks:
+    summary: This path operations deal with Webhook registrations
+    post:
+      tags:
+      - webhook
+      requestBody:
+        description: Webhook registration request payload
+        content:
+          application/json:
+            schema:
+              $ref: '#/components/schemas/WebhookRegistrationRequest'
