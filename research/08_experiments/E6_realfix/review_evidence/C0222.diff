+    WebhookRegistrationRequest:
+      description: Request payload used to register a new Webhook subscription
+      required:
+      - operationId
+      - targetUrl
+      properties:
+        operationId:
+          description: Identifier of the Operation to subscribe to, formatted as {serviceId}-{operationName}
