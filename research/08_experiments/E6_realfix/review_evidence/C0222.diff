+      security:
+      - jwt-bearer:
+        - user
+      operationId: RegisterWebhook
+      summary: Register a new Webhook
+      description: Register a new Webhook subscription for a given Service Operation.
+  /webhooks/{id}:
+    delete:
+      tags:
+      - webhook
+      responses:
+        "200":
+          description: Webhook registration was successfully deleted
+        "404":
+          description: No Webhook registration found for the given identifier
+      security:
+      - jwt-bearer:
+        - user
+      operationId: UnregisterWebhook
+      summary: Unregister an existing Webhook
+      description: Remove the Webhook registration having the specified identifier.
+    parameters:
+    - name: id
+      description: Unique identifier of the Webhook registration to remove
+      schema:
+        type: string
+      in: path
+      required: true
+  /webhooks/operation/{operationId}:
+    get:
+      tags:
+      - webhook
+      parameters:
+      - name: page
+        description: Page of Webhook registrations to retrieve (starts at and defaults
+          to 0)
+        schema:
+          type: integer
+        in: query
+      - name: size
+        description: Size of a page. Maximum number of Webhook registrations to include
+          in a response (defaults to 20)
+        schema:
+          type: integer
+        in: query
+      responses:
+        "200":
+          content:
+            application/json:
+              schema:
+                type: array
+                items:
+                  $ref: '#/components/schemas/WebhookRegistration'
+          description: List of Webhook registrations for the requested Operation
+      security:
+      - jwt-bearer:
+        - user
+      operationId: ListWebhookRegistrationsForOperation
+      summary: List Webhook registrations for an Operation
+    parameters:
+    - name: operationId
+      description: Unique identifier of the Operation to list Webhook registrations
+        for (formatted as {serviceId}-{operationName})
+      schema:
+        type: string
+      in: path
+      required: true
+  /webhooks/operation/{operationId}/count:
+    get:
+      tags:
+      - webhook
+      responses:
+        "200":
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/Counter'
+          description: Number of Webhook registrations for this Operation in datastore
+      security:
+      - jwt-bearer:
+        - user
+      operationId: CountWebhookRegistrationsForOperation
+      summary: Count Webhook registrations for an Operation
+    parameters:
+    - name: operationId
+      description: Unique identifier of the Operation to count Webhook registrations
+        for (formatted as {serviceId}-{operationName})
+      schema:
+        type: string
+      in: path
+      required: true
 components:
   schemas:
     TestCaseResult:
       description: Companion objects for TestResult. Each TestCaseResult correspond
