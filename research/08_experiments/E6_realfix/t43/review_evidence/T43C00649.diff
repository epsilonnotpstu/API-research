diff --git a/src/main/resources/application.yaml b/src/main/resources/application.yaml
index b3ee19b..efe1d72 100644
--- a/src/main/resources/application.yaml
+++ b/src/main/resources/application.yaml
@@ -42,16 +42,38 @@ gg:
     use-precompiled-templates: true
 
 ### Security
+# Authentication is always enabled. The bootstrap main administrator is seeded from
+# basic.auth.username / basic.auth.password on first startup; subsequent changes are
+# managed through the /app/admin/users UI (DB is authoritative).
+#
+# basic.auth.enable is DEPRECATED. It is still honored for backward compatibility:
+# when set to true every request except public static assets (css/js/img, favicon)
+# requires authentication — this explicitly includes /api/** and /allure/** (the
+# pre-2.x behavior), so deployments that relied on it stay protected after upgrade.
+# Prefer the runtime 'require API auth' toggle at /app/admin/settings
+# (app.security.require-api-auth) and remove this flag.
 basic:
   auth:
     username: admin
[REDACTED credential-related line]
     enable: false
 
+# app.security.require-api-auth controls /api/** protection on FIRST startup only —
+# once the system-settings row is written the database value wins. Admins flip this
+# at runtime via /app/admin/settings.
+app:
+  security:
+    require-api-auth: false
+    enable-oauth2: false
+
 ### App Configuration
 springdoc:
   swagger-ui:
     path: /swagger-ui.html
+    custom-css-url:
+      - /swagger/theme.css
+    custom-js-url:
+      - /swagger/brand.js
 
 # #################
 # Deprecated format. Not supported!
diff --git a/src/main/resources/brew-brand/brew-brand.css b/src/main/resources/brew-brand/brew-brand.css
new file mode 100644
index 0000000..a49931a
--- /dev/null
+++ b/src/main/resources/brew-brand/brew-brand.css
@@ -0,0 +1,49 @@
+/* Brew.QA branding — overrides Allure sidebar brand only. Do not change Allure palette/layout. */
+:root {
+  --brew-gold: #EBBB40;
+  --brew-green: #649c67;
+  --brew-on-gold: #111111;
+}
+
+/* Hide original Allure brand text/logo */
+.side-nav__brand > * { display: none !important; }
+
+/* Paint our brand into the existing .side-nav__brand slot */
+.side-nav__brand {
+  display: flex !important;
+  align-items: center !important;
+  gap: 8px !important;
+  text-decoration: none !important;
+}
+.side-nav__brand .brew-brand-link {
+  display: inline-flex !important;
+  align-items: center !important;
+  gap: 8px !important;
+  text-decoration: none !important;
+}
+.side-nav__brand .brew-brand-badge {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 28px;
+  height: 28px;
+  border-radius: 6px;
+  background: var(--brew-gold);
+  color: var(--brew-on-gold);
+  font-weight: 700;
+  font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
+  font-size: 16px;
+  line-height: 1;
+}
+.side-nav__brand .brew-brand-word {
+  font-weight: 600;
+  font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
+  font-size: 15px;
+  letter-spacing: -0.01em;
+  color: inherit;
+}
+.side-nav__brand .brew-brand-word .brew-dot { color: var(--brew-gold); }
+.side-nav__brand .brew-brand-word .brew-qa  { color: var(--brew-green); }
+
+/* Collapsed sidebar — hide wordmark, keep badge */
+.side-nav_collapsed .side-nav__brand .brew-brand-word { display: none !important; }
diff --git a/src/main/resources/brew-brand/brew-brand.js b/src/main/resources/brew-brand/brew-brand.js
new file mode 100644
index 0000000..7c6452f
--- /dev/null
+++ b/src/main/resources/brew-brand/brew-brand.js
@@ -0,0 +1,57 @@
+/* Brew.QA branding — injects logo into Allure sidebar. Idempotent. */
+(function () {
+  var MARKER = 'brew-brand-link';
+  var HOME_URL = '/';
+
+  function buildLink() {
+    var a = document.createElement('a');
+    a.className = MARKER;
+    a.href = HOME_URL;
+    a.setAttribute('aria-label', 'Brew.QA home');
+
+    var badge = document.createElement('span');
+    badge.className = 'brew-brand-badge';
+    badge.setAttribute('aria-hidden', 'true');
+    badge.textContent = 'B';
+
+    var word = document.createElement('span');
+    word.className = 'brew-brand-word';
+    var brew = document.createTextNode('Brew');
+    var dot = document.createElement('span');
+    dot.className = 'brew-dot';
+    dot.textContent = '.';
+    var qa = document.createElement('span');
+    qa.className = 'brew-qa';
+    qa.textContent = 'QA';
+    word.appendChild(brew);
+    word.appendChild(dot);
+    word.appendChild(qa);
+
+    a.appendChild(badge);
+    a.appendChild(word);
+    return a;
+  }
+
+  function apply(root) {
+    var brand = root.querySelector('.side-nav__brand');
+    if (!brand) return false;
+    if (brand.querySelector('.' + MARKER)) return true;
+    while (brand.firstChild) brand.removeChild(brand.firstChild);
+    brand.appendChild(buildLink());
+    return true;
+  }
+
+  function start() {
+    if (apply(document)) return;
+    var observer = new MutationObserver(function () {
+      if (apply(document)) observer.disconnect();
+    });
+    observer.observe(document.body, { childList: true, subtree: true });
+  }
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', start);
+  } else {
+    start();
+  }
+})();
