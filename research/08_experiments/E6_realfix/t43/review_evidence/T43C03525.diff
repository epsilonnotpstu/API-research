new file mode 100644
index 000000000..90762c325
--- /dev/null
+++ b/hivemq-edge/src/test/java/com/hivemq/protocols/v2/runtime/SchemaConformanceTest.java
@@ -0,0 +1,227 @@
+/*
[REDACTED attribution]
+ *
