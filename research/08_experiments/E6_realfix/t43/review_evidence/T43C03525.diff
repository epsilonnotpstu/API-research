+        managed.close();
+    }
+
+    private static @NotNull NodeTagPair pairOf(final @NotNull List<NodeTagPair> nodes, final @NotNull String tagName) {
+        return nodes.stream()
+                .filter(pair -> pair.tag().name().equals(tagName))
+                .findFirst()
+                .orElseThrow();
+    }
