# Non-secret values; all EMB paths are relative to EMB_DIR.
SUT_ID=cwa-verification
# pom.xml:7-8,282-283: repackage finalName overrides artifactId-version locally.
JAR_SOURCE=jdk_11_maven/cs/rest/cwa-verification-server/target/cwa-verification-sut.jar
COMPOSE_FILE=dockerfiles/cwa-verification.yaml
DOCKERFILE=dockerfiles/cwa-verification.dockerfile
SUT_SERVICE=sut-cwa-verification
INTERNAL_PORT=8080
# No actuator HTTP listener: management.server.port=-1 in the EMB Dockerfile.
# An empty JSON POST must reach required-body binding and return exactly 400.
# ⚠️ Source-derived readiness behavior; not runtime-verified in T17.
HEALTH_PATH_DEFAULT=/version/v1/tan/verify
HEALTH_METHOD_DEFAULT=POST
HEALTH_STATUS_DEFAULT=400
BASE_PATH_DEFAULT=/
AUTH_ROLE_DEFAULT=none
AUTH_SOURCE=
SUT_IMAGE=r1-cwa-verification-sut:pilot
SPEC_SOURCE=openapi-swagger/cwa-verification.json
