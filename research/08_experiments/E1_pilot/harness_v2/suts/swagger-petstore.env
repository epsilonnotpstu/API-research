# Non-secret values; all EMB paths are relative to EMB_DIR.
SUT_ID=swagger-petstore
JAR_SOURCE=jdk_8_maven/cs/rest/original/swagger-petstore/target/swagger-petstore-sut.jar
COMPOSE_FILE=dockerfiles/swagger-petstore.yaml
DOCKERFILE=dockerfiles/swagger-petstore.dockerfile
SUT_SERVICE=sut-swagger-petstore
INTERNAL_PORT=8080
# ⚠️ Runtime HTTP behavior is unverified in T14; see README.md evidence/assumptions.
HEALTH_PATH_DEFAULT=/api/v3/openapi.json
BASE_PATH_DEFAULT=/api/v3
AUTH_ROLE_DEFAULT=none
AUTH_SOURCE=
SUT_IMAGE=r1-swagger-petstore-sut:pilot
SPEC_SOURCE=openapi-swagger/swagger-petstore.json
