# Non-secret values; all EMB paths are relative to EMB_DIR.
SUT_ID=market
JAR_SOURCE=jdk_11_maven/cs/rest-gui/market/market-rest/target/market-sut.jar
COMPOSE_FILE=dockerfiles/market.yaml
DOCKERFILE=dockerfiles/market.dockerfile
SUT_SERVICE=sut-market
INTERNAL_PORT=8080
# ⚠️ Runtime HTTP behavior is unverified in T14; see README.md evidence/assumptions.
HEALTH_PATH_DEFAULT=/v2/api-docs
BASE_PATH_DEFAULT=/
AUTH_ROLE_DEFAULT=user
AUTH_SOURCE=auth/market-auth.yaml
SUT_IMAGE=r1-market-sut:pilot
SPEC_SOURCE=openapi-swagger/market.json
